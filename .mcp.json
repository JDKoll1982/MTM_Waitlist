  "mcpServers": {
    "oraios/serena": {
      "type": "local",
      "command": "C:\\Users\\johnk\\.local\\bin\\serena.exe",
      "args": [
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project-from-cwd"
