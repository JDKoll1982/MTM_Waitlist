<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Every package this solution restores is pinned to the one feed above (DEP-009; FR-009).

    NuGet matches a package against these patterns before it asks any source for it, and refuses to restore a
    package no pattern covers, so a package that appears from a feed this file does not name cannot be pulled in
    by a transitive dependency. There is deliberately no bare `*` pattern: a catch-all would make the mapping a
    formality and restore the behaviour it is here to remove.

    The families are written as prefixes rather than as one line per package id because the graph carries over a
    hundred ids across Microsoft.Extensions, the Windows App SDK's own split packages and the toolkit's
    sub-packages, all of which move between releases. A version bump changes a version, not this file.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Azure.*" />
      <package pattern="ColorCode.*" />
      <package pattern="CommunityToolkit.*" />
      <package pattern="coverlet.collector" />
      <package pattern="DevWinUI*" />
      <package pattern="Microsoft.*" />
      <package pattern="MSTest.*" />
      <package pattern="MySqlConnector" />
      <package pattern="NETStandard.Library" />
      <package pattern="Newtonsoft.Json" />
      <package pattern="System.*" />
      <package pattern="WinUIEx" />
    </packageSource>
  </packageSourceMapping>
</configuration>
