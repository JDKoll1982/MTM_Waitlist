{
  "name": "csharp-xaml-graph",
  "displayName": "C# / XAML Dependency Graph",
  "description": "Interactive dependency graph of C# class relationships and XAML View-to-ViewModel bindings for a WinUI 3 workspace.",
  "version": "0.6.0",
  "publisher": "mtm-local",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onCommand:csharpXamlGraph.show",
    "onCommand:csharpXamlGraph.debug",
    "onCommand:csharpXamlGraph.profile.initialize",
    "onCommand:csharpXamlGraph.profile.import",
    "onCommand:csharpXamlGraph.profile.refresh",
    "onView:csharpXamlGraph.menu"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "csharpXamlGraph.show",
        "title": "Show Dependency Graph",
        "category": "C#/XAML Graph"
      },
      {
        "command": "csharpXamlGraph.refresh",
        "title": "Refresh Dependency Graph",
        "category": "C#/XAML Graph"
      },
      {
        "command": "csharpXamlGraph.showForSelection",
        "title": "Show Dependency Graph for Selection",
        "category": "C#/XAML Graph"
      },
      {
        "command": "csharpXamlGraph.showForFile",
        "title": "Show Dependency Graph for File",
        "category": "C#/XAML Graph"
      },
      {
        "command": "csharpXamlGraph.export",
        "title": "Export Dependency Graph as JSON",
        "category": "C#/XAML Graph"
      },
      {
        "command": "csharpXamlGraph.openSettings",
        "title": "Open Settings",
        "category": "C#/XAML Graph"
      },
      {
        "command": "csharpXamlGraph.openMenu",
        "title": "Open Commands and Settings Panel",
        "category": "C#/XAML Graph"
      },
      {
        "command": "csharpXamlGraph.debug",
        "title": "Open Debug Report",
        "category": "C#/XAML Graph"
      },
      {
        "command": "csharpXamlGraph.profile.initialize",
        "title": "Set up Repository Profile",
        "category": "C#/XAML Graph"
      },
      {
        "command": "csharpXamlGraph.profile.import",
        "title": "Import Profile Reply",
        "category": "C#/XAML Graph"
      },
      {
        "command": "csharpXamlGraph.profile.refresh",
        "title": "Update Repository Profile",
        "category": "C#/XAML Graph"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "csharpXamlGraph.showForSelection",
          "when": "resourceExtname == .cs || resourceExtname == .xaml",
          "group": "navigation@9"
        },
        {
          "command": "csharpXamlGraph.showForFile",
          "when": "resourceExtname == .cs || resourceExtname == .xaml",
          "group": "navigation@10"
        }
      ],
      "explorer/context": [
        {
          "command": "csharpXamlGraph.showForFile",
          "when": "resourceExtname == .cs || resourceExtname == .xaml",
          "group": "navigation@9"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "csharpXamlGraphPanel",
          "title": "C#/XAML Graph",
          "icon": "assets/graph.svg"
        }
      ]
    },
    "views": {
      "csharpXamlGraphPanel": [
        {
          "id": "csharpXamlGraph.menu",
          "name": "Commands and settings",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "C#/XAML Dependency Graph",
      "properties": {
        "csharpXamlGraph.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.cs",
            "**/*.xaml"
          ],
          "description": "Glob patterns, relative to the workspace folder, describing the files to analyse."
        },
        "csharpXamlGraph.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/bin/**",
            "**/obj/**",
            "**/node_modules/**",
            "**/*.Tests/**",
            "**/.github/**",
            "**/.specify/**"
          ],
          "description": "Glob patterns excluded from analysis."
        },
        "csharpXamlGraph.includeExternalTypes": {
          "type": "boolean",
          "default": true,
          "description": "Show types that are referenced but not declared in the workspace (framework base classes, package interfaces)."
        },
        "csharpXamlGraph.maxNodes": {
          "type": "number",
          "default": 4000,
          "description": "Safety cap on the number of nodes sent to the webview."
        },
        "csharpXamlGraph.unpackedLayout": {
          "type": "string",
          "enum": [
            "layered-tb",
            "layered-lr",
            "force",
            "radial",
            "grid",
            "circle"
          ],
          "enumDescriptions": [
            "Layered Down — each type above the types it depends on. The default, because a chain of types reads top to bottom.",
            "Layered Right — each type to the left of the types it depends on.",
            "Force — nodes push apart until the springs settle.",
            "Radial — views near the middle, models further out.",
            "Grid — an even grid with no dependency shape.",
            "Circle — one ring. Only legible for a small group."
          ],
          "default": "layered-tb",
          "markdownDescription": "Layout applied to a shape when it is unpacked from the packed tiles. Packed tiles are always drawn compressed; an unpacked shape is redrawn in this layout, from its starting root to the end of the group."
        }
      }
    }
  },
  "scripts": {
    "compile": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "build": "npm run typecheck && npm run compile",
    "selftest": "npm run build && node out/selftest.js",
    "validate": "npm run build && node out/validate.js",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "package:vsix": "npm run build && vsce package --allow-missing-repository --out csharp-xaml-graph.vsix",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "web-tree-sitter": "0.27.2"
  },
  "devDependencies": {
    "@types/node": "26.6.11",
    "@types/vscode": "1.146.0",
    "@vitest/coverage-v8": "^5.1.2",
    "@vscode/vsce": "4.1.1",
    "cytoscape": "3.35.0",
    "cytoscape-dagre": "4.1.0",
    "dagre": "0.8.5",
    "esbuild": "0.28.2",
    "htmlparser2": "12.0.0",
    "jsdom": "^31.0.1",
    "tree-sitter-c-sharp": "0.24.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.2"
  }
}
