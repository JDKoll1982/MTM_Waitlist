<Page
    x:Class="MTM_Waitlist.Views.SplashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">
            <ProgressRing
                Width="64"
                Height="64"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="26"
                FontWeight="SemiBold"
                Text="Starting MTM Waitlist" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </StackPanel>

        <StackPanel
            x:Name="ActionArea"
            Grid.Row="1"
            x:Load="{x:Bind ViewModel.ShowActions, Mode=OneWay}"
            Margin="0,0,0,24"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="12">
            <Button Command="{x:Bind ViewModel.RetryCommand, Mode=OneWay}" Content="Retry" />
            <Button Command="{x:Bind ViewModel.ResetToDefaultsCommand, Mode=OneWay}" Content="Reset to defaults" />
            <Button Command="{x:Bind ViewModel.ExitCommand, Mode=OneWay}" Content="Exit" />
        </StackPanel>
    </Grid>
</Page>
