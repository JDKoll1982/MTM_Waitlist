<Page
    x:Class="MTM_Waitlist.Module_Shared.Views.ControlInspectorDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:MTM_Waitlist.Module_Shared.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Shared.Models"
    mc:Ignorable="d"
    Loaded="OnPageLoaded"
    Unloaded="OnPageUnloaded">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Command="{x:Bind ViewModel.BackCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                    <TextBlock Text="Back" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Detail.Title, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.Detail.Summary, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Style="{StaticResource InspectorChipStyle}">
                        <TextBlock
                            Style="{StaticResource InspectorChipTextStyle}"
                            Text="{x:Bind ViewModel.ElementTypeLabel, Mode=OneWay}" />
                    </Border>
                    <Border Style="{StaticResource InspectorChipStyle}">
                        <TextBlock
                            Style="{StaticResource InspectorChipTextStyle}"
                            Text="{x:Bind ViewModel.AutomationIdLabel, Mode=OneWay}" />
                    </Border>
                    <Border Style="{StaticResource InspectorChipStyle}">
                        <TextBlock
                            Style="{StaticResource InspectorChipTextStyle}"
                            Text="{x:Bind ViewModel.VisibilityLabel, Mode=OneWay}" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <Button
                x:Name="PrintButton"
                Grid.Column="2"
                VerticalAlignment="Top"
                Click="OnPrintClick" shared:TooltipBehavior.ResourceKey="Shared_PrintButton_Tooltip" shared:TooltipBehavior.AssociatedFiles="Module_Shared/Views/ControlInspectorDetailPage.xaml|Module_Shared/Views/ControlInspectorDetailPage.xaml.cs|Module_Shared/ViewModels/ControlInspectorDetailViewModel.cs|Module_Shared/Services/TooltipBehavior.cs|Module_Shared/Services/TooltipService.cs|Module_Shared/Services/ControlInspectorService.cs|Module_Core/Helpers/ResourceExtensions.cs" shared:TooltipBehavior.FallbackText="Activate Print Button.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE749;" />
                    <TextBlock Text="Print" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">

                <!-- Workflow chart -->
                <Border Style="{StaticResource InspectorAccentCardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource InspectorSectionTitleStyle}"
                                Text="Control workflow" />
                            <TextBlock
                                Style="{StaticResource InspectorCaptionStyle}"
                                Text="How this control's action flows through the app." />
                        </StackPanel>
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.WorkflowSteps, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel
                                            Padding="0,4,0,8"
                                            Orientation="Horizontal"
                                            Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ControlInspectorWorkflowStep">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE76C;"
                                                Visibility="{x:Bind models:ControlInspectorWorkflowStepView.ChevronVisibility(ShowChevron), Mode=OneTime}" />
                                            <Grid Width="172" VerticalAlignment="Top">
                                                <Border Style="{StaticResource InspectorStepStyle}">
                                                    <StackPanel Spacing="8">
                                                        <Border Style="{StaticResource InspectorStepNumberStyle}">
                                                            <TextBlock Style="{StaticResource InspectorStepNumberTextStyle}" Text="{x:Bind Index}" />
                                                        </Border>
                                                        <TextBlock Style="{StaticResource InspectorStepTitleStyle}" Text="{x:Bind Title}" TextWrapping="WrapWholeWords" />
                                                        <TextBlock Style="{StaticResource InspectorCaptionStyle}" Text="{x:Bind Caption}" TextWrapping="WrapWholeWords" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Sections rendered as label/value tables -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ControlInspectorSection">
                            <Border
                                Margin="0,0,0,16"
                                Style="{StaticResource InspectorCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock
                                        Style="{StaticResource InspectorSectionTitleStyle}"
                                        Text="{x:Bind Title}" />
                                    <ItemsControl ItemsSource="{x:Bind Fields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ControlInspectorField">
                                                <Grid
                                                    Padding="0,10"
                                                    ColumnSpacing="16"
                                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                    BorderThickness="0,0,0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Style="{StaticResource InspectorKeyStyle}"
                                                        Text="{x:Bind Label}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Style="{StaticResource InspectorValueStyle}"
                                                        IsTextSelectionEnabled="True"
                                                        Text="{x:Bind Value}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Associated source files -->
                <Border Style="{StaticResource InspectorCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock
                                    Style="{StaticResource InspectorSectionTitleStyle}"
                                    Text="Associated source files" />
                                <TextBlock
                                    Style="{StaticResource InspectorCaptionStyle}"
                                    Text="{x:Bind ViewModel.AssociatedFilesSummary, Mode=OneWay}" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                Header="Hide tooltip files"
                                IsOn="{x:Bind ViewModel.HideTooltipRelatedFiles, Mode=TwoWay}"
                                OffContent="Show"
                                OnContent="Hidden"
                                MinWidth="0" />
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.VisibleAssociatedFiles, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Grid.Column="0"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE8A5;" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource InspectorMonoStyle}"
                                            IsTextSelectionEnabled="True"
                                            Text="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

