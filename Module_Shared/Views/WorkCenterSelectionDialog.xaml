<ContentDialog
    x:Class="MTM_Waitlist.Module_Shared.Views.WorkCenterSelectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:MTM_Waitlist.Module_Shared.Services"
    DefaultButton="Close"
    CloseButtonText="Close"
    Title="Select Work Center"
    Style="{StaticResource RequestContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
        <x:Double x:Key="ContentDialogThemeMaxWidth">900</x:Double>
        <x:Double x:Key="ContentDialogThemeMinWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">900</x:Double>
    </ContentDialog.Resources>

    <StackPanel MaxHeight="560" Spacing="16">
        <TextBlock
            x:Name="WorkstationTextBlock"
            FontSize="14"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <InfoBar
            x:Name="NoActiveJobInfoBar"
            IsOpen="False"
            IsClosable="True"
            Severity="Warning"
            Title="No active setup job"
            Message="No Job is currently set up for that Press. Please contact a Setup Tech." />

        <Border Style="{StaticResource RequestDialogSectionCardStyle}">
            <StackPanel Spacing="10">
                <TextBlock
                    Style="{StaticResource RequestDialogTitleStyle}"
                    Text="Hot Work Centers" />
                <GridView
                    x:Name="HotWorkCentersGridView"
                    IsItemClickEnabled="True"
                    ItemClick="WorkCenter_ItemClick"
                    SelectionMode="Single" shared:TooltipBehavior.ResourceKey="Shared_HotWorkCentersGridView_Tooltip" shared:TooltipBehavior.AssociatedFiles="Module_Shared/Views/WorkCenterSelectionDialog.xaml|Module_Shared/Views/WorkCenterSelectionDialog.xaml.cs|Module_Shared/Services/TooltipBehavior.cs|Module_Shared/Services/TooltipService.cs|Module_Shared/Services/ControlInspectorService.cs|Module_Core/Helpers/ResourceExtensions.cs" shared:TooltipBehavior.FallbackText="Select an option in Hot Work Centers Grid View.">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid
                                Orientation="Horizontal"
                                MaximumRowsOrColumns="3" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                MinWidth="220"
                                Margin="8"
                                Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel Spacing="8">
                                    <Border
                                        Width="44"
                                        Height="44"
                                        Padding="4"
                                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                        CornerRadius="8">
                                        <Image
                                            Source="{Binding ResolvedImagePath, Converter={StaticResource ResolvedImagePathToSourceConverter}}"
                                            Stretch="Uniform" />
                                    </Border>
                                    <TextBlock
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Text="{Binding WorkCenterName}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource RequestDialogSectionCardStyle}">
            <StackPanel Spacing="10">
                <TextBlock
                    Style="{StaticResource RequestDialogTitleStyle}"
                    Text="Other Work Centers" />
                <GridView
                    x:Name="OtherWorkCentersGridView"
                    MaxHeight="320"
                    IsItemClickEnabled="True"
                    ItemClick="WorkCenter_ItemClick"
                    SelectionMode="Single" shared:TooltipBehavior.ResourceKey="Shared_OtherWorkCentersGridView_Tooltip" shared:TooltipBehavior.AssociatedFiles="Module_Shared/Views/WorkCenterSelectionDialog.xaml|Module_Shared/Views/WorkCenterSelectionDialog.xaml.cs|Module_Shared/Services/TooltipBehavior.cs|Module_Shared/Services/TooltipService.cs|Module_Shared/Services/ControlInspectorService.cs|Module_Core/Helpers/ResourceExtensions.cs" shared:TooltipBehavior.FallbackText="Select an option in Other Work Centers Grid View.">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid
                                Orientation="Horizontal"
                                MaximumRowsOrColumns="3" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                MinWidth="220"
                                Margin="8"
                                Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel Spacing="8">
                                    <Border
                                        Width="44"
                                        Height="44"
                                        Padding="4"
                                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                        CornerRadius="8">
                                        <Image
                                            Source="{Binding ResolvedImagePath, Converter={StaticResource ResolvedImagePathToSourceConverter}}"
                                            Stretch="Uniform" />
                                    </Border>
                                    <TextBlock
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Text="{Binding WorkCenterName}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>


