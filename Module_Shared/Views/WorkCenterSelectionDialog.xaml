<ContentDialog
    x:Class="MTM_Waitlist.Module_Shared.Views.WorkCenterSelectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Close"
    CloseButtonText="Close"
    Title="Select Work Center">

    <StackPanel MaxHeight="560" Spacing="16">
        <TextBlock
            x:Name="WorkstationTextBlock"
            FontSize="14"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <InfoBar
            x:Name="NoActiveJobInfoBar"
            IsOpen="False"
            IsClosable="True"
            Severity="Warning"
            Title="No active setup job"
            Message="No Job is currently set up for that Press. Please contact a Setup Tech." />

        <Border
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <StackPanel Spacing="10">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Hot Work Centers" />
                <GridView
                    x:Name="HotWorkCentersGridView"
                    IsItemClickEnabled="True"
                    ItemClick="WorkCenter_ItemClick"
                    SelectionMode="Single">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                MinWidth="220"
                                Margin="8"
                                Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel Spacing="8">
                                    <FontIcon Glyph="&#xE7F8;" FontSize="24" />
                                    <TextBlock
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Text="{Binding}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </Border>

        <Border
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <StackPanel Spacing="10">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Other Work Centers" />
                <GridView
                    x:Name="OtherWorkCentersGridView"
                    MaxHeight="320"
                    IsItemClickEnabled="True"
                    ItemClick="WorkCenter_ItemClick"
                    SelectionMode="Single">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                MinWidth="220"
                                Margin="8"
                                Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel Spacing="8">
                                    <FontIcon Glyph="&#xE7F8;" FontSize="24" />
                                    <TextBlock
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Text="{Binding}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>
