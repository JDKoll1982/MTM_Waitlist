<?xml version="1.0" encoding="utf-8"?>
<!--
  Folder publish profile for the MTM_Waitlist desktop application.

  The app is deliberately UNPACKAGED (WindowsPackageType=None) and installed per user by copying the whole
  folder to %LOCALAPPDATA%\Programs\MTM_Waitlist, so no MSIX identity, signing, or Store packaging is
  involved. See README.md, "Deploying the desktop application".

  `dotnet publish MTM_Waitlist.csproj -p:PublishProfile=win-x64-selfcontained` resolves this file. Without
  it MSBuild reports NETSDK1198 'A publish profile with the name ... was not found' and silently falls back
  to bin/<Config>/<TFM>/<RID>/publish with a FRAMEWORK-DEPENDENT result - which would put the .NET runtime
  back on the list of prerequisites every plant workstation has to satisfy.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PublishProtocol>FileSystem</PublishProtocol>
    <!-- The documented output location; README.md names it. -->
    <PublishDir>bin\publish\win-x64\</PublishDir>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Self-contained .NET *and* self-contained Windows App SDK: a workstation needs no runtime
         prerequisite at all, the same guarantee the on-host mock service makes. -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>

    <!-- Keep the deployed folder a plain set of files: the deploy step is "copy the whole folder", and
         neither a single-file nor a ReadyToRun build improves that. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
