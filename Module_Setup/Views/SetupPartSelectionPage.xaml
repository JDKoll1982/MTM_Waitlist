<Page
    x:Class="MTM_Waitlist.Module_Setup.Views.SetupPartSelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Setup.Models"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.State.NormalizedWorkOrder, Mode=OneWay}" />
            <TextBlock x:Uid="Setup_Part.FoundPartsLabel" Style="{ThemeResource BodyLargeTextBlockStyle}" Text="Matching parts" />
            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Parts, Mode=OneWay}" SelectionMode="Single" SelectedItem="{x:Bind ViewModel.SelectedPart, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SetupPartResult">
                    <StackPanel Padding="12" Spacing="4">
                        <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="{x:Bind PartNumber}" />
                        <TextBlock Text="{x:Bind Description}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind WorkCenter}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
            <Button x:Uid="Setup_Action.Back" Content="Back" Command="{x:Bind ViewModel.BackCommand}" />
            <Button x:Uid="Setup_Action.Continue" Content="Continue" Command="{x:Bind ViewModel.ContinueCommand}" />
        </StackPanel>
    </Grid>
</Page>