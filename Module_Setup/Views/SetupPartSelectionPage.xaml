<Page
    x:Class="MTM_Waitlist.Module_Setup.Views.SetupPartSelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Setup.Models"
    mc:Ignorable="d">

    <Grid Style="{StaticResource SetupPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource SetupPageHeaderStyle}">
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.State.NormalizedWorkOrder, Mode=OneWay}" />
            <TextBlock x:Uid="Setup_Part.FoundPartsLabel" Style="{StaticResource SetupPageTitleStyle}" Text="Matching parts" />
            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>

        <ListView AutomationProperties.AutomationId="SetupPartSelectionPage_PartList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Parts, Mode=OneWay}" SelectionMode="Single" SelectedItem="{x:Bind ViewModel.SelectedPart, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SetupPartResult">
                    <!--
                        One card per part (FR-021). The part's own picture is drawn beside its number, and an entry
                        with no picture draws the one shared placeholder rather than a blank space (FR-014, FR-018).
                        The entry is still a list item, so choosing it still selects the part.
                    -->
                    <Grid
                        Margin="4"
                        ColumnSpacing="12"
                        AutomationProperties.AutomationId="{x:Bind AutomationId}"
                        AutomationProperties.Name="{x:Bind PartNumber}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            MinWidth="72"
                            MinHeight="72"
                            Padding="4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <Image
                                AutomationProperties.AutomationId="{x:Bind ImageAutomationId}"
                                Source="{x:Bind ImagePath, Converter={StaticResource ResolvedImagePathToSourceConverter}}"
                                Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Padding="0,6,0,6" Spacing="6">
                            <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="{x:Bind PartNumber}" />
                            <TextBlock Text="{x:Bind Description}" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind WorkCenter}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Style="{StaticResource SetupActionBarStyle}">
            <Button AutomationProperties.AutomationId="SetupPartSelectionPage_BackButton" x:Uid="Setup_Action.Back" Content="Back" Command="{x:Bind ViewModel.BackCommand}" />
            <Button AutomationProperties.AutomationId="SetupPartSelectionPage_ContinueButton" x:Uid="Setup_Action.Continue" Content="Continue" Command="{x:Bind ViewModel.ContinueCommand}" />
        </StackPanel>
    </Grid>
</Page>