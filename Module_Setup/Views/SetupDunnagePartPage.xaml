<Page
    x:Class="MTM_Waitlist.Module_Setup.Views.SetupDunnagePartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Waitlist.Module_Setup.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Setup.Models"
    x:Name="RootPage"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock x:Uid="Setup_DunnagePart.Header.SelectedType" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Selected Type" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.State.SelectedDunnageTypeId, Mode=OneWay}" />
            <TextBlock x:Uid="Setup_Dunnage.SelectionSummaryLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Selected dunnage" />
            <TextBlock Text="{x:Bind ViewModel.CurrentSelectionSummary, Mode=OneWay}" TextWrapping="WrapWholeWords" />
            <TextBlock x:Uid="Setup_DunnagePart.PageLabel" Style="{ThemeResource BodyLargeTextBlockStyle}" Text="Choose a dunnage option" />
            <TextBox x:Uid="Setup_DunnagePart.Filter.PlaceholderText" PlaceholderText="Search by part number, name, or details" Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="WrapWholeWords" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GridView
                Grid.Column="0"
                ItemsSource="{x:Bind ViewModel.FilteredDunnageParts, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedDunnagePart, Mode=TwoWay}"
                SelectionMode="Single">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid MaximumRowsOrColumns="3" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:SetupDunnagePart">
                        <Border
                            MinWidth="200"
                            Margin="8"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel Spacing="8">
                                <Image Height="96" Source="{x:Bind DisplayImagePath}" Stretch="Uniform" />
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{x:Bind PartNumber}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Metadata}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Border
                Grid.Column="1"
                Padding="12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Uid="Setup_DunnagePart.AssignedTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Assigned to This Part/Sequence" />

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.SelectedDunnageParts, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SetupDunnagePart">
                                <Grid Margin="0,0,0,8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind PartNumber}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        x:Uid="Setup_Action.RemoveAssigned"
                                        Command="{Binding ElementName=RootPage, Path=ViewModel.RemoveAssignedPartCommand}"
                                        CommandParameter="{x:Bind}"
                                        Content="Remove" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="2" Spacing="8">
                        <Button x:Uid="Setup_Action.AddSelectedToPair" Command="{x:Bind ViewModel.AddSelectedToPairCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" />
                                <TextBlock x:Uid="Setup_Action.AddSelectedToPair.Label" Text="Add Selected to Pair" />
                            </StackPanel>
                        </Button>
                        <Button x:Uid="Setup_Action.RemoveAllForType" Command="{x:Bind ViewModel.RemoveAllForTypeCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" />
                                <TextBlock x:Uid="Setup_Action.RemoveAllForType.Label" Text="Remove All for Type" />
                            </StackPanel>
                        </Button>
                        <Button x:Uid="Setup_Action.ClearAllForPair" Command="{x:Bind ViewModel.ClearAllForPairCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE894;" />
                                <TextBlock x:Uid="Setup_Action.ClearAllForPair.Label" Text="Clear All for Pair" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="1"
                x:Uid="Setup_Action.QuickAddPart"
                Click="OnQuickAddPartClick"
                Visibility="{x:Bind ViewModel.CanManageDefinitions, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" />
                    <TextBlock x:Uid="Setup_Action.QuickAddPart.Label" Text="Add New Part" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2" x:Uid="Setup_Action.BackToTypes" Content="Back to Types" Command="{x:Bind ViewModel.BackToTypesCommand}" />
            <Button Grid.Column="3" x:Uid="Setup_Action.Review" Content="Review" Command="{x:Bind ViewModel.ReviewCommand}" />
        </Grid>
    </Grid>
</Page>