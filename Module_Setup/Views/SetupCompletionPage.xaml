<Page
    x:Class="MTM_Waitlist.Module_Setup.Views.SetupCompletionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Style="{StaticResource SetupPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MinWidth="520"
            MaxWidth="760"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="14">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="{x:Bind ViewModel.ResultIconGlyph, Mode=OneWay}" FontSize="24" />
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.ResultHeading, Mode=OneWay}" />
                </StackPanel>

                <TextBlock
                    x:Uid="Setup_Completion.ResultMessageLabel"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Result" />

                <TextBlock Text="{x:Bind ViewModel.ResultMessage, Mode=OneWay}" TextWrapping="WrapWholeWords" />

                <TextBlock
                    x:Uid="Setup_Completion.FailureReasonLabel"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Failure reason"
                    Visibility="{x:Bind ViewModel.FailureReasonVisibility, Mode=OneWay}" />

                <TextBlock
                    Text="{x:Bind ViewModel.ResultMessage, Mode=OneWay}"
                    TextWrapping="WrapWholeWords"
                    Visibility="{x:Bind ViewModel.FailureReasonVisibility, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Style="{StaticResource SetupActionBarStyle}">
            <Button x:Uid="Setup_Completion.Action.StartOver" Content="Start Over" Command="{x:Bind ViewModel.StartOverCommand}" />
            <Button x:Uid="Setup_Completion.Action.ReturnToWaitlist" Content="Return to Waitlist" Command="{x:Bind ViewModel.ReturnToWaitlistCommand}" />
        </StackPanel>
    </Grid>
</Page>
