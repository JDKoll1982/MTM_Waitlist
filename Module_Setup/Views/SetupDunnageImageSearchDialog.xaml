<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MTM_Waitlist.Module_Setup.Views.SetupDunnageImageSearchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sharedControls="using:MTM_Waitlist.Module_Shared.Controls"
    HorizontalAlignment="Stretch">
    <!--
        The catalogue itself is the shared control, so this dialog and the generic request's dunnage page draw one
        list from one read (FR-002). The dialog's behaviour, its words, its sort, its one-box filter and the
        accessible names its automation already used are unchanged: they moved into the control with the markup.
    -->
    <sharedControls:DunnageCatalogueView ViewModel="{x:Bind ViewModel.Catalogue}" />
</UserControl>
