<Page
    x:Class="MTM_Waitlist.Module_Setup.Views.SetupSequenceSelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Setup.Models"
    mc:Ignorable="d">

    <Grid Style="{StaticResource SetupPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource SetupPageHeaderStyle}">
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.State.NormalizedWorkOrder, Mode=OneWay}" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.State.SelectedPartNumber, Mode=OneWay}" />
            <TextBlock x:Uid="Setup_Sequence.AvailableLabel" Style="{StaticResource SetupPageTitleStyle}" Text="Available operations" />
            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Sequences, Mode=OneWay}" SelectionMode="Single" SelectedItem="{x:Bind ViewModel.SelectedSequence, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SetupSequenceResult">
                    <StackPanel Padding="14" Spacing="6">
                        <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="{x:Bind SequenceNumber}" />
                        <TextBlock Text="{x:Bind Description}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Style="{StaticResource SetupActionBarStyle}">
            <Button x:Uid="Setup_Action.Back" Content="Back" Command="{x:Bind ViewModel.BackCommand}" />
            <Button x:Uid="Setup_Action.Continue" Content="Continue" Command="{x:Bind ViewModel.ContinueCommand}" />
        </StackPanel>
    </Grid>
</Page>