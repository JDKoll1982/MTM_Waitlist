<Page
    x:Class="MTM_Waitlist.Module_Setup.Views.SetupDunnageTypePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Setup.Models"
    x:Name="RootPage"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock x:Uid="Setup_DunnagePair.PageLabel" Style="{ThemeResource BodyLargeTextBlockStyle}" Text="Dunnage Pair" />
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Setup_DunnagePair.Header.WorkStation" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="WORK STATION" CharacterSpacing="120" />
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.State.SelectedWorkCenter, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Setup_DunnagePair.Header.WorkOrder" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="WORK ORDER" CharacterSpacing="120" />
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.State.NormalizedWorkOrder, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Padding="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Setup_DunnagePair.Header.PartNumber" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="PART NUMBER" CharacterSpacing="120" />
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.State.SelectedPartNumber, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Padding="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Setup_DunnagePair.Header.Sequence" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="SEQUENCE" CharacterSpacing="120" />
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.State.SelectedSequence, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="WrapWholeWords" />
        </StackPanel>

        <Border Grid.Row="1" Padding="12" MaxWidth="560" HorizontalAlignment="Left" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
            <StackPanel Spacing="8">
                <TextBlock Text="SCRAP TYPE" Foreground="{ThemeResource TextFillColorSecondaryBrush}" CharacterSpacing="120" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        Grid.Column="0"
                        PlaceholderText="Select scrap type"
                        ItemsSource="{x:Bind ViewModel.ScrapTypes, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedScrapType, Mode=TwoWay}" />

                    <Button
                        Grid.Column="1"
                        Width="40"
                        Height="40"
                        FontSize="18"
                        Content="+"
                        Click="OnAddScrapTypeClick" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Setup_DunnagePair.CurrentAssignments" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Current Pair Assignments" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.PairAssignments, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SetupDunnagePart">
                                <Grid Margin="0,0,0,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind PartNumber}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Remove" Command="{Binding ElementName=RootPage, Path=ViewModel.RemoveAssignedCommand}" CommandParameter="{x:Bind}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" x:Uid="Setup_Action.AddDunnage" Content="Add Dunnage" Command="{x:Bind ViewModel.AddDunnageCommand}" />
            <Button Grid.Column="2" x:Uid="Setup_Action.ClearAllForPair" Content="Clear All" Click="OnClearAllForPairClick" />
            <Button Grid.Column="3" x:Uid="Setup_Action.Back" Content="Back" Command="{x:Bind ViewModel.BackCommand}" />
            <Button Grid.Column="4" x:Uid="Setup_Action.Continue" Content="Continue" Command="{x:Bind ViewModel.ContinueToReviewCommand}" />
        </Grid>
    </Grid>
</Page>