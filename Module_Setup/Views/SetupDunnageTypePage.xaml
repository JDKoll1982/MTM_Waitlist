<Page
    x:Class="MTM_Waitlist.Module_Setup.Views.SetupDunnageTypePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Waitlist.Module_Setup.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Setup.Models"
    x:Name="RootPage"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock x:Uid="Setup_DunnageType.Header.PairContext" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Part/Sequence" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.State.SelectedPartNumber, Mode=OneWay}" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.State.SelectedSequence, Mode=OneWay}" />
            <TextBlock x:Uid="Setup_Dunnage.SelectionSummaryLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Selected dunnage" />
            <TextBlock Text="{x:Bind ViewModel.CurrentSelectionSummary, Mode=OneWay}" TextWrapping="WrapWholeWords" />
            <TextBlock x:Uid="Setup_DunnageType.PageLabel" Style="{ThemeResource BodyLargeTextBlockStyle}" Text="Choose a dunnage type" />
            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="WrapWholeWords" />
        </StackPanel>

        <GridView
            Grid.Row="1"
            MaxWidth="920"
            HorizontalAlignment="Center"
            ItemContainerStyle="{StaticResource GridViewItemRevealStyle}"
            ItemsSource="{x:Bind ViewModel.DunnageTypes, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedDunnageType, Mode=TwoWay}"
            SelectionMode="Single">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid MaximumRowsOrColumns="3" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:SetupDunnageType">
                    <Border
                        MinWidth="180"
                        Margin="8"
                        Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Spacing="10">
                            <Border
                                Width="72"
                                Height="72"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="30"
                                    Glyph="{x:Bind IconGlyph}" />
                            </Border>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold"
                                MaxLines="2"
                                Text="{x:Bind Name}"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="1"
                x:Uid="Setup_Action.QuickAddType"
                Click="OnQuickAddTypeClick"
                Visibility="{x:Bind ViewModel.CanManageDefinitions, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" />
                    <TextBlock x:Uid="Setup_Action.QuickAddType.Label" Text="Add New Type" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="2"
                x:Uid="Setup_Action.RemoveAllForType"
                Command="{x:Bind ViewModel.RemoveAllForSelectedTypeCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" />
                    <TextBlock x:Uid="Setup_Action.RemoveAllForType.Label" Text="Remove All For Type" />
                </StackPanel>
            </Button>

            <Button Grid.Column="3" x:Uid="Setup_Action.Back" Content="Back" Command="{x:Bind ViewModel.BackCommand}" />
            <Button Grid.Column="4" x:Uid="Setup_Action.Continue" Content="Continue" Command="{x:Bind ViewModel.ContinueCommand}" />
        </Grid>
    </Grid>
</Page>