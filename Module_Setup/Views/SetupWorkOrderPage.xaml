<Page
    x:Class="MTM_Waitlist.Module_Setup.Views.SetupWorkOrderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:MTM_Waitlist.Module_Shared.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Setup.Models"
    xmlns:sharedControls="using:MTM_Waitlist.Module_Shared.Controls"
    x:Name="RootPage"
    mc:Ignorable="d">

    <Grid Style="{StaticResource SetupPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource SetupPageHeaderStyle}">
            <TextBlock x:Uid="Setup_WorkOrder_EnterTitle" Style="{StaticResource SetupPageTitleStyle}" Text="Start Setup" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    AutomationProperties.AutomationId="SetupWorkOrderPage_WorkOrderInput"
                    x:Name="WorkOrderTextBox"
                    x:Uid="Setup_WorkOrder_Input"
                    Header="Work Order"
                    Text="{x:Bind ViewModel.WorkOrderInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    LostFocus="OnWorkOrderTextBoxLostFocus"
                    PlaceholderText="Enter work order (for example 76951, 076951, or WO-076951)" shared:TooltipBehavior.ResourceKey="Setup_WorkOrderTextBox_Tooltip" shared:TooltipBehavior.AssociatedFiles="Module_Setup/Views/SetupWorkOrderPage.xaml|Module_Setup/Views/SetupWorkOrderPage.xaml.cs|Module_Setup/ViewModels/SetupWorkOrderViewModel.cs|Module_Shared/Services/TooltipBehavior.cs|Module_Shared/Services/TooltipService.cs|Module_Shared/Services/ControlInspectorService.cs|Module_Core/Helpers/ResourceExtensions.cs" shared:TooltipBehavior.FallbackText="Enter work order (for example 76951, 076951, or WO-076951). It is formatted as WO-###### before the lookup runs."/>

                <!-- Find an order by number, part or customer. It only fills the box above: the page's own
                     Search is what looks the order up, so the box behaves exactly as it always has. -->
                <Button
                    AutomationProperties.AutomationId="SetupWorkOrderPage_FindWorkOrderButton"
                    AutomationProperties.Name="Find a work order"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.FindWorkOrderCommand}"
                    shared:TooltipBehavior.AssociatedFiles="Module_Setup/Views/SetupWorkOrderPage.xaml|Module_Setup/Views/SetupWorkOrderSearchDialog.xaml|Module_Setup/Views/SetupWorkOrderSearchDialog.xaml.cs|Module_Setup/ViewModels/SetupWorkOrderSearchDialogViewModel.cs|MTM_Waitlist.Setup/ViewModels/SetupWorkOrderViewModel.cs"
                    shared:TooltipBehavior.FallbackText="Find a work order by number, part number or customer.">
                    <FontIcon FontSize="16" Glyph="&#xE721;" />
                </Button>
            </Grid>

            <Border Style="{StaticResource SetupSectionCardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Uid="Setup_Combined_Header_WorkOrder" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="WORK ORDER" CharacterSpacing="120" />
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.State.NormalizedWorkOrder, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Uid="Setup_Combined_Header_SelectedPart" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="SELECTED PART" CharacterSpacing="120" />
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SelectedPartDisplay, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Visibility="{x:Bind ViewModel.PartSectionVisibility, Mode=OneWay}">
                <TextBlock x:Uid="Setup_Part_FoundPartsLabel" Style="{StaticResource SetupPageTitleStyle}" Text="Matching parts" Margin="0,8,0,4" />
                <ItemsControl AutomationProperties.AutomationId="SetupWorkOrderPage_PartTiles" ItemsSource="{x:Bind ViewModel.State.PartResults, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SetupPartResult">
                            <Button AutomationProperties.Name="{x:Bind PartNumber}" Command="{Binding ElementName=RootPage, Path=ViewModel.SelectPartCommand}" CommandParameter="{x:Bind}" Margin="0,0,12,12">
                                <StackPanel Padding="14" MinWidth="180" MaxWidth="260" Spacing="6">
                                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind PartNumber}" />
                                    <!-- The description is drawn by the one-line scrolling control (009 B1/B2): this
                                         tile is capped at 260 px, so a long description scrolls its own line
                                         instead of wrapping and making the tile taller than its neighbours. -->
                                    <dev:AutoScrollView IsPlaying="True">
                                        <TextBlock
                                            Text="{x:Bind Description}"
                                            TextTrimming="CharacterEllipsis" />
                                    </dev:AutoScrollView>
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind WorkCenter}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Visibility="{x:Bind ViewModel.SequenceSectionVisibility, Mode=OneWay}">
                <TextBlock x:Uid="Setup_Sequence_AvailableLabel" Style="{StaticResource SetupPageTitleStyle}" Text="Available operations" Margin="0,8,0,4" />
                <ItemsControl AutomationProperties.AutomationId="SetupWorkOrderPage_OperationTiles" ItemsSource="{x:Bind ViewModel.State.SequenceResults, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SetupSequenceResult">
                            <Button AutomationProperties.Name="{x:Bind SequenceNumber}" Command="{Binding ElementName=RootPage, Path=ViewModel.SelectSequenceCommand}" CommandParameter="{x:Bind}" Margin="0,0,12,12">
                                <StackPanel Padding="14" MinWidth="150" MaxWidth="220" Spacing="6">
                                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind SequenceNumber}" />
                                    <!-- The operation's description is drawn by the one-line scrolling control
                                         (009 B1/B2): this tile is capped at 220 px, so a long description scrolls
                                         instead of wrapping. -->
                                    <dev:AutoScrollView IsPlaying="True">
                                        <TextBlock
                                            Text="{x:Bind Description}"
                                            TextTrimming="CharacterEllipsis" />
                                    </dev:AutoScrollView>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- A live Infor Visual lookup can spend seconds failing over to the mtm_mock mirror. The ring is the
             operator's only signal that the search is running rather than the screen having frozen. -->
        <ProgressRing
            Grid.Row="1"
            AutomationProperties.AutomationId="SetupWorkOrderPage_BusyIndicator"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

        <StackPanel Grid.Row="2" Style="{StaticResource SetupActionBarStyle}">
            <Button AutomationProperties.AutomationId="SetupWorkOrderPage_BackButton" x:Uid="Setup_Action_BackToWorkstations" Content="Back" ContentTemplate="{StaticResource ActionBarBackTemplate}" Command="{x:Bind ViewModel.BackToWorkCentersCommand}" />
            <Button AutomationProperties.AutomationId="SetupWorkOrderPage_CancelButton" x:Uid="Setup_Action_Cancel" Content="Cancel" ContentTemplate="{StaticResource ActionBarCancelTemplate}" Command="{x:Bind ViewModel.CancelCommand}" />
            <Button AutomationProperties.AutomationId="SetupWorkOrderPage_SearchButton" x:Uid="Setup_Action_Search" Content="Search" ContentTemplate="{StaticResource ActionBarSearchTemplate}" Command="{x:Bind ViewModel.SearchCommand}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
