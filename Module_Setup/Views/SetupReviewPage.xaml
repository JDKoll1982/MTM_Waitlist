<Page
    x:Class="MTM_Waitlist.Module_Setup.Views.SetupReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:converters="using:MTM_Waitlist.Module_Setup.Converters"
    xmlns:viewmodels="using:MTM_Waitlist.Module_Setup.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Setup.Models"
    xmlns:sharedControls="using:MTM_Waitlist.Module_Shared.Controls"
    mc:Ignorable="d">

    <!--
        The review is one page, read top to bottom, with no tabs (2026-11-04).

        Windows' own guidance is the reason: tabs are for peer documents, and a set of views that fits comfortably on
        one page should be a single page rather than a tab strip. What this surface holds is one setup seen from three
        angles — the job it is for, the parts the operation consumes, and what it is paired with — so a person
        checking their work needs all of it at once, not three quarters of it hidden behind a header they must click.
        The step's own breadcrumb already says this is a step in a task, so the tabs were carrying no navigation
        meaning either.

        Each section is drawn as a card with a header and a line saying what it holds, which is the shape the rest of
        the flow uses; a section with nothing in it says so instead of drawing an empty box.
    -->
    <Page.Resources>
        <converters:CategoryAccentBrushConverter x:Key="CategoryAccentBrushConverter" />
        <converters:StockStateBrushConverter x:Key="StockStateBrushConverter" />
    </Page.Resources>

    <Grid Style="{StaticResource SetupPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel Padding="0,0,8,0" Spacing="20">

                <!--  The job this setup is for.  -->
                <Border Style="{StaticResource SetupSectionCardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="Setup_Review_Section_JobContext" Style="{ThemeResource BodyLargeTextBlockStyle}" Text="Job context" />
                            <TextBlock x:Uid="Setup_Review_Section_JobContext_Description" Style="{StaticResource SetupPageSubtitleStyle}" Text="The setup is saved against this work order, part and operation." />
                        </StackPanel>
                        <Grid ColumnSpacing="40" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock x:Uid="Setup_Review_Header_WorkOrder" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" Text="Work Order" />
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.State.NormalizedWorkOrder, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="Setup_Review_Header_Part" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" Text="Part" />
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.State.SelectedPartNumber, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock x:Uid="Setup_Review_Header_Sequence" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" Text="Sequence" />
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.State.SelectedSequence, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  What the operation consumes, grouped by family.  -->
                <Border Style="{StaticResource SetupSectionCardStyle}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="Setup_Review_SubordinatePartsTitle" Style="{ThemeResource BodyLargeTextBlockStyle}" Text="Subordinate Parts" />
                                <TextBlock x:Uid="Setup_Review_Section_SubordinateParts_Description" Style="{StaticResource SetupPageSubtitleStyle}" Text="The components, packaging and tooling this operation consumes." />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.SubordinatePartsCountLabel, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasSubordinateParts, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>

                        <TextBlock
                            x:Uid="Setup_Review_Section_SubordinateParts_Empty"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="No subordinate parts are recorded for this operation."
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasNoSubordinateParts, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <ItemsControl AutomationProperties.AutomationId="SetupReviewPage_SubordinatePartsList" ItemsSource="{x:Bind ViewModel.SubordinatePartGroups, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SetupSubordinatePartGroup">
                                    <StackPanel Margin="0,0,0,14" Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock AutomationProperties.Name="{x:Bind CategoryDisplayName}" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind CategoryDisplayName}" />
                                            <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind PartCountLabel}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{x:Bind Parts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:SetupSubordinatePart">
                                                    <!--
                                                        Each row carries the part's own picture beside its number, still grouped
                                                        by the family the group header names. A part that cannot be pictured
                                                        draws the one shared placeholder — never the family's artwork
                                                        (FR-014, FR-015, FR-018).
                                                    -->
                                                    <Grid AutomationProperties.Name="{x:Bind PartNumber}" Margin="0,0,0,8" ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- A fixed-size thumbnail: a frame bounded only by Min*
                                                             measured in an auto-width column sizes itself to the
                                                             picture's own natural size and blew the row up. -->
                                                        <Border
                                                            Width="64"
                                                            Height="64"
                                                            Padding="4"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                            CornerRadius="8">
                                                            <sharedControls:ClickToEnlargeImageView
                                                                AutomationProperties.AutomationId="{x:Bind ImageAutomationId}"
                                                                AutomationProperties.Name="{x:Bind PartNumber}"
                                                                Source="{x:Bind ImagePath, Converter={StaticResource ResolvedImagePathToSourceConverter}}"
                                                                Stretch="Uniform" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind PartNumber}" />
                                                            <!-- The description is drawn by the one-line scrolling control
                                                                 (009 B1/B2): this row has fixed columns, so a long
                                                                 description scrolls its own line instead of wrapping into
                                                                 the rows below it. -->
                                                            <dev:AutoScrollView IsPlaying="True">
                                                                <TextBlock
                                                                    Text="{x:Bind Description}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </dev:AutoScrollView>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Location" />
                                                            <TextBlock Text="{x:Bind LocationDisplay}" />
                                                        </StackPanel>
                                                        <!-- Hidden for dies: they are never inventoried, so a 0 here would read as a stock-out. -->
                                                        <StackPanel Grid.Column="3" HorizontalAlignment="Right" Visibility="{x:Bind ShowsOnHand, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="On Hand" />
                                                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind OnHandDisplay}" HorizontalAlignment="Right" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!--  What the operation is paired with: the dunnage it takes, and the scrap type recorded with it.  -->
                <Border Style="{StaticResource SetupSectionCardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="Setup_Review_Header_Dunnage" Style="{ThemeResource BodyLargeTextBlockStyle}" Text="Dunnage &amp; Scrap" />
                            <TextBlock x:Uid="Setup_Review_Section_Dunnage_Description" Style="{StaticResource SetupPageSubtitleStyle}" Text="What this setup is paired with, and the scrap type saved beside it." />
                        </StackPanel>

                        <TextBlock
                            x:Uid="Setup_Review_Section_Dunnage_Empty"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="No dunnage is assigned to this operation."
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasNoDunnageAssignments, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <ItemsControl AutomationProperties.AutomationId="SetupReviewPage_DunnageAssignmentsList" ItemsSource="{x:Bind ViewModel.DunnageAssignmentDisplays, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:SetupDunnageAssignmentDisplay">
                                    <Grid AutomationProperties.Name="{x:Bind DisplayName}" Margin="0,0,0,10" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="{x:Bind IconGlyph}" VerticalAlignment="Center" />
                                        <!-- The assignment's name is drawn by the one-line scrolling control (009
                                             B1/B2); its strong-body size is set here because the control draws its
                                             own text and cannot inherit a TextBlock style. -->
                                        <dev:AutoScrollView IsPlaying="True"
                                            Grid.Column="1">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                Text="{x:Bind DisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                        </dev:AutoScrollView>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="Setup_Review_Scrap_Label"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="Scrap type" />
                            <TextBlock Grid.Column="1" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.ScrapTypeDisplay, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Style="{StaticResource SetupActionBarStyle}">
            <Button AutomationProperties.AutomationId="SetupReviewPage_EditButton" x:Uid="Setup_Action_Edit" Content="Edit" ContentTemplate="{StaticResource ActionBarEditTemplate}" Command="{x:Bind ViewModel.EditCommand}" />
            <Button AutomationProperties.AutomationId="SetupReviewPage_ConfirmButton" x:Uid="Setup_Action_Confirm" Content="Confirm" ContentTemplate="{StaticResource ActionBarConfirmTemplate}" Command="{x:Bind ViewModel.ConfirmCommand}" Visibility="{x:Bind ViewModel.ConfirmButtonVisibility, Mode=OneWay}" />
            <Button AutomationProperties.AutomationId="SetupReviewPage_CancelButton" x:Uid="Setup_Action_Cancel" Content="Cancel" ContentTemplate="{StaticResource ActionBarCancelTemplate}" Command="{x:Bind ViewModel.CancelReplacementCommand}" Visibility="{x:Bind ViewModel.ReplacementConfirmationVisibility, Mode=OneWay}" />
            <Button AutomationProperties.AutomationId="SetupReviewPage_ReplaceButton" x:Uid="Setup_Action_Replace" Content="Replace" ContentTemplate="{StaticResource ActionBarSubstituteTemplate}" Command="{x:Bind ViewModel.ReplaceCommand}" Visibility="{x:Bind ViewModel.ReplacementConfirmationVisibility, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
