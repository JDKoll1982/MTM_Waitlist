<Page
    x:Class="MTM_Waitlist.Module_Setup.Views.SetupReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:converters="using:MTM_Waitlist.Module_Setup.Converters"
    xmlns:viewmodels="using:MTM_Waitlist.Module_Setup.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Setup.Models"
    xmlns:sharedControls="using:MTM_Waitlist.Module_Shared.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:CategoryAccentBrushConverter x:Key="CategoryAccentBrushConverter" />
        <converters:StockStateBrushConverter x:Key="StockStateBrushConverter" />
    </Page.Resources>

    <Grid Style="{StaticResource SetupPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabView AutomationProperties.AutomationId="SetupReviewPage_Tabs" Grid.Row="0" IsAddTabButtonVisible="False">
            <TabViewItem AutomationProperties.AutomationId="SetupReviewPage_JobContextTab" x:Uid="Setup_Review.Tab.JobContext" Header="Job Context">
                <Border Margin="0,8,0,0" Style="{StaticResource SetupSectionCardStyle}">
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" x:Uid="Setup_Review.Header.WorkOrder" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Work Order" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.State.NormalizedWorkOrder, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" x:Uid="Setup_Review.Header.Part" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Part" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.State.SelectedPartNumber, Mode=OneWay}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" x:Uid="Setup_Review.Header.Sequence" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Sequence" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.State.SelectedSequence, Mode=OneWay}" />
                    </Grid>
                </Border>
            </TabViewItem>

            <TabViewItem AutomationProperties.AutomationId="SetupReviewPage_SubordinatePartsTab" x:Uid="Setup_Review.Tab.SubordinateParts" Header="Subordinate Parts">
                <ScrollViewer Margin="0,8,0,0">
                    <ItemsControl AutomationProperties.AutomationId="SetupReviewPage_SubordinatePartsList" ItemsSource="{x:Bind ViewModel.SubordinatePartGroups, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SetupSubordinatePartGroup">
                                <Border AutomationProperties.Name="{x:Bind CategoryDisplayName}" Margin="0,0,0,12" Style="{StaticResource SetupSectionCardStyle}">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{x:Bind CategoryDisplayName}" />
                                            <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind PartCountLabel}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{x:Bind Parts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:SetupSubordinatePart">
                                                    <!--
                                                        Each row carries the part's own picture beside its number,
                                                        still grouped by the family the group header names. A part
                                                        that cannot be pictured draws the one shared placeholder — never
                                                        the family's artwork (FR-014, FR-015, FR-018).
                                                    -->
                                                    <Grid AutomationProperties.Name="{x:Bind PartNumber}" Margin="0,0,0,8" ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- A fixed-size thumbnail: a frame bounded only by Min*
                                                             measured in an auto-width column sizes itself to the
                                                             picture's own natural size and blew the row up. -->
                                                        <Border
                                                            Width="64"
                                                            Height="64"
                                                            Padding="4"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                            CornerRadius="8">
                                                            <sharedControls:ClickToEnlargeImageView
                                                                AutomationProperties.AutomationId="{x:Bind ImageAutomationId}"
                                                                AutomationProperties.Name="{x:Bind PartNumber}"
                                                                Source="{x:Bind ImagePath, Converter={StaticResource ResolvedImagePathToSourceConverter}}"
                                                                Stretch="Uniform" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind PartNumber}" />
                                                            <TextBlock Text="{x:Bind Description}" TextWrapping="WrapWholeWords" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Location" />
                                                            <TextBlock Text="{x:Bind LocationDisplay}" />
                                                        </StackPanel>
                                                        <!-- Hidden for dies: they are never inventoried, so a 0 here would read as a stock-out. -->
                                                        <StackPanel Grid.Column="3" HorizontalAlignment="Right" Visibility="{x:Bind ShowsOnHand, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="On Hand" />
                                                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind OnHandDisplay}" HorizontalAlignment="Right" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem AutomationProperties.AutomationId="SetupReviewPage_DunnageAssignmentsTab" x:Uid="Setup_Review.Tab.DunnageAssignments" Header="Dunnage &amp; Scrap Assignments">
                <Border Margin="0,8,0,0" Style="{StaticResource SetupSectionCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="Setup_Review.SelectedDunnageTitle" Style="{ThemeResource BodyLargeTextBlockStyle}" Text="Selected Dunnage Summary" />
                        <ItemsControl AutomationProperties.AutomationId="SetupReviewPage_DunnageAssignmentsList" ItemsSource="{x:Bind ViewModel.DunnageAssignmentDisplays, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:SetupDunnageAssignmentDisplay">
                                    <Grid AutomationProperties.Name="{x:Bind DisplayName}" Margin="0,0,0,10" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="{x:Bind IconGlyph}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" TextWrapping="WrapWholeWords" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </TabViewItem>
        </TabView>

        <StackPanel Grid.Row="1" Style="{StaticResource SetupActionBarStyle}">
            <Button AutomationProperties.AutomationId="SetupReviewPage_EditButton" x:Uid="Setup_Action.Edit" Content="Edit" Command="{x:Bind ViewModel.EditCommand}" />
            <Button AutomationProperties.AutomationId="SetupReviewPage_ConfirmButton" x:Uid="Setup_Action.Confirm" Content="Confirm" Command="{x:Bind ViewModel.ConfirmCommand}" Visibility="{x:Bind ViewModel.ConfirmButtonVisibility, Mode=OneWay}" />
            <Button AutomationProperties.AutomationId="SetupReviewPage_CancelButton" x:Uid="Setup_Action.Cancel" Content="Cancel" Command="{x:Bind ViewModel.CancelReplacementCommand}" Visibility="{x:Bind ViewModel.ReplacementConfirmationVisibility, Mode=OneWay}" />
            <Button AutomationProperties.AutomationId="SetupReviewPage_ReplaceButton" x:Uid="Setup_Action.Replace" Content="Replace" Command="{x:Bind ViewModel.ReplaceCommand}" Visibility="{x:Bind ViewModel.ReplacementConfirmationVisibility, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>