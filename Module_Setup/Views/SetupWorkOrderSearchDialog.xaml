<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MTM_Waitlist.Module_Setup.Views.SetupWorkOrderSearchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Waitlist.Module_Setup.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Setup.Models"
    xmlns:shared="using:MTM_Waitlist.Module_Shared.Services"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The three things an operator knows before they know the number. Enter in any of them searches. -->
        <Border
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    AutomationProperties.AutomationId="SetupWorkOrderSearchDialog_WorkOrderInput"
                    x:Name="WorkOrderFilterBox"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Header="Work order"
                    KeyDown="OnFilterKeyDown"
                    PlaceholderText="0752, WO-0752 or 752"
                    Text="{x:Bind ViewModel.WorkOrderText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    shared:TooltipBehavior.FallbackText="Any part of the work order number. WO- and dashes are ignored, so 0752 finds WO-0752xx." />

                <TextBox
                    AutomationProperties.AutomationId="SetupWorkOrderSearchDialog_PartInput"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Header="Part number"
                    KeyDown="OnFilterKeyDown"
                    PlaceholderText="Any part of the part number"
                    Text="{x:Bind ViewModel.PartFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    shared:TooltipBehavior.FallbackText="Any part of the part number." />

                <TextBox
                    AutomationProperties.AutomationId="SetupWorkOrderSearchDialog_CustomerInput"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    Header="Customer"
                    KeyDown="OnFilterKeyDown"
                    PlaceholderText="Customer name, for example Volvo"
                    Text="{x:Bind ViewModel.CustomerFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    shared:TooltipBehavior.FallbackText="Any part of the customer's name. A stock order has no customer, so a customer filter leaves it out." />

                <Button
                    AutomationProperties.AutomationId="SetupWorkOrderSearchDialog_SearchButton"
                    Grid.Column="3"
                    MinWidth="96"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.SearchCommand}"
                    Content="Search"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}"
                    shared:TooltipBehavior.FallbackText="Search the open work orders with these filters." />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Spacing="2">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="Double-click a line, or select one and choose Use Work Order."
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="ErrorText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="2" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The column captions sit outside the list so they do not scroll away with the rows. -->
            <Grid Grid.Row="0" Padding="16,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="2.4*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{ThemeResource CaptionTextBlockStyle}" Text="Work order" />
                <TextBlock Grid.Column="1" Style="{ThemeResource CaptionTextBlockStyle}" Text="Part" />
                <TextBlock Grid.Column="2" Style="{ThemeResource CaptionTextBlockStyle}" Text="Customer" />
                <TextBlock Grid.Column="3" Style="{ThemeResource CaptionTextBlockStyle}" Text="Work center" />
                <TextBlock Grid.Column="4" Style="{ThemeResource CaptionTextBlockStyle}" Text="Status" />
                <TextBlock Grid.Column="5" Style="{ThemeResource CaptionTextBlockStyle}" Text="Want date" />
            </Grid>

            <ListView
                AutomationProperties.AutomationId="SetupWorkOrderSearchDialog_Results"
                x:Name="ResultsList"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                DoubleTapped="OnResultDoubleTapped"
                ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedResult, Mode=TwoWay}"
                SelectionMode="Single"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="8,6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SetupWorkOrderSearchResult">
                        <Grid
                            AutomationProperties.Name="{x:Bind WorkOrder}"
                            ColumnSpacing="12"
                            shared:TooltipBehavior.FallbackText="{x:Bind WorkOrder}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind WorkOrder}"
                                TextTrimming="CharacterEllipsis" />

                            <!-- The number is what a person matches on and the description is what tells two
                                 similar numbers apart, so the hover tooltip carries the description. -->
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind PartNumber}"
                                TextTrimming="CharacterEllipsis"
                                shared:TooltipBehavior.FallbackText="{x:Bind PartDescription}" />

                            <TextBlock
                                Grid.Column="2"
                                Text="{x:Bind CustomerName}"
                                TextTrimming="CharacterEllipsis"
                                shared:TooltipBehavior.FallbackText="{x:Bind CustomerName}" />
                            <TextBlock
                                Grid.Column="3"
                                Text="{x:Bind WorkCenter}"
                                TextTrimming="CharacterEllipsis"
                                shared:TooltipBehavior.FallbackText="{x:Bind WorkCenter}" />
                            <TextBlock
                                Grid.Column="4"
                                Text="{x:Bind StatusText}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="5"
                                Text="{x:Bind WantDateText}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ProgressRing
                Grid.Row="1"
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <Border
                Grid.Row="1"
                MaxWidth="460"
                Padding="16,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.HasNoResults, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.EmptyStateMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
