<Page
    x:Class="MTM_Waitlist.Module_Setup.Views.SetupWorkCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Setup.Models"
    xmlns:shared="using:MTM_Waitlist.Module_Shared.Services"
    xmlns:sharedControls="using:MTM_Waitlist.Module_Shared.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="WorkCenterCardItemContainerStyle" TargetType="GridViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <ListViewItemPresenter
                            ContentMargin="0"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            PointerOverBackground="Transparent"
                            PressedBackground="Transparent"
                            SelectedBackground="Transparent"
                            SelectedPointerOverBackground="Transparent"
                            SelectedPressedBackground="Transparent"
                            SelectedBorderThickness="0"
                            RevealBorderThickness="0"
                            SelectionCheckMarkVisualEnabled="False" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="WorkCenterCardTemplate" x:DataType="models:SetupWorkCenter">
            <Grid
                Margin="8"
                AutomationProperties.Name="{x:Bind Name}">
                <!-- Card body: image + details with a neutral border. -->
                <Border
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Border.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Edit" Tag="{x:Bind}" Click="OnEditWorkCenterClick" />
                            <MenuFlyoutItem Text="Remove" Tag="{x:Bind}" Click="OnRemoveWorkCenterClick" />
                        </MenuFlyout>
                    </Border.ContextFlyout>
                    <Grid>
                        <!--
                        The photo pane takes a share of the card rather than a fixed width, so a wider card gives the
                        picture and the details beside it more room instead of leaving one of them clipped. The floor
                        keeps the picture readable when the card is at its narrowest.
                        -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left pane: compact rectangular work center photo (Shift+click shows it in full). -->
                        <Border
                            Grid.Column="0"
                            Padding="8"
                            CornerRadius="12,0,0,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid VerticalAlignment="Center" Height="90">
                                <Border
                                    CornerRadius="10"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="2">
                                    <!-- The photo is drawn by the shared picture control like every other content
                                         picture (009 A3). This card is clickable, so the control asks for
                                         Shift+click here and leaves an ordinary click to the card. -->
                                    <sharedControls:ClickToEnlargeImageView
                                        AutomationProperties.Name="{x:Bind Name}"
                                        Source="{x:Bind ImagePath, Converter={StaticResource ResolvedImagePathToSourceConverter}}"
                                        Stretch="Uniform" />
                                </Border>
                                <!-- Blue photo frame, only on the selected card. -->
                                <Border
                                    CornerRadius="10"
                                    BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                                    BorderThickness="2"
                                    IsHitTestVisible="False"
                                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <!-- Divider between the image and the text panel. -->
                        <Border Grid.Column="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <!-- Right pane: stacked workstation details with section dividers. -->
                        <Border
                            Grid.Column="2"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="0,12,12,0">
                            <StackPanel Padding="12,8" VerticalAlignment="Center">
                                <!-- The card's five values are drawn by the one-line scrolling control (009 B1/B2): a
                                     work-centre name or a job summary that runs long scrolls across its own line
                                     instead of wrapping and pushing the card taller. -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <sharedControls:AutoScrollTextView
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,0,8"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind TitleDisplay}" />
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="36"
                                        Height="36"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="SetupWorkCenterPage_ViewHistoryButton"
                                        AutomationProperties.Name="View History"
                                        Click="OnViewHistoryClick"
                                        Tag="{x:Bind}"
                                        shared:TooltipBehavior.FallbackText="View this work center's setup history."
                                        shared:TooltipBehavior.ResourceKey="Setup_WorkCenterViewHistory.Tooltip">
                                        <FontIcon FontSize="16" Glyph="&#xE81C;" />
                                    </Button>
                                </Grid>
                                <Border Height="1" Margin="0,0,0,8" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                                <Grid ColumnSpacing="8" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Current Job:" Style="{StaticResource SetupFieldLabelStyle}" />
                                    <sharedControls:AutoScrollTextView Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind CurrentJobSummary}" />
                                    <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Part Number:" Style="{StaticResource SetupFieldLabelStyle}" />
                                    <sharedControls:AutoScrollTextView Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind CurrentPartSummary}" />
                                    <Border Grid.Row="3" Grid.ColumnSpan="2" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Last Updated:" Style="{StaticResource SetupFieldLabelStyle}" />
                                    <sharedControls:AutoScrollTextView Grid.Row="4" Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind LastUpdatedDisplay}" />
                                </Grid>                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Selection outline drawn on the card border (only when selected). -->
                <Border
                    BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                    BorderThickness="2"
                    CornerRadius="12"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource SetupPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource SetupPageHeaderStyle}">
            <TextBlock x:Uid="Setup_Workstation_Title" Style="{StaticResource SetupPageTitleStyle}" Text="Select Work Center" />
            <TextBlock x:Uid="Setup_Workstation_Subtitle" Style="{StaticResource SetupPageSubtitleStyle}" Text="Choose where this setup is being performed." />
            <TextBox AutomationProperties.AutomationId="SetupWorkCenterPage_SearchInput" x:Uid="Setup_Workstation_SearchInput" Header="Search" PlaceholderText="Search by work center, work order, sequence, or part number" Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="WrapWholeWords" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <Border
                    Style="{StaticResource SetupSectionCardStyle}"
                    Visibility="{x:Bind ViewModel.IsLocalWorkCentersVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Local Work Centers" />
                        <GridView
                            AutomationProperties.AutomationId="SetupWorkCenterPage_WorkCenterTiles"
                            x:Name="HotWorkCentersGridView"
                            HorizontalContentAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.DisplayedHotWorkCenters, Mode=OneWay}"
                            IsItemClickEnabled="True"
                            ItemClick="WorkCenterCard_ItemClick"
                            DoubleTapped="WorkCenterCard_DoubleTapped"
                            ItemContainerStyle="{StaticResource WorkCenterCardItemContainerStyle}"
                            ItemTemplate="{StaticResource WorkCenterCardTemplate}"
                            SelectionMode="None"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            shared:CardGridSizing.MinimumCardWidth="300">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid HorizontalAlignment="Stretch" ItemHeight="190" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                    </StackPanel>
                </Border>

                <Expander
                    AutomationProperties.AutomationId="SetupWorkCenterPage_OtherWorkCentersExpander"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="{x:Bind ViewModel.IsOtherWorkCentersExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <TextBlock
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.OtherWorkCentersHeader, Mode=OneWay}" />
                    </Expander.Header>
                    <StackPanel Spacing="12" Margin="0,12,0,0">
                        <GridView
                            AutomationProperties.AutomationId="SetupWorkCenterPage_OtherWorkCenterTiles"
                            x:Name="OtherWorkCentersGridView"
                            HorizontalContentAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.DisplayedOtherWorkCenters, Mode=OneWay}"
                            IsItemClickEnabled="True"
                            ItemClick="WorkCenterCard_ItemClick"
                            DoubleTapped="WorkCenterCard_DoubleTapped"
                            ItemContainerStyle="{StaticResource WorkCenterCardItemContainerStyle}"
                            ItemTemplate="{StaticResource WorkCenterCardTemplate}"
                            SelectionMode="None"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            shared:CardGridSizing.MinimumCardWidth="300">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid HorizontalAlignment="Stretch" ItemHeight="190" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button AutomationProperties.AutomationId="SetupWorkCenterPage_NewWorkCenterButton" Grid.Column="0" Content="New Work Center" MinWidth="150" Click="OnNewWorkCenterClick" IsEnabled="{x:Bind ViewModel.CanManageWorkCenters, Mode=OneWay}" />
            <Button AutomationProperties.AutomationId="SetupWorkCenterPage_RefreshButton" Grid.Column="2" x:Uid="Setup_Action_Refresh" Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
            <Button AutomationProperties.AutomationId="SetupWorkCenterPage_ContinueButton" Grid.Column="3" x:Uid="Setup_Action_Continue" Content="Continue" Command="{x:Bind ViewModel.ContinueCommand}" />
        </Grid>
    </Grid>
</Page>
