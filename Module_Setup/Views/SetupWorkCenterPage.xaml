<Page
    x:Class="MTM_Waitlist.Module_Setup.Views.SetupWorkCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Setup.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="WorkCenterCardItemContainerStyle" TargetType="GridViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <ListViewItemPresenter
                            ContentMargin="0"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            PointerOverBackground="Transparent"
                            PressedBackground="Transparent"
                            SelectedBackground="Transparent"
                            SelectedPointerOverBackground="Transparent"
                            SelectedPressedBackground="Transparent"
                            SelectedBorderThickness="0"
                            RevealBorderThickness="0"
                            SelectionCheckMarkVisualEnabled="False" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="WorkCenterCardTemplate" x:DataType="models:SetupWorkCenter">
            <Grid
                Margin="8"
                AutomationProperties.Name="{x:Bind Name}">
                <!-- Card body: image + details with a neutral border. -->
                <Border
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Border.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Edit" Tag="{x:Bind}" Click="OnEditWorkCenterClick" />
                            <MenuFlyoutItem Text="Remove" Tag="{x:Bind}" Click="OnRemoveWorkCenterClick" />
                        </MenuFlyout>
                    </Border.ContextFlyout>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left pane: square work center photo with a neutral frame. -->
                        <Border
                            Grid.Column="0"
                            Padding="8"
                            CornerRadius="12,0,0,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid>
                                <Border
                                    CornerRadius="10"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="2">
                                    <Border.Background>
                                        <ImageBrush
                                            ImageSource="{x:Bind ImagePath, Converter={StaticResource ResolvedImagePathToSourceConverter}}"
                                            Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <!-- Blue photo frame, only on the selected card. -->
                                <Border
                                    CornerRadius="10"
                                    BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                                    BorderThickness="2"
                                    IsHitTestVisible="False"
                                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <!-- Divider between the image and the text panel. -->
                        <Border Grid.Column="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <!-- Right pane: stacked workstation details with section dividers. -->
                        <Border
                            Grid.Column="2"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="0,12,12,0">
                            <StackPanel Padding="12" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Name}"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    Margin="0,2,0,8"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Building}"
                                    TextWrapping="WrapWholeWords" />
                                <Border Height="1" Margin="0,0,0,8" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                                <TextBlock Text="Current Job" Style="{StaticResource SetupFieldLabelStyle}" />
                                <TextBlock Margin="0,2,0,6" FontWeight="SemiBold" Text="{x:Bind CurrentJobSummary}" TextWrapping="WrapWholeWords" />
                                <Border Height="1" Margin="0,0,0,6" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                                <TextBlock Text="Part Number" Style="{StaticResource SetupFieldLabelStyle}" />
                                <TextBlock Margin="0,2,0,6" FontWeight="SemiBold" Text="{x:Bind CurrentPartSummary}" TextWrapping="WrapWholeWords" />
                                <Border Height="1" Margin="0,0,0,6" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                                <TextBlock Text="Last Updated" Style="{StaticResource SetupFieldLabelStyle}" />
                                <TextBlock Margin="0,2,0,6" FontWeight="SemiBold" Text="{x:Bind LastUpdatedDisplay}" TextWrapping="WrapWholeWords" />
                                <Border Height="1" Margin="0,0,0,8" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                                <Button Margin="0,4,0,0" Content="View History" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Selection outline drawn on the card border (only when selected). -->
                <Border
                    BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                    BorderThickness="2"
                    CornerRadius="12"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource SetupPageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource SetupPageHeaderStyle}">
            <TextBlock x:Uid="Setup_Workstation.Title" Style="{StaticResource SetupPageTitleStyle}" Text="Select Work Center" />
            <TextBlock x:Uid="Setup_Workstation.Subtitle" Style="{StaticResource SetupPageSubtitleStyle}" Text="Choose where this setup is being performed." />
            <TextBox x:Uid="Setup_Workstation.SearchInput" Header="Search" PlaceholderText="Search by work center, work order, sequence, or part number" Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="WrapWholeWords" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <Border
                    Style="{StaticResource SetupSectionCardStyle}"
                    Visibility="{x:Bind ViewModel.IsLocalWorkCentersVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Local Work Centers" />
                        <GridView
                            x:Name="HotWorkCentersGridView"
                            HorizontalContentAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.DisplayedHotWorkCenters, Mode=OneWay}"
                            IsItemClickEnabled="True"
                            ItemClick="WorkCenterCard_ItemClick"
                            ItemContainerStyle="{StaticResource WorkCenterCardItemContainerStyle}"
                            ItemTemplate="{StaticResource WorkCenterCardTemplate}"
                            SelectionMode="None"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SizeChanged="WorkCenterGridView_SizeChanged">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                    </StackPanel>
                </Border>

                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="{x:Bind ViewModel.IsOtherWorkCentersExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <TextBlock
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.OtherWorkCentersHeader, Mode=OneWay}" />
                    </Expander.Header>
                    <StackPanel Spacing="12" Margin="0,12,0,0">
                        <GridView
                            x:Name="OtherWorkCentersGridView"
                            HorizontalContentAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.DisplayedOtherWorkCenters, Mode=OneWay}"
                            IsItemClickEnabled="True"
                            ItemClick="WorkCenterCard_ItemClick"
                            ItemContainerStyle="{StaticResource WorkCenterCardItemContainerStyle}"
                            ItemTemplate="{StaticResource WorkCenterCardTemplate}"
                            SelectionMode="None"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SizeChanged="WorkCenterGridView_SizeChanged">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="New Work Center" MinWidth="150" Click="OnNewWorkCenterClick" IsEnabled="{x:Bind ViewModel.CanManageWorkCenters, Mode=OneWay}" />
            <Button Grid.Column="2" x:Uid="Setup_Action.Refresh" Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
            <Button Grid.Column="3" x:Uid="Setup_Action.Continue" Content="Continue" Command="{x:Bind ViewModel.ContinueCommand}" />
        </Grid>
    </Grid>
</Page>
