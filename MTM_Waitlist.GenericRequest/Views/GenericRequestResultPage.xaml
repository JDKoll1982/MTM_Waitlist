<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MTM_Waitlist.GenericRequest.Views.GenericRequestResultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MTM_Waitlist.Module_Settings.Converters"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Style="{StaticResource SetupPageGridStyle}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <FontIcon
                    Width="64"
                    Height="64"
                    HorizontalAlignment="Center"
                    FontSize="64"
                    Glyph="{x:Bind ViewModel.IconGlyph, Mode=OneWay}"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SetupPageTitleStyle}"
                    Text="{x:Bind ViewModel.Heading, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="WrapWholeWords" />

                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SetupPageSubtitleStyle}"
                    Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="WrapWholeWords" />

                <ProgressRing
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.IsSuccess, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button
                        x:Uid="GenericRequest_Result_AddAnother"
                        AutomationProperties.AutomationId="GenericRequestResultPage_AddAnotherRequestButton"
                        ContentTemplate="{StaticResource ActionBarSubmitTemplate}"
                        Command="{x:Bind ViewModel.AddAnotherRequestCommand}" />
                    <Button
                        x:Uid="GenericRequest_Result_ReturnToWaitlist"
                        AutomationProperties.AutomationId="GenericRequestResultPage_ReturnToWaitlistButton"
                        ContentTemplate="{StaticResource ActionBarReturnTemplate}"
                        Command="{x:Bind ViewModel.ReturnToWaitlistCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.IsDuplicate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button
                        x:Uid="GenericRequest_Result_DuplicateReturnToWaitlist"
                        AutomationProperties.AutomationId="GenericRequestResultPage_DuplicateReturnToWaitlistButton"
                        ContentTemplate="{StaticResource ActionBarReturnTemplate}"
                        Command="{x:Bind ViewModel.ReturnToWaitlistCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.IsFailure, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button
                        x:Uid="GenericRequest_Result_Close"
                        AutomationProperties.AutomationId="GenericRequestResultPage_CloseButton"
                        ContentTemplate="{StaticResource ActionBarCancelTemplate}"
                        Command="{x:Bind ViewModel.CancelToWaitlistCommand}" />
                    <Button
                        x:Uid="GenericRequest_Result_Retry"
                        AutomationProperties.AutomationId="GenericRequestResultPage_RetryButton"
                        ContentTemplate="{StaticResource ActionBarStartOverTemplate}"
                        Command="{x:Bind ViewModel.ResubmitCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" />
    </Grid>
</Page>
