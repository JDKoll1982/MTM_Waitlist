<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MTM_Waitlist.GenericRequest.Views.GenericRequestScrapTypePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MTM_Waitlist.GenericRequest.Controls"
    xmlns:models="using:MTM_Waitlist.GenericRequest.Models"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <controls:GenericRequestStepFrame
        AttemptedAtDisplay="{x:Bind ViewModel.AttemptedAtDisplay, Mode=OneWay}"
        BackCommand="{x:Bind ViewModel.BackCommand}"
        ContinueCommand="{x:Bind ViewModel.ContinueCommand}"
        EmptyKey="{x:Bind ViewModel.EmptyKey}"
        IntroKey="{x:Bind ViewModel.IntroKey}"
        Presentation="{x:Bind ViewModel.Presentation, Mode=OneWay}"
        RetryCommand="{x:Bind ViewModel.RetryCommand}"
        TitleKey="{x:Bind ViewModel.TitleKey}">
        <controls:GenericRequestStepFrame.Body>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListView
                    Grid.Row="0"
                    AutomationProperties.Name="{x:Bind ViewModel.Title}"
                    ItemsSource="{x:Bind ViewModel.Options}"
                    SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:GenericRequestScrapOption">
                            <Grid Padding="0,8">
                                <TextBlock
                                    Text="{x:Bind ScrapType}"
                                    TextTrimming="CharacterEllipsis"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="1" Spacing="12">
                    <Button
                        x:Uid="GenericRequest_Scrap_AddButton"
                        AutomationProperties.AutomationId="GenericRequestScrapTypePage_AddScrapTypeButton"
                        Command="{x:Bind ViewModel.ShowAddCommand}"
                        Content="Add scrap type…"
                        Visibility="{x:Bind ViewModel.AddVisibility, Mode=OneWay}" />

                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{x:Bind ViewModel.AddPanelVisibility, Mode=OneWay}">
                        <StackPanel Spacing="12">
                            <TextBlock
                                x:Uid="GenericRequest_Scrap_AddTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Add a scrap type the list does not carry" />

                            <TextBox
                                x:Uid="GenericRequest_Scrap_AddTypeBox"
                                AutomationProperties.AutomationId="GenericRequestScrapTypePage_AddScrapTypeInput"
                                Header="Scrap type"
                                PlaceholderText="Enter scrap type"
                                Text="{x:Bind ViewModel.NewScrapType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <ComboBox
                                x:Uid="GenericRequest_Scrap_AddLuggerBox"
                                AutomationProperties.AutomationId="GenericRequestScrapTypePage_AddScrapTypeLugger"
                                DisplayMemberPath="Name"
                                Header="Lugger it dumps into"
                                ItemsSource="{x:Bind ViewModel.Luggers, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedLugger, Mode=TwoWay}" />

                            <TextBlock
                                AutomationProperties.AutomationId="GenericRequestScrapTypePage_AddScrapTypeMessage"
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind ViewModel.AddMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.AddMessageVisibility, Mode=OneWay}" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Uid="GenericRequest_Scrap_AddSaveButton"
                                    AutomationProperties.AutomationId="GenericRequestScrapTypePage_AddScrapTypeSave"
                                    Command="{x:Bind ViewModel.AddScrapTypeCommand}"
                                    Content="Add"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    x:Uid="GenericRequest_Scrap_AddCancelButton"
                                    AutomationProperties.AutomationId="GenericRequestScrapTypePage_AddScrapTypeCancel"
                                    Command="{x:Bind ViewModel.CancelAddCommand}"
                                    Content="Cancel" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </controls:GenericRequestStepFrame.Body>
    </controls:GenericRequestStepFrame>
</Page>
