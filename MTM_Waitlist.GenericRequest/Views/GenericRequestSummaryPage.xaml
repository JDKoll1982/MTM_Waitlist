<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MTM_Waitlist.GenericRequest.Views.GenericRequestSummaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MTM_Waitlist.GenericRequest.Controls"
    xmlns:vm="using:MTM_Waitlist.GenericRequest.ViewModels"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <controls:GenericRequestStepFrame
        AttemptedAtDisplay="{x:Bind ViewModel.AttemptedAtDisplay, Mode=OneWay}"
        BackCommand="{x:Bind ViewModel.BackCommand}"
        ContinueCommand="{x:Bind ViewModel.ContinueCommand}"
        ContinueKey="GenericRequest_Summary_Submit.Content"
        EmptyKey="{x:Bind ViewModel.EmptyKey}"
        IntroKey="{x:Bind ViewModel.IntroKey}"
        Presentation="{x:Bind ViewModel.Presentation, Mode=OneWay}"
        RetryCommand="{x:Bind ViewModel.RetryCommand}"
        TitleKey="{x:Bind ViewModel.TitleKey}">
        <controls:GenericRequestStepFrame.Body>
            <ListView
                AutomationProperties.Name="{x:Bind ViewModel.Title}"
                ItemsSource="{x:Bind ViewModel.Rows}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GenericRequestSummaryRow">
                        <Grid Padding="0,6" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{x:Bind Label}"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind Value}"
                                TextWrapping="Wrap"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </controls:GenericRequestStepFrame.Body>
    </controls:GenericRequestStepFrame>
</Page>
