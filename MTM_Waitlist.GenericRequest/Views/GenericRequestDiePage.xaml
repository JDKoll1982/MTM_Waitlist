<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MTM_Waitlist.GenericRequest.Views.GenericRequestDiePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MTM_Waitlist.GenericRequest.Controls"
    xmlns:models="using:MTM_Waitlist.GenericRequest.Models"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <controls:GenericRequestStepFrame
        AttemptedAtDisplay="{x:Bind ViewModel.AttemptedAtDisplay, Mode=OneWay}"
        BackCommand="{x:Bind ViewModel.BackCommand}"
        ContinueCommand="{x:Bind ViewModel.ContinueCommand}"
        EmptyKey="{x:Bind ViewModel.EmptyKey}"
        IntroKey="{x:Bind ViewModel.IntroKey}"
        Presentation="{x:Bind ViewModel.Presentation, Mode=OneWay}"
        RetryCommand="{x:Bind ViewModel.RetryCommand}"
        TitleKey="{x:Bind ViewModel.TitleKey}">
        <controls:GenericRequestStepFrame.Body>
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Uid="GenericRequest_Die_Search"
                        AutomationProperties.Name="{x:Bind ViewModel.Title}"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
                    <Button
                        Grid.Column="1"
                        x:Uid="GenericRequest_Die_SearchButton"
                        AutomationProperties.Name="{x:Bind ViewModel.Title}"
                        Command="{x:Bind ViewModel.SearchCommand}" />
                </Grid>
                <ListView
                    Grid.Row="1"
                    AutomationProperties.Name="{x:Bind ViewModel.Title}"
                    ItemsSource="{x:Bind ViewModel.Options}"
                    SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:GenericRequestDieOption">
                            <StackPanel Padding="0,6" Spacing="2">
                                <TextBlock
                                    Text="{x:Bind DieNumber}"
                                    TextTrimming="CharacterEllipsis"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Description}"
                                    TextTrimming="CharacterEllipsis"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Location}"
                                    TextTrimming="CharacterEllipsis"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </controls:GenericRequestStepFrame.Body>
    </controls:GenericRequestStepFrame>
</Page>
