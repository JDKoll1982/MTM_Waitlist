<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MTM_Waitlist.GenericRequest.Views.GenericRequestPartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MTM_Waitlist.GenericRequest.Controls"
    xmlns:converters="using:MTM_Waitlist.Module_Settings.Converters"
    xmlns:models="using:MTM_Waitlist.GenericRequest.Models"
    xmlns:shared="using:MTM_Waitlist.Module_Shared.Services"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!--
            The card is the clickable thing, so the item container draws nothing of its own: the border, the accent
            outline and the tick all live in the item template, as on every other card list in this flow.
        -->
        <Style x:Key="SequenceCardItemContainerStyle" TargetType="GridViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <ListViewItemPresenter
                            ContentMargin="0"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            PointerOverBackground="Transparent"
                            PressedBackground="Transparent"
                            SelectedBackground="Transparent"
                            SelectedPointerOverBackground="Transparent"
                            SelectedPressedBackground="Transparent"
                            SelectedBorderThickness="0"
                            RevealBorderThickness="0"
                            SelectionCheckMarkVisualEnabled="False" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <controls:GenericRequestStepFrame
        AttemptedAtDisplay="{x:Bind ViewModel.AttemptedAtDisplay, Mode=OneWay}"
        BackCommand="{x:Bind ViewModel.BackCommand}"
        ContinueCommand="{x:Bind ViewModel.ContinueCommand}"
        EmptyKey="{x:Bind ViewModel.EmptyKey}"
        IntroKey="{x:Bind ViewModel.IntroKey}"
        Presentation="{x:Bind ViewModel.Presentation, Mode=OneWay}"
        RetryCommand="{x:Bind ViewModel.RetryCommand}"
        TitleKey="{x:Bind ViewModel.TitleKey}">
        <controls:GenericRequestStepFrame.Body>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">

                    <AutoSuggestBox
                        x:Uid="GenericRequest_Part_Search"
                        AutomationProperties.Name="{x:Bind ViewModel.Title}"
                        ItemsSource="{x:Bind ViewModel.Completions}"
                        QuerySubmitted="OnQuerySubmitted"
                        SuggestionChosen="OnSuggestionChosen"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                        TextChanged="OnSearchTextChanged"
                        TextMemberPath="PartNumber">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="models:GenericRequestPartOption">
                                <StackPanel Padding="0,6" Spacing="2">
                                    <TextBlock
                                        Text="{x:Bind PartNumber}"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Description}"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind SourceDisplay}"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.FromJobText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.FromJobVisibility, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}" />

                    <TextBlock
                        x:Uid="GenericRequest_Part_NoMatch"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.NoMatchVisibility, Mode=OneWay}"
                        Style="{StaticResource BodyTextBlockStyle}" />

                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Uid="GenericRequest_Part_Sequence_Title"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <TextBlock
                            x:Uid="GenericRequest_Part_NoSequence"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.NoSequenceVisibility, Mode=OneWay}"
                            Style="{StaticResource BodyTextBlockStyle}" />

                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.SequencesUnavailableVisibility, Mode=OneWay}">
                            <TextBlock
                                x:Uid="GenericRequest_Part_Sequences_Unavailable"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                TextWrapping="Wrap"
                                Style="{StaticResource BodyTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.SequencesAttemptedAtDisplay, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                <Button
                                    x:Uid="GenericRequest_Part_Sequences_Retry"
                                    AutomationProperties.Name="{x:Bind ViewModel.Title}"
                                    Command="{x:Bind ViewModel.RetrySequencesCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <!--
                            One card per sequence, beneath the part number box, so the sequences the part stands at are
                            read as a set of choices rather than as a list beside the search. A card is chosen by
                            clicking it, which is what reads that sequence's quantity.
                        -->
                        <GridView
                            AutomationProperties.Name="{x:Bind ViewModel.Title}"
                            IsItemClickEnabled="True"
                            ItemClick="OnSequenceClicked"
                            ItemContainerStyle="{StaticResource SequenceCardItemContainerStyle}"
                            ItemsSource="{x:Bind ViewModel.Sequences}"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionMode="None"
                            Visibility="{x:Bind ViewModel.SequenceListVisibility, Mode=OneWay}"
                            shared:CardGridSizing.MaximumColumns="3"
                            shared:CardGridSizing.MinimumCardWidth="280">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid HorizontalAlignment="Stretch" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:GenericRequestSequenceOption">
                                    <Grid
                                        Margin="8"
                                        AutomationProperties.Name="{x:Bind Sequence}">
                                        <Border
                                            MinHeight="132"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                            <StackPanel Padding="16" Spacing="10">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        FontSize="18"
                                                        FontWeight="SemiBold"
                                                        Text="{x:Bind Sequence}" />
                                                    <SymbolIcon
                                                        Grid.Column="1"
                                                        VerticalAlignment="Top"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                        Symbol="Accept"
                                                        Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </Grid>
                                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Description}"
                                                    TextWrapping="Wrap"
                                                    Style="{StaticResource BodyTextBlockStyle}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind InventoriedWith}"
                                                    TextWrapping="Wrap"
                                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- The chosen card's outline, drawn on the card border like the other steps'. -->
                                        <Border
                                            BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                                            BorderThickness="2"
                                            CornerRadius="12"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Uid="GenericRequest_Part_Quantity_Title"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12"
                            Visibility="{x:Bind ViewModel.QuantityAnsweredVisibility, Mode=OneWay}">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.StageLabel, Mode=OneWay}"
                                Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.QuantityFigure, Mode=OneWay}"
                                Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.QuantityAnsweredBy, Mode=OneWay}"
                                Style="{StaticResource BodyTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.NextResourceVisibility, Mode=OneWay}">
                            <TextBlock
                                x:Uid="GenericRequest_Part_NextResource"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.NextResourceDisplay, Mode=OneWay}"
                                Style="{StaticResource BodyTextBlockStyle}" />
                        </StackPanel>

                        <TextBlock
                            x:Uid="GenericRequest_Part_Quantity_NothingOnHand"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.NothingOnHandVisibility, Mode=OneWay}"
                            Style="{StaticResource BodyTextBlockStyle}" />

                        <StackPanel
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.QuantityUnavailableVisibility, Mode=OneWay}">
                            <TextBlock
                                x:Uid="GenericRequest_Part_Quantity_Unavailable"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                TextWrapping="Wrap"
                                Style="{StaticResource BodyTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.QuantityAttemptedAtDisplay, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                <Button
                                    x:Uid="GenericRequest_Part_Quantity_Retry"
                                    AutomationProperties.Name="{x:Bind ViewModel.Title}"
                                    Command="{x:Bind ViewModel.RetryQuantityCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </controls:GenericRequestStepFrame.Body>
    </controls:GenericRequestStepFrame>
</Page>
