<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MTM_Waitlist.GenericRequest.Views.GenericRequestItemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MTM_Waitlist.GenericRequest.Controls"
    xmlns:models="using:MTM_Waitlist.GenericRequest.Models"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <controls:GenericRequestStepFrame
        AttemptedAtDisplay="{x:Bind ViewModel.AttemptedAtDisplay, Mode=OneWay}"
        BackCommand="{x:Bind ViewModel.BackCommand}"
        ContinueCommand="{x:Bind ViewModel.ContinueCommand}"
        EmptyKey="{x:Bind ViewModel.EmptyKey}"
        IntroKey="{x:Bind ViewModel.IntroKey}"
        Presentation="{x:Bind ViewModel.Presentation, Mode=OneWay}"
        RetryCommand="{x:Bind ViewModel.RetryCommand}"
        TitleKey="{x:Bind ViewModel.TitleKey}">
        <controls:GenericRequestStepFrame.Body>
            <Grid>
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <GridView
                    AutomationProperties.Name="{x:Bind ViewModel.Title}"
                    ItemsSource="{x:Bind ViewModel.Options}"
                    SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                    SelectionMode="Single">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:GenericRequestItemOption">
                            <Border
                                MinWidth="220"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"
                                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Code}"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </controls:GenericRequestStepFrame.Body>
    </controls:GenericRequestStepFrame>
</Page>
