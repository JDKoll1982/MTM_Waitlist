<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MTM_Waitlist.GenericRequest.Controls.GenericRequestStepFrame"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock
                Text="{x:Bind TitleText}"
                TextWrapping="Wrap"
                Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind IntroText}"
                TextWrapping="Wrap"
                Style="{StaticResource BodyTextBlockStyle}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <StackPanel
                Spacing="8"
                VerticalAlignment="Top"
                Visibility="{x:Bind LoadingVisibility}">
                <ProgressRing
                    HorizontalAlignment="Left"
                    IsActive="{x:Bind IsLoading}"
                    Visibility="{x:Bind LoadingVisibility}" />
                <TextBlock
                    Text="{x:Bind LoadingText}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind LoadingTextVisibility}"
                    Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>

            <ContentPresenter
                Content="{x:Bind Body}"
                Visibility="{x:Bind BodyVisibility}" />

            <TextBlock
                VerticalAlignment="Top"
                Text="{x:Bind EmptyText}"
                TextWrapping="Wrap"
                Visibility="{x:Bind EmptyVisibility}"
                Style="{StaticResource SubtitleTextBlockStyle}" />

            <StackPanel
                Spacing="12"
                VerticalAlignment="Top"
                Visibility="{x:Bind UnavailableVisibility}">
                <TextBlock
                    x:Uid="GenericRequest_StepFrame_Unavailable_Title"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind UnavailableHeadingVisibility}"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="{x:Bind UnavailableText}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind UnavailableMessageVisibility}"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind UnavailableAttemptedVisibility}">
                    <TextBlock
                        x:Uid="GenericRequest_StepFrame_Unavailable_Attempted"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind AttemptedAtDisplay}"
                        Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <Button
                    x:Uid="GenericRequest_StepFrame_Retry"
                    AutomationProperties.Name="{x:Bind RetryName}"
                    Command="{x:Bind RetryCommand}"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Uid="GenericRequest_StepFrame_Back"
                AutomationProperties.Name="{x:Bind BackName}"
                Command="{x:Bind BackCommand}"
                Visibility="{x:Bind BackVisibility}" />
            <Button
                Grid.Column="2"
                x:Uid="GenericRequest_StepFrame_Continue"
                AutomationProperties.Name="{x:Bind ContinueName}"
                Command="{x:Bind ContinueCommand}"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ContinueVisibility}" />
        </Grid>
    </Grid>
</UserControl>
