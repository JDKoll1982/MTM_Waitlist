<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MTM_Waitlist.Module_Settings.Views.UserManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Settings.Models"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <!--
        A table rather than a list of cards: Microsoft's guidance is that a ListView is for lists and that
        multi-column data belongs in a DataGrid.

        No column carries a fixed width. Each takes a share of the window and stops at a minimum, and past that
        the table scrolls sideways rather than dropping a fact, which is what decision 28 promises. A value too
        long for its column is trimmed and carries the whole of itself as a tooltip, so trimming can hide the end
        of a word and never the fact itself.
    -->
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: the way back, the title with how many people are listed beside it, and one line about the screen. -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                AutomationProperties.AutomationId="UserManagementPage_Back"
                Click="OnBackClick"
                Content="{x:Bind ViewModel.BackLabelText}"
                VerticalAlignment="Top" />

            <StackPanel Grid.Column="1" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.TitleText}" />
                    <TextBlock
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,5"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.RosterCountText, Mode=OneWay}" />
                </StackPanel>
                <TextBlock
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.SubtitleText}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- Toolbar: search, the role filter, and the one action this screen adds people with. -->
        <Grid Grid.Row="1" x:Name="FilterBar" ColumnSpacing="12" x:Load="{x:Bind ViewModel.IsEntitled, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                AutomationProperties.AutomationId="UserManagementPage_Search"
                Header="{x:Bind ViewModel.SearchLabelText}"
                PlaceholderText="{x:Bind ViewModel.SearchPlaceholderText}"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />

            <muxc:ComboBox
                Grid.Column="1"
                AutomationProperties.AutomationId="UserManagementPage_RoleFilter"
                Header="{x:Bind ViewModel.RoleFilterLabelText}"
                ItemsSource="{x:Bind ViewModel.RoleOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedRole, Mode=TwoWay}"
                VerticalAlignment="Bottom" />

            <Button
                Grid.Column="2"
                AutomationProperties.AutomationId="UserManagementPage_Add"
                Command="{x:Bind ViewModel.AddPersonCommand}"
                Content="{x:Bind ViewModel.AddLabelText}"
                Style="{ThemeResource AccentButtonStyle}"
                VerticalAlignment="Bottom" />
        </Grid>

        <!-- The active filter, named, with the way to clear it -->
        <StackPanel
            Grid.Row="2"
            x:Name="ActiveFilterBanner"
            Orientation="Horizontal"
            Spacing="12"
            x:Load="{x:Bind ViewModel.IsFilterApplied, Mode=OneWay}">
            <TextBlock
                VerticalAlignment="Center"
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.FilterActiveText}"
                TextWrapping="Wrap" />
            <TextBlock
                VerticalAlignment="Center"
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.HiddenCountText, Mode=OneWay}" />
            <Button
                AutomationProperties.AutomationId="UserManagementPage_ShowEveryone"
                Command="{x:Bind ViewModel.ShowEveryoneCommand}"
                Content="{x:Bind ViewModel.ShowEveryoneText}" />
        </StackPanel>

        <!-- What the table cannot show, said above it: busy, empty, filtered to nobody, or an unreadable store. -->
        <StackPanel Grid.Row="3" Spacing="8">
            <muxc:ProgressRing
                Width="24"
                Height="24"
                HorizontalAlignment="Left"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <TextBlock
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.StateMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
            <TextBlock
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.EmptyText}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.IsRosterEmpty, Mode=OneWay}" />
            <TextBlock
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.NoMatchText}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.IsNoMatch, Mode=OneWay}" />
            <Button
                AutomationProperties.AutomationId="UserManagementPage_Retry"
                Command="{x:Bind ViewModel.LoadCommand}"
                Content="{x:Bind ViewModel.RetryText}"
                Visibility="{x:Bind ViewModel.IsStoreUnavailable, Mode=OneWay}" />
        </StackPanel>

        <!--
            The roster as a table: a header row of the five facts, each one a button that orders the roster by
            it, and the rows beneath.

            The toolkit's DataGrid was the first choice and could not be used: dropped onto this page, the control
            fails fast as the window builds it, with no items, no columns and none of this page's code involved
            (exit code 0xC000027B, a stowed WinRT exception). A ListView under a header row is the table the rest
            of this application already draws, so the columns here follow that.

            No column carries a fixed width. Each takes a share of the window and stops at a minimum, and past
            that the table scrolls sideways rather than dropping a fact, which is what decision 28 promises. A
            value too long for its column is trimmed and carries the whole of itself as a tooltip, so trimming can
            hide the end of a word and never the fact itself.
        -->
        <ListView
            Grid.Row="4"
            AutomationProperties.AutomationId="UserManagementPage_Roster"
            HorizontalContentAlignment="Stretch"
            IsItemClickEnabled="True"
            ItemClick="OnPersonInvoked"
            ItemsSource="{x:Bind ViewModel.PageRows}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollMode="Enabled"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>

            <!-- The five headings: each one orders the roster by the fact above it. -->
            <ListView.Header>
                <Grid MinWidth="650" Padding="12,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="150" />
                        <ColumnDefinition Width="*" MinWidth="130" />
                        <ColumnDefinition Width="*" MinWidth="110" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="Auto" MinWidth="100" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        AutomationProperties.AutomationId="UserManagementPage_SortByName"
                        Command="{x:Bind ViewModel.SortByCommand}"
                        CommandParameter="Name"
                        Content="{x:Bind ViewModel.ColumnNameHeaderText}"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Style="{ThemeResource DefaultButtonStyle}" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.AutomationId="UserManagementPage_SortBySignInName"
                        Command="{x:Bind ViewModel.SortByCommand}"
                        CommandParameter="SignInName"
                        Content="{x:Bind ViewModel.ColumnSignInNameHeaderText}"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Style="{ThemeResource DefaultButtonStyle}" />
                    <Button
                        Grid.Column="2"
                        AutomationProperties.AutomationId="UserManagementPage_SortByEmployeeNumber"
                        Command="{x:Bind ViewModel.SortByCommand}"
                        CommandParameter="EmployeeNumber"
                        Content="{x:Bind ViewModel.ColumnEmployeeNumberHeaderText}"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Style="{ThemeResource DefaultButtonStyle}" />
                    <Button
                        Grid.Column="3"
                        AutomationProperties.AutomationId="UserManagementPage_SortByRole"
                        Command="{x:Bind ViewModel.SortByCommand}"
                        CommandParameter="Role"
                        Content="{x:Bind ViewModel.ColumnRoleHeaderText}"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Style="{ThemeResource DefaultButtonStyle}" />
                    <Button
                        AutomationProperties.AutomationId="UserManagementPage_SortByStatus"
                        Grid.Column="4"
                        Command="{x:Bind ViewModel.SortByCommand}"
                        CommandParameter="Status"
                        Content="{x:Bind ViewModel.ColumnStatusHeaderText}"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Style="{ThemeResource DefaultButtonStyle}" />
                </Grid>
            </ListView.Header>

            <!-- One row, the five facts, and nothing else: reaching it opens that person. -->
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:UserSummary">
                    <Grid MinWidth="650" Padding="12,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="150" />
                            <ColumnDefinition Width="*" MinWidth="130" />
                            <ColumnDefinition Width="*" MinWidth="110" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="Auto" MinWidth="100" />
                        </Grid.ColumnDefinitions>

                        <!-- Fact 1: the person's name, and the row's own way in for the keyboard. -->
                        <HyperlinkButton
                            Grid.Column="0"
                            Padding="0"
                            AutomationProperties.Name="{x:Bind OpenAnnouncement}"
                            Click="OnPersonLinkClick"
                            Content="{x:Bind DisplayName}"
                            ToolTipService.ToolTip="{x:Bind DisplayName}" />

                        <!-- Fact 2: the sign-in name. -->
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{x:Bind UsernameNormalized}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTipService.ToolTip="{x:Bind UsernameNormalized}" />

                        <!-- Fact 3: the employee number. -->
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Text="{x:Bind EmployeeIdentifier}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTipService.ToolTip="{x:Bind EmployeeIdentifier}" />

                        <!-- Fact 4: the role, carried by the glyph and colour the one badge lookup holds for it. -->
                        <StackPanel
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <FontIcon
                                FontSize="14"
                                Foreground="{x:Bind RoleColorHex, Converter={StaticResource HexColorToBrushConverter}}"
                                Glyph="{x:Bind RoleGlyph}" />
                            <TextBlock
                                Text="{x:Bind RoleText}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind RoleText}" />
                        </StackPanel>

                        <!--
                            Fact 5: whether the account is active, as a pill that states the condition either
                            way. It is one border per state rather than one border recoloured, because both
                            colours come from the theme and a pill whose background and text disagree is
                            unreadable in one of the two.
                        -->
                        <Grid Grid.Column="4">
                            <Border
                                Padding="8,2"
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                CornerRadius="10"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind IsActive}">
                                <TextBlock
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ActiveStateText}" />
                            </Border>
                            <Border
                                Padding="8,2"
                                Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                CornerRadius="10"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind IsSwitchedOff}">
                                <TextBlock
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ActiveStateText}" />
                            </Border>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

        <!-- Footer: how many rows at a time, which of them these are, and the way to the other pages. -->
        <Grid
            Grid.Row="5"
            ColumnSpacing="16"
            Visibility="{x:Bind ViewModel.HasPeople, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.RowsPerPageLabelText}" />
                <muxc:ComboBox
                    AutomationProperties.AutomationId="UserManagementPage_RowsPerPage"
                    ItemsSource="{x:Bind ViewModel.RowsPerPageOptions}"
                    SelectedItem="{x:Bind ViewModel.RowsPerPage, Mode=TwoWay}" />
            </StackPanel>

            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.RangeText, Mode=OneWay}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.PageText, Mode=OneWay}" />
                <Button
                    AutomationProperties.AutomationId="UserManagementPage_PreviousPage"
                    Command="{x:Bind ViewModel.PreviousPageCommand}"
                    Content="{x:Bind ViewModel.PreviousPageText}"
                    IsEnabled="{x:Bind ViewModel.CanGoToPreviousPage, Mode=OneWay}" />
                <Button
                    AutomationProperties.AutomationId="UserManagementPage_NextPage"
                    Command="{x:Bind ViewModel.NextPageCommand}"
                    Content="{x:Bind ViewModel.NextPageText}"
                    IsEnabled="{x:Bind ViewModel.CanGoToNextPage, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
