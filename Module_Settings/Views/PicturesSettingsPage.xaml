<Page
    x:Class="MTM_Waitlist.Module_Settings.Views.PicturesSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:MTM_Waitlist.Module_Settings.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:MTM_Waitlist.Module_Core.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:views="using:MTM_Waitlist.Module_Settings.Views"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls"
    xmlns:xaml="using:Microsoft.UI.Xaml"
    x:Name="RootPage"
    mc:Ignorable="d">

<Page.Resources>
    <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />

    <!-- What the no-picture box will actually draw, resolved by existence rather than by the picture rule, so the
         preview and the card that draws it agree. -->
    <conv:NoImagePathToSourceConverter x:Key="NoImagePathToSourceConverter" />

    <!--
        Settings page typography and row chrome.

        Every description and status line on the page uses SettingsDescriptionStyle, and every
        value pill in a two-column pick list uses SettingsListPillStyle. Section headings use the
        platform BodyStrong style directly. Keeping these three in one place is what stops the
        page drifting back into a mix of margins, brushes and font sizes.
    -->
    <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingsListPillStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,6,10,6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        Pictures panel row chrome.

        The merged panel holds three cards, and between them a dozen rows of "label, description, control". The
        measurements live here rather than on each row, so a folder box and the Browse button beside it sit in
        one straight column instead of every row inventing its own width.
    -->
    <Style x:Key="SettingsFormRowStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="16" />
    </Style>

    <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        A folder box has a floor and a ceiling. The floor keeps it usable; the ceiling matters more: a TextBox
        measures to the width of the text it holds, and these boxes hold long UNC share paths. With no ceiling the
        box claims the whole row, the star column beside it collapses, and the label and description beside it wrap
        one character per line.
    -->
    <Style x:Key="SettingsFolderBoxStyle" TargetType="TextBox">
        <Setter Property="MinWidth" Value="300" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsFolderButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Page.Resources>
    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid
            Padding="0,0,0,48"
            HorizontalAlignment="Stretch"
            RowSpacing="28">
            <StackPanel Spacing="10">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Pictures" />
                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Which pictures the app shows, where they are kept, and the copies on this computer." />
<TextBox
    AutomationProperties.AutomationId="PicturesSettingsPage_SearchBox"
    Header="Search"
    PlaceholderText="Search settings"
    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
<wct:SettingsExpander
    AutomationProperties.AutomationId="SettingsPage_ImagesExpander"
    x:Name="ImagesExpander"
    x:Load="{x:Bind ViewModel.IsImagesPanelVisible, Mode=OneWay}"
    Description="{x:Bind ViewModel.ImagesPanelDescription}"
    Header="{x:Bind ViewModel.ImagesPanelTitle}"
    HorizontalAlignment="Stretch"
    IsExpanded="False">
    <wct:SettingsExpander.HeaderIcon>
        <SymbolIcon Symbol="Pictures" />
    </wct:SettingsExpander.HeaderIcon>

    <wct:SettingsExpander.Items>
        <!-- Which picture an item or a work center resolves -->
        <wct:SettingsCard
            AutomationProperties.AutomationId="SettingsPage_Images_AssignmentsCard"
            ContentAlignment="Vertical"
            HorizontalContentAlignment="Stretch"
            Visibility="{x:Bind ViewModel.IsPictureAssignmentsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <wct:SettingsCard.Header>
                <TextBlock
                    x:Uid="Settings_Images_AssignmentsTitle"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Pictures the app shows"
                    TextWrapping="Wrap" />
            </wct:SettingsCard.Header>
            <wct:SettingsCard.Description>
                <TextBlock
                    x:Uid="Settings_Images_AssignmentsDescription"
                    Style="{StaticResource SettingsDescriptionStyle}"
                    Text="Which picture an item or work center shows, and what it shows when it has none." />
            </wct:SettingsCard.Description>

            <Grid RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Style="{StaticResource SettingsFormRowStyle}"
                    Visibility="{x:Bind ViewModel.IsImageLocationSettingsPanelVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Uid="Settings_Images_ItemPicturesTitle"
                            Style="{StaticResource SettingsRowTitleStyle}"
                            Text="Item pictures" />
                        <TextBlock
                            x:Uid="Settings_Images_ItemPicturesDescription"
                            Style="{StaticResource SettingsDescriptionStyle}"
                            Text="The picture each item uses across the app." />
                    </StackPanel>
                    <Button
                        AutomationProperties.AutomationId="SettingsPage_Images_ManageItemsButton"
                        AutomationProperties.Name="Manage request item pictures"
                        x:Uid="Settings_Images_ItemPicturesAction"
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        Click="RequestItemImages_Click"
                        Content="Manage items" />
                </Grid>

                <Grid
                    Grid.Row="1"
                    Style="{StaticResource SettingsFormRowStyle}"
                    Visibility="{x:Bind ViewModel.IsImageLocationSettingsPanelVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Uid="Settings_Images_WorkCenterPicturesTitle"
                            Style="{StaticResource SettingsRowTitleStyle}"
                            Text="Work center pictures" />
                        <TextBlock
                            x:Uid="Settings_Images_WorkCenterPicturesDescription"
                            Style="{StaticResource SettingsDescriptionStyle}"
                            Text="Pictures for work center selections and detail pages." />
                    </StackPanel>
                    <Button
                        AutomationProperties.AutomationId="SettingsPage_Images_ManageWorkCentersButton"
                        AutomationProperties.Name="Manage work center images"
                        x:Uid="Settings_Images_WorkCenterPicturesAction"
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        Click="WorkCenterImages_Click"
                        Content="Manage work centers" />
                </Grid>

                <Grid
                    Grid.Row="2"
                    Style="{StaticResource SettingsFormRowStyle}"
                    Visibility="{x:Bind ViewModel.IsPartPicturesEntryVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            Style="{StaticResource SettingsRowTitleStyle}"
                            Text="{x:Bind ViewModel.PartPicturesEntryTitle}" />
                        <TextBlock
                            Style="{StaticResource SettingsDescriptionStyle}"
                            Text="{x:Bind ViewModel.PartPicturesEntryDescription}" />
                    </StackPanel>
                    <Button
                        AutomationProperties.AutomationId="SettingsPage_PartPicturesEntry"
                        AutomationProperties.Name="Open the part picture screen"
                        x:Uid="Settings_Images_PartPicturesAction"
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.OpenPartPicturesCommand}"
                        Content="Open part pictures" />
                </Grid>
            </Grid>
        </wct:SettingsCard>

        <!--
            Where the picture files are kept (008-part-pictures, T022). The picture folder, the
            dunnage root, the hopper folder and the period a replaced picture is kept, on the
            storage entitlement rather than the picture entitlement, because FR-017 reserves the
            folders to IT Department and Developer while FR-025 widens the picture entitlement past
            them. Each box has a folder dialog beside it, because a share path typed from memory is
            the commonest way these boxes go wrong.
        -->
        <wct:SettingsCard
            AutomationProperties.AutomationId="SettingsPage_Images_FoldersCard"
            ContentAlignment="Vertical"
            HorizontalContentAlignment="Stretch"
            Visibility="{x:Bind ViewModel.IsStoragePathsPanelVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <wct:SettingsCard.Header>
                <TextBlock
                    x:Uid="Settings_Images_FoldersTitle"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Where the picture files are kept"
                    TextWrapping="Wrap" />
            </wct:SettingsCard.Header>
            <wct:SettingsCard.Description>
                <TextBlock
                    x:Uid="Settings_Images_FoldersDescription"
                    Style="{StaticResource SettingsDescriptionStyle}"
                    Text="Where every picture is read from, and how long a replaced one is kept." />
            </wct:SettingsCard.Description>

            <Grid RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Style="{StaticResource SettingsFormRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            Style="{StaticResource SettingsRowTitleStyle}"
                            Text="{x:Bind ViewModel.StoragePathsImageFolderLabel}" />
                        <TextBlock
                            x:Uid="Settings_Images_PictureFolderDescription"
                            Style="{StaticResource SettingsDescriptionStyle}"
                            Text="The folder every picture sits under." />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBox
                            AutomationProperties.AutomationId="SettingsPage_StoragePaths_ImageFolderBox"
                            AutomationProperties.Name="{x:Bind ViewModel.StoragePathsImageFolderLabel}"
                            Style="{StaticResource SettingsFolderBoxStyle}"
                            Text="{x:Bind ViewModel.PictureFolderInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            AutomationProperties.AutomationId="SettingsPage_Images_PictureFolderBrowseButton"
                            AutomationProperties.Name="Browse for the picture folder"
                            Style="{StaticResource SettingsFolderButtonStyle}"
                            Command="{x:Bind ViewModel.BrowsePictureFolderCommand}"
                            Content="{x:Bind ViewModel.ImagesBrowseLabel}"
                            Visibility="{x:Bind ViewModel.CanBrowseFolders, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Style="{StaticResource SettingsFormRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            Style="{StaticResource SettingsRowTitleStyle}"
                            Text="{x:Bind ViewModel.StoragePathsDunnageRootLabel}" />
                        <TextBlock
                            x:Uid="Settings_Images_DunnageRootDescription"
                            Style="{StaticResource SettingsDescriptionStyle}"
                            Text="Where the dunnage pictures live, one folder per type and part." />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBox
                            AutomationProperties.AutomationId="SettingsPage_StoragePaths_DunnageRootBox"
                            AutomationProperties.Name="{x:Bind ViewModel.StoragePathsDunnageRootLabel}"
                            Style="{StaticResource SettingsFolderBoxStyle}"
                            Text="{x:Bind ViewModel.DunnageRootInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            AutomationProperties.AutomationId="SettingsPage_Images_DunnageRootBrowseButton"
                            AutomationProperties.Name="Browse for the dunnage picture root"
                            Style="{StaticResource SettingsFolderButtonStyle}"
                            Command="{x:Bind ViewModel.BrowseDunnageRootCommand}"
                            Content="{x:Bind ViewModel.ImagesBrowseLabel}"
                            Visibility="{x:Bind ViewModel.CanBrowseFolders, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>

                <!-- The hopper reference pictures (012-waitlist-card-layout, FR-078). A folder of its
                     own because the three files are named after the size a person chose, not after
                     a part, so the naming contract is written into the row. -->
                <Grid Grid.Row="2" Style="{StaticResource SettingsFormRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            Style="{StaticResource SettingsRowTitleStyle}"
                            Text="{x:Bind ViewModel.StoragePathsHopperFolderLabel}" />
                        <TextBlock
                            Style="{StaticResource SettingsDescriptionStyle}"
                            Text="{x:Bind ViewModel.StoragePathsHopperFolderHint}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBox
                            AutomationProperties.AutomationId="SettingsPage_StoragePaths_HopperFolderBox"
                            AutomationProperties.Name="{x:Bind ViewModel.StoragePathsHopperFolderLabel}"
                            Style="{StaticResource SettingsFolderBoxStyle}"
                            Text="{x:Bind ViewModel.HopperFolderInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            AutomationProperties.AutomationId="SettingsPage_StoragePaths_HopperFolderBrowseButton"
                            AutomationProperties.Name="{x:Bind ViewModel.StoragePathsHopperFolderBrowseName}"
                            Style="{StaticResource SettingsFolderButtonStyle}"
                            Command="{x:Bind ViewModel.BrowseHopperFolderCommand}"
                            Content="{x:Bind ViewModel.StoragePathsHopperFolderBrowseLabel}"
                            Visibility="{x:Bind ViewModel.CanBrowseFolders, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>

                <!-- The lugger pictures. One file per lugger, named after the lugger's place in the
                     arrangement rather than after its name, so renaming a lugger keeps its picture.
                     The row sits beside the hopper folder because it is the same kind of decision:
                     a plant folder the owner sets once and every computer reads. -->
                <Grid Grid.Row="3" Style="{StaticResource SettingsFormRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            Style="{StaticResource SettingsRowTitleStyle}"
                            Text="{x:Bind ViewModel.StoragePathsLuggerFolderLabel}" />
                        <TextBlock
                            Style="{StaticResource SettingsDescriptionStyle}"
                            Text="{x:Bind ViewModel.StoragePathsLuggerFolderHint}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBox
                            AutomationProperties.AutomationId="SettingsPage_StoragePaths_LuggerFolderBox"
                            AutomationProperties.Name="{x:Bind ViewModel.StoragePathsLuggerFolderLabel}"
                            Style="{StaticResource SettingsFolderBoxStyle}"
                            Text="{x:Bind ViewModel.LuggerFolderInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            AutomationProperties.AutomationId="SettingsPage_StoragePaths_LuggerFolderBrowseButton"
                            AutomationProperties.Name="{x:Bind ViewModel.StoragePathsLuggerFolderBrowseName}"
                            Style="{StaticResource SettingsFolderButtonStyle}"
                            Command="{x:Bind ViewModel.BrowseLuggerFolderCommand}"
                            Content="{x:Bind ViewModel.StoragePathsLuggerFolderBrowseLabel}"
                            Visibility="{x:Bind ViewModel.CanBrowseFolders, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>

                <!-- The picture drawn wherever a surface has none. One file rather than a folder, because there
                     is only ever one answer: an item, a work center and a lugger with no picture all draw the same
                     thing. The preview beside the box shows exactly what will be drawn, including the shipped
                     artwork while the box names a file that is not there. -->
                <Grid Grid.Row="4" Style="{StaticResource SettingsFormRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="56"
                        Height="56"
                        VerticalAlignment="Center"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Image
                            AutomationProperties.Name="The picture drawn when there is no picture"
                            Source="{x:Bind ViewModel.NoImagePathInput, Mode=OneWay, Converter={StaticResource NoImagePathToSourceConverter}}"
                            Stretch="Uniform" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock
                            Style="{StaticResource SettingsRowTitleStyle}"
                            Text="{x:Bind ViewModel.StoragePathsNoImagePathLabel}" />
                        <TextBlock
                            Style="{StaticResource SettingsDescriptionStyle}"
                            Text="{x:Bind ViewModel.StoragePathsNoImagePathHint}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBox
                            AutomationProperties.AutomationId="SettingsPage_StoragePaths_NoImagePathBox"
                            AutomationProperties.Name="{x:Bind ViewModel.StoragePathsNoImagePathLabel}"
                            Style="{StaticResource SettingsFolderBoxStyle}"
                            Text="{x:Bind ViewModel.NoImagePathInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            AutomationProperties.AutomationId="SettingsPage_StoragePaths_NoImagePathBrowseButton"
                            AutomationProperties.Name="{x:Bind ViewModel.StoragePathsNoImagePathBrowseName}"
                            Style="{StaticResource SettingsFolderButtonStyle}"
                            Click="PickNoImage_Click"
                            Content="{x:Bind ViewModel.StoragePathsNoImagePathBrowseLabel}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="5" Style="{StaticResource SettingsFormRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            Style="{StaticResource SettingsRowTitleStyle}"
                            Text="{x:Bind ViewModel.StoragePathsArchiveKeepDaysLabel}" />
                        <TextBlock
                            x:Uid="Settings_Images_KeepDaysDescription"
                            Style="{StaticResource SettingsDescriptionStyle}"
                            Text="How long a replaced picture is kept before cleanup." />
                    </StackPanel>
                    <NumberBox
                        AutomationProperties.AutomationId="SettingsPage_StoragePaths_KeepDaysBox"
                        AutomationProperties.Name="{x:Bind ViewModel.StoragePathsArchiveKeepDaysLabel}"
                        Grid.Column="1"
                        MinWidth="140"
                        VerticalAlignment="Center"
                        Minimum="1"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.ArchiveKeepDaysInput, Mode=TwoWay}" />
                </Grid>

                <StackPanel
                    Grid.Row="6"
                    Spacing="8">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            AutomationProperties.AutomationId="SettingsPage_StoragePaths_SaveButton"
                            AutomationProperties.Name="{x:Bind ViewModel.StoragePathsSaveLabel}"
                            MinWidth="180"
                            Click="SaveStoragePaths_Click"
                            Content="{x:Bind ViewModel.StoragePathsSaveLabel}" />
                        <ProgressRing
                            Width="20"
                            Height="20"
                            IsActive="{x:Bind ViewModel.IsStoragePathsBusy, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock
                        Style="{StaticResource SettingsDescriptionStyle}"
                        Text="{x:Bind ViewModel.StoragePathsStoreIsTruthText}" />

                    <TextBlock
                        Style="{StaticResource SettingsDescriptionStyle}"
                        Text="{x:Bind ViewModel.StoragePathsStatusMessage, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </wct:SettingsCard>

        <!-- The copies made on this computer, on the storage entitlement for the same reason as
             the folders above (research D10): the folder a machine copies from is a storage
             control, not a picture-permission one. -->
        <wct:SettingsCard
            AutomationProperties.AutomationId="SettingsPage_Images_CacheCard"
            ContentAlignment="Vertical"
            HorizontalContentAlignment="Stretch"
            Visibility="{x:Bind ViewModel.IsPictureCachePanelVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <wct:SettingsCard.Header>
                <TextBlock
                    x:Uid="Settings_Images_CacheTitle"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Copies on this computer"
                    TextWrapping="Wrap" />
            </wct:SettingsCard.Header>
            <wct:SettingsCard.Description>
                <TextBlock
                    x:Uid="Settings_Images_CacheDescription"
                    Style="{StaticResource SettingsDescriptionStyle}"
                    Text="Pictures are copied here when the app starts, so the waitlist reads them from local disk. Changed pictures are copied again; deleted ones are removed." />
            </wct:SettingsCard.Description>

            <Grid RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Style="{StaticResource SettingsFormRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Uid="Settings_Images_CacheToggleTitle"
                            Style="{StaticResource SettingsRowTitleStyle}"
                            Text="Cache pictures on this computer" />
                        <TextBlock
                            x:Uid="Settings_Images_CacheToggleDescription"
                            Style="{StaticResource SettingsDescriptionStyle}"
                            Text="Applies to every computer. Off, pictures are read from the share." />
                    </StackPanel>
                    <ToggleSwitch
                        AutomationProperties.AutomationId="SettingsPage_PictureCache_Toggle"
                        AutomationProperties.Name="Cache pictures on this computer"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        IsOn="{x:Bind ViewModel.IsPictureCacheEnabled, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />
                </Grid>

                <Grid Grid.Row="1" Style="{StaticResource SettingsFormRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Uid="Settings_Images_CacheFolderTitle"
                            Style="{StaticResource SettingsRowTitleStyle}"
                            Text="Cache folder" />
                        <TextBlock
                            x:Uid="Settings_Images_CacheFolderDescription"
                            Style="{StaticResource SettingsDescriptionStyle}"
                            Text="Where the copies are kept, mirroring the share's folders." />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBox
                            AutomationProperties.AutomationId="SettingsPage_PictureCache_FolderBox"
                            AutomationProperties.Name="Picture cache folder"
                            Style="{StaticResource SettingsFolderBoxStyle}"
                            PlaceholderText="%LOCALAPPDATA%\MTM_Waitlist\ImageCache"
                            Text="{x:Bind ViewModel.PictureCacheFolderInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            AutomationProperties.AutomationId="SettingsPage_PictureCache_BrowseFolderButton"
                            AutomationProperties.Name="Browse for the picture cache folder"
                            Style="{StaticResource SettingsFolderButtonStyle}"
                            Command="{x:Bind ViewModel.BrowsePictureCacheFolderCommand}"
                            Content="{x:Bind ViewModel.ImagesBrowseLabel}"
                            Visibility="{x:Bind ViewModel.CanBrowseFolders, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button
                            AutomationProperties.AutomationId="SettingsPage_PictureCache_SaveFolderButton"
                            AutomationProperties.Name="Save picture cache folder"
                            x:Uid="Settings_Images_CacheFolderSave"
                            MinWidth="80"
                            VerticalAlignment="Center"
                            Click="SavePictureCacheFolder_Click"
                            Content="Save" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Style="{StaticResource SettingsFormRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Uid="Settings_Images_CacheCopyTitle"
                            Style="{StaticResource SettingsRowTitleStyle}"
                            Text="Copy pictures now" />
                        <TextBlock
                            x:Uid="Settings_Images_CacheCopyDescription"
                            Style="{StaticResource SettingsDescriptionStyle}"
                            Text="Runs the same copy the app runs at startup, without a restart." />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            AutomationProperties.AutomationId="SettingsPage_PictureCache_RefreshButton"
                            AutomationProperties.Name="Copy pictures now"
                            x:Uid="Settings_Images_CacheCopyAction"
                            MinWidth="140"
                            VerticalAlignment="Center"
                            Click="RefreshPictureCache_Click"
                            Content="Copy now" />
                        <ProgressRing
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            IsActive="{x:Bind ViewModel.IsPictureCacheBusy, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    Grid.Row="3"
                    Style="{StaticResource SettingsDescriptionStyle}"
                    Text="{x:Bind ViewModel.PictureCacheStatusMessage, Mode=OneWay}" />
            </Grid>
        </wct:SettingsCard>
    </wct:SettingsExpander.Items>
</wct:SettingsExpander>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
