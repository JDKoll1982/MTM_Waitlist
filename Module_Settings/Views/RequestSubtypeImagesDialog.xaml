<ContentDialog
    x:Class="MTM_Waitlist.Module_Settings.Views.RequestSubtypeImagesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MTM_Waitlist.Module_Settings.Views"
    Title="Request Subtype Images"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    HorizontalAlignment="Center"
    VerticalAlignment="Center">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1000</x:Double>
        <x:Double x:Key="ContentDialogThemeMaxWidth">1000</x:Double>
        <x:Double x:Key="ContentDialogThemeMinWidth">1000</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">1000</x:Double>
        <x:Double x:Key="ContentDialogMinHeight">600</x:Double>
        <x:Double x:Key="ContentDialogThemeMinHeight">600</x:Double>
        <x:Double x:Key="ContentDialogThemeMaxHeight">600</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">600</x:Double>
        <x:Double x:Key="ContentDialogHeight">600</x:Double>
        <x:Double x:Key="ContentDialogThemeHeight">600</x:Double>
    </ContentDialog.Resources>

        <views:ImageOverrideEditorControl x:Name="Editor" />
</ContentDialog>
