<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MTM_Waitlist.Module_Settings.Views.LuggerEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls"
    AutomationProperties.AutomationId="LuggerEditorDialog_Dialog"
    MinWidth="480"
    mc:Ignorable="d">

    <!--
        One lugger's editor (013-lugger-location-config, FR-019, FR-030, FR-031). The lugger is the card that opened
        this window, so there is no picker: every action below applies to the lugger the window is named for.

        The editor is a column of Fluent settings rows rather than a stack of loose controls: each row names what it
        changes, says what that means, and holds the control that changes it. The rows are stretched so every control
        shares one left and right edge down the window, which is what makes a short modal read as deliberate rather
        than as a form that happened.

        A dialog is centred in the window it covers and stays centred while the window is resized, because the
        dialog host places it rather than the window; the alignment here states that rather than working around it.
    -->
    <ScrollViewer
        MaxHeight="560"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel MinWidth="440" Spacing="12">

            <!-- What the last action answered, or what the editor is waiting for. -->
            <TextBlock
                Margin="0,0,0,4"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.MessageText, Mode=OneWay}"
                TextWrapping="Wrap" />

            <wct:SettingsCard
                AutomationProperties.AutomationId="LuggerEditorDialog_StatusCard"
                ContentAlignment="Vertical"
                Description="Available, full, a backup, or out of use. A status that needs a reason will not save without one."
                Header="{x:Bind ViewModel.StatusLabelText}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
                <wct:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="Important" />
                </wct:SettingsCard.HeaderIcon>

                <StackPanel Spacing="8">
                    <ComboBox
                        AutomationProperties.AutomationId="LuggerArrangementPage_Status"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.StatusOptions}"
                        SelectedItem="{x:Bind ViewModel.StatusInput, Mode=TwoWay}" />
                    <Button
                        AutomationProperties.AutomationId="LuggerArrangementPage_SetStatus"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.SetStatusCommand}"
                        Content="{x:Bind ViewModel.StatusActionText}"
                        Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>
            </wct:SettingsCard>

            <wct:SettingsCard
                AutomationProperties.AutomationId="LuggerEditorDialog_ReasonCard"
                ContentAlignment="Vertical"
                Description="Why the lugger is out of use. Stays blank while the status does not need one."
                Header="{x:Bind ViewModel.ReasonLabelText}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
                <wct:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="Message" />
                </wct:SettingsCard.HeaderIcon>

                <TextBox
                    AutomationProperties.AutomationId="LuggerArrangementPage_Reason"
                    HorizontalAlignment="Stretch"
                    IsEnabled="{x:Bind ViewModel.IsReasonRequired, Mode=OneWay}"
                    Text="{x:Bind ViewModel.ReasonInput, Mode=TwoWay}" />
            </wct:SettingsCard>

            <wct:SettingsCard
                AutomationProperties.AutomationId="LuggerEditorDialog_ScrapCard"
                ContentAlignment="Vertical"
                Description="The scrapped material this lugger takes, from the catalogue the setup workflow recognises."
                Header="{x:Bind ViewModel.ScrapTypeLabelText}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
                <wct:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="Bullets" />
                </wct:SettingsCard.HeaderIcon>

                <StackPanel Spacing="8">
                    <ComboBox
                        AutomationProperties.AutomationId="LuggerArrangementPage_ScrapType"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.ScrapTypeOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.ScrapTypeInput, Mode=TwoWay}" />

                    <StackPanel
                        Margin="0,4,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            AutomationProperties.AutomationId="LuggerArrangementPage_Assign"
                            Command="{x:Bind ViewModel.AssignScrapTypeCommand}"
                            Content="{x:Bind ViewModel.AssignActionText}" />
                        <Button
                            AutomationProperties.AutomationId="LuggerArrangementPage_Unassign"
                            Command="{x:Bind ViewModel.UnassignScrapTypeCommand}"
                            Content="{x:Bind ViewModel.UnassignActionText}" />
                        <!-- Offered only when there is a backup to promote this lugger ahead of (FR-006, FR-018). -->
                        <Button
                            AutomationProperties.AutomationId="LuggerArrangementPage_Promote"
                            Command="{x:Bind ViewModel.PromoteLuggerCommand}"
                            Content="{x:Bind ViewModel.PromoteActionText}"
                            Visibility="{x:Bind ViewModel.CanPromote, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>
            </wct:SettingsCard>

            <!--
                Removing a lugger is its own row rather than a third button beside Assign: it takes the lugger out of
                the arrangement altogether, so it is separated from the changes that can be undone by editing again.
            -->
            <wct:SettingsCard
                AutomationProperties.AutomationId="LuggerEditorDialog_RemoveCard"
                ContentAlignment="Vertical"
                Description="Takes this lugger out of the arrangement. The scrap types it holds are released."
                Header="{x:Bind ViewModel.RemoveActionText}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
                <wct:SettingsCard.HeaderIcon>
                    <SymbolIcon Symbol="Delete" />
                </wct:SettingsCard.HeaderIcon>

                <Button
                    AutomationProperties.AutomationId="LuggerArrangementPage_Remove"
                    HorizontalAlignment="Right"
                    Command="{x:Bind ViewModel.RemoveLuggerCommand}"
                    Content="{x:Bind ViewModel.RemoveActionText}" />
            </wct:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
