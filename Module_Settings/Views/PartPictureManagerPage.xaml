<Page
    x:Class="MTM_Waitlist.Module_Settings.Views.PartPictureManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Settings.Models"
    xmlns:vm="using:MTM_Waitlist.Module_Settings.ViewModels"
    mc:Ignorable="d">

    <!--
        The part-picture screen (FR-024 to FR-027).

        Three things on one page, in the order a person works: find the part, give it a picture, then work through
        the list of parts that still have none. The picture the screen shows for a part comes from the same reader
        every card draws with, so what is shown here is what a surface shows.
    -->
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{ThemeResource TitleTextBlockStyle}"
            Text="{x:Bind ViewModel.PartPicturesTitle}" />

        <!-- Find one part, in one system -->
        <Border
            Grid.Row="1"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    Grid.Column="0"
                    MinWidth="140"
                    AutomationProperties.AutomationId="PartPictureManagerPage_SystemBox"
                    AutomationProperties.Name="{x:Bind ViewModel.SystemLabel}"
                    DisplayMemberPath="Label"
                    Header="{x:Bind ViewModel.SystemLabel}"
                    ItemsSource="{x:Bind ViewModel.Systems}"
                    SelectedItem="{x:Bind ViewModel.SelectedSystem, Mode=TwoWay}" />

                <TextBox
                    Grid.Column="2"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="PartPictureManagerPage_PartNumberBox"
                    AutomationProperties.Name="{x:Bind ViewModel.PartNumberLabel}"
                    Header="{x:Bind ViewModel.PartNumberLabel}"
                    PlaceholderText="{x:Bind ViewModel.PartNumberPlaceholder}"
                    Text="{x:Bind ViewModel.PartNumberInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    Grid.Column="3"
                    MinWidth="120"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="PartPictureManagerPage_FindButton"
                    AutomationProperties.Name="{x:Bind ViewModel.FindLabel}"
                    Command="{x:Bind ViewModel.FindPartCommand}"
                    Content="{x:Bind ViewModel.FindLabel}"
                    Style="{ThemeResource AccentButtonStyle}" />
            </Grid>
        </Border>

        <!-- The part in front of the person, its picture, and the action -->
        <Border
            Grid.Row="2"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="{x:Bind ViewModel.HasCurrentPart, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="120"
                    Height="120"
                    Padding="4"
                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                    CornerRadius="8">
                    <Image
                        AutomationProperties.AutomationId="PartPictureManagerPage_CurrentPicture"
                        AutomationProperties.Name="{x:Bind ViewModel.CurrentPictureLabel}"
                        Source="{x:Bind ViewModel.CurrentPicturePath, Mode=OneWay, Converter={StaticResource ResolvedImagePathToSourceConverter}}"
                        Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                    <TextBlock
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.CurrentPart.PartNumber, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.NoCurrentPictureText}"
                        Visibility="{x:Bind ViewModel.NoCurrentPictureVisibility, Mode=OneWay}" />
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.CurrentPartStoredAt, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.StoredAtLabel}" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    MinWidth="160"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="PartPictureManagerPage_ChoosePictureButton"
                    AutomationProperties.Name="{x:Bind ViewModel.PictureActionLabel, Mode=OneWay}"
                    Click="ChoosePicture_Click"
                    Content="{x:Bind ViewModel.PictureActionLabel, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Spacing="8">
            <InfoBar
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />
            <InfoBar
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="Informational" />
        </StackPanel>

        <!-- The change record, and the parts still to photograph -->
        <Grid Grid.Row="4" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.HistoryTitle}" />

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.HistoryEmptyText}"
                    Visibility="{x:Bind ViewModel.HistoryEmptyVisibility, Mode=OneWay}" />

                <ListView
                    AutomationProperties.AutomationId="PartPictureManagerPage_ChangeRecord"
                    AutomationProperties.Name="{x:Bind ViewModel.HistoryTitle}"
                    ItemsSource="{x:Bind ViewModel.ChangeRecord}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PartPictureChangeDisplay">
                            <StackPanel Margin="0,0,0,8" Spacing="2">
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Detail}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.MissingTitle}" />

                    <Button
                        Grid.Column="1"
                        AutomationProperties.AutomationId="PartPictureManagerPage_ExportButton"
                        AutomationProperties.Name="{x:Bind ViewModel.ExportLabel}"
                        Click="Export_Click"
                        Content="{x:Bind ViewModel.ExportLabel}" />
                </Grid>

                <TextBlock
                    AutomationProperties.AutomationId="PartPictureManagerPage_MissingCount"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.MissingCountText, Mode=OneWay}" />

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.CoverageNote, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.CoverageNoteVisibility, Mode=OneWay}" />

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.MissingEmptyText}"
                    Visibility="{x:Bind ViewModel.MissingEmptyVisibility, Mode=OneWay}" />

                <ListView
                    AutomationProperties.AutomationId="PartPictureManagerPage_MissingList"
                    AutomationProperties.Name="{x:Bind ViewModel.MissingTitle}"
                    ItemsSource="{x:Bind ViewModel.MissingParts}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PartPictureMissRow">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind PartNumber}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind RelativePath}"
                                    TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind SystemName}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
