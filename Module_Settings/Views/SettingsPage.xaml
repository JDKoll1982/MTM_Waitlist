<Page
    x:Class="MTM_Waitlist.Module_Settings.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Settings.Models"
    xmlns:sharedControls="using:MTM_Waitlist.Module_Shared.Controls"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls"
    x:Name="RootPage"
    mc:Ignorable="d">

    <!--
        The settings hub.

        This page holds no setting of its own: it offers one card per audience, and each card opens the page that
        owns those settings. The split is by who may use them, and each card is drawn from the same permission
        answers that gate the settings it leads to, so a person never sees a destination that would open empty.
    -->
    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid
            MaxWidth="1080"
            Padding="0,0,0,48"
            HorizontalAlignment="Stretch"
            RowSpacing="28">
            <StackPanel Spacing="10">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Settings" />
                <TextBlock
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Settings are grouped by who may change them. Pick the group you need."
                    TextWrapping="Wrap" />

                <!--
                    The hub's search. It finds a setting by the words a person would use and opens the page that owns
                    it, landing on the setting's own section rather than at the top of the page.
                -->
                <AutoSuggestBox
                    AutomationProperties.AutomationId="SettingsPage_SearchBox"
                    AutomationProperties.Name="Search settings"
                    Header="Search settings"
                    PlaceholderText="Search settings by name"
                    QueryIcon="Find"
                    TextChanged="OnSearchTextChanged"
                    SuggestionChosen="OnSearchSuggestionChosen"
                    QuerySubmitted="OnSearchQuerySubmitted">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="models:SettingsSearchTarget">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <sharedControls:AutoScrollTextView Text="{x:Bind Title}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Area}" />
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>

                <wct:SettingsCard
                    AutomationProperties.AutomationId="SettingsPage_GeneralEntry"
                    Header="General"
                    Description="How the app looks, whether pictures enlarge, whether a new request announces itself, and which version is installed."
                    HorizontalAlignment="Stretch"
                    IsClickEnabled="True"
                    Command="{x:Bind ViewModel.OpenGeneralSettingsCommand}">
                    <wct:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="Setting" />
                    </wct:SettingsCard.HeaderIcon>
                </wct:SettingsCard>

                <wct:SettingsCard
                    x:Name="OperationsEntryCard"
                    AutomationProperties.AutomationId="SettingsPage_OperationsEntry"
                    x:Load="{x:Bind ViewModel.IsOperationsSettingsPageAvailable, Mode=OneWay}"
                    Header="Operations"
                    Description="Work centres, dunnage visibility, hidden locations, how long a session lasts, and the minutes each item is allowed."
                    HorizontalAlignment="Stretch"
                    IsClickEnabled="True"
                    Command="{x:Bind ViewModel.OpenOperationsSettingsCommand}">
                    <wct:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="Repair" />
                    </wct:SettingsCard.HeaderIcon>
                </wct:SettingsCard>

                <wct:SettingsCard
                    x:Name="PicturesEntryCard"
                    AutomationProperties.AutomationId="SettingsPage_PicturesEntry"
                    x:Load="{x:Bind ViewModel.IsPicturesSettingsPageAvailable, Mode=OneWay}"
                    Header="Pictures"
                    Description="Which picture an item or work centre shows, where the picture files are kept, and the copies kept on this computer."
                    HorizontalAlignment="Stretch"
                    IsClickEnabled="True"
                    Command="{x:Bind ViewModel.OpenPicturesSettingsCommand}">
                    <wct:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="Pictures" />
                    </wct:SettingsCard.HeaderIcon>
                </wct:SettingsCard>

                <wct:SettingsCard
                    x:Name="DevicesEntryCard"
                    AutomationProperties.AutomationId="SettingsPage_DevicesEntry"
                    x:Load="{x:Bind ViewModel.ComputerManagement.CanManageComputers, Mode=OneWay}"
                    Header="Devices"
                    Description="The computers that may run MTM Waitlist, and what each one is called on the floor."
                    HorizontalAlignment="Stretch"
                    IsClickEnabled="True"
                    Command="{x:Bind ViewModel.OpenDevicesSettingsCommand}">
                    <wct:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="Keyboard" />
                    </wct:SettingsCard.HeaderIcon>
                </wct:SettingsCard>

                <wct:SettingsCard
                    x:Name="DiagnosticsEntryCard"
                    AutomationProperties.AutomationId="SettingsPage_DiagnosticsEntry"
                    x:Load="{x:Bind ViewModel.IsDiagnosticsSettingsPageAvailable, Mode=OneWay}"
                    Header="Diagnostics"
                    Description="The developer log, how much of it is kept, and rebuilding the cached Infor Visual data."
                    HorizontalAlignment="Stretch"
                    IsClickEnabled="True"
                    Command="{x:Bind ViewModel.OpenDiagnosticsSettingsCommand}">
                    <wct:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="Document" />
                    </wct:SettingsCard.HeaderIcon>
                </wct:SettingsCard>

                <wct:SettingsCard
                    x:Name="AdministrationEntryCard"
                    AutomationProperties.AutomationId="SettingsPage_AdministrationEntry"
                    x:Load="{x:Bind ViewModel.IsAdministrationSettingsPageAvailable, Mode=OneWay}"
                    Header="Administration"
                    Description="The people who may sign in, what each of them is allowed to do, and the lugger arrangement."
                    HorizontalAlignment="Stretch"
                    IsClickEnabled="True"
                    Command="{x:Bind ViewModel.OpenAdministrationSettingsCommand}">
                    <wct:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="Permissions" />
                    </wct:SettingsCard.HeaderIcon>
                </wct:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>