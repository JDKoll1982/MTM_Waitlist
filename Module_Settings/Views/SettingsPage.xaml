                <!-- The developer log panel from Phase 7 (US5, SC-005). Kept out of the tree for a person who
                     may not open it; the panel's own view model is what enforces the read and the copy.

                     The panel is hosted in a vertically-aligned SettingsCard, and that is load bearing rather
                     than cosmetic. A SettingsCard lays its content out to the RIGHT of its header by default
                     (ContentAlignment="Right"), and that layout sizes the content column to the content, which
                     measures it with an unbounded width. Given unbounded width the panel's entries stop
                     wrapping: each one reports the full width of its exception text - thousands of pixels for a
                     stored exception chain - the entry grows to match, the list is re-measured against the wider
                     entry, and the two never settle. The layout engine gives up with a LayoutCycleException and
                     the process ends (observed 2026-10-02, with the trace naming a Measure(infx220) and a
                     Measure(infx160) presenter holding a 6733-pixel-wide TextBlock). Vertically-aligned content
                     is given the card's own width instead, which is what the panel's wrapping text needs. -->
                <wct:SettingsExpander
                    AutomationProperties.AutomationId="SettingsPage_DeveloperLogExpander"
                    x:Name="DeveloperLogExpander"
                    x:Load="{x:Bind ViewModel.IsDeveloperLogPanelVisible, Mode=OneWay}"
                    Header="{x:Bind ViewModel.DeveloperLogPanelTitle}"
                    HorizontalAlignment="Stretch"
                    IsExpanded="True">
                    <wct:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </wct:SettingsExpander.HeaderIcon>

                    <wct:SettingsExpander.Items>
                        <wct:SettingsCard
                            ContentAlignment="Vertical"
                            HorizontalContentAlignment="Stretch">
                            <views:DeveloperLogPanelView x:Name="DeveloperLogPanel" />
                        </wct:SettingsCard>
                    </wct:SettingsExpander.Items>
                </wct:SettingsExpander>

                <!-- How much the log store keeps. Offered beside the log panel to the same person: whoever may
                     read the log is who may say how much of it is kept. This narrows or widens what is STORED, for
                     every computer — it never gates the write, which happens on every machine for every person.
                     The wrapping status line sits in a vertically-aligned card for the reason the storage panel
                     and the log panel do: a right-aligned content slot measures its content with unbounded width,
                     and wrapping text in an unbounded slot is the layout cycle recorded in the notes above. -->
                <wct:SettingsExpander
                    AutomationProperties.AutomationId="SettingsPage_LogStoreLevelExpander"
                    x:Name="LogStoreLevelExpander"
                    x:Load="{x:Bind ViewModel.IsLogStoreLevelPanelVisible, Mode=OneWay}"
                    Description="{x:Bind ViewModel.LogStoreLevelPanelDescription}"
                    Header="{x:Bind ViewModel.LogStoreLevelPanelTitle}"
                    HorizontalAlignment="Stretch"
                    IsExpanded="False">
                    <wct:SettingsExpander.HeaderIcon>
                        <SymbolIcon Symbol="Filter" />
                    </wct:SettingsExpander.HeaderIcon>

                    <wct:SettingsExpander.Items>
                        <wct:SettingsCard Header="{x:Bind ViewModel.LogStoreLevelLabel}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox
                                    AutomationProperties.AutomationId="SettingsPage_LogStoreLevelBox"
                                    AutomationProperties.Name="{x:Bind ViewModel.LogStoreLevelLabel}"
                                    MinWidth="180"
                                    ItemsSource="{x:Bind ViewModel.LogStoreLevelOptions}"
                                    SelectedItem="{x:Bind ViewModel.LogStoreMinimumLevelInput, Mode=TwoWay}" />
                                <Button
                                    AutomationProperties.AutomationId="SettingsPage_LogStoreLevelSaveButton"
                                    AutomationProperties.Name="{x:Bind ViewModel.LogStoreLevelSaveLabel}"
                                    MinWidth="110"
                                    Click="SaveLogStoreLevel_Click"
                                    Content="{x:Bind ViewModel.LogStoreLevelSaveLabel}" />
                                <ProgressRing
                                    Width="20"
                                    Height="20"
                                    IsActive="{x:Bind ViewModel.IsLogStoreBusy, Mode=OneWay}" />
                            </StackPanel>
                        </wct:SettingsCard>

                        <wct:SettingsCard
                            ContentAlignment="Vertical"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    MaxWidth="680"
                                    Text="{x:Bind ViewModel.LogStoreLevelStoreIsTruthText}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    MaxWidth="680"
                                    Text="{x:Bind ViewModel.LogStoreStatusMessage, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </wct:SettingsCard>
