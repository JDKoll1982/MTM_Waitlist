<Page
    x:Class="MTM_Waitlist.Module_Settings.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:MTM_Waitlist.Module_Core.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls"
    xmlns:xaml="using:Microsoft.UI.Xaml"
    x:Name="RootPage"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            x:Name="ContentArea"
            Margin="24"
            Spacing="24">
            <!--  SECTION 1: Personalization settings  -->
            <StackPanel Spacing="8">
                <TextBlock
                    x:Uid="Settings_Personalization"
                    FontWeight="SemiBold"
                    Style="{ThemeResource SubtitleTextBlockStyle}" />

                <!--  FIX 1: Explicitly redirect the localization engine from .Text to .Header and .Description properties  -->
                <wct:SettingsExpander Description="Choose the appearance used throughout MTM Waitlist." Header="App Theme">
                    <wct:SettingsExpander.HeaderIcon>
                        <SymbolIcon Symbol="Setting" />
                    </wct:SettingsExpander.HeaderIcon>

                    <!--  Content maps to the right-hand action slot on the header bar  -->
                    <wct:SettingsExpander.Content>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.SelectedThemeText, Mode=OneWay}" />
                    </wct:SettingsExpander.Content>

                    <wct:SettingsExpander.Items>
                        <wct:SettingsCard HorizontalContentAlignment="Center">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="50*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton
                                    x:Uid="Settings_Theme_Light"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SwitchThemeCommand}"
                                    GroupName="AppTheme"
                                    IsChecked="{x:Bind ViewModel.ElementTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light, Mode=OneWay}">
                                    <RadioButton.CommandParameter>
                                        <xaml:ElementTheme>Light</xaml:ElementTheme>
                                    </RadioButton.CommandParameter>
                                </RadioButton>
                                <RadioButton
                                    x:Uid="Settings_Theme_Dark"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SwitchThemeCommand}"
                                    GroupName="AppTheme"
                                    IsChecked="{x:Bind ViewModel.ElementTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark, Mode=OneWay}">
                                    <RadioButton.CommandParameter>
                                        <xaml:ElementTheme>Dark</xaml:ElementTheme>
                                    </RadioButton.CommandParameter>
                                </RadioButton>
                                <RadioButton
                                    x:Uid="Settings_Theme_Default"
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SwitchThemeCommand}"
                                    GroupName="AppTheme"
                                    IsChecked="{x:Bind ViewModel.ElementTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Default, Mode=OneWay}">
                                    <RadioButton.CommandParameter>
                                        <xaml:ElementTheme>Default</xaml:ElementTheme>
                                    </RadioButton.CommandParameter>
                                </RadioButton>
                            </Grid>
                        </wct:SettingsCard>

                    </wct:SettingsExpander.Items>
                </wct:SettingsExpander>

                <wct:SettingsCard>
                    <wct:SettingsCard.Header>
                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="Infor Visual Mock Data" />
                    </wct:SettingsCard.Header>
                    <wct:SettingsCard.Description>
                        <TextBlock
                            Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="Use sample data for Infor Visual lookup flows. Default: On." />
                    </wct:SettingsCard.Description>
                    <wct:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="PreviewLink" />
                    </wct:SettingsCard.HeaderIcon>
                    <wct:SettingsCard.Content>
                        <ToggleSwitch
                            IsOn="{x:Bind ViewModel.UseInforVisualMockData, Mode=TwoWay}"
                            OffContent="Off"
                            OnContent="On" />
                    </wct:SettingsCard.Content>
                </wct:SettingsCard>

                <wct:SettingsCard>
                    <wct:SettingsCard.Header>
                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="Receiving Mock Data" />
                    </wct:SettingsCard.Header>
                    <wct:SettingsCard.Description>
                        <TextBlock
                            Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="Use sample data for receiving and MySQL-backed flows. Default: Off." />
                    </wct:SettingsCard.Description>
                    <wct:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="PreviewLink" />
                    </wct:SettingsCard.HeaderIcon>
                    <wct:SettingsCard.Content>
                        <ToggleSwitch
                            IsOn="{x:Bind ViewModel.UseRecvMockData, Mode=TwoWay}"
                            OffContent="Off"
                            OnContent="On" />
                    </wct:SettingsCard.Content>
                </wct:SettingsCard>

                <wct:SettingsExpander
                    HorizontalContentAlignment="Stretch"
                    Description="Pin frequently used presses to the top of the Waitlist + modal for each computer."
                    Header="Hot Workcenters">
                    <wct:SettingsExpander.HeaderIcon>
                        <SymbolIcon Symbol="Pin" />
                    </wct:SettingsExpander.HeaderIcon>


                    <wct:SettingsExpander.Items>
                        <wct:SettingsCard HorizontalContentAlignment="Stretch">
                            <Grid
                                Padding="20"
                                HorizontalAlignment="Stretch"
                                ColumnSpacing="12"
                                RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="Computer" />
                                <ComboBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="3"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{x:Bind ViewModel.CanManageHotWorkCenters, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.AvailableWorkstations, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedWorkstation, Mode=TwoWay}" />
                                <ProgressRing
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    IsActive="{x:Bind ViewModel.IsHotWorkCentersBusy, Mode=OneWay}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="4"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Admin and lead roles can modify the hot press list for the selected computer."
                                    TextWrapping="Wrap" />

                                <Grid
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="4"
                                    HorizontalAlignment="Stretch"
                                    ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Padding="10"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <Grid RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock
                                                Grid.Row="0"
                                                FontWeight="SemiBold"
                                                Text="Hot Workcenters" />
                                            <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.HotWorkCenters, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border
                                                                Grid.Column="0"
                                                                Padding="8"
                                                                Background="{ThemeResource SystemFillColorSuccessBrush}"
                                                                CornerRadius="8">
                                                                <TextBlock Foreground="White" Text="{Binding}" />
                                                            </Border>
                                                            <Button
                                                                Grid.Column="1"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding ViewModel.RemoveHotWorkCenterCommand, ElementName=RootPage}"
                                                                CommandParameter="{Binding}"
                                                                Content="Unpin"
                                                                IsEnabled="{Binding ViewModel.CanManageHotWorkCenters, ElementName=RootPage}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>

                                    <Border
                                        Grid.Column="1"
                                        Padding="10"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <Grid RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock
                                                Grid.Row="0"
                                                FontWeight="SemiBold"
                                                Text="Other Workcenters" />
                                            <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.OtherWorkCenters, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border
                                                                Grid.Column="0"
                                                                Padding="8"
                                                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                                CornerRadius="8">
                                                                <TextBlock Text="{Binding}" />
                                                            </Border>
                                                            <Button
                                                                Grid.Column="1"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding ViewModel.AddHotWorkCenterCommand, ElementName=RootPage}"
                                                                CommandParameter="{Binding}"
                                                                Content="Pin"
                                                                IsEnabled="{Binding ViewModel.CanManageHotWorkCenters, ElementName=RootPage}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Border
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="4"
                                    Padding="10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.HotWorkCentersStatusMessage, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </wct:SettingsCard>
                    </wct:SettingsExpander.Items>
                </wct:SettingsExpander>

                <!--  Explicit standalone TextBlock mapping your localized description text cleanly below the card  -->
                <TextBlock x:Uid="Settings_Theme" Visibility="Collapsed" />
            </StackPanel>

            <!--  SECTION 2: About application configurations  -->
            <StackPanel Spacing="8">
                <TextBlock
                    x:Uid="Settings_About"
                    FontWeight="SemiBold"
                    Style="{ThemeResource SubtitleTextBlockStyle}" />

                <!--  Single card displaying current system version rules  -->
                <wct:SettingsCard>
                    <wct:SettingsCard.Header>
                        <!--  FIX 3: Embed localized TextBlocks explicitly in Header elements to absorb .Text string properties safely  -->
                        <TextBlock
                            x:Uid="Settings_About"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="App Version" />
                    </wct:SettingsCard.Header>
                    <wct:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="Important" />
                    </wct:SettingsCard.HeaderIcon>
                    <wct:SettingsCard.Content>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.VersionDescription, Mode=OneWay}" />
                    </wct:SettingsCard.Content>
                </wct:SettingsCard>

                <!--  Descriptive card holding project summaries and legal external hyperlink bindings  -->
                <wct:SettingsCard>
                    <wct:SettingsCard.Header>
                        <!--  FIX 4: Safely intercepts header strings without generating property target mismatches  -->
                        <TextBlock
                            x:Uid="Settings_About"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="About MTM Waitlist" />
                    </wct:SettingsCard.Header>
                    <wct:SettingsCard.Description>
                        <!--  FIX 5: Redirects your old .Text value straight into a compatible body wrapper element layout  -->
                        <TextBlock
                            x:Uid="Settings_AboutDescription"
                            Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="Manage waitlists and local consumer records securely." />
                    </wct:SettingsCard.Description>
                    <wct:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="ContactInfo" />
                    </wct:SettingsCard.HeaderIcon>

                    <wct:SettingsCard.Content>
                        <!--  FIX 6: Hyperlink buttons natively consume .Content strings from your localization files  -->
                        <HyperlinkButton
                            x:Uid="SettingsPage_PrivacyTermsLink"
                            VerticalAlignment="Center"
                            Content="Privacy Policy" />
                    </wct:SettingsCard.Content>
                </wct:SettingsCard>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
