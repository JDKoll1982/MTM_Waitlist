<Page
    x:Class="MTM_Waitlist.Module_Settings.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:MTM_Waitlist.Module_Core.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls"
    xmlns:xaml="using:Microsoft.UI.Xaml"
    x:Name="RootPage"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </Page.Resources>

    <ScrollViewer>
        <Grid
            x:Name="ContentArea"
            Margin="24"
            RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox
                Grid.Row="0"
                PlaceholderText="Search settings"
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Header>
                    <TextBlock Text="Search" />
                </TextBox.Header>
            </TextBox>

            <Grid
                Grid.Row="1"
                x:Name="AppearanceCategoryPanel"
                x:Load="{x:Bind ViewModel.IsAppearanceCategoryVisible, Mode=OneWay}"
                RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    FontWeight="SemiBold"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="Appearance" />

                <muxc:Expander
                    Grid.Row="1"
                    x:Name="AppearanceExpander"
                    x:Load="{x:Bind ViewModel.IsAppearancePanelVisible, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="False">
                    <muxc:Expander.Header>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Symbol="Setting" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="App Theme" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.SelectedThemeText, Mode=OneWay}" />
                        </Grid>
                    </muxc:Expander.Header>

                    <Grid
                        Margin="0,8,0,0"
                        RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Choose the appearance used throughout MTM Waitlist."
                            TextWrapping="Wrap" />

                        <Border
                            Grid.Row="1"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="50*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton
                                    x:Uid="Settings_Theme_Light"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SwitchThemeCommand}"
                                    GroupName="AppTheme"
                                    IsChecked="{x:Bind ViewModel.ElementTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light, Mode=OneWay}">
                                    <RadioButton.CommandParameter>
                                        <xaml:ElementTheme>Light</xaml:ElementTheme>
                                    </RadioButton.CommandParameter>
                                </RadioButton>
                                <RadioButton
                                    x:Uid="Settings_Theme_Dark"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SwitchThemeCommand}"
                                    GroupName="AppTheme"
                                    IsChecked="{x:Bind ViewModel.ElementTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark, Mode=OneWay}">
                                    <RadioButton.CommandParameter>
                                        <xaml:ElementTheme>Dark</xaml:ElementTheme>
                                    </RadioButton.CommandParameter>
                                </RadioButton>
                                <RadioButton
                                    x:Uid="Settings_Theme_Default"
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SwitchThemeCommand}"
                                    GroupName="AppTheme"
                                    IsChecked="{x:Bind ViewModel.ElementTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Default, Mode=OneWay}">
                                    <RadioButton.CommandParameter>
                                        <xaml:ElementTheme>Default</xaml:ElementTheme>
                                    </RadioButton.CommandParameter>
                                </RadioButton>
                            </Grid>
                        </Border>
                    </Grid>
                </muxc:Expander>
            </Grid>

            <Grid
                Grid.Row="2"
                x:Name="OperationsCategoryPanel"
                x:Load="{x:Bind ViewModel.IsOperationsCategoryVisible, Mode=OneWay}"
                RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    FontWeight="SemiBold"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="Operations" />

                <muxc:Expander
                    Grid.Row="1"
                    x:Name="MockDataExpander"
                    x:Load="{x:Bind ViewModel.IsMockDataPanelVisible, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="False">
                    <muxc:Expander.Header>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Symbol="PreviewLink" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Mock Data" />
                        </Grid>
                    </muxc:Expander.Header>

                    <Grid
                        Margin="0,8,0,0"
                        RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Control sample-data routing for lookup and receiving flows."
                            TextWrapping="Wrap" />

                        <wct:SettingsCard Grid.Row="1">
                            <wct:SettingsCard.Header>
                                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="Infor Visual Mock Data" />
                            </wct:SettingsCard.Header>
                            <wct:SettingsCard.Description>
                                <TextBlock
                                    Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Use sample data for Infor Visual lookup flows. Default: On." />
                            </wct:SettingsCard.Description>
                            <wct:SettingsCard.Content>
                                <ToggleSwitch
                                    IsOn="{x:Bind ViewModel.UseInforVisualMockData, Mode=TwoWay}"
                                    OffContent="Off"
                                    OnContent="On" />
                            </wct:SettingsCard.Content>
                        </wct:SettingsCard>

                        <wct:SettingsCard Grid.Row="2">
                            <wct:SettingsCard.Header>
                                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="Receiving Mock Data" />
                            </wct:SettingsCard.Header>
                            <wct:SettingsCard.Description>
                                <TextBlock
                                    Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Use sample data for receiving and MySQL-backed flows. Default: Off." />
                            </wct:SettingsCard.Description>
                            <wct:SettingsCard.Content>
                                <ToggleSwitch
                                    IsOn="{x:Bind ViewModel.UseRecvMockData, Mode=TwoWay}"
                                    OffContent="Off"
                                    OnContent="On" />
                            </wct:SettingsCard.Content>
                        </wct:SettingsCard>
                    </Grid>
                </muxc:Expander>

                <muxc:Expander
                    Grid.Row="2"
                    x:Name="ImageLocationSettingsExpander"
                    x:Load="{x:Bind ViewModel.IsImageLocationSettingsPanelVisible, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="False"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="0">
                    <muxc:Expander.Header>
                        <Grid
                            Padding="16,12,16,12"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Symbol="Pictures" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Image Location Settings" />
                        </Grid>
                    </muxc:Expander.Header>

                    <Grid
                        Margin="0,8,0,0"
                        Padding="16,0,16,16"
                        RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Manage request type, work-center, and subtype image overrides for authorized staff."
                            TextWrapping="Wrap" />

                        <wct:SettingsCard Grid.Row="1">
                            <wct:SettingsCard.Header>
                                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="Request Type Images" />
                            </wct:SettingsCard.Header>
                            <wct:SettingsCard.Description>
                                <TextBlock
                                    Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Manage the default visuals used for request type cards and summaries." />
                            </wct:SettingsCard.Description>
                            <wct:SettingsCard.Content>
                                <Button
                                    MinWidth="120"
                                    Content="Manage"
                                    Click="RequestTypeImages_Click"
                                    AutomationProperties.Name="Manage request type images" />
                            </wct:SettingsCard.Content>
                        </wct:SettingsCard>

                        <wct:SettingsCard Grid.Row="2">
                            <wct:SettingsCard.Header>
                                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="Work Center Images" />
                            </wct:SettingsCard.Header>
                            <wct:SettingsCard.Description>
                                <TextBlock
                                    Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Review and override the images used for active work-center selections and detail pages." />
                            </wct:SettingsCard.Description>
                            <wct:SettingsCard.Content>
                                <Button
                                    MinWidth="120"
                                    Content="Manage"
                                    Click="WorkCenterImages_Click"
                                    AutomationProperties.Name="Manage work center images" />
                            </wct:SettingsCard.Content>
                        </wct:SettingsCard>

                        <wct:SettingsCard Grid.Row="3">
                            <wct:SettingsCard.Header>
                                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="Request Subtype Images" />
                            </wct:SettingsCard.Header>
                            <wct:SettingsCard.Description>
                                <TextBlock
                                    Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Assign subtype-specific artwork while preserving the inherited fallback chain." />
                            </wct:SettingsCard.Description>
                            <wct:SettingsCard.Content>
                                <Button
                                    MinWidth="120"
                                    Content="Manage"
                                    Click="RequestSubtypeImages_Click"
                                    AutomationProperties.Name="Manage request subtype images" />
                            </wct:SettingsCard.Content>
                        </wct:SettingsCard>
                    </Grid>
                </muxc:Expander>

                <muxc:Expander
                    Grid.Row="3"
                    x:Name="HotWorkCentersExpander"
                    x:Load="{x:Bind ViewModel.IsHotWorkCentersPanelVisible, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="False">
                    <muxc:Expander.Header>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Symbol="Pin" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Local Work Centers" />
                        </Grid>
                    </muxc:Expander.Header>

                    <Grid
                        Margin="0,8,0,0"
                        Padding="20"
                        HorizontalAlignment="Stretch"
                        ColumnSpacing="12"
                        RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Computer" />
                        <ComboBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Grid.ColumnSpan="3"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind ViewModel.CanManageHotWorkCenters, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.AvailableWorkstations, Mode=OneWay}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Key"
                            SelectedValue="{x:Bind ViewModel.SelectedWorkstation, Mode=TwoWay}" />
                        <ProgressRing
                            Grid.Row="0"
                            Grid.Column="2"
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            IsActive="{x:Bind ViewModel.IsHotWorkCentersBusy, Mode=OneWay}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="4"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Admin and lead roles can modify the Local press list for the selected computer."
                            TextWrapping="Wrap" />

                        <Grid
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="4"
                            HorizontalAlignment="Stretch"
                            ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Padding="10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        FontWeight="SemiBold"
                                        Text="Local Work Centers" />
                                    <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.HotWorkCenters, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Grid.Column="0"
                                                        Padding="8"
                                                        Background="{ThemeResource SystemFillColorSuccessBrush}"
                                                        CornerRadius="8">
                                                        <TextBlock Foreground="White" Text="{Binding}" />
                                                    </Border>
                                                    <Button
                                                        Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding ViewModel.RemoveHotWorkCenterCommand, ElementName=RootPage}"
                                                        CommandParameter="{Binding}"
                                                        Content="Unpin"
                                                        IsEnabled="{Binding ViewModel.CanManageHotWorkCenters, ElementName=RootPage}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Padding="10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        FontWeight="SemiBold"
                                        Text="Other Workcenters" />
                                    <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.OtherWorkCenters, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Grid.Column="0"
                                                        Padding="8"
                                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                        CornerRadius="8">
                                                        <TextBlock Text="{Binding}" />
                                                    </Border>
                                                    <Button
                                                        Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding ViewModel.AddHotWorkCenterCommand, ElementName=RootPage}"
                                                        CommandParameter="{Binding}"
                                                        Content="Pin"
                                                        IsEnabled="{Binding ViewModel.CanManageHotWorkCenters, ElementName=RootPage}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border
                            Grid.Row="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="4"
                            Padding="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.HotWorkCentersStatusMessage, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </muxc:Expander>

                <muxc:Expander
                    Grid.Row="4"
                    x:Name="DunnageTypeVisibilityExpander"
                    x:Load="{x:Bind ViewModel.IsDunnageTypeVisibilityPanelVisible, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="False">
                    <muxc:Expander.Header>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Symbol="Library" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Dunnage Type Visibility" />
                        </Grid>
                    </muxc:Expander.Header>

                    <Grid
                        Margin="0,8,0,0"
                        Padding="20"
                        HorizontalAlignment="Stretch"
                        RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            Grid.Row="0"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Choose which MTM Receiving Application dunnage types are visible in this app."
                                TextWrapping="Wrap" />
                            <ProgressRing
                                Grid.Column="1"
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                IsActive="{x:Bind ViewModel.IsDunnageTypeVisibilityBusy, Mode=OneWay}" />
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Padding="10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        FontWeight="SemiBold"
                                        Text="Shown Dunnage Types" />
                                    <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.VisibleDunnageTypes, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Grid.Column="0"
                                                        Padding="8"
                                                        Background="{ThemeResource SystemFillColorSuccessBrush}"
                                                        CornerRadius="8">
                                                        <TextBlock Foreground="White" Text="{Binding Name}" />
                                                    </Border>
                                                    <Button
                                                        Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding ViewModel.HideDunnageTypeCommand, ElementName=RootPage}"
                                                        CommandParameter="{Binding Id}"
                                                        Content="Hide"
                                                        IsEnabled="{Binding ViewModel.CanManageDunnageTypeVisibility, ElementName=RootPage}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Padding="10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        FontWeight="SemiBold"
                                        Text="Hidden Dunnage Types" />
                                    <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.HiddenDunnageTypes, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Grid.Column="0"
                                                        Padding="8"
                                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                        CornerRadius="8">
                                                        <TextBlock Text="{Binding Name}" />
                                                    </Border>
                                                    <Button
                                                        Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding ViewModel.ShowDunnageTypeCommand, ElementName=RootPage}"
                                                        CommandParameter="{Binding Id}"
                                                        Content="Show"
                                                        IsEnabled="{Binding ViewModel.CanManageDunnageTypeVisibility, ElementName=RootPage}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border
                            Grid.Row="2"
                            Padding="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.DunnageTypeVisibilityStatusMessage, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </muxc:Expander>

                <muxc:Expander
                    Grid.Row="5"
                    x:Name="ComputersExpander"
                    x:Load="{x:Bind ViewModel.IsComputersPanelVisible, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="False">
                    <muxc:Expander.Header>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Symbol="Setting" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Computers" />
                        </Grid>
                    </muxc:Expander.Header>

                    <Grid
                        Margin="0,8,0,0"
                        Padding="20"
                        HorizontalAlignment="Stretch"
                        ColumnSpacing="12"
                        RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Manage the computers registered on the shop floor. Restricted to Admin and Developer roles."
                            TextWrapping="Wrap" />

                        <Grid
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Stretch"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="1"
                                Content="Add"
                                Click="AddComputer_Click"
                                IsEnabled="{x:Bind ViewModel.ComputerManagement.CanManageComputers, Mode=OneWay}" />
                            <Button
                                Grid.Column="2"
                                Content="Edit"
                                Click="EditComputer_Click"
                                IsEnabled="{x:Bind ViewModel.ComputerManagement.CanEditSelected, Mode=OneWay}" />
                        </Grid>

                        <Border
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Padding="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        FontWeight="SemiBold"
                                        Text="Registered Computers" />
                                    <ProgressRing
                                        Grid.Column="1"
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        IsActive="{x:Bind ViewModel.ComputerManagement.IsBusy, Mode=OneWay}" />
                                </Grid>

                                <ListView
                                    Grid.Row="1"
                                    MaxHeight="320"
                                    ItemsSource="{x:Bind ViewModel.ComputerManagement.Computers, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.ComputerManagement.SelectedComputer, Mode=TwoWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="4" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding ComputerName}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding MacAddressNormalized}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding ViewModel.ComputerManagement.DeleteCommand, ElementName=RootPage}"
                                                    CommandParameter="{Binding}"
                                                    Content="Delete"
                                                    Visibility="{Binding IsCurrentComputer, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <TextBlock
                                    Grid.Row="2"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.ComputerManagement.StatusMessage, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </Grid>
                </muxc:Expander>
            </Grid>

            <Grid
                Grid.Row="3"
                x:Name="AboutCategoryPanel"
                x:Load="{x:Bind ViewModel.IsAboutCategoryVisible, Mode=OneWay}"
                RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    x:Uid="Settings_About"
                    FontWeight="SemiBold"
                    Style="{ThemeResource SubtitleTextBlockStyle}" />

                <muxc:Expander
                    Grid.Row="1"
                    x:Name="AboutExpander"
                    x:Load="{x:Bind ViewModel.IsAboutPanelVisible, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="False">
                    <muxc:Expander.Header>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Symbol="ContactInfo" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="About / App Info" />
                        </Grid>
                    </muxc:Expander.Header>

                    <Grid
                        Margin="0,8,0,0"
                        RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <wct:SettingsCard Grid.Row="0">
                            <wct:SettingsCard.Header>
                                <TextBlock
                                    x:Uid="Settings_About"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="App Version" />
                            </wct:SettingsCard.Header>
                            <wct:SettingsCard.HeaderIcon>
                                <SymbolIcon Symbol="Important" />
                            </wct:SettingsCard.HeaderIcon>
                            <wct:SettingsCard.Content>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{x:Bind ViewModel.VersionDescription, Mode=OneWay}" />
                            </wct:SettingsCard.Content>
                        </wct:SettingsCard>

                        <wct:SettingsCard Grid.Row="1">
                            <wct:SettingsCard.Header>
                                <TextBlock
                                    x:Uid="Settings_About"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="About MTM Waitlist" />
                            </wct:SettingsCard.Header>
                            <wct:SettingsCard.Description>
                                <TextBlock
                                    x:Uid="Settings_AboutDescription"
                                    Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Manage waitlists and local consumer records securely." />
                            </wct:SettingsCard.Description>
                            <wct:SettingsCard.HeaderIcon>
                                <SymbolIcon Symbol="ContactInfo" />
                            </wct:SettingsCard.HeaderIcon>
                            <wct:SettingsCard.Content>
                                <HyperlinkButton
                                    x:Uid="SettingsPage_PrivacyTermsLink"
                                    VerticalAlignment="Center"
                                    Content="Privacy Policy" />
                            </wct:SettingsCard.Content>
                        </wct:SettingsCard>
                    </Grid>
                </muxc:Expander>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
