<Page
    x:Class="MTM_Waitlist.Module_Settings.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:MTM_Waitlist.Module_Core.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls"
    xmlns:xaml="using:Microsoft.UI.Xaml"
    x:Name="RootPage"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />

        <!--
            Settings page typography and row chrome.

            Every description and status line on the page uses SettingsDescriptionStyle, and every
            value pill in a two-column pick list uses SettingsListPillStyle. Section headings use the
            platform BodyStrong style directly. Keeping these three in one place is what stops the
            page drifting back into a mix of margins, brushes and font sizes.
        -->
        <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingsListPillStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,6,10,6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <!--
        Page frame.

        The shell already insets page content (NavigationViewPageContentMargin), so this page adds no
        outer margin of its own. Instead it keeps one scrollable, centred column capped at 1080px, which
        is the width the Windows app-settings guidance recommends for readability on wide displays.
        Sections are stacked top to bottom (never a row grid), so a panel can no longer be clamped on to
        the last row and silently stack on top of its neighbour.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid
            x:Name="ContentArea"
            MaxWidth="1080"
            Padding="0,0,0,48"
            HorizontalAlignment="Stretch"
            RowSpacing="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search -->
            <TextBox
                AutomationProperties.AutomationId="SettingsPage_SearchBox"
                Grid.Row="0"
                Header="Search"
                PlaceholderText="Search settings"
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Appearance -->
            <StackPanel
                Grid.Row="1"
                x:Name="AppearanceCategoryPanel"
                x:Load="{x:Bind ViewModel.IsAppearanceCategoryVisible, Mode=OneWay}"
                Spacing="8">

                <TextBlock
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Appearance" />

                <wct:SettingsExpander
                    AutomationProperties.AutomationId="SettingsPage_AppearanceExpander"
                    x:Name="AppearanceExpander"
                    x:Load="{x:Bind ViewModel.IsAppearancePanelVisible, Mode=OneWay}"
                    Description="Choose the appearance used throughout MTM Waitlist."
                    Header="App Theme"
                    HorizontalAlignment="Stretch"
                    IsExpanded="False">
                    <wct:SettingsExpander.HeaderIcon>
                        <SymbolIcon Symbol="Setting" />
                    </wct:SettingsExpander.HeaderIcon>

                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.SelectedThemeText, Mode=OneWay}" />

                    <wct:SettingsExpander.Items>
                        <wct:SettingsCard
                            Description="Light, dark, or the default that follows Windows."
                            Header="Theme">
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <RadioButton
                                    AutomationProperties.AutomationId="SettingsPage_ThemeLightOption"
                                    x:Uid="Settings_Theme_Light"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SwitchThemeCommand}"
                                    GroupName="AppTheme"
                                    IsChecked="{x:Bind ViewModel.ElementTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light, Mode=OneWay}">
                                    <RadioButton.CommandParameter>
                                        <xaml:ElementTheme>Light</xaml:ElementTheme>
                                    </RadioButton.CommandParameter>
                                </RadioButton>
                                <RadioButton
                                    AutomationProperties.AutomationId="SettingsPage_ThemeDarkOption"
                                    x:Uid="Settings_Theme_Dark"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SwitchThemeCommand}"
                                    GroupName="AppTheme"
                                    IsChecked="{x:Bind ViewModel.ElementTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark, Mode=OneWay}">
                                    <RadioButton.CommandParameter>
                                        <xaml:ElementTheme>Dark</xaml:ElementTheme>
                                    </RadioButton.CommandParameter>
                                </RadioButton>
                                <RadioButton
                                    AutomationProperties.AutomationId="SettingsPage_ThemeDefaultOption"
                                    x:Uid="Settings_Theme_Default"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SwitchThemeCommand}"
                                    GroupName="AppTheme"
                                    IsChecked="{x:Bind ViewModel.ElementTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Default, Mode=OneWay}">
                                    <RadioButton.CommandParameter>
                                        <xaml:ElementTheme>Default</xaml:ElementTheme>
                                    </RadioButton.CommandParameter>
                                </RadioButton>
                            </StackPanel>
                        </wct:SettingsCard>
                    </wct:SettingsExpander.Items>
                </wct:SettingsExpander>
            </StackPanel>

            <!-- Operations -->
            <StackPanel
                Grid.Row="2"
                x:Name="OperationsCategoryPanel"
                x:Load="{x:Bind ViewModel.IsOperationsCategoryVisible, Mode=OneWay}"
                Spacing="8">

                <TextBlock
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Operations" />

                <!-- Part pictures (008-part-pictures). Offered only to an account holding the picture entitlement;
                     the gate is the permission key, read from the store, not a list of role names. -->
                <wct:SettingsCard
                    x:Name="PartPicturesEntryCard"
                    x:Load="{x:Bind ViewModel.IsPartPicturesEntryVisible, Mode=OneWay}"
                    AutomationProperties.AutomationId="SettingsPage_PartPicturesEntry"
                    AutomationProperties.Name="{x:Bind ViewModel.PartPicturesEntryTitle}"
                    HorizontalAlignment="Stretch"
                    IsClickEnabled="True"
                    Command="{x:Bind ViewModel.OpenPartPicturesCommand}">
                    <wct:SettingsCard.Header>
                        <TextBlock Text="{x:Bind ViewModel.PartPicturesEntryTitle}" />
                    </wct:SettingsCard.Header>
                    <wct:SettingsCard.Description>
                        <TextBlock Text="{x:Bind ViewModel.PartPicturesEntryDescription}" />
                    </wct:SettingsCard.Description>
                    <wct:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="Pictures" />
                    </wct:SettingsCard.HeaderIcon>
                </wct:SettingsCard>

                <!-- Image location settings -->
                <wct:SettingsExpander
                    AutomationProperties.AutomationId="SettingsPage_ImageLocationExpander"
                    x:Name="ImageLocationSettingsExpander"
                    x:Load="{x:Bind ViewModel.IsImageLocationSettingsPanelVisible, Mode=OneWay}"
                    Description="Manage the default visuals used for item and work-center image overrides for authorized staff."
                    Header="Image Location Settings"
                    HorizontalAlignment="Stretch"
                    IsExpanded="False">
                    <wct:SettingsExpander.HeaderIcon>
                        <SymbolIcon Symbol="Pictures" />
                    </wct:SettingsExpander.HeaderIcon>

                    <wct:SettingsExpander.Items>
                        <wct:SettingsCard
                            Description="Manage the picture each item uses. An item with no picture of its own shows its category's picture, so nothing configured for the item replaces a picture the request already resolves."
                            Header="Item Images">
                            <Button
                                AutomationProperties.AutomationId="SettingsPage_Images_ManageItemsButton"
                                AutomationProperties.Name="Manage request item images"
                                MinWidth="120"
                                Click="RequestItemImages_Click"
                                Content="Manage items" />
                        </wct:SettingsCard>

                        <wct:SettingsCard
                            Description="Review and override the images used for active work-center selections and detail pages."
                            Header="Work Center Images">
                            <Button
                                AutomationProperties.AutomationId="SettingsPage_Images_ManageWorkCentersButton"
                                AutomationProperties.Name="Manage work center images"
                                MinWidth="120"
                                Click="WorkCenterImages_Click"
                                Content="Manage" />
                        </wct:SettingsCard>
                    </wct:SettingsExpander.Items>
                </wct:SettingsExpander>

                <!-- Where pictures are kept (008-part-pictures, T022). The picture folder, the key folder and the
                     period a replaced picture is kept, on the storage entitlement rather than the picture
                     entitlement, because FR-017 reserves the folders to IT Department and Developer while FR-025
                     widens the picture entitlement past them. -->
                <wct:SettingsExpander
                    AutomationProperties.AutomationId="SettingsPage_StoragePathsExpander"
                    x:Name="StoragePathsExpander"
                    x:Load="{x:Bind ViewModel.IsStoragePathsPanelVisible, Mode=OneWay}"
                    Description="{x:Bind ViewModel.StoragePathsPanelDescription}"
                    Header="{x:Bind ViewModel.StoragePathsPanelTitle}"
                    HorizontalAlignment="Stretch"
                    IsExpanded="False">
                    <wct:SettingsExpander.HeaderIcon>
                        <SymbolIcon Symbol="Folder" />
                    </wct:SettingsExpander.HeaderIcon>

                    <wct:SettingsExpander.Items>
                        <wct:SettingsCard Header="{x:Bind ViewModel.StoragePathsImageFolderLabel}">
                            <TextBox
                                AutomationProperties.AutomationId="SettingsPage_StoragePaths_ImageFolderBox"
                                AutomationProperties.Name="{x:Bind ViewModel.StoragePathsImageFolderLabel}"
                                MinWidth="420"
                                Text="{x:Bind ViewModel.PictureFolderInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </wct:SettingsCard>

                        <wct:SettingsCard Header="{x:Bind ViewModel.StoragePathsKeysFolderLabel}">
                            <TextBox
                                AutomationProperties.AutomationId="SettingsPage_StoragePaths_KeysFolderBox"
                                AutomationProperties.Name="{x:Bind ViewModel.StoragePathsKeysFolderLabel}"
                                MinWidth="420"
                                Text="{x:Bind ViewModel.KeysFolderInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </wct:SettingsCard>

                        <wct:SettingsCard Header="{x:Bind ViewModel.StoragePathsArchiveKeepDaysLabel}">
                            <NumberBox
                                AutomationProperties.AutomationId="SettingsPage_StoragePaths_KeepDaysBox"
                                AutomationProperties.Name="{x:Bind ViewModel.StoragePathsArchiveKeepDaysLabel}"
                                MinWidth="140"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.ArchiveKeepDaysInput, Mode=TwoWay}" />
                        </wct:SettingsCard>

                        <wct:SettingsCard
                            ContentAlignment="Vertical"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        AutomationProperties.AutomationId="SettingsPage_StoragePaths_SaveButton"
                                        AutomationProperties.Name="{x:Bind ViewModel.StoragePathsSaveLabel}"
                                        MinWidth="150"
                                        Click="SaveStoragePaths_Click"
                                        Content="{x:Bind ViewModel.StoragePathsSaveLabel}" />
                                    <ProgressRing
                                        Width="20"
                                        Height="20"
                                        IsActive="{x:Bind ViewModel.IsStoragePathsBusy, Mode=OneWay}" />
                                </StackPanel>

                                <TextBlock
                                    MaxWidth="680"
                                    Text="{x:Bind ViewModel.StoragePathsStoreIsTruthText}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    MaxWidth="680"
                                    Text="{x:Bind ViewModel.StoragePathsDisagreementMessage, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.StoragePathsDisagreementVisibility, Mode=OneWay}" />

                                <TextBlock
                                    MaxWidth="680"
                                    Text="{x:Bind ViewModel.StoragePathsStatusMessage, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </wct:SettingsCard>
                    </wct:SettingsExpander.Items>
                </wct:SettingsExpander>

                <!-- Picture cache -->
                <wct:SettingsExpander
                    AutomationProperties.AutomationId="SettingsPage_PictureCacheExpander"
                    x:Name="PictureCacheExpander"
                    x:Load="{x:Bind ViewModel.IsPictureCachePanelVisible, Mode=OneWay}"
                    Description="Pictures are copied onto this computer when the application starts, so the waitlist draws them from local disk instead of reaching across the network for each one. A picture that has changed on the share is copied again, and a copy whose picture has gone is removed. Nothing else is touched."
                    Header="Picture Cache"
                    HorizontalAlignment="Stretch"
                    IsExpanded="False">
                    <wct:SettingsExpander.HeaderIcon>
                        <SymbolIcon Symbol="Download" />
                    </wct:SettingsExpander.HeaderIcon>

                    <wct:SettingsExpander.Items>
                        <wct:SettingsCard
                            Description="Applies to every computer, not just this one. Turned off, pictures are read from the network share."
                            Header="Cache pictures on this computer">
                            <ToggleSwitch
                                AutomationProperties.AutomationId="SettingsPage_PictureCache_Toggle"
                                AutomationProperties.Name="Cache pictures on this computer"
                                IsOn="{x:Bind ViewModel.IsPictureCacheEnabled, Mode=TwoWay}"
                                OffContent="Off"
                                OnContent="On" />
                        </wct:SettingsCard>

                        <wct:SettingsCard
                            Description="Where the copies are kept. Each picture keeps the folder it has on the share, so the two trees read the same way."
                            Header="Cache folder">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox
                                    AutomationProperties.AutomationId="SettingsPage_PictureCache_FolderBox"
                                    AutomationProperties.Name="Picture cache folder"
                                    MinWidth="320"
                                    PlaceholderText="%LOCALAPPDATA%\MTM_Waitlist\ImageCache"
                                    Text="{x:Bind ViewModel.PictureCacheFolderInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    AutomationProperties.AutomationId="SettingsPage_PictureCache_SaveFolderButton"
                                    AutomationProperties.Name="Save picture cache folder"
                                    MinWidth="90"
                                    Click="SavePictureCacheFolder_Click"
                                    Content="Save" />
                            </StackPanel>
                        </wct:SettingsCard>

                        <wct:SettingsCard
                            Description="Runs the same copy the application runs when it starts, without waiting for a restart."
                            Header="Copy pictures now">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="SettingsPage_PictureCache_RefreshButton"
                                    AutomationProperties.Name="Copy pictures now"
                                    MinWidth="110"
                                    Click="RefreshPictureCache_Click"
                                    Content="Copy now" />
                                <ProgressRing
                                    Width="20"
                                    Height="20"
                                    IsActive="{x:Bind ViewModel.IsPictureCacheBusy, Mode=OneWay}" />
                                <TextBlock
                                    MaxWidth="420"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ViewModel.PictureCacheStatusMessage, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </wct:SettingsCard>
                    </wct:SettingsExpander.Items>
                </wct:SettingsExpander>

                <!-- Local work centers -->
                <wct:SettingsExpander
                    AutomationProperties.AutomationId="SettingsPage_LocalWorkCentersExpander"
                    x:Name="HotWorkCentersExpander"
                    x:Load="{x:Bind ViewModel.IsHotWorkCentersPanelVisible, Mode=OneWay}"
                    Description="Admin and lead roles can modify the Local press list for the selected computer."
                    Header="Local Work Centers"
                    HorizontalAlignment="Stretch"
                    IsExpanded="False">
                    <wct:SettingsExpander.HeaderIcon>
                        <SymbolIcon Symbol="Pin" />
                    </wct:SettingsExpander.HeaderIcon>

                    <ProgressRing
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsHotWorkCentersBusy, Mode=OneWay}" />

                    <wct:SettingsExpander.Items>
                        <wct:SettingsCard
                            Description="Select the computer whose Local press list you are editing."
                            Header="Computer">
                            <ComboBox
                                AutomationProperties.AutomationId="SettingsPage_HotWorkCenters_ComputerCombo"
                                MinWidth="280"
                                DisplayMemberPath="Label"
                                IsEnabled="{x:Bind ViewModel.CanManageHotWorkCenters, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.AvailableWorkstations, Mode=OneWay}"
                                SelectedValue="{x:Bind ViewModel.SelectedWorkstation, Mode=TwoWay}"
                                SelectedValuePath="Key" />
                        </wct:SettingsCard>

                        <wct:SettingsCard
                            Header="Press list"
                            ContentAlignment="Vertical"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel
                                        Grid.Column="0"
                                        Spacing="8">
                                        <TextBlock
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="Local Work Centers" />
                                        <ItemsControl AutomationProperties.AutomationId="SettingsPage_HotWorkCentersList" ItemsSource="{x:Bind ViewModel.HotWorkCenters, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid
                                                        Margin="0,0,0,8"
                                                        ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border
                                                            Grid.Column="0"
                                                            Style="{StaticResource SettingsListPillStyle}"
                                                            Background="{ThemeResource SystemFillColorSuccessBrush}">
                                                            <TextBlock Foreground="White" Text="{Binding}" />
                                                        </Border>
                                                        <Button
                                                            AutomationProperties.Name="{Binding}"
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding ViewModel.RemoveHotWorkCenterCommand, ElementName=RootPage}"
                                                            CommandParameter="{Binding}"
                                                            Content="Unpin"
                                                            IsEnabled="{Binding ViewModel.CanManageHotWorkCenters, ElementName=RootPage}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        Spacing="8">
                                        <TextBlock
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="Other Workcenters" />
                                        <ItemsControl AutomationProperties.AutomationId="SettingsPage_OtherWorkCentersList" ItemsSource="{x:Bind ViewModel.OtherWorkCenters, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid
                                                        Margin="0,0,0,8"
                                                        ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border
                                                            Grid.Column="0"
                                                            Style="{StaticResource SettingsListPillStyle}"
                                                            Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                                            <TextBlock Text="{Binding}" />
                                                        </Border>
                                                        <Button
                                                            AutomationProperties.Name="{Binding}"
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding ViewModel.AddHotWorkCenterCommand, ElementName=RootPage}"
                                                            CommandParameter="{Binding}"
                                                            Content="Pin"
                                                            IsEnabled="{Binding ViewModel.CanManageHotWorkCenters, ElementName=RootPage}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    Style="{StaticResource SettingsDescriptionStyle}"
                                    Text="{x:Bind ViewModel.HotWorkCentersStatusMessage, Mode=OneWay}" />
                            </StackPanel>
                        </wct:SettingsCard>
                    </wct:SettingsExpander.Items>
                </wct:SettingsExpander>

                <!-- Dunnage type visibility -->
                <wct:SettingsExpander
                    AutomationProperties.AutomationId="SettingsPage_DunnageVisibilityExpander"
                    x:Name="DunnageTypeVisibilityExpander"
                    x:Load="{x:Bind ViewModel.IsDunnageTypeVisibilityPanelVisible, Mode=OneWay}"
                    Description="Choose which MTM Receiving Application dunnage types are visible in this app."
                    Header="Dunnage Type Visibility"
                    HorizontalAlignment="Stretch"
                    IsExpanded="False">
                    <wct:SettingsExpander.HeaderIcon>
                        <SymbolIcon Symbol="Library" />
                    </wct:SettingsExpander.HeaderIcon>

                    <ProgressRing
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsDunnageTypeVisibilityBusy, Mode=OneWay}" />

                    <wct:SettingsExpander.Items>
                        <wct:SettingsCard
                            Header="Dunnage types"
                            ContentAlignment="Vertical"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel
                                        Grid.Column="0"
                                        Spacing="8">
                                        <TextBlock
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="Shown Dunnage Types" />
                                        <!--
                                            Every shown type is the shared card, so this list answers the picture question the way the
                                            other converted lists do. Hiding a type is the card's action and is unchanged.
                                        -->
                                        <GridView
                                            AutomationProperties.AutomationId="SettingsPage_VisibleDunnageTypesList"
                                            ItemsSource="{x:Bind ViewModel.VisibleDunnageTypes, Mode=OneWay}"
                                            IsItemClickEnabled="False"
                                            SelectionMode="None">
                                            <GridView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </GridView.ItemsPanel>
                                            <GridView.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel
                                                        Margin="0,0,0,8"
                                                        HorizontalAlignment="Center"
                                                        Spacing="6">
                                                        <ContentControl
                                                            HorizontalContentAlignment="Stretch"
                                                            Content="{Binding}"
                                                            ContentTemplate="{StaticResource PartPictureCardTemplate}" />
                                                        <Button
                                                            AutomationProperties.Name="{Binding Name}"
                                                            HorizontalAlignment="Center"
                                                            Command="{Binding ViewModel.HideDunnageTypeCommand, ElementName=RootPage}"
                                                            CommandParameter="{Binding Id}"
                                                            Content="Hide"
                                                            IsEnabled="{Binding ViewModel.CanManageDunnageTypeVisibility, ElementName=RootPage}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        Spacing="8">
                                        <TextBlock
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="Hidden Dunnage Types" />
                                        <!-- The hidden types are the same card, with showing a type as the card's action. -->
                                        <GridView
                                            AutomationProperties.AutomationId="SettingsPage_HiddenDunnageTypesList"
                                            ItemsSource="{x:Bind ViewModel.HiddenDunnageTypes, Mode=OneWay}"
                                            IsItemClickEnabled="False"
                                            SelectionMode="None">
                                            <GridView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </GridView.ItemsPanel>
                                            <GridView.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel
                                                        Margin="0,0,0,8"
                                                        HorizontalAlignment="Center"
                                                        Spacing="6">
                                                        <ContentControl
                                                            HorizontalContentAlignment="Stretch"
                                                            Content="{Binding}"
                                                            ContentTemplate="{StaticResource PartPictureCardTemplate}" />
                                                        <Button
                                                            AutomationProperties.Name="{Binding Name}"
                                                            HorizontalAlignment="Center"
                                                            Command="{Binding ViewModel.ShowDunnageTypeCommand, ElementName=RootPage}"
                                                            CommandParameter="{Binding Id}"
                                                            Content="Show"
                                                            IsEnabled="{Binding ViewModel.CanManageDunnageTypeVisibility, ElementName=RootPage}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    Style="{StaticResource SettingsDescriptionStyle}"
                                    Text="{x:Bind ViewModel.DunnageTypeVisibilityStatusMessage, Mode=OneWay}" />
                            </StackPanel>
                        </wct:SettingsCard>
                    </wct:SettingsExpander.Items>
                </wct:SettingsExpander>

                <!-- Computers -->
                <wct:SettingsExpander
                    AutomationProperties.AutomationId="SettingsPage_ComputersExpander"
                    x:Name="ComputersExpander"
                    x:Load="{x:Bind ViewModel.IsComputersPanelVisible, Mode=OneWay}"
                    Description="Manage the computers registered on the shop floor. Restricted to Admin and Developer roles."
                    Header="Computers"
                    HorizontalAlignment="Stretch"
                    IsExpanded="False">
                    <wct:SettingsExpander.HeaderIcon>
                        <SymbolIcon Symbol="Setting" />
                    </wct:SettingsExpander.HeaderIcon>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <ProgressRing
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            IsActive="{x:Bind ViewModel.ComputerManagement.IsBusy, Mode=OneWay}" />
                        <Button
                            AutomationProperties.AutomationId="SettingsPage_Computers_AddButton"
                            Content="Add"
                            Click="AddComputer_Click"
                            IsEnabled="{x:Bind ViewModel.ComputerManagement.CanManageComputers, Mode=OneWay}" />
                        <Button
                            AutomationProperties.AutomationId="SettingsPage_Computers_EditButton"
                            Content="Edit"
                            Click="EditComputer_Click"
                            IsEnabled="{x:Bind ViewModel.ComputerManagement.CanEditSelected, Mode=OneWay}" />
                    </StackPanel>

                    <wct:SettingsExpander.Items>
                        <wct:SettingsCard
                            Header="Registered Computers"
                            ContentAlignment="Vertical"
                            HorizontalContentAlignment="Stretch">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ListView
                                    AutomationProperties.AutomationId="SettingsPage_ComputersList"
                                    Grid.Row="0"
                                    MaxHeight="320"
                                    ItemsSource="{x:Bind ViewModel.ComputerManagement.Computers, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.ComputerManagement.SelectedComputer, Mode=TwoWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="4" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding ComputerName}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding MacAddressNormalized}" />
                                                </StackPanel>
                                                <Button
                                                    AutomationProperties.Name="{Binding DisplayName}"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding ViewModel.ComputerManagement.DeleteCommand, ElementName=RootPage}"
                                                    CommandParameter="{Binding}"
                                                    Content="Delete"
                                                    Visibility="{Binding IsCurrentComputer, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <TextBlock
                                    Grid.Row="1"
                                    Style="{StaticResource SettingsDescriptionStyle}"
                                    Text="{x:Bind ViewModel.ComputerManagement.StatusMessage, Mode=OneWay}" />
                            </Grid>
                        </wct:SettingsCard>
                    </wct:SettingsExpander.Items>
                </wct:SettingsExpander>

                <!-- Ignored Infor Visual locations -->
                <wct:SettingsExpander
                    AutomationProperties.AutomationId="SettingsPage_IgnoredLocationsExpander"
                    x:Name="IgnoredLocationsExpander"
                    x:Load="{x:Bind ViewModel.IsIgnoredLocationsPanelVisible, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    IsExpanded="False">
                    <wct:SettingsExpander.HeaderIcon>
                        <SymbolIcon Symbol="Map" />
                    </wct:SettingsExpander.HeaderIcon>

                    <wct:SettingsExpander.Header>
                        <TextBlock
                            x:Uid="Settings_IgnoredLocations_Title"
                            Text="Ignored Infor Visual Locations" />
                    </wct:SettingsExpander.Header>

                    <wct:SettingsExpander.Description>
                        <TextBlock
                            x:Uid="Settings_IgnoredLocations_Description"
                            Text="Locations omitted from inventory lists and totals (for example WC, NCM, V-WC, NCM-VITS, SHIP). Editing is limited to roles above Material Handler." />
                    </wct:SettingsExpander.Description>

                    <wct:SettingsExpander.Items>
                        <wct:SettingsCard
                            ContentAlignment="Vertical"
                            HorizontalContentAlignment="Stretch">
                            <wct:SettingsCard.Header>
                                <TextBlock
                                    x:Uid="Settings_IgnoredLocations_ListLabel"
                                    Text="Ignored locations" />
                            </wct:SettingsCard.Header>

                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid
                                    Grid.Row="0"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        AutomationProperties.AutomationId="SettingsPage_IgnoredLocations_AddInput"
                                        Grid.Column="0"
                                        x:Uid="Settings_IgnoredLocations_AddPlaceholder"
                                        IsEnabled="{x:Bind ViewModel.CanManageIgnoredLocations, Mode=OneWay}"
                                        PlaceholderText="Add location code (for example WC)"
                                        Text="{x:Bind ViewModel.IgnoredLocationInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        AutomationProperties.AutomationId="SettingsPage_IgnoredLocations_AddButton"
                                        Grid.Column="1"
                                        x:Uid="Settings_IgnoredLocations_Add"
                                        VerticalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.AddIgnoredLocationCommand}"
                                        Content="Add"
                                        IsEnabled="{x:Bind ViewModel.CanManageIgnoredLocations, Mode=OneWay}" />
                                </Grid>

                                <ItemsControl
                                    AutomationProperties.AutomationId="SettingsPage_IgnoredLocationsList"
                                    Grid.Row="1"
                                    ItemsSource="{x:Bind ViewModel.IgnoredLocations, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Margin="0,4"
                                                ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Glyph="&#xE71E;"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding}" />
                                                <Button
                                                    AutomationProperties.Name="{Binding}"
                                                    Grid.Column="2"
                                                    x:Uid="Settings_IgnoredLocations_Remove"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding ViewModel.RemoveIgnoredLocationCommand, ElementName=RootPage}"
                                                    CommandParameter="{Binding}"
                                                    Content="Remove"
                                                    IsEnabled="{Binding ViewModel.CanManageIgnoredLocations, ElementName=RootPage}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--
                                    Deliberately collapsed: the status line is reported by the remote
                                    retry flow rather than this panel, and it has never been shown here.
                                    It stays bound so the message is not lost if that changes.
                                -->
                                <TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource SettingsDescriptionStyle}"
                                    Text="{x:Bind ViewModel.IgnoredLocationsStatusMessage, Mode=OneWay}"
                                    Visibility="Collapsed" />
                            </Grid>
                        </wct:SettingsCard>
                    </wct:SettingsExpander.Items>
                </wct:SettingsExpander>

                <!-- New request alerts -->
                <wct:SettingsCard
                    AutomationProperties.AutomationId="SettingsPage_NewRequestAlertsExpander"
                    x:Name="NewRequestAlertsExpander"
                    x:Load="{x:Bind ViewModel.IsNewRequestAlertsPanelVisible, Mode=OneWay}"
                    Description="{x:Bind ViewModel.NewRequestAlertsDescription, Mode=OneWay}"
                    Header="New Request Alerts"
                    HorizontalAlignment="Stretch">
                    <wct:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEA8F;" />
                    </wct:SettingsCard.HeaderIcon>

                    <ToggleSwitch
                        AutomationProperties.AutomationId="SettingsPage_NewRequestAlerts_Toggle"
                        IsEnabled="{x:Bind ViewModel.IsNewRequestAlertsAvailable, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.NewRequestAlertsEnabled, Mode=TwoWay}"
                        OffContent="Off"
                        OnContent="On" />
                </wct:SettingsCard>

                <!-- Max allotted time -->
                <wct:SettingsExpander
                    AutomationProperties.AutomationId="SettingsPage_MaxAllottedTimeExpander"
                    x:Name="UrgencyAllotmentsExpander"
                    x:Load="{x:Bind ViewModel.IsUrgencyAllotmentsPanelVisible, Mode=OneWay}"
                    Description="Set how long (in minutes) each item has before it is considered overdue, beside the average its completed requests have actually taken. Plant Manager+ can edit; others can view."
                    Header="Max Allotted Time"
                    HorizontalAlignment="Stretch"
                    IsExpanded="False">
                    <wct:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </wct:SettingsExpander.HeaderIcon>

                    <ProgressRing
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind ViewModel.UrgencyAllotments.IsBusy, Mode=OneWay}" />

                    <wct:SettingsExpander.Items>
                        <wct:SettingsCard
                            ContentAlignment="Vertical"
                            HorizontalContentAlignment="Stretch">
                            <Grid RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--
                                    The column header and the item rows must declare the SAME column widths.
                                    An Auto column is measured per grid: it collapsed to zero width in the
                                    header (which leaves that cell empty) but held the configured/default
                                    chip in the rows, so the header's star column absorbed the difference and
                                    every fixed column to its right shifted out of line.
                                -->
                                <Grid
                                    Grid.Row="0"
                                    Margin="0,4"
                                    ColumnSpacing="12"
                                    HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        x:Uid="Settings_UrgencyAllotments_ItemColumn"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="Item" />
                                    <TextBlock
                                        Grid.Column="1"
                                        x:Uid="Settings_UrgencyAllotments_ConfiguredColumn"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="Configured minutes" />
                                    <TextBlock
                                        Grid.Column="3"
                                        x:Uid="Settings_UrgencyAllotments_ObservedColumn"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="Observed average" />
                                </Grid>

                                <ItemsControl
                                    AutomationProperties.AutomationId="SettingsPage_MinutesList"
                                    Grid.Row="1"
                                    HorizontalContentAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.UrgencyAllotments.Items, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Margin="0,4"
                                                ColumnSpacing="12"
                                                HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="170" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding DisplayName}"
                                                    TextWrapping="Wrap" />
                                                <muxc:NumberBox
                                                    AutomationProperties.Name="{Binding DisplayName}"
                                                    Grid.Column="1"
                                                    Minimum="1"
                                                    Maximum="1440"
                                                    SmallChange="5"
                                                    SpinButtonPlacementMode="Compact"
                                                    Value="{Binding Minutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    IsEnabled="{Binding ViewModel.UrgencyAllotments.CanManageUrgencySettings, ElementName=RootPage}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{Binding ConfiguredValueLabel}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding ObservedAverageText}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource SettingsDescriptionStyle}"
                                    Text="{x:Bind ViewModel.UrgencyAllotments.StatusMessage, Mode=OneWay}" />
                            </Grid>
                        </wct:SettingsCard>
                    </wct:SettingsExpander.Items>
                </wct:SettingsExpander>

                <!-- Cached Infor Visual data -->
                <wct:SettingsExpander
                    AutomationProperties.AutomationId="SettingsPage_CacheRefreshExpander"
                    x:Name="CacheRefreshExpander"
                    x:Load="{x:Bind ViewModel.IsCacheRefreshPanelVisible, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    IsExpanded="False">
                    <wct:SettingsExpander.HeaderIcon>
                        <SymbolIcon Symbol="Refresh" />
                    </wct:SettingsExpander.HeaderIcon>

                    <wct:SettingsExpander.Header>
                        <TextBlock
                            x:Uid="Settings_CacheRefresh_Title"
                            Text="Cached Infor Visual data" />
                    </wct:SettingsExpander.Header>

                    <wct:SettingsExpander.Description>
                        <TextBlock
                            x:Uid="Settings_CacheRefresh_Description"
                            Text="Ask the cache service to rebuild the cached Infor Visual reads now instead of waiting for its next scheduled cycle. Plant Manager and above only. A workstation that is not pointed at the service is told so rather than failing." />
                    </wct:SettingsExpander.Description>

                    <ProgressRing
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsCacheRefreshing, Mode=OneWay}" />

                    <wct:SettingsExpander.Items>
                        <wct:SettingsCard
                            ContentAlignment="Vertical"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <Button
                                    AutomationProperties.AutomationId="SettingsPage_CacheRefresh_RefreshButton"
                                    x:Uid="Settings_CacheRefresh_Refresh"
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.RequestCacheRefreshCommand}"
                                    Content="Refresh cached data" />
                                <TextBlock
                                    Style="{StaticResource SettingsDescriptionStyle}"
                                    Text="{x:Bind ViewModel.CacheRefreshStatusMessage, Mode=OneWay}" />
                            </StackPanel>
                        </wct:SettingsCard>
                    </wct:SettingsExpander.Items>
                </wct:SettingsExpander>
            </StackPanel>

            <!-- About -->
            <StackPanel
                Grid.Row="3"
                x:Name="AboutCategoryPanel"
                x:Load="{x:Bind ViewModel.IsAboutCategoryVisible, Mode=OneWay}"
                Spacing="8">

                <TextBlock
                    x:Uid="Settings_About"
                    Style="{ThemeResource BodyStrongTextBlockStyle}" />

                <wct:SettingsExpander
                    AutomationProperties.AutomationId="SettingsPage_AboutExpander"
                    x:Name="AboutExpander"
                    x:Load="{x:Bind ViewModel.IsAboutPanelVisible, Mode=OneWay}"
                    Header="About / App Info"
                    HorizontalAlignment="Stretch"
                    IsExpanded="False">
                    <wct:SettingsExpander.HeaderIcon>
                        <SymbolIcon Symbol="ContactInfo" />
                    </wct:SettingsExpander.HeaderIcon>

                    <wct:SettingsExpander.Items>
                        <wct:SettingsCard>
                            <wct:SettingsCard.Header>
                                <TextBlock
                                    x:Uid="Settings_AppVersion_Title"
                                    Text="App Version" />
                            </wct:SettingsCard.Header>
                            <wct:SettingsCard.HeaderIcon>
                                <SymbolIcon Symbol="Important" />
                            </wct:SettingsCard.HeaderIcon>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.VersionDescription, Mode=OneWay}" />
                        </wct:SettingsCard>

                        <wct:SettingsCard>
                            <wct:SettingsCard.Header>
                                <TextBlock
                                    x:Uid="Settings_AboutApp_Title"
                                    Text="About MTM Waitlist" />
                            </wct:SettingsCard.Header>
                            <wct:SettingsCard.Description>
                                <TextBlock
                                    x:Uid="Settings_AboutDescription"
                                    Text="MTM Waitlist helps teams track, prioritize, and complete material requests in real time." />
                            </wct:SettingsCard.Description>
                            <wct:SettingsCard.HeaderIcon>
                                <SymbolIcon Symbol="ContactInfo" />
                            </wct:SettingsCard.HeaderIcon>
                        </wct:SettingsCard>
                    </wct:SettingsExpander.Items>
                </wct:SettingsExpander>
            </StackPanel>

            <!--
                Administration: two entries, and both of them navigate rather than expanding — so they are
                SettingsCards rather than expanders, each wrapped in x:Load (which requires an x:Name) and each
                shown only to a reader who may open it. A reader entitled to neither does not see the category.
            -->
            <StackPanel
                Grid.Row="4"
                x:Name="AdministrationCategoryPanel"
                x:Load="{x:Bind ViewModel.IsAdministrationCategoryVisible, Mode=OneWay}"
                Spacing="8">

                <TextBlock
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.AdministrationCategoryTitle}" />

                <wct:SettingsCard
                    x:Name="UserManagementEntryCard"
                    x:Load="{x:Bind ViewModel.IsUserManagementEntryVisible, Mode=OneWay}"
                    AutomationProperties.AutomationId="SettingsPage_UserManagementEntry"
                    AutomationProperties.Name="{x:Bind ViewModel.UserManagementEntryTitle}"
                    HorizontalAlignment="Stretch"
                    IsClickEnabled="True"
                    Command="{x:Bind ViewModel.OpenUserManagementCommand}">
                    <wct:SettingsCard.Header>
                        <TextBlock Text="{x:Bind ViewModel.UserManagementEntryTitle}" />
                    </wct:SettingsCard.Header>
                    <wct:SettingsCard.Description>
                        <TextBlock Text="{x:Bind ViewModel.UserManagementEntryDescription}" />
                    </wct:SettingsCard.Description>
                    <wct:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="People" />
                    </wct:SettingsCard.HeaderIcon>
                </wct:SettingsCard>

                <wct:SettingsCard
                    x:Name="PermissionsEntryCard"
                    x:Load="{x:Bind ViewModel.IsPermissionsEntryVisible, Mode=OneWay}"
                    AutomationProperties.AutomationId="SettingsPage_PermissionsEntry"
                    AutomationProperties.Name="{x:Bind ViewModel.PermissionsEntryTitle}"
                    HorizontalAlignment="Stretch"
                    IsClickEnabled="True"
                    Command="{x:Bind ViewModel.OpenPermissionsCommand}">
                    <wct:SettingsCard.Header>
                        <TextBlock Text="{x:Bind ViewModel.PermissionsEntryTitle}" />
                    </wct:SettingsCard.Header>
                    <wct:SettingsCard.Description>
                        <TextBlock Text="{x:Bind ViewModel.PermissionsEntryDescription}" />
                    </wct:SettingsCard.Description>
                    <wct:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="Permissions" />
                    </wct:SettingsCard.HeaderIcon>
                </wct:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
