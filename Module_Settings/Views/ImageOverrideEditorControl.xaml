<UserControl
    x:Class="MTM_Waitlist.Module_Settings.Views.ImageOverrideEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:MTM_Waitlist.Module_Shared.Services"
    xmlns:models="using:MTM_Waitlist.Module_Settings.Models"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <!--
        Image override editor layout
        Row 0: Search + "Custom only" toggle + "Reset all" button
        Row 1: Error InfoBar
        Row 2: Status InfoBar
        Row 3: Loading spinner / empty message / scrollable list of grouped rows
    -->
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!-- Toolbar: search filter, custom-only toggle, reset-all action -->

        <Border Grid.Row="0" Padding="12" CornerRadius="12" Background="{ThemeResource SystemControlBackgroundAltHighBrush}">
        
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="SearchTextBox"
                    Grid.Column="0"
                    PlaceholderText="Search"
                    TextChanged="SearchTextBox_TextChanged"
                    AutomationProperties.Name="Search image rows" shared:TooltipBehavior.ResourceKey="Settings_SearchTextBox_Tooltip" shared:TooltipBehavior.AssociatedFiles="Module_Settings/Views/ImageOverrideEditorControl.xaml|Module_Settings/Views/ImageOverrideEditorControl.xaml.cs|Module_Shared/Services/TooltipBehavior.cs|Module_Shared/Services/TooltipService.cs|Module_Shared/Services/ControlInspectorService.cs|Module_Core/Helpers/ResourceExtensions.cs" shared:TooltipBehavior.FallbackText="Search."/>

                <ToggleSwitch
                    x:Name="CustomOnlyToggle"
                    Grid.Column="1"
                    MinWidth="0"
                    OffContent="All"
                    OnContent="Custom only"
                    Toggled="CustomOnlyToggle_Toggled"
                    AutomationProperties.Name="Show only rows with a custom image" shared:TooltipBehavior.ResourceKey="Settings_CustomOnlyToggle_Tooltip" shared:TooltipBehavior.AssociatedFiles="Module_Settings/Views/ImageOverrideEditorControl.xaml|Module_Settings/Views/ImageOverrideEditorControl.xaml.cs|Module_Shared/Services/TooltipBehavior.cs|Module_Shared/Services/TooltipService.cs|Module_Shared/Services/ControlInspectorService.cs|Module_Core/Helpers/ResourceExtensions.cs" shared:TooltipBehavior.FallbackText="All."/>

                <Button
                    x:Name="ResetAllButton"
                    Grid.Column="2"
                    Content="Reset all"
                    Click="ResetAllButton_Click"
                    AutomationProperties.Name="Reset every override in this list" shared:TooltipBehavior.ResourceKey="Settings_ResetAllButton_Tooltip" shared:TooltipBehavior.AssociatedFiles="Module_Settings/Views/ImageOverrideEditorControl.xaml|Module_Settings/Views/ImageOverrideEditorControl.xaml.cs|Module_Shared/Services/TooltipBehavior.cs|Module_Shared/Services/TooltipService.cs|Module_Shared/Services/ControlInspectorService.cs|Module_Core/Helpers/ResourceExtensions.cs" shared:TooltipBehavior.FallbackText="Reset all."/>
            </Grid>
        
        </Border>
        

        <!-- Error banner (e.g., load/save failures) -->
        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="1"
            IsOpen="False"
            IsClosable="False"
            Severity="Error" />

        <!-- Status banner (e.g., save confirmation) -->
        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="2"
            IsOpen="False"
            IsClosable="True"
            Severity="Informational" />

        <!-- Content area: loading ring, empty filter message, or grouped row list -->
        
        <Border Grid.Row="3" Padding="12" CornerRadius="12" Background="{ThemeResource SystemControlBackgroundAltHighBrush}">
        
            <Grid>
                <ProgressRing
                    x:Name="LoadingRing"
                    Width="36"
                    Height="36"
                    IsActive="False"
                    Visibility="Collapsed" />

                <TextBlock
                    x:Name="EmptyTextBlock"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No rows match the current filter."
                    Visibility="Collapsed" />

                <!-- Scrollable list of image-override row groups -->
                <ScrollViewer
                    x:Name="RowsScrollViewer"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto"
                    HorizontalScrollMode="Disabled">
                    <ItemsControl x:Name="GroupsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ImageOverrideRowGroup">
                                <StackPanel Margin="0,0,0,12" Spacing="6">
                                    <!-- Group header text (e.g., "Request Type Images" or request type name) -->
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontWeight="SemiBold"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Key}" />

                                    <!-- Rows within this group -->
                                    <ItemsControl ItemsSource="{x:Bind Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ImageOverrideRow">
                                                <Border
                                                    Margin="0,0,0,6"
                                                    Padding="10"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                    <StackPanel Spacing="6">
                                                        <!-- Per-row layout: name | preview | inherited badge | path | browse | reset -->
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="180" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Display label (e.g., request type name) -->
                                                            <TextBlock
                                                                Grid.Column="0"
                                                                VerticalAlignment="Center"
                                                                IsTextSelectionEnabled="False"
                                                                Text="{x:Bind DisplayName}"
                                                                TextWrapping="Wrap" />

                                                            <!-- 48x48 preview of the effective image -->
                                                            <Border
                                                                Grid.Column="1"
                                                                Width="48"
                                                                Height="48"
                                                                VerticalAlignment="Center"
                                                                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6">
                                                                <Image
                                                                    Width="48"
                                                                    Height="48"
                                                                    Stretch="Uniform"
                                                                    Source="{x:Bind EffectiveImagePath, Mode=OneWay, Converter={StaticResource ResolvedImagePathToSourceConverter}}"
                                                                    AutomationProperties.Name="Image preview" />
                                                            </Border>

                                                            <!-- "Inherited" badge shown for subtypes that fall back to parent type image -->
                                                            <Border
                                                                Grid.Column="2"
                                                                Padding="6,2,6,2"
                                                                VerticalAlignment="Center"
                                                                Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                                CornerRadius="8"
                                                                Visibility="{x:Bind IsInherited, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    FontWeight="SemiBold"
                                                                    Text="Inherited" />
                                                            </Border>

                                                            <!-- Editable custom image path text box -->
                                                            <TextBox
                                                                Grid.Column="3"
                                                                VerticalAlignment="Center"
                                                                IsEnabled="{x:Bind IsEditable}"
                                                                PlaceholderText="No custom image"
                                                                Text="{x:Bind CustomPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                AutomationProperties.Name="Custom image path" />

                                                            <!-- File-picker button to choose a custom image -->
                                                            <Button
                                                                Grid.Column="4"
                                                                MinWidth="84"
                                                                VerticalAlignment="Center"
                                                                Content="Browse"
                                                                IsEnabled="{x:Bind IsEditable}"
                                                                Click="BrowseButton_Click"
                                                                Tag="{x:Bind}" />

                                                            <!-- Reset this row back to the inherited/default image -->
                                                            <Button
                                                                Grid.Column="5"
                                                                MinWidth="72"
                                                                VerticalAlignment="Center"
                                                                Content="Reset"
                                                                IsEnabled="{x:Bind IsEditable}"
                                                                Click="ResetButton_Click"
                                                                Tag="{x:Bind}" />
                                                        </Grid>

                                                        <!-- Warning shown when the custom image file is missing -->
                                                        <TextBlock
                                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind WarningMessage, Mode=OneWay}"
                                                            TextWrapping="Wrap"
                                                            Visibility="{x:Bind HasWarning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

        </Border>

        
    </Grid>
</UserControl>



