<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MTM_Waitlist.Module_Settings.Views.PermissionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Settings.Models"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:views="using:MTM_Waitlist.Module_Settings.Views"
    mc:Ignorable="d">

    <!--
        One card per area of the declaration, that area's permissions across the top and the people down the side,
        with a mark in every cell. It is a matrix of people against permissions and never a grid of roles against
        permissions: a role supplies the baseline a person starts from, and the person is what this page changes.

        The left column is what makes the middle readable. It names the person, their role, what is pending for them
        and why their row may be locked, so a reader always knows whose row a cell belongs to even at the far right
        of a wide card.
    -->
    <Page.Resources>
        <!--
            The chrome every block on this page wears: the five cards, the block of unsaved changes, and the
            who-holds-this control. One style rather than four copies, so the page reads as one screen.
        -->
        <Style x:Key="PermissionCardChrome" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!--
            A column's working width, declared once so the heading row and every row beneath it line up. It is a
            floor rather than a cap: a card wider than the window scrolls sideways instead of dropping a column,
            because a column that is not there is a fact the reader will not know is missing (decision 28).
        -->
        <x:Double x:Key="PermissionCellWidth">168</x:Double>
        <x:Double x:Key="PermissionPersonColumnWidth">240</x:Double>
    </Page.Resources>

    <Grid Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
            <StackPanel Spacing="16">

                <!-- Header and the way back -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        AutomationProperties.AutomationId="PermissionsPage_Back"
                        Click="OnBackClick"
                        Content="{x:Bind ViewModel.BackLabelText}"
                        VerticalAlignment="Top" />

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.TitleText}" />
                        <TextBlock
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.SubtitleText}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.LegendText}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!-- The reader who may not open this page is told so rather than shown a screen they cannot use. -->
                <InfoBar
                    x:Name="NotEntitledBar"
                    x:Load="{x:Bind ViewModel.NotEntitled, Mode=OneWay}"
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind ViewModel.MessageText, Mode=OneWay}"
                    Severity="Warning"
                    Title="{x:Bind ViewModel.TitleText}" />

                <!-- Somebody outranks the reader: their row is shown and cannot be changed (FR-066). -->
                <InfoBar
                    x:Name="ReadOnlyBar"
                    AutomationProperties.AutomationId="PermissionsPage_ReadOnly"
                    x:Load="{x:Bind ViewModel.HasLockedRows, Mode=OneWay}"
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind ViewModel.ReadOnlyReasonText}"
                    Severity="Warning"
                    Title="{x:Bind ViewModel.TitleText}" />

                <!-- What the page cannot show, said above the cards: busy, nobody, or a store that failed. -->
                <StackPanel Spacing="8">
                    <muxc:ProgressRing
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Left"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <TextBlock
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.MessageText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <!-- Nobody at all is not the same as a store that could not be read (FR-096). -->
                    <TextBlock
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.EmptyText}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.IsRosterEmpty, Mode=OneWay}" />
                    <Button
                        AutomationProperties.AutomationId="PermissionsPage_Retry"
                        Command="{x:Bind ViewModel.LoadCommand}"
                        Content="{x:Bind ViewModel.RetryText}"
                        Visibility="{x:Bind ViewModel.IsStoreUnavailable, Mode=OneWay}" />
                </StackPanel>

                <!--
                    What has been changed and not written. A save is written for one person, so this lists people
                    rather than cells, and each one is saved on its own rather than several people's changes going in
                    one write that could half land (FR-071).
                -->
                <Border
                    x:Name="PendingPanel"
                    Style="{StaticResource PermissionCardChrome}"
                    x:Load="{x:Bind ViewModel.HasPendingChanges, Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.PendingHeadingText}" />
                        <ItemsControl AutomationProperties.AutomationId="PermissionsPage_Pending" ItemsSource="{x:Bind ViewModel.PendingRows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:PermissionMatrixRow">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" />
                                            <TextBlock
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind PendingText, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="PermissionsPage_Save"
                                            Click="OnSaveRowClick"
                                            Content="{x:Bind SaveLabelText}"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Tag="{x:Bind}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- The matrix: one card per area, drawn from the declaration rather than listed here. -->
                <ItemsControl AutomationProperties.AutomationId="PermissionsPage_Matrix" ItemsSource="{x:Bind ViewModel.Cards, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:PermissionAreaCard">
                            <Border Style="{StaticResource PermissionCardChrome}">
                                <!--
                                    The card scrolls sideways rather than cropping its columns, and the heading row
                                    scrolls with the rows beneath it so a column label always sits over its own
                                    column.
                                -->
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled">
                                    <StackPanel>
                                        <!-- The heading row: the area's name, then its permissions across the top. -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Width="{StaticResource PermissionPersonColumnWidth}"
                                                Margin="0,0,4,8"
                                                VerticalAlignment="Bottom"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind AreaHeadingText}"
                                                TextWrapping="Wrap" />

                                            <ItemsControl AutomationProperties.AutomationId="PermissionsPage_Columns" ItemsSource="{x:Bind Columns}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:PermissionColumn">
                                                        <!-- The permission's own words, and what it gates beneath them. -->
                                                        <StackPanel Width="{StaticResource PermissionCellWidth}" Margin="4,0" Spacing="2">
                                                            <TextBlock
                                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                                Text="{x:Bind LabelText}"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                                Text="{x:Bind GatesText}"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <!-- One row per person, each carrying this card's cells and nothing else. -->
                                        <ItemsControl ItemsSource="{x:Bind Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:PermissionCardRow">
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel
                                                            Width="{StaticResource PermissionPersonColumnWidth}"
                                                            Margin="0,6,4,6"
                                                            Spacing="2">
                                                            <HyperlinkButton
                                                                Padding="0"
                                                                AutomationProperties.Name="{x:Bind Person.AccountAnnouncement}"
                                                                Click="OnPersonLinkClick"
                                                                Content="{x:Bind Person.DisplayName}"
                                                                Tag="{x:Bind Person}" />
                                                            <!-- The sign-in name, because a name is not an identity: two accounts can share one. -->
                                                            <TextBlock
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                                Text="{x:Bind Person.SignInName}"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock
                                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                                Text="{x:Bind Person.RoleText}"
                                                                TextWrapping="Wrap" />
                                                            <!-- How much of theirs is unsaved, in the reader's words. -->
                                                            <TextBlock
                                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                                Text="{x:Bind Person.PendingText, Mode=OneWay}"
                                                                TextWrapping="Wrap"
                                                                Visibility="{x:Bind Person.HasPendingChanges, Mode=OneWay}" />
                                                            <!-- Why the whole row is locked, in words rather than by absence. -->
                                                            <TextBlock
                                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                                Text="{x:Bind Person.LockReasonText}"
                                                                TextWrapping="Wrap"
                                                                Visibility="{x:Bind Person.IsLockedShape}" />
                                                        </StackPanel>

                                                        <ItemsControl ItemsSource="{x:Bind Cells}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:PermissionCell">
                                                                    <!--
                                                                        A cell is a button rather than a check box,
                                                                        because it carries three states and a check
                                                                        box carries two. The state is drawn as a
                                                                        shape rather than as a colour: a filled square
                                                                        for a choice made for this person, an outlined
                                                                        circle for their role's baseline, and an empty
                                                                        square for off. Its accessible name says which
                                                                        one it is, because a reader who cannot see a
                                                                        shape cannot read one.
                                                                    -->
                                                                    <Button
                                                                        Width="{StaticResource PermissionCellWidth}"
                                                                        Height="48"
                                                                        Padding="0"
                                                                        AutomationProperties.Name="{x:Bind Announcement, Mode=OneWay}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Command="{x:Bind ToggleCommand}"
                                                                        IsEnabled="{x:Bind CanEdit}">
                                                                        <Grid Width="36" Height="36">
                                                                            <Border
                                                                                Width="24"
                                                                                Height="24"
                                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                                CornerRadius="3"
                                                                                Visibility="{x:Bind IsChosenShape, Mode=OneWay}">
                                                                                <FontIcon
                                                                                    FontSize="12"
                                                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                                    Glyph="&#xE73E;" />
                                                                            </Border>

                                                                            <Border
                                                                                Width="24"
                                                                                Height="24"
                                                                                Background="Transparent"
                                                                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                                                BorderThickness="1.5"
                                                                                CornerRadius="12"
                                                                                Visibility="{x:Bind IsInheritedShape, Mode=OneWay}">
                                                                                <FontIcon
                                                                                    FontSize="12"
                                                                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                                                    Glyph="&#xE73E;" />
                                                                            </Border>

                                                                            <Border
                                                                                Width="24"
                                                                                Height="24"
                                                                                BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                                                                BorderThickness="1.5"
                                                                                CornerRadius="3"
                                                                                Visibility="{x:Bind IsOffShape, Mode=OneWay}" />

                                                                            <!-- Not written yet: a mark of its own, beside a row that says how many. -->
                                                                            <Ellipse
                                                                                Width="8"
                                                                                Height="8"
                                                                                HorizontalAlignment="Right"
                                                                                VerticalAlignment="Top"
                                                                                Fill="{ThemeResource SystemFillColorCautionBrush}"
                                                                                Visibility="{x:Bind IsPendingShape, Mode=OneWay}" />
                                                                        </Grid>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Saving with nothing changed is unavailable, and says why (FR-068). -->
                <TextBlock
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.NothingChangedText}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.NothingChanged, Mode=OneWay}" />

                <!-- The count of cells still pending, which is also what leaving warns with (FR-073). -->
                <TextBlock
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.UnsavedWarningText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasPendingChanges, Mode=OneWay}" />

                <Button
                    x:Name="UndoButton"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="PermissionsPage_Undo"
                    Command="{x:Bind ViewModel.UndoCommand}"
                    Content="{x:Bind ViewModel.UndoLabelText}"
                    Visibility="{x:Bind ViewModel.CanUndo, Mode=OneWay}" />

                <!-- What the value has moved to, and the question the reader is asked before restoring it. -->
                <InfoBar
                    x:Name="RestoreBar"
                    AutomationProperties.AutomationId="PermissionsPage_RestorePrompt"
                    x:Load="{x:Bind ViewModel.IsRestorePromptVisible, Mode=OneWay}"
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind ViewModel.RestorePromptText, Mode=OneWay}"
                    Severity="Informational"
                    Title="{x:Bind ViewModel.UndoHeadingText}" />

                <!--
                    The two answers to that question. They sit beside the bar rather than inside it because an
                    InfoBar's action area takes one button and there are two answers.
                -->
                <StackPanel
                    x:Name="RestoreActions"
                    Orientation="Horizontal"
                    Spacing="8"
                    x:Load="{x:Bind ViewModel.IsRestorePromptVisible, Mode=OneWay}">
                    <Button
                        AutomationProperties.AutomationId="PermissionsPage_RestoreConfirm"
                        Command="{x:Bind ViewModel.ConfirmRestoreCommand}"
                        Content="{x:Bind ViewModel.RestoreLabelText}" />
                    <Button
                        AutomationProperties.AutomationId="PermissionsPage_RestoreDismiss"
                        Command="{x:Bind ViewModel.DismissRestoreCommand}"
                        Content="{x:Bind ViewModel.KeepValueLabelText}" />
                </StackPanel>

                <!--
                    The second view of the same data on the same page, as the UI contract requires: asking who holds
                    a feature. It is read-only and changes nothing, and it wears the same chrome as the cards so the
                    page reads as one screen.
                -->
                <Border x:Name="HoldersCard" Style="{StaticResource PermissionCardChrome}" x:Load="{x:Bind ViewModel.IsEntitled, Mode=OneWay}">
                    <views:PermissionHoldersView x:Name="HoldersView" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
