<UserControl
    x:Class="MTM_Waitlist.Module_Settings.Views.ComputerEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="ComputerEditDialog_Dialog"
    HorizontalAlignment="Center"
    VerticalAlignment="Center">
    <UserControl.Resources>
    </UserControl.Resources>

    <StackPanel Spacing="14">
        <TextBox
            AutomationProperties.AutomationId="ComputerEditDialog_DisplayNameInput"
            Header="Display Name"
            PlaceholderText="e.g. John's Computer"
            Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextChanged="Field_OnTextChanged" />

        <TextBox
            AutomationProperties.AutomationId="ComputerEditDialog_ComputerNameInput"
            Header="Computer Name"
            PlaceholderText="e.g. johnspc"
            Text="{x:Bind ViewModel.ComputerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextChanged="Field_OnTextChanged" />

        <TextBox
            AutomationProperties.AutomationId="ComputerEditDialog_MacAddressInput"
            Header="MAC Address"
            PlaceholderText="e.g. 00-11-22-33-44-55"
            Text="{x:Bind ViewModel.MacAddressNormalized, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBox
            AutomationProperties.AutomationId="ComputerEditDialog_LocationInput"
            Header="Location (optional)"
            PlaceholderText="Describe this computer"
            Text="{x:Bind ViewModel.Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            AcceptsReturn="True"
            TextWrapping="Wrap" />

        <ToggleSwitch
            AutomationProperties.AutomationId="ComputerEditDialog_ActiveToggle"
            Header="Active"
            IsOn="{x:Bind ViewModel.IsRegistered, Mode=TwoWay}" />

        <TextBlock
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.ValidationError, Mode=OneWay}"
            TextWrapping="WrapWholeWords" />
    </StackPanel>
</UserControl>
