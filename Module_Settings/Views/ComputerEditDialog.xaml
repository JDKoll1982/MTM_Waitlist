<ContentDialog
    x:Class="MTM_Waitlist.Module_Settings.Views.ComputerEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    HorizontalAlignment="Center"
    VerticalAlignment="Center">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">520</x:Double>
        <x:Double x:Key="ContentDialogThemeMaxWidth">520</x:Double>
        <x:Double x:Key="ContentDialogThemeMinWidth">520</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">520</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="14" MinWidth="460">
        <TextBox
            Header="Display Name"
            PlaceholderText="e.g. John's Computer"
            Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextChanged="Field_OnTextChanged" />

        <TextBox
            Header="Computer Name"
            PlaceholderText="e.g. johnspc"
            Text="{x:Bind ViewModel.ComputerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextChanged="Field_OnTextChanged" />

        <TextBox
            Header="MAC Address"
            PlaceholderText="e.g. 00-11-22-33-44-55"
            Text="{x:Bind ViewModel.MacAddressNormalized, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBox
            Header="Description (optional)"
            PlaceholderText="Describe this computer"
            Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            AcceptsReturn="True"
            TextWrapping="Wrap" />

        <ToggleSwitch
            Header="Active"
            IsOn="{x:Bind ViewModel.IsRegistered, Mode=TwoWay}" />

        <TextBlock
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.ValidationError, Mode=OneWay}"
            TextWrapping="WrapWholeWords" />
    </StackPanel>
</ContentDialog>
