<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MTM_Waitlist.Module_Settings.Views.LuggerNameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="LuggerNameDialog_Dialog"
    HorizontalAlignment="Center"
    VerticalAlignment="Center">
    <!--
        Adding a lugger and renaming one ask the same question — what is it called — so they are one window, opened
        with a different title and a different action behind its primary button (FR-003).
    -->
    <StackPanel Spacing="14">
        <TextBlock
            Style="{ThemeResource BodyTextBlockStyle}"
            Text="{x:Bind ViewModel.MessageText, Mode=OneWay}"
            TextWrapping="Wrap" />

        <TextBox
            AutomationProperties.AutomationId="LuggerArrangementPage_Name"
            Header="{x:Bind ViewModel.NameLabelText}"
            Text="{x:Bind ViewModel.LuggerNameInput, Mode=TwoWay}" />
    </StackPanel>
</UserControl>
