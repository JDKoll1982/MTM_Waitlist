<Page
    x:Class="MTM_Waitlist.Module_Settings.Views.OperationsSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:MTM_Waitlist.Module_Core.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:views="using:MTM_Waitlist.Module_Settings.Views"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls"
    xmlns:xaml="using:Microsoft.UI.Xaml"
    x:Name="RootPage"
    mc:Ignorable="d">

<Page.Resources>
    <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />

    <!--
        Settings page typography and row chrome.

        Every description and status line on the page uses SettingsDescriptionStyle, and every
        value pill in a two-column pick list uses SettingsListPillStyle. Section headings use the
        platform BodyStrong style directly. Keeping these three in one place is what stops the
        page drifting back into a mix of margins, brushes and font sizes.
    -->
    <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingsListPillStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,6,10,6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        Pictures panel row chrome.

        The merged panel holds three cards, and between them a dozen rows of "label, description, control". The
        measurements live here rather than on each row, so a folder box and the Browse button beside it sit in
        one straight column instead of every row inventing its own width.
    -->
    <Style x:Key="SettingsFormRowStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="16" />
    </Style>

    <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingsFolderBoxStyle" TargetType="TextBox">
        <Setter Property="MinWidth" Value="300" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsFolderButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Page.Resources>
    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid
            MaxWidth="{StaticResource PageContentMaxWidth}"
            Padding="0,0,0,48"
            HorizontalAlignment="Stretch"
            RowSpacing="28">
            <StackPanel Spacing="10">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Operations" />
                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="The settings a lead changes for the floor: work centres, dunnage visibility, hidden locations, session length and the minutes each item is allowed." />
<TextBox
    AutomationProperties.AutomationId="OperationsSettingsPage_SearchBox"
    Header="Search"
    PlaceholderText="Search settings"
    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
<wct:SettingsExpander
    AutomationProperties.AutomationId="SettingsPage_LocalWorkCentersExpander"
    x:Name="HotWorkCentersExpander"
    x:Load="{x:Bind ViewModel.IsHotWorkCentersPanelVisible, Mode=OneWay}"
    Description="Admin and lead roles can modify the Local press list for the selected computer."
    Header="Local Work Centers"
    HorizontalAlignment="Stretch"
    IsExpanded="False">
    <wct:SettingsExpander.HeaderIcon>
        <SymbolIcon Symbol="Pin" />
    </wct:SettingsExpander.HeaderIcon>

    <ProgressRing
        Width="20"
        Height="20"
        VerticalAlignment="Center"
        IsActive="{x:Bind ViewModel.IsHotWorkCentersBusy, Mode=OneWay}" />

    <wct:SettingsExpander.Items>
        <wct:SettingsCard
            Description="Select the computer whose Local press list you are editing."
            Header="Computer">
            <ComboBox
                AutomationProperties.AutomationId="SettingsPage_HotWorkCenters_ComputerCombo"
                MinWidth="280"
                DisplayMemberPath="Label"
                IsEnabled="{x:Bind ViewModel.CanManageHotWorkCenters, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.AvailableWorkstations, Mode=OneWay}"
                SelectedValue="{x:Bind ViewModel.SelectedWorkstation, Mode=TwoWay}"
                SelectedValuePath="Key" />
        </wct:SettingsCard>

        <wct:SettingsCard
            Header="Press list"
            ContentAlignment="Vertical"
            HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Spacing="8">
                        <TextBlock
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="Local Work Centers" />
                        <ItemsControl AutomationProperties.AutomationId="SettingsPage_HotWorkCentersList" ItemsSource="{x:Bind ViewModel.HotWorkCenters, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Margin="0,0,0,8"
                                        ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.Column="0"
                                            Style="{StaticResource SettingsListPillStyle}"
                                            Background="{ThemeResource SystemFillColorSuccessBrush}">
                                            <TextBlock Foreground="White" Text="{Binding}" />
                                        </Border>
                                        <Button
                                            AutomationProperties.Name="{Binding}"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Command="{Binding ViewModel.RemoveHotWorkCenterCommand, ElementName=RootPage}"
                                            CommandParameter="{Binding}"
                                            Content="Unpin"
                                            IsEnabled="{Binding ViewModel.CanManageHotWorkCenters, ElementName=RootPage}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Spacing="8">
                        <TextBlock
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="Other Workcenters" />
                        <ItemsControl AutomationProperties.AutomationId="SettingsPage_OtherWorkCentersList" ItemsSource="{x:Bind ViewModel.OtherWorkCenters, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Margin="0,0,0,8"
                                        ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.Column="0"
                                            Style="{StaticResource SettingsListPillStyle}"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                            <TextBlock Text="{Binding}" />
                                        </Border>
                                        <Button
                                            AutomationProperties.Name="{Binding}"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Command="{Binding ViewModel.AddHotWorkCenterCommand, ElementName=RootPage}"
                                            CommandParameter="{Binding}"
                                            Content="Pin"
                                            IsEnabled="{Binding ViewModel.CanManageHotWorkCenters, ElementName=RootPage}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <TextBlock
                    Style="{StaticResource SettingsDescriptionStyle}"
                    Text="{x:Bind ViewModel.HotWorkCentersStatusMessage, Mode=OneWay}" />
            </StackPanel>
        </wct:SettingsCard>
    </wct:SettingsExpander.Items>
</wct:SettingsExpander>

<wct:SettingsExpander
    AutomationProperties.AutomationId="SettingsPage_DunnageVisibilityExpander"
    x:Name="DunnageTypeVisibilityExpander"
    x:Load="{x:Bind ViewModel.IsDunnageTypeVisibilityPanelVisible, Mode=OneWay}"
    Description="Choose which MTM Receiving Application dunnage types are visible in this app."
    Header="Dunnage Type Visibility"
    HorizontalAlignment="Stretch"
    IsExpanded="False">
    <wct:SettingsExpander.HeaderIcon>
        <SymbolIcon Symbol="Library" />
    </wct:SettingsExpander.HeaderIcon>

    <ProgressRing
        Width="20"
        Height="20"
        VerticalAlignment="Center"
        IsActive="{x:Bind ViewModel.IsDunnageTypeVisibilityBusy, Mode=OneWay}" />

    <wct:SettingsExpander.Items>
        <wct:SettingsCard
            Header="Dunnage types"
            ContentAlignment="Vertical"
            HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Spacing="8">
                        <TextBlock
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="Shown Dunnage Types" />
                        <!--
                            Every shown type is the shared card, so this list answers the picture question the way the
                            other converted lists do. Hiding a type is the card's action and is unchanged.
                        -->
                        <GridView
                            AutomationProperties.AutomationId="SettingsPage_VisibleDunnageTypesList"
                            ItemsSource="{x:Bind ViewModel.VisibleDunnageTypes, Mode=OneWay}"
                            IsItemClickEnabled="False"
                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Center"
                                        Spacing="6">
                                        <ContentControl
                                            HorizontalContentAlignment="Stretch"
                                            Content="{Binding}"
                                            ContentTemplate="{StaticResource PartPictureCardTemplate}" />
                                        <Button
                                            AutomationProperties.Name="{Binding Name}"
                                            HorizontalAlignment="Center"
                                            Command="{Binding ViewModel.HideDunnageTypeCommand, ElementName=RootPage}"
                                            CommandParameter="{Binding Id}"
                                            Content="Hide"
                                            IsEnabled="{Binding ViewModel.CanManageDunnageTypeVisibility, ElementName=RootPage}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Spacing="8">
                        <TextBlock
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="Hidden Dunnage Types" />
                        <!-- The hidden types are the same card, with showing a type as the card's action. -->
                        <GridView
                            AutomationProperties.AutomationId="SettingsPage_HiddenDunnageTypesList"
                            ItemsSource="{x:Bind ViewModel.HiddenDunnageTypes, Mode=OneWay}"
                            IsItemClickEnabled="False"
                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Center"
                                        Spacing="6">
                                        <ContentControl
                                            HorizontalContentAlignment="Stretch"
                                            Content="{Binding}"
                                            ContentTemplate="{StaticResource PartPictureCardTemplate}" />
                                        <Button
                                            AutomationProperties.Name="{Binding Name}"
                                            HorizontalAlignment="Center"
                                            Command="{Binding ViewModel.ShowDunnageTypeCommand, ElementName=RootPage}"
                                            CommandParameter="{Binding Id}"
                                            Content="Show"
                                            IsEnabled="{Binding ViewModel.CanManageDunnageTypeVisibility, ElementName=RootPage}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>
                </Grid>

                <TextBlock
                    Style="{StaticResource SettingsDescriptionStyle}"
                    Text="{x:Bind ViewModel.DunnageTypeVisibilityStatusMessage, Mode=OneWay}" />
            </StackPanel>
        </wct:SettingsCard>
    </wct:SettingsExpander.Items>
</wct:SettingsExpander>

<wct:SettingsExpander
    AutomationProperties.AutomationId="SettingsPage_IgnoredLocationsExpander"
    AutomationProperties.Name="{x:Bind IgnoredLocationsHeaderText.Text, Mode=OneWay}"
    x:Name="IgnoredLocationsExpander"
    x:Load="{x:Bind ViewModel.IsIgnoredLocationsPanelVisible, Mode=OneWay}"
    HorizontalAlignment="Stretch"
    IsExpanded="False">
    <wct:SettingsExpander.HeaderIcon>
        <SymbolIcon Symbol="Map" />
    </wct:SettingsExpander.HeaderIcon>

    <wct:SettingsExpander.Header>
        <TextBlock
            x:Name="IgnoredLocationsHeaderText"
            x:Uid="Settings_IgnoredLocations_Title"
            Text="Ignored Infor Visual Locations" />
    </wct:SettingsExpander.Header>

    <wct:SettingsExpander.Description>
        <TextBlock
            x:Uid="Settings_IgnoredLocations_Description"
            Text="Locations omitted from inventory lists and totals (for example WC, NCM, V-WC, NCM-VITS, SHIP). Everyone can read the list; changing it is limited to the IT team." />
    </wct:SettingsExpander.Description>

    <wct:SettingsExpander.Items>
        <wct:SettingsCard
            ContentAlignment="Vertical"
            HorizontalContentAlignment="Stretch">
            <wct:SettingsCard.Header>
                <TextBlock
                    x:Uid="Settings_IgnoredLocations_ListLabel"
                    Text="Ignored locations" />
            </wct:SettingsCard.Header>

            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        AutomationProperties.AutomationId="SettingsPage_IgnoredLocations_AddInput"
                        Grid.Column="0"
                        x:Uid="Settings_IgnoredLocations_AddPlaceholder"
                        IsEnabled="{x:Bind ViewModel.CanManageIgnoredLocations, Mode=OneWay}"
                        PlaceholderText="Add location code (for example WC)"
                        Text="{x:Bind ViewModel.IgnoredLocationInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        AutomationProperties.AutomationId="SettingsPage_IgnoredLocations_AddButton"
                        Grid.Column="1"
                        x:Uid="Settings_IgnoredLocations_Add"
                        VerticalAlignment="Stretch"
                        Command="{x:Bind ViewModel.AddIgnoredLocationCommand}"
                        Content="Add"
                        IsEnabled="{x:Bind ViewModel.CanManageIgnoredLocations, Mode=OneWay}" />
                </Grid>

                <ItemsControl
                    AutomationProperties.AutomationId="SettingsPage_IgnoredLocationsList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.IgnoredLocations, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Margin="0,4"
                                ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Glyph="&#xE71E;"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{Binding}" />
                                <Button
                                    AutomationProperties.Name="{Binding}"
                                    Grid.Column="2"
                                    x:Uid="Settings_IgnoredLocations_Remove"
                                    VerticalAlignment="Center"
                                    Command="{Binding ViewModel.RemoveIgnoredLocationCommand, ElementName=RootPage}"
                                    CommandParameter="{Binding}"
                                    Content="Remove"
                                    IsEnabled="{Binding ViewModel.CanManageIgnoredLocations, ElementName=RootPage}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    Deliberately collapsed: the status line is reported by the remote
                    retry flow rather than this panel, and it has never been shown here.
                    It stays bound so the message is not lost if that changes.
                -->
                <TextBlock
                    Grid.Row="2"
                    Style="{StaticResource SettingsDescriptionStyle}"
                    Text="{x:Bind ViewModel.IgnoredLocationsStatusMessage, Mode=OneWay}"
                    Visibility="Collapsed" />
            </Grid>
        </wct:SettingsCard>
    </wct:SettingsExpander.Items>
</wct:SettingsExpander>

<wct:SettingsExpander
    AutomationProperties.AutomationId="SettingsPage_SessionLengthExpander"
    x:Name="SessionLengthExpander"
    x:Load="{x:Bind ViewModel.IsSessionLengthPanelVisible, Mode=OneWay}"
    Description="{x:Bind ViewModel.SessionLengthDescription}"
    Header="{x:Bind ViewModel.SessionLengthTitle}"
    HorizontalAlignment="Stretch"
    IsExpanded="False">
    <wct:SettingsExpander.HeaderIcon>
        <FontIcon Glyph="&#xE916;" />
    </wct:SettingsExpander.HeaderIcon>

    <wct:SettingsExpander.Items>
        <wct:SettingsCard
            ContentAlignment="Vertical"
            HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="8">
                <muxc:NumberBox
                    AutomationProperties.AutomationId="SettingsPage_SessionLength_Minutes"
                    Header="{x:Bind ViewModel.SessionLengthLabel}"
                    Maximum="1440"
                    Minimum="15"
                    SmallChange="15"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind ViewModel.SessionLengthMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    AutomationProperties.AutomationId="SettingsPage_SessionLength_SaveButton"
                    HorizontalAlignment="Left"
                    Command="{x:Bind ViewModel.SaveSessionLengthCommand}"
                    Content="{x:Bind ViewModel.SessionLengthSaveLabel}" />
                <TextBlock
                    Style="{StaticResource SettingsDescriptionStyle}"
                    Text="{x:Bind ViewModel.SessionLengthStatusMessage, Mode=OneWay}" />
            </StackPanel>
        </wct:SettingsCard>
    </wct:SettingsExpander.Items>
</wct:SettingsExpander>

<wct:SettingsExpander
    AutomationProperties.AutomationId="SettingsPage_MaxAllottedTimeExpander"
    x:Name="UrgencyAllotmentsExpander"
    x:Load="{x:Bind ViewModel.IsUrgencyAllotmentsPanelVisible, Mode=OneWay}"
    Description="Set how long (in minutes) each item has before it is considered overdue, beside the average its completed requests have actually taken. Plant Manager+ can edit; others can view."
    Header="Max Allotted Time"
    HorizontalAlignment="Stretch"
    IsExpanded="False">
    <wct:SettingsExpander.HeaderIcon>
        <FontIcon Glyph="&#xE9D2;" />
    </wct:SettingsExpander.HeaderIcon>

    <ProgressRing
        Width="20"
        Height="20"
        VerticalAlignment="Center"
        IsActive="{x:Bind ViewModel.UrgencyAllotments.IsBusy, Mode=OneWay}" />

    <wct:SettingsExpander.Items>
        <wct:SettingsCard
            ContentAlignment="Vertical"
            HorizontalContentAlignment="Stretch">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    The column header and the item rows must declare the SAME column widths.
                    An Auto column is measured per grid: it collapsed to zero width in the
                    header (which leaves that cell empty) but held the configured/default
                    chip in the rows, so the header's star column absorbed the difference and
                    every fixed column to its right shifted out of line.
                -->
                <Grid
                    Grid.Row="0"
                    Margin="0,4"
                    ColumnSpacing="12"
                    HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        x:Uid="Settings_UrgencyAllotments_ItemColumn"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="Item" />
                    <TextBlock
                        Grid.Column="1"
                        x:Uid="Settings_UrgencyAllotments_ConfiguredColumn"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="Configured minutes" />
                    <TextBlock
                        Grid.Column="3"
                        x:Uid="Settings_UrgencyAllotments_ObservedColumn"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="Observed average" />
                </Grid>

                <ItemsControl
                    AutomationProperties.AutomationId="SettingsPage_MinutesList"
                    Grid.Row="1"
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.UrgencyAllotments.Items, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Margin="0,4"
                                ColumnSpacing="12"
                                HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="{Binding DisplayName}"
                                    TextWrapping="Wrap" />
                                <muxc:NumberBox
                                    AutomationProperties.Name="{Binding DisplayName}"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Maximum="1440"
                                    SmallChange="5"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{Binding Minutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding ViewModel.UrgencyAllotments.CanManageUrgencySettings, ElementName=RootPage}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{Binding ConfiguredValueLabel}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Text="{Binding ObservedAverageText}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    Grid.Row="2"
                    Style="{StaticResource SettingsDescriptionStyle}"
                    Text="{x:Bind ViewModel.UrgencyAllotments.StatusMessage, Mode=OneWay}" />
            </Grid>
        </wct:SettingsCard>
    </wct:SettingsExpander.Items>
</wct:SettingsExpander>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
