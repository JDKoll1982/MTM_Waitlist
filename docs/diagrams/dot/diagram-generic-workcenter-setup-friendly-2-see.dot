// Generic Work Centres — made simple · Sheet 2 of 2: what the operator sees — Sheet 2 of 2
// Source of truth: Plain-language view of the generic work-centre configuration
digraph FriendlyGenSetup2 {
  graph [
    rankdir=LR, splines=polyline, overlap=false, nodesep=0.45, ranksep=0.55,
    newrank=true, fontname="Segoe UI", fontsize=11, bgcolor="#FFFFFF", pad=0.02
  ];
  node [
    shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=11,
    margin="0.10,0.05", penwidth=1.5, color="#111111", fillcolor="#FFFFFF"
  ];
  edge [
    fontname="Segoe UI", fontsize=11, color="#111111", arrowsize=0.6,
    penwidth=1.5, fontcolor="#111111"
  ];
  subgraph cluster_ui {
    label="1 · What the operator sees"; fontcolor="#0B3D91"; color="#1F6FEB";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    a1 [shape=box, label="Only generic\npresses are listed", fillcolor="#DCE9FF"];
    a2 [shape=box, label="Categories and\nitems follow the\nsettings", fillcolor="#DCE9FF"];
    a3 [shape=box, label="Part and die lists\ncome from the\nplant system", fillcolor="#DCE9FF"];
  }
  subgraph cluster_vm {
    label="2 · What the app does"; fontcolor="#4B2A8A"; color="#8250DF";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    b1 [shape=box, label="The list is read\nfresh on every visit", fillcolor="#EFE3FF"];
    b2 [shape=box, label="Hidden dunnage\ntypes do not appear", fillcolor="#EFE3FF"];
    b3 [shape=box, label="A saved copy is used\nonly when the plant\nsystem is unreachable", fillcolor="#EFE3FF"];
  }
  subgraph cluster_svc {
    label="3 · What it looks up"; fontcolor="#0A5A4F"; color="#0F7B6C";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    c1 [shape=box, label="Reads the press\nlist", fillcolor="#D6F5F0"];
    c2 [shape=box, label="Reads the request\nsettings", fillcolor="#D6F5F0"];
    c3 [shape=box, label="Reads stock and\ndies", fillcolor="#D6F5F0"];
  }
  subgraph cluster_data {
    label="4 · Where it comes from"; fontcolor="#5A4300"; color="#8A6D3B";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    d1 [shape=cylinder, label="Press list", fillcolor="#EDEDED", fontname="Consolas"];
    d2 [shape=cylinder, label="Settings values", fillcolor="#EDEDED", fontname="Consolas"];
    d3 [shape=box, label="Plant stock and\ndie records", fillcolor="#F2E8D5", color="#8A6D3B"];
    d4 [shape=note, label="Worth fixing: the\nsettings are re-read\non every visit\ninstead of once", fillcolor="#FFD6D6", color="#C62828", style="filled,dashed"];
  }
  { rank=same; a1; b1; c1; d1; }
  a1 -> b1 -> c1 -> d1 [style=invis, constraint=false];
  { rank=same; a2; b2; c2; d2; }
  a2 -> b2 -> c2 -> d2 [style=invis, constraint=false];
  { rank=same; a3; b3; c3; d3; }
  a3 -> b3 -> c3 -> d3 [style=invis, constraint=false];
  a1 -> a2 -> a3 [style=invis, constraint=true];
  b1 -> b2 -> b3 [style=invis, constraint=true];
  c1 -> c2 -> c3 [style=invis, constraint=true];
  d1 -> d2 -> d3 -> d4 [style=invis, constraint=true];
  a1 -> b1 [label="see"];
  a2 -> b2 [label="see"];
  a3 -> b3 [label="see"];
  b1 -> c1;
  b2 -> c2;
  b3 -> c3;
  c1 -> d1;
  c2 -> d2;
  c3 -> d3;
  d4 -> c2 [style=dashed, color="#C62828", arrowhead=none, constraint=false];
}
