// Diagram 2 / Sheet 1 of 5 — Work Center Setup: choose and manage a work center — Sheet 1 of 5
// Source of truth: SetupWorkCenterViewModel, ISetupWorkCenterService, PermissionKeys.SetupWorkCenters
digraph WorkOrderSetup1 {
  graph [
    rankdir=LR, splines=polyline, overlap=false, nodesep=0.45, ranksep=0.55,
    newrank=true, fontname="Segoe UI", fontsize=11, bgcolor="#FFFFFF", pad=0.02
  ];
  node [
    shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=11,
    margin="0.10,0.05", penwidth=1.5, color="#111111", fillcolor="#FFFFFF"
  ];
  edge [
    fontname="Segoe UI", fontsize=11, color="#111111", arrowsize=0.6,
    penwidth=1.5, fontcolor="#111111"
  ];
  subgraph cluster_ui {
    label="1 · UI — XAML Views"; fontcolor="#0B3D91"; color="#1F6FEB";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    u_wc [shape=box, label="SetupWorkCenterPage\ncards · filter\nbuilding from shell", fillcolor="#DCE9FF"];
    u_hist [shape=box, label="SetupWorkCenter\nHistoryPage.xaml", fillcolor="#DCE9FF"];
    x_perm [shape=note, label="manage controls\nhidden without\npermission", fillcolor="#FFF1C9", color="#B7791F", style="filled,dashed"];
  }
  subgraph cluster_vm {
    label="2 · ViewModels and commands"; fontcolor="#4B2A8A"; color="#8250DF";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    v_wc [shape=box, label="SetupWorkCenter\nViewModel\nContinueCommand\nRefreshCommand", fillcolor="#EFE3FF"];
    x_mgr [shape=box, label="AddWorkCenter\nUpdateWorkCenter\nRemoveWorkCenter", fillcolor="#EFE3FF"];
    v_hist [shape=box, label="SetupWorkCenter\nHistoryViewModel\nBackCommand", fillcolor="#EFE3FF"];
  }
  subgraph cluster_svc {
    label="3 · Services (DI)"; fontcolor="#0A5A4F"; color="#0F7B6C";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    s_perm [shape=box, label="IPermissionService\nsetup.work_centers", fillcolor="#D6F5F0"];
    s_wcs [shape=box, label="ISetupWorkCenter\nService", fillcolor="#D6F5F0"];
    s_cat [shape=box, label="IWorkCenterCatalog\nService\nGetCatalogAsync()", fillcolor="#D6F5F0"];
    s_img [shape=box, label="IWorkCenterImage\nService", fillcolor="#D6F5F0"];
  }
  subgraph cluster_data {
    label="4 · Store"; fontcolor="#5A4300"; color="#8A6D3B";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    d_wc [shape=cylinder, label="sp_setup_work_centers_\nget_all\nupsert · delete", fillcolor="#EDEDED", fontname="Consolas"];
    d_gen [shape=cylinder, label="sp_setup_work_centers_\ngeneric_set", fillcolor="#EDEDED", fontname="Consolas"];
    d_hot [shape=cylinder, label="sp_config_hot_\nworkcenters_get_\nfor_computer", fillcolor="#EDEDED", fontname="Consolas"];
    x_n [shape=note, label="[REFACTOR] the generic\nflag is a second write,\nnot part of the upsert", fillcolor="#FFD6D6", color="#C62828", style="filled,dashed"];
  }
  { rank=same; u_wc; v_wc; s_perm; d_wc; }
  u_wc -> v_wc -> s_perm -> d_wc [style=invis, constraint=false];
  { rank=same; u_hist; x_mgr; s_wcs; d_gen; }
  u_hist -> x_mgr -> s_wcs -> d_gen [style=invis, constraint=false];
  { rank=same; x_perm; v_hist; s_cat; d_hot; }
  x_perm -> v_hist -> s_cat -> d_hot [style=invis, constraint=false];
  { rank=same; s_img; x_n; }
  s_img -> x_n [style=invis, constraint=false];
  u_wc -> u_hist -> x_perm [style=invis, constraint=true];
  v_wc -> x_mgr -> v_hist [style=invis, constraint=true];
  s_perm -> s_wcs -> s_cat -> s_img [style=invis, constraint=true];
  d_wc -> d_gen -> d_hot -> x_n [style=invis, constraint=true];
  u_wc -> v_wc [label="pick"];
  u_hist -> v_hist [label="open"];
  v_wc -> s_perm [label="gate"];
  v_wc -> s_wcs [label="save"];
  v_wc -> s_cat [label="local"];
  v_wc -> s_img [label="photo"];
  s_wcs -> d_wc;
  s_wcs -> d_gen [style=dotted];
  s_cat -> d_hot;
  x_mgr -> s_wcs;
  v_hist -> s_wcs [label="log"];
  x_perm -> v_wc [style=dashed, color="#B7791F", arrowhead=none, constraint=false];
  x_n -> s_wcs [style=dashed, color="#C62828", arrowhead=none, constraint=false];
}
