// Diagram 4 / Sheet 2 of 2 — Generic work centers: how the request flow reads that configuration — Sheet 2 of 2
// Source of truth: GenericRequestLiveStepData, GenericRequestPartData, WorkCenterCatalogService, RequestItemConfigurationService
digraph GenericSetup2 {
  graph [
    rankdir=LR, splines=polyline, overlap=false, nodesep=0.45, ranksep=0.55,
    newrank=true, fontname="Segoe UI", fontsize=11, bgcolor="#FFFFFF", pad=0.02
  ];
  node [
    shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=11,
    margin="0.10,0.05", penwidth=1.5, color="#111111", fillcolor="#FFFFFF"
  ];
  edge [
    fontname="Segoe UI", fontsize=11, color="#111111", arrowsize=0.6,
    penwidth=1.5, fontcolor="#111111"
  ];
  subgraph cluster_ui {
    label="1 · UI — where it is used"; fontcolor="#0B3D91"; color="#1F6FEB";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    u_wc [shape=box, label="GenericRequest\nWorkCenterPage", fillcolor="#DCE9FF"];
    u_cat [shape=box, label="GenericRequest\nCategoryPage", fillcolor="#DCE9FF"];
    u_item [shape=box, label="GenericRequest\nItemPage", fillcolor="#DCE9FF"];
    u_part [shape=box, label="GenericRequest\nPartPage", fillcolor="#DCE9FF"];
  }
  subgraph cluster_vm {
    label="2 · ViewModels and read seam"; fontcolor="#4B2A8A"; color="#8250DF";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    v_live [shape=box, label="GenericRequestLive\nStepData\nReadWorkCenters\nReadCategories", fillcolor="#EFE3FF"];
    v_pick [shape=box, label="GenericRequest\nItem + Part\nViewModels", fillcolor="#EFE3FF"];
    x_n2 [shape=note, label="[REFACTOR] the IsGeneric\nflag is read per visit\nand is not cached", fillcolor="#FFD6D6", color="#C62828", style="filled,dashed"];
  }
  subgraph cluster_svc {
    label="3 · Services (DI)"; fontcolor="#0A5A4F"; color="#0F7B6C";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    s_cat [shape=box, label="IWorkCenterCatalog\nService\nGetCatalogAsync()", fillcolor="#D6F5F0"];
    s_cfg [shape=box, label="IRequestItem\nConfigurationService\n+ Picker", fillcolor="#D6F5F0"];
    s_part [shape=box, label="IGenericRequestPart\nData\nIVisualReadFallback", fillcolor="#D6F5F0"];
  }
  subgraph cluster_data {
    label="4 · Store / ERP"; fontcolor="#5A4300"; color="#8A6D3B";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    d_cat [shape=cylinder, label="sp_setup_work_centers_\nget_all\nsp_config_hot_workcenters\n_get_for_computer", fillcolor="#EDEDED", fontname="Consolas"];
    d_cfg [shape=cylinder, label="sp_waitlist_request_\nitem_configs_get()", fillcolor="#EDEDED", fontname="Consolas"];
    d_vis [shape=box, label="Infor Visual shapes\n9 / 10 / 11 / 7 / 12", fillcolor="#F2E8D5", color="#8A6D3B"];
    d_mock [shape=component, label="mtm_mock\nsp_visual_<key>_get", fillcolor="#FFE0E3", color="#B02A37"];
  }
  { rank=same; u_wc; v_live; s_cat; d_cat; }
  u_wc -> v_live -> s_cat -> d_cat [style=invis, constraint=false];
  { rank=same; u_cat; v_pick; s_cfg; d_cfg; }
  u_cat -> v_pick -> s_cfg -> d_cfg [style=invis, constraint=false];
  { rank=same; u_item; x_n2; s_part; d_vis; }
  u_item -> x_n2 -> s_part -> d_vis [style=invis, constraint=false];
  { rank=same; u_part; d_mock; }
  u_part -> d_mock [style=invis, constraint=false];
  u_wc -> u_cat -> u_item -> u_part [style=invis, constraint=true];
  v_live -> v_pick -> x_n2 [style=invis, constraint=true];
  s_cat -> s_cfg -> s_part [style=invis, constraint=true];
  d_cat -> d_cfg -> d_vis -> d_mock [style=invis, constraint=true];
  u_wc -> v_live [label="read"];
  u_cat -> v_live [label="read"];
  u_item -> v_pick [label="read"];
  u_part -> v_pick [label="read"];
  v_live -> s_cat;
  s_cat -> d_cat;
  v_pick -> s_cfg;
  s_cfg -> d_cfg;
  v_pick -> s_part;
  s_part -> d_vis;
  d_vis -> d_mock [style=dashed, color="#B02A37", constraint=false];
  x_n2 -> s_cat [style=dashed, color="#C62828", arrowhead=none, constraint=false];
}
