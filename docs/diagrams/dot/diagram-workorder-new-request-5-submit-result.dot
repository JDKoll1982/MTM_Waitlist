// Diagram 1 / Sheet 5 of 5 — Work Order New Request: confirm, submit, result — Sheet 5 of 5
// Source of truth: NewRequestSummaryViewModel.SubmitAsync, WaitlistRequestService.SubmitAsync, NewRequestResultViewModel
digraph WorkOrderNewRequest5 {
  graph [
    rankdir=LR, splines=polyline, overlap=false, nodesep=0.45, ranksep=0.55,
    newrank=true, fontname="Segoe UI", fontsize=11, bgcolor="#FFFFFF", pad=0.02
  ];
  node [
    shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=11,
    margin="0.10,0.05", penwidth=1.5, color="#111111", fillcolor="#FFFFFF"
  ];
  edge [
    fontname="Segoe UI", fontsize=11, color="#111111", arrowsize=0.6,
    penwidth=1.5, fontcolor="#111111"
  ];
  subgraph cluster_ui {
    label="1 · UI — XAML Views"; fontcolor="#0B3D91"; color="#1F6FEB";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    u_sum [shape=box, label="NewRequest\nSummaryPage.xaml\nconfirm · coil", fillcolor="#DCE9FF"];
    x_err [shape=note, label="error strip\n「could not be\nsubmitted」", fillcolor="#FFF1C9", color="#B7791F", style="filled,dashed"];
    u_res [shape=box, label="NewRequest\nResultPage.xaml\nsuccess · duplicate", fillcolor="#DCE9FF"];
  }
  subgraph cluster_vm {
    label="2 · ViewModels and flow rules"; fontcolor="#4B2A8A"; color="#8250DF";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    v_sum [shape=box, label="NewRequestSummary\nViewModel\nSubmitCommand", fillcolor="#EFE3FF"];
    x_g [shape=note, label="[REFACTOR] job guard\npasses the work centre\ntwice: it compares a\nvalue with itself", fillcolor="#FFD6D6", color="#C62828", style="filled,dashed"];
    v_res [shape=box, label="NewRequestResult\nViewModel\nRetry · Return · New", fillcolor="#EFE3FF"];
  }
  subgraph cluster_svc {
    label="3 · Services (DI)"; fontcolor="#0A5A4F"; color="#0F7B6C";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    s_req [shape=box, label="IWaitlistRequestService\nSubmitAsync(draft)\n+ INewRequestAlert", fillcolor="#D6F5F0"];
    s_urg [shape=box, label="IUrgencyDeadlineService\nComputeAsync()", fillcolor="#D6F5F0"];
    s_nav [shape=box, label="INavigationService\nIPageService", fillcolor="#D6F5F0"];
  }
  subgraph cluster_data {
    label="4 · Store / ERP"; fontcolor="#5A4300"; color="#8A6D3B";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    d_list [shape=cylinder, label="sp_waitlist_request_\nlist\n(p_building)", fillcolor="#EDEDED", fontname="Consolas"];
    d_write [shape=cylinder, label="sp_waitlist_request_\ninsert\nsp_waitlist_request_\naudit_insert", fillcolor="#EDEDED", fontname="Consolas"];
    x_d [shape=note, label="[REFACTOR] duplicate\ncheck reads the\nin-memory snapshot", fillcolor="#FFD6D6", color="#C62828", style="filled,dashed"];
  }
  { rank=same; u_sum; v_sum; s_req; d_list; }
  u_sum -> v_sum -> s_req -> d_list [style=invis, constraint=false];
  { rank=same; x_err; x_g; s_urg; d_write; }
  x_err -> x_g -> s_urg -> d_write [style=invis, constraint=false];
  { rank=same; u_res; v_res; s_nav; x_d; }
  u_res -> v_res -> s_nav -> x_d [style=invis, constraint=false];
  u_sum -> x_err -> u_res [style=invis, constraint=true];
  v_sum -> x_g -> v_res [style=invis, constraint=true];
  s_req -> s_urg -> s_nav [style=invis, constraint=true];
  d_list -> d_write -> x_d [style=invis, constraint=true];
  u_sum -> v_sum [label="submit"];
  v_sum -> s_req [label="submit"];
  s_req -> s_urg [label="due time"];
  s_req -> d_list [label="check"];
  s_req -> d_write [label="write", color="#C62828", penwidth=2.0];
  v_sum -> v_res [label="result"];
  v_sum -> x_err [label="failure", style=dashed, color="#B7791F"];
  x_g -> v_sum [style=dashed, color="#C62828", arrowhead=none, constraint=false];
  x_d -> s_req [style=dashed, color="#C62828", arrowhead=none, constraint=false];
  v_res -> s_nav [label="leave"];
  s_nav -> u_res [style=dashed, color="#8250DF"];
}
