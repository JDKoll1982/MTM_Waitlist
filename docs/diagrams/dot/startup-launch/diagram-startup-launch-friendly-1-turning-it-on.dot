// Startup — made simple · Sheet 1 of 2: turning it on — Sheet 1 of 2
// Source of truth: LaunchPipeline, LaunchStepCatalog, ConfigurationStep, StoreReachabilityStep, MachineReadinessStep, PictureCacheStep
digraph StartupFriendly1 {
  graph [
    rankdir=LR, splines=polyline, overlap=false, nodesep=0.45, ranksep=0.55,
    newrank=true, fontname="Segoe UI", fontsize=11, bgcolor="#FFFFFF", pad=0.02
  ];
  node [
    shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=11,
    margin="0.10,0.05", penwidth=1.5, color="#111111", fillcolor="#FFFFFF"
  ];
  edge [
    fontname="Segoe UI", fontsize=11, color="#111111", arrowsize=0.6,
    penwidth=1.5, fontcolor="#111111"
  ];
  subgraph cluster_ui {
    label="1 · What you see"; fontcolor="#0B3D91"; color="#1F6FEB";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    u_launch [shape=box, label="The launch window\nstatus, progress\nand the count", fillcolor="#DCE9FF"];
    u_setup [shape=box, label="Setup screen\nwhere this computer\nstands", fillcolor="#DCE9FF"];
    u_signin [shape=box, label="Sign-in screen\nname, then PIN", fillcolor="#DCE9FF"];
  }
  subgraph cluster_vm {
    label="2 · What the app checks"; fontcolor="#4B2A8A"; color="#8250DF";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    v_limits [shape=box, label="One step at a time,\neach with a time\nlimit", fillcolor="#EFE3FF"];
    d_ready [shape=diamond, label="Is this computer\nset up yet?", fillcolor="#FFF1C9", color="#B7791F", margin="0.01,0.01"];
    x_next [shape=cds, label="[To Sheet 2]\nSigning in", fillcolor="#E8F0FF", color="#1F6FEB", style="filled,dashed"];
    n_authority [shape=note, label="Worth fixing: the setup\nscreen says Administrator,\nbut only IT Department\ncan unlock it.", fillcolor="#FFD6D6", color="#C62828", style="filled,dashed"];
  }
  subgraph cluster_svc {
    label="3 · What it does"; fontcolor="#0A5A4F"; color="#0F7B6C";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    s_pictures [shape=box, label="Copies the shared\npictures: best\neffort, so never\nholds up the launch", fillcolor="#D6F5F0"];
    s_settings [shape=box, label="Reads what this\ncomputer keeps", fillcolor="#D6F5F0"];
    s_store [shape=box, label="Asks the store\nif it answers", fillcolor="#D6F5F0"];
    s_computer [shape=box, label="Reads this\ncomputer's name", fillcolor="#D6F5F0"];
  }
  subgraph cluster_data {
    label="4 · Where it looks"; fontcolor="#5A4300"; color="#8A6D3B";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    d_settings [shape=cylinder, label="This computer's\nsettings", fillcolor="#EDEDED", fontname="Consolas"];
    d_record [shape=cylinder, label="This computer's\nrecord", fillcolor="#EDEDED", fontname="Consolas"];
    d_place [shape=cylinder, label="Where the computer\nstands", fillcolor="#EDEDED", fontname="Consolas"];
  }
  { rank=same; u_launch; v_limits; s_pictures; d_settings; }
  u_launch -> v_limits -> s_pictures -> d_settings [style=invis, constraint=false];
  { rank=same; u_setup; d_ready; s_settings; d_record; }
  u_setup -> d_ready -> s_settings -> d_record [style=invis, constraint=false];
  { rank=same; u_signin; x_next; s_store; d_place; }
  u_signin -> x_next -> s_store -> d_place [style=invis, constraint=false];
  { rank=same; n_authority; s_computer; }
  n_authority -> s_computer [style=invis, constraint=false];
  u_launch -> u_setup -> u_signin [style=invis, constraint=true];
  v_limits -> d_ready -> x_next -> n_authority [style=invis, constraint=true];
  s_pictures -> s_settings -> s_store -> s_computer [style=invis, constraint=true];
  d_settings -> d_record -> d_place [style=invis, constraint=true];
  u_launch -> v_limits [label="start"];
  v_limits -> s_pictures [label="first"];
  s_settings -> d_settings;
  s_settings -> s_store [label="asks"];
  s_store -> s_computer [label="then"];
  s_computer -> d_record;
  s_computer -> d_place;
  d_ready -> u_setup [label="no"];
  u_setup -> n_authority [label="says"];
  u_setup -> d_place [label="writes"];
  d_ready -> x_next [label="yes"];
  x_next -> u_signin;
}
