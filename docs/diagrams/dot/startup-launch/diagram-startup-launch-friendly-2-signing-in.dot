// Startup — made simple · Sheet 2 of 2: signing in — Sheet 2 of 2
// Source of truth: SignInPage, SignInViewModel, IdentifierSignInService, CredentialCheckService, LaunchSessionService, PreviousSignInService
digraph StartupFriendly2 {
  graph [
    rankdir=LR, splines=polyline, overlap=false, nodesep=0.45, ranksep=0.55,
    newrank=true, fontname="Segoe UI", fontsize=11, bgcolor="#FFFFFF", pad=0.02
  ];
  node [
    shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=11,
    margin="0.10,0.05", penwidth=1.5, color="#111111", fillcolor="#FFFFFF"
  ];
  edge [
    fontname="Segoe UI", fontsize=11, color="#111111", arrowsize=0.6,
    penwidth=1.5, fontcolor="#111111"
  ];
  subgraph cluster_ui {
    label="1 · What you see"; fontcolor="#0B3D91"; color="#1F6FEB";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    u_signin [shape=box, label="Sign-in screen\nname, then PIN", fillcolor="#DCE9FF"];
    u_form [shape=box, label="The form to set\nyourself up", fillcolor="#DCE9FF"];
    u_first [shape=box, label="The first screen", fillcolor="#DCE9FF"];
  }
  subgraph cluster_vm {
    label="2 · What it checks"; fontcolor="#4B2A8A"; color="#8250DF";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    x_back [shape=cds, label="[From Sheet 1]\nturning it on", fillcolor="#E8F0FF", color="#1F6FEB", style="filled,dashed"];
    d_known [shape=diamond, label="Does it know\nthe name?", fillcolor="#FFF1C9", color="#B7791F", margin="0.01,0.01"];
    v_offer [shape=box, label="The people who\nsigned in here\nbefore", fillcolor="#EFE3FF"];
  }
  subgraph cluster_svc {
    label="3 · What it does"; fontcolor="#0A5A4F"; color="#0F7B6C";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    s_name [shape=box, label="Looks the name up\nhere, then at the\nplant system", fillcolor="#D6F5F0"];
    s_pin [shape=box, label="Checks the PIN", fillcolor="#D6F5F0"];
    s_session [shape=box, label="Notes that you\nare signed in", fillcolor="#D6F5F0"];
    s_setup [shape=box, label="Sets up a new\naccount", fillcolor="#D6F5F0"];
  }
  subgraph cluster_data {
    label="4 · Where it looks"; fontcolor="#5A4300"; color="#8A6D3B";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    d_people [shape=cylinder, label="Employee list", fillcolor="#EDEDED", fontname="Consolas"];
    d_accounts [shape=cylinder, label="Accounts\nand roles", fillcolor="#EDEDED", fontname="Consolas"];
    d_pins [shape=cylinder, label="PINs, never shown", fillcolor="#EDEDED", fontname="Consolas"];
    d_recent [shape=cylinder, label="People who signed\nin here before", fillcolor="#EDEDED", fontname="Consolas"];
    n_offer [shape=note, label="Worth fixing: when that\nlist cannot be read, it\nvanishes without a word.", fillcolor="#FFD6D6", color="#C62828", style="filled,dashed"];
  }
  { rank=same; u_signin; x_back; s_name; d_people; }
  u_signin -> x_back -> s_name -> d_people [style=invis, constraint=false];
  { rank=same; u_form; d_known; s_pin; d_accounts; }
  u_form -> d_known -> s_pin -> d_accounts [style=invis, constraint=false];
  { rank=same; u_first; v_offer; s_session; d_pins; }
  u_first -> v_offer -> s_session -> d_pins [style=invis, constraint=false];
  { rank=same; s_setup; d_recent; }
  s_setup -> d_recent [style=invis, constraint=false];
  u_signin -> u_form -> u_first [style=invis, constraint=true];
  x_back -> d_known -> v_offer [style=invis, constraint=true];
  s_name -> s_pin -> s_session -> s_setup [style=invis, constraint=true];
  d_people -> d_accounts -> d_pins -> d_recent -> n_offer [style=invis, constraint=true];
  x_back -> u_signin [label="shows"];
  u_signin -> d_known [label="type a name"];
  s_name -> d_known [label="known?"];
  v_offer -> n_offer [label="cannot read", style=dashed, color="#C62828", arrowhead=none, constraint=false];
  v_offer -> d_recent;
  s_name -> d_people;
  d_known -> u_form [label="no"];
  s_setup -> d_accounts [label="writes"];
  s_pin -> d_pins [label="checks"];
  s_pin -> s_session [label="accepted"];
  s_session -> d_accounts [label="session"];
  s_session -> u_first [label="signed in"];
}
