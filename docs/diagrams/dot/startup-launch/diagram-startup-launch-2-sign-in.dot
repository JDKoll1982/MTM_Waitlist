// Diagram 5 / Sheet 2 of 3 — Startup launch: signing in — Sheet 2 of 3
// Source of truth: SignInPage, SignInViewModel, IdentifierSignInService, CredentialCheckService, LaunchSessionService, PreviousSignInService, AccountCreationService
digraph StartupLaunch2 {
  graph [
    rankdir=LR, splines=polyline, overlap=false, nodesep=0.45, ranksep=0.55,
    newrank=true, fontname="Segoe UI", fontsize=11, bgcolor="#FFFFFF", pad=0.02
  ];
  node [
    shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=11,
    margin="0.10,0.05", penwidth=1.5, color="#111111", fillcolor="#FFFFFF"
  ];
  edge [
    fontname="Segoe UI", fontsize=11, color="#111111", arrowsize=0.6,
    penwidth=1.5, fontcolor="#111111"
  ];
  subgraph cluster_ui {
    label="1 · UI — launch surfaces"; fontcolor="#0B3D91"; color="#1F6FEB";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    u_signin [shape=box, label="SignInPage\nidentifier · PIN", fillcolor="#DCE9FF"];
  }
  subgraph cluster_vm {
    label="2 · ViewModels and commands"; fontcolor="#4B2A8A"; color="#8250DF";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    v_signin [shape=box, label="SignInViewModel\nEnterAsync", fillcolor="#EFE3FF"];
    d_ident [shape=diamond, label="identifier\nknown?", fillcolor="#FFF1C9", color="#B7791F", margin="0.01,0.01"];
    v_setup [shape=box, label="SetUpPanel\nViewModel", fillcolor="#EFE3FF"];
    x_from [shape=cds, label="[From Sheet 1]\nresolve-person", fillcolor="#E8F0FF", color="#1F6FEB", style="filled,dashed"];
    x_next [shape=cds, label="[To Sheet 3]\nMainScreens", fillcolor="#E8F0FF", color="#1F6FEB", style="filled,dashed"];
  }
  subgraph cluster_svc {
    label="3 · Services (DI)"; fontcolor="#0A5A4F"; color="#0F7B6C";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    s_ident [shape=box, label="IdentifierSignIn\nService", fillcolor="#D6F5F0"];
    s_people [shape=box, label="PreviousSignIn\nService", fillcolor="#D6F5F0"];
    s_cred [shape=box, label="CredentialCheck\nService", fillcolor="#D6F5F0"];
    s_session [shape=box, label="LaunchSession\nService", fillcolor="#D6F5F0"];
    s_account [shape=box, label="AccountCreation\nService", fillcolor="#D6F5F0"];
  }
  subgraph cluster_data {
    label="4 · Store"; fontcolor="#5A4300"; color="#8A6D3B";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    db_employee [shape=cylinder, label="sp_core_employee_\nby_identifier_get", fillcolor="#EDEDED", fontname="Consolas"];
    db_prev [shape=cylinder, label="sp_auth_user_\nprevious_sign_ins", fillcolor="#EDEDED", fontname="Consolas"];
    db_cred [shape=cylinder, label="sp_auth_user_\ncredential_get", fillcolor="#EDEDED", fontname="Consolas"];
    db_user [shape=cylinder, label="sp_auth_user_row_get\nsp_core_account_\nsetup_create", fillcolor="#EDEDED", fontname="Consolas"];
  }
  { rank=same; u_signin; v_signin; s_ident; db_employee; }
  u_signin -> v_signin -> s_ident -> db_employee [style=invis, constraint=false];
  { rank=same; d_ident; s_people; db_prev; }
  d_ident -> s_people -> db_prev [style=invis, constraint=false];
  { rank=same; v_setup; s_cred; db_cred; }
  v_setup -> s_cred -> db_cred [style=invis, constraint=false];
  { rank=same; x_from; s_session; db_user; }
  x_from -> s_session -> db_user [style=invis, constraint=false];
  { rank=same; x_next; s_account; }
  x_next -> s_account [style=invis, constraint=false];
  v_signin -> d_ident -> v_setup -> x_from -> x_next [style=invis, constraint=true];
  s_ident -> s_people -> s_cred -> s_session -> s_account [style=invis, constraint=true];
  db_employee -> db_prev -> db_cred -> db_user [style=invis, constraint=true];
  x_from -> v_signin;
  v_signin -> u_signin [label="bind", style=dashed, color="#8250DF"];
  v_signin -> s_ident [label="Enter"];
  s_ident -> db_employee;
  s_ident -> d_ident [label="held?"];
  d_ident -> v_setup [label="no"];
  d_ident -> s_cred [label="yes"];
  s_cred -> db_cred [label="PIN"];
  s_cred -> s_session [label="accepted"];
  s_session -> db_user [label="session"];
  v_setup -> s_account [label="create"];
  s_account -> db_user [label="writes"];
  v_signin -> s_people [label="offer", style=dashed, color="#B7791F"];
  s_people -> db_prev [style=dotted];
  s_session -> x_next [label="signed in"];
}
