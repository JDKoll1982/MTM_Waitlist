// Diagram 2 / Sheet 4 of 5 — Work Center Setup: dunnage, scrap and history — Sheet 4 of 5
// Source of truth: SetupDunnageTypeViewModel, DunnageWorkflowService, SetupPersistenceService
digraph WorkOrderSetup4 {
  graph [
    rankdir=LR, splines=polyline, overlap=false, nodesep=0.45, ranksep=0.55,
    newrank=true, fontname="Segoe UI", fontsize=11, bgcolor="#FFFFFF", pad=0.02
  ];
  node [
    shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=11,
    margin="0.10,0.05", penwidth=1.5, color="#111111", fillcolor="#FFFFFF"
  ];
  edge [
    fontname="Segoe UI", fontsize=11, color="#111111", arrowsize=0.6,
    penwidth=1.5, fontcolor="#111111"
  ];
  subgraph cluster_ui {
    label="1 · UI — XAML Views and dialogs"; fontcolor="#0B3D91"; color="#1F6FEB";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    u_dun [shape=box, label="SetupDunnageTypePage\ntype + part tabs\nscrap type", fillcolor="#DCE9FF"];
    u_img [shape=box, label="SetupDunnageImage\nSearchDialog.xaml", fillcolor="#DCE9FF"];
    x_scr [shape=note, label="scrap type prefilled\nfrom the saved pair", fillcolor="#FFF1C9", color="#B7791F", style="filled,dashed"];
  }
  subgraph cluster_vm {
    label="2 · ViewModels and commands"; fontcolor="#4B2A8A"; color="#8250DF";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    v_dun [shape=box, label="SetupDunnageType\nViewModel\nAddDunnageCommand\nContinueToReview", fillcolor="#EFE3FF"];
    x_q [shape=note, label="Quick Add needs\nsetup.dunnage_\nquick_add", fillcolor="#FFD6D6", color="#C62828", style="filled,dashed"];
    x_next [shape=cds, label="[To Sheet 5]\nReviewVM", fillcolor="#E8F0FF", color="#1F6FEB", style="filled,dashed"];
  }
  subgraph cluster_svc {
    label="3 · Services (DI)"; fontcolor="#0A5A4F"; color="#0F7B6C";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    s_dw [shape=box, label="IDunnageWorkflow\nService\n+ IDunnageCatalogue", fillcolor="#D6F5F0"];
    s_p [shape=box, label="ISetupPersistence\nService\nLoadSavedScrapType", fillcolor="#D6F5F0"];
  }
  subgraph cluster_data {
    label="4 · Store"; fontcolor="#5A4300"; color="#8A6D3B";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    d_load [shape=cylinder, label="sp_setup_active_job_\ndunnage_assign_\nments_get", fillcolor="#EDEDED", fontname="Consolas"];
    d_scr [shape=cylinder, label="sp_setup_job_history_\nscrap_type_get", fillcolor="#EDEDED", fontname="Consolas"];
    x_n [shape=note, label="[REFACTOR] the scrap type\nis loaded from two\nsources and merged\nin the view model", fillcolor="#FFD6D6", color="#C62828", style="filled,dashed"];
  }
  { rank=same; u_dun; v_dun; s_dw; d_load; }
  u_dun -> v_dun -> s_dw -> d_load [style=invis, constraint=false];
  { rank=same; u_img; x_q; s_p; d_scr; }
  u_img -> x_q -> s_p -> d_scr [style=invis, constraint=false];
  { rank=same; x_scr; x_next; x_n; }
  x_scr -> x_next -> x_n [style=invis, constraint=false];
  u_dun -> u_img -> x_scr [style=invis, constraint=true];
  v_dun -> x_q -> x_next [style=invis, constraint=true];
  s_dw -> s_p [style=invis, constraint=true];
  d_load -> d_scr -> x_n [style=invis, constraint=true];
  u_dun -> v_dun [label="add"];
  v_dun -> s_dw [label="pick"];
  s_dw -> u_img [label="dialog"];
  s_dw -> d_load [label="load"];
  v_dun -> s_p [label="scrap"];
  s_p -> d_scr;
  v_dun -> x_next [label="next"];
  x_q -> s_dw [style=dashed, color="#C62828", arrowhead=none, constraint=false];
  x_n -> s_p [style=dashed, color="#C62828", arrowhead=none, constraint=false];
  x_scr -> v_dun [style=dashed, color="#B7791F", arrowhead=none, constraint=false];
}
