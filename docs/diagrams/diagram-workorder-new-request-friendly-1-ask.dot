// Work Order Request — made simple · Sheet 1 of 2: asking for something — Sheet 1 of 2
// Source of truth: Plain-language view of the work-order request flow
digraph FriendlyWO1 {
  graph [
    rankdir=LR, splines=polyline, overlap=false, nodesep=0.45, ranksep=0.55,
    newrank=true, fontname="Segoe UI", fontsize=11, bgcolor="#FFFFFF", pad=0.02
  ];
  node [
    shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=11,
    margin="0.10,0.05", penwidth=1.5, color="#111111", fillcolor="#FFFFFF"
  ];
  edge [
    fontname="Segoe UI", fontsize=11, color="#111111", arrowsize=0.6,
    penwidth=1.5, fontcolor="#111111"
  ];
  subgraph cluster_ui {
    label="1 · What you do"; fontcolor="#0B3D91"; color="#1F6FEB";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    a1 [shape=box, label="Open the waitlist\nand tap 「＋」", fillcolor="#DCE9FF"];
    a2 [shape=box, label="Pick the press you\nare standing at", fillcolor="#DCE9FF"];
    a3 [shape=box, label="Pick what you need\ncoil · die · dunnage", fillcolor="#DCE9FF"];
    a4 [shape=box, label="Answer the one\nquestion it asks", fillcolor="#DCE9FF"];
  }
  subgraph cluster_vm {
    label="2 · What the app checks"; fontcolor="#4B2A8A"; color="#8250DF";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    b1 [shape=box, label="It reads this\ncomputer's presses", fillcolor="#EFE3FF"];
    b2 [shape=box, label="It checks a job\nis running", fillcolor="#EFE3FF"];
    b3 [shape=box, label="It offers only what\nthat job can supply", fillcolor="#EFE3FF"];
    b4 [shape=box, label="It checks you are\non the employee list", fillcolor="#EFE3FF"];
  }
  subgraph cluster_svc {
    label="3 · What it looks up"; fontcolor="#0A5A4F"; color="#0F7B6C";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    c1 [shape=box, label="Reads the press\nlist", fillcolor="#D6F5F0"];
    c2 [shape=box, label="Reads the current\njob on the press", fillcolor="#D6F5F0"];
    c3 [shape=box, label="Reads what each\nchoice needs", fillcolor="#D6F5F0"];
    c4 [shape=box, label="Reads the people\nlist", fillcolor="#D6F5F0"];
  }
  subgraph cluster_data {
    label="4 · Where it comes from"; fontcolor="#5A4300"; color="#8A6D3B";
    style="rounded,dashed"; penwidth=1.5; labeljust=l; labelloc=t; margin=8;
    d1 [shape=cylinder, label="Work centre list", fillcolor="#EDEDED", fontname="Consolas"];
    d2 [shape=cylinder, label="The job on the\npress", fillcolor="#EDEDED", fontname="Consolas"];
    d3 [shape=cylinder, label="The rules for\neach choice", fillcolor="#EDEDED", fontname="Consolas"];
    d4 [shape=note, label="No job running?\nYou cannot ask\nhere.", fillcolor="#FFF1C9", color="#B7791F", style="filled,dashed"];
    d5 [shape=note, label="Worth fixing: the\nadd button builds\nthe whole request\nitself", fillcolor="#FFD6D6", color="#C62828", style="filled,dashed"];
  }
  { rank=same; a1; b1; c1; d1; }
  a1 -> b1 -> c1 -> d1 [style=invis, constraint=false];
  { rank=same; a2; b2; c2; d2; }
  a2 -> b2 -> c2 -> d2 [style=invis, constraint=false];
  { rank=same; a3; b3; c3; d3; }
  a3 -> b3 -> c3 -> d3 [style=invis, constraint=false];
  { rank=same; a4; b4; c4; d4; }
  a4 -> b4 -> c4 -> d4 [style=invis, constraint=false];
  a1 -> a2 -> a3 -> a4 [style=invis, constraint=true];
  b1 -> b2 -> b3 -> b4 [style=invis, constraint=true];
  c1 -> c2 -> c3 -> c4 [style=invis, constraint=true];
  d1 -> d2 -> d3 -> d4 -> d5 [style=invis, constraint=true];
  a1 -> b1 [label="start"];
  a2 -> b2 [label="pick"];
  a3 -> b3 [label="pick"];
  a4 -> b4 [label="answer"];
  b1 -> c1;
  b2 -> c2;
  b3 -> c3;
  b4 -> c4;
  c1 -> d1;
  c2 -> d2;
  c3 -> d3;
  d4 -> d2 [style=dashed, color="#B7791F", arrowhead=none, constraint=false];
  d5 -> b1 [style=dashed, color="#C62828", arrowhead=none, constraint=false];
}
