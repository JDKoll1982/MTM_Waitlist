<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MTM_Database_Deployment</RootNamespace>
    <AssemblyName>MTM_Database_Deployment.Core</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CS1591</NoWarn>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!--
    The deployment module's models and services, lifted verbatim from the module that already runs against
    mtm_receiving_application. They are a library rather than part of the executable for one reason: the suite has to
    be able to test them, and a test project that references a WinUI executable cannot start without the Windows App
    SDK runtime — the specification's own porting note 9 records that failure. The namespaces are unchanged, so
    nothing in the module reads differently.
  -->
  <ItemGroup>
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MTM_Waitlist.Tests" />
  </ItemGroup>

</Project>
