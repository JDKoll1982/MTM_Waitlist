<mxfile host="app.diagrams.net">
  <diagram id="setup-dunnage-pair" name="Module_Setup Dunnage Pair Workflow">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="Start: Work Center Setup" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="wo" value="Enter Work Order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="260" y="120" width="190" height="60" as="geometry" />
        </mxCell>

        <mxCell id="part" value="Select Part" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="490" y="120" width="170" height="60" as="geometry" />
        </mxCell>

        <mxCell id="seq" value="Select Sequence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="700" y="120" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="pair" value="Dunnage Pair Screen&#xa;(shows current dunnage assignments for Part+Sequence)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="100" width="330" height="100" as="geometry" />
        </mxCell>

        <mxCell id="decision" value="Add Dunnage clicked?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1320" y="110" width="170" height="80" as="geometry" />
        </mxCell>

        <mxCell id="review" value="Review Screen (Tabbed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="930" y="260" width="230" height="70" as="geometry" />
        </mxCell>

        <mxCell id="save" value="Save Pair Assignments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1200" y="260" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="end" value="Finish" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1440" y="265" width="130" height="60" as="geometry" />
        </mxCell>

        <mxCell id="typeFlow" value="Add Dunnage Flow&#xa;Step 1: Select Type&#xa;(Receiving parity layout/commands)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1320" y="420" width="250" height="100" as="geometry" />
        </mxCell>

        <mxCell id="partFlow" value="Add Dunnage Flow&#xa;Step 2: Select Part(s)&#xa;Multi-select enabled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1320" y="560" width="250" height="100" as="geometry" />
        </mxCell>

        <mxCell id="returnPair" value="Return to Pair Screen&#xa;Append selected dunnage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1000" y="560" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="emptyBranch" value="No receiving dunnage definitions found" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1000" y="430" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="permBranch" value="Management commands hidden in Waitlist&#xa;(Receiving app only for edit/delete/quick add mgmt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="700" y="430" width="270" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="start" target="wo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#1f2937;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="wo" target="part" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#1f2937;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="part" target="seq" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#1f2937;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="seq" target="pair" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#1f2937;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="pair" target="decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#1f2937;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e6" edge="1" parent="1" source="decision" target="review" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#1f2937;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="review" target="save" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#1f2937;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="save" target="end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#1f2937;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e9" edge="1" parent="1" source="decision" target="typeFlow" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#1f2937;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="typeFlow" target="partFlow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#1f2937;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="partFlow" target="returnPair" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#1f2937;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="returnPair" target="pair" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#1f2937;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e13" edge="1" parent="1" source="typeFlow" target="emptyBranch" value="No types" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;dashed=1;endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#b85450;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" edge="1" parent="1" source="emptyBranch" target="pair" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;dashed=1;endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#b85450;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e15" edge="1" parent="1" source="typeFlow" target="permBranch" value="Role/command policy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;dashed=1;endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#9673a6;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
