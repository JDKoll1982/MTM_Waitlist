<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MTM_Waitlist.Mock.Service.Views.ServiceShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The same title-bar shape the main app uses: app icon, the title, and a search box that
            searches whatever surface is showing. The WinUI TitleBar control is used rather than a bare
            Grid because only it keeps its children interactive: an element passed to SetTitleBar makes
            the whole rectangle behave as the caption area, and its children stop receiving pointer
            input unless the interactive regions are published explicitly.
        -->
        <TitleBar
            x:Name="ShellTitleBar"
            Grid.Row="0"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="TitleBarSearchBox"
                    MaxWidth="400"
                    Margin="12,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    QueryIcon="Find"
                    QuerySubmitted="OnTitleBarSearchBoxQuerySubmitted"
                    SuggestionChosen="OnTitleBarSearchBoxSuggestionChosen"
                    TextChanged="OnTitleBarSearchBoxTextChanged" />
            </TitleBar.Content>
        </TitleBar>

        <!--
            The settings entry is the NavigationView's own item (IsSettingsVisible), which the control pins to the
            BOTTOM of the pane and which carries the settings gear. It is deliberately not a NavigationViewItem of
            our own: one placed in MenuItems would sit at the top with the destinations, and the conventional place
            for settings is the foot of the pane.

            Every entry carries an icon because the pane collapses to LeftCompact, where the control shows icons
            only. An item without one renders as blank space in that state.
        -->
        <NavigationView
            x:Name="ShellNavigationView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            OpenPaneLength="200"
            SelectionChanged="OnNavigationSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="StatusNavigationItem" Tag="status">
                    <NavigationViewItem.Icon>
                        <!-- Diagnostic: this surface reports the service's health and last run. -->
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
