<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MTM_Waitlist.Mock.Service.Views.ServiceShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The same title-bar shape the main app uses: app icon, the title, and a search box that
            searches whatever surface is showing. The WinUI TitleBar control is used rather than a bare
            Grid because only it keeps its children interactive: an element passed to SetTitleBar makes
            the whole rectangle behave as the caption area, and its children stop receiving pointer
            input unless the interactive regions are published explicitly.
        -->
        <TitleBar
            x:Name="ShellTitleBar"
            Grid.Row="0"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="TitleBarSearchBox"
                    MaxWidth="400"
                    Margin="12,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    QueryIcon="Find"
                    QuerySubmitted="OnTitleBarSearchBoxQuerySubmitted"
                    SuggestionChosen="OnTitleBarSearchBoxSuggestionChosen"
                    TextChanged="OnTitleBarSearchBoxTextChanged" />
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="ShellNavigationView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="200"
            SelectionChanged="OnNavigationSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="SettingsNavigationItem" Tag="settings" />
                <NavigationViewItem x:Name="StatusNavigationItem" Tag="status" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
