<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MTM_Waitlist.Mock.Service.Views.ServiceStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Mock.Service.Models"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <!--
        The page fills the frame from its left edge: no maximum width and no centring, so the cards start
        where the title bar and the navigation pane end instead of leaving a band of empty space down the
        left of the surface.
    -->
    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.TitleText}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.SubtitleText}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Command="{x:Bind ViewModel.LoadStatusCommand}"
                    Content="{x:Bind ViewModel.ReloadText}" />
            </Grid>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="Informational" />

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasNoMatches, Mode=OneWay}"
                Message="{x:Bind ViewModel.NoMatchesText}"
                Severity="Informational" />

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.SearchSummaryText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasSearchQuery, Mode=OneWay}" />

            <!--
                The service summary: one card per value, each carrying the note that says what the value is,
                so "Started" or "Backup tool" never appears without an explanation under it.
            -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsSummarySectionVisible, Mode=OneWay}">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.SummaryHeaderText}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.SummaryRows, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ServiceSummaryRow">
                            <wct:SettingsCard
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch">
                                <wct:SettingsCard.Header>
                                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="{x:Bind LabelText}" />
                                </wct:SettingsCard.Header>
                                <wct:SettingsCard.Description>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind DescriptionText}"
                                        TextWrapping="Wrap" />
                                </wct:SettingsCard.Description>
                                <wct:SettingsCard.Content>
                                    <TextBlock
                                        MaxWidth="360"
                                        HorizontalAlignment="Right"
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind ValueText}"
                                        TextAlignment="Right"
                                        TextWrapping="Wrap" />
                                </wct:SettingsCard.Content>
                            </wct:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsShapesSectionVisible, Mode=OneWay}">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.ShapesHeaderText}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.ShapesHintText}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Shapes, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsShapesSectionVisible, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ShapeStatusRow">
                        <Border
                            Margin="0,0,0,10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                            <StackPanel Spacing="14">

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind DescriptionText}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Border
                                        Grid.Column="1"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Padding="8,2">
                                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind OutcomeText}" />
                                    </Border>
                                </Grid>

                                <Grid ColumnSpacing="28" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind LastRunLabelText}" />
                                        <TextBlock Text="{x:Bind LastRunText}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind RowsLabelText}" />
                                        <TextBlock Text="{x:Bind RowCountText}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind FreshnessLabelText}" />
                                        <TextBlock Text="{x:Bind FreshnessText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <Border
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4"
                                    Padding="12"
                                    Visibility="{x:Bind HasValidationError}">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ValidationErrorLabelText}" />
                                        <TextBlock
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Text="{x:Bind ValidationErrorText}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsBackupsSectionVisible, Mode=OneWay}">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.BackupsHeaderText}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.BackupsHintText}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Backups, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBackupsSectionVisible, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:BackupStatusRow">
                        <Border
                            Margin="0,0,0,10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                            <StackPanel Spacing="14">

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind DescriptionText}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Border
                                        Grid.Column="1"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Padding="8,2">
                                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind OutcomeText}" />
                                    </Border>
                                </Grid>

                                <Grid ColumnSpacing="28" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind LastRunLabelText}" />
                                        <TextBlock Text="{x:Bind LastRunText}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind NextDueLabelText}" />
                                        <TextBlock Text="{x:Bind ScheduleText}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ArtifactsLabelText}" />
                                        <TextBlock Text="{x:Bind ArtifactCountText}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Spacing="2">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ArtifactPathLabelText}" />
                                        <TextBlock Text="{x:Bind ArtifactPathText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
