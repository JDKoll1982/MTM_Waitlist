<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MTM_Waitlist.Mock.Service</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- On-host service app: unpackaged, self-contained WinAppSDK, no MSIX-only APIs. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_BREAK_ON_UNHANDLED_EXCEPTION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- SettingsCard/SettingsExpander — the same settings controls the main app's settings window uses,
         so the service surfaces match that window's look instead of hand-rolled cards. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="WinUIEx" Version="2.9.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MTM_Waitlist.Mock\MTM_Waitlist.Mock.csproj" />
    <ProjectReference Include="..\MTM_Waitlist.Core\MTM_Waitlist.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MTM_Waitlist.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- The tray icon is the service's only always-present surface, so it ships beside the app. -->
  <ItemGroup>
    <Content Include="..\Assets\WindowIcon.ico"
             Link="Assets\WindowIcon.ico"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The shape catalog validates that each shape's source Visual script exists on disk, and the
       refresh engine reads them at runtime to pull from Infor Visual. Ship them beside the app
       under the same relative layout the catalog records. The Module_Mock population reads are the
       service's own set-based snapshots (one Round trip per shape) and are required as well. -->
  <ItemGroup>
    <Content Include="..\Database\InforVisual\Queues\Module_Setup\**\*.sql"
             Link="Database\InforVisual\Queues\Module_Setup\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Database\InforVisual\Queues\Module_Waitlist\**\*.sql"
             Link="Database\InforVisual\Queues\Module_Waitlist\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Database\InforVisual\Queues\Module_Mock\**\*.sql"
             Link="Database\InforVisual\Queues\Module_Mock\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The desktop shortcut opens this control prompt (show the window, restart, shut down), so it is part
       of the deployed payload rather than something the installer adds afterwards. Shipping it here is
       what keeps the deployed folder an exact copy of the publish output, which the installer verifies. -->
  <ItemGroup>
    <Content Include="deploy\mock-service-control.ps1"
             Link="mock-service-control.ps1"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The restore operation's SQL steps are reviewed artifacts under Database/, not statement text in C#
       (constitution III, FR-015). RestoreService reads them beside the app, substitutes the store's
       database name, and streams the result to the mysql client on stdin. The README records the one
       step that cannot be a stored procedure. -->
  <ItemGroup>
    <Content Include="..\Database\Mock.Service\Restore\**\*"
             Link="Database\Mock.Service\Restore\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
</Project>
