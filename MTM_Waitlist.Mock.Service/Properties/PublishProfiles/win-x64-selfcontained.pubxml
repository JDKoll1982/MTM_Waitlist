<?xml version="1.0" encoding="utf-8"?>
<!--
  Folder publish profile for the on-host Module_Mock service.

  This project is deliberately UNPACKAGED (WindowsPackageType=None) and installed by copying the whole
  folder to the MySQL / Infor Visual host, so no MSIX identity, signing, or Store packaging is involved.

  `dotnet publish ... -p:PublishProfile=win-x64-selfcontained` (the command in README.md and
  quickstart.md section 2 step 1) resolves this file. Without it MSBuild reports
  NETSDK1198 'A publish profile with the name ... was not found', silently falls back to
  bin/<Config>/<TFM>/<RID>/publish, and produces a FRAMEWORK-DEPENDENT build - which would require the
  .NET runtime on the host and would contradict the guarantees this profile's properties exist to make.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PublishProtocol>FileSystem</PublishProtocol>
    <!-- The documented output location; README.md and quickstart.md both name it. -->
    <PublishDir>bin\publish\win-x64\</PublishDir>

    <!-- The four guarantees README.md's table rests on. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>

    <!-- Keep the deployed folder a plain set of files: nothing here needs a single-file or AOT build,
         and both would complicate the "copy the whole folder" deploy step. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
