<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="Platform">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MTM_Database_Deployment</RootNamespace>
    <AssemblyName>MTM_Database_Deployment</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0.0</Version>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <UseRidGraph>true</UseRidGraph>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <!--
    A WinUI project is never AnyCPU: the Windows App SDK self-contained payload and Win2D both refuse it. The
    solution already maps its "Any CPU" configuration onto x64, but a per-project build does not go through that
    mapping — the C# extension's build task passes Platform=AnyCPU straight to MSBuild, which then fails with
    "WindowsAppSDKSelfContained requires a supported Windows architecture". The TreatAsLocalProperty attribute on
    the Project element above is what lets this file replace the caller's value instead of arguing with it, so the
    same project builds whether it is reached through the solution or on its own.
  -->
  <PropertyGroup>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
  </PropertyGroup>

  <!--
    The repository's own object folders ship next to the executable so the tool works without the repo. Only the
    create scripts ship: the rollback pair stays in the repo, and the aggregates would re-run every object.
  -->
  <ItemGroup>
    <Content Include="..\Database\Tables\**\create.sql">
      <Link>Database\Tables\%(RecursiveDir)create.sql</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Database\Views\**\create.sql">
      <Link>Database\Views\%(RecursiveDir)create.sql</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Database\StoredProcedures\**\create.sql">
      <Link>Database\StoredProcedures\%(RecursiveDir)create.sql</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Database\Functions\**\create.sql">
      <Link>Database\Functions\%(RecursiveDir)create.sql</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Database\Seeds\**\create.sql">
      <Link>Database\Seeds\%(RecursiveDir)create.sql</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The maintained descriptions, which the engine applies after the tables so a fresh store reads the same
         as one that has been updated in place. -->
    <Content Include="..\Database\Bootstrap\update_table_descriptions.sql">
      <Link>Database\Bootstrap\update_table_descriptions.sql</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- The cache mirror's own tree. It describes a different schema, so it ships beside the waitlist tree and is
         chosen by the database's name rather than mixed in. -->
    <Content Include="..\Database\Mock\Tables\**\create.sql">
      <Link>Database\Mock\Tables\%(RecursiveDir)create.sql</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Database\Mock\StoredProcedures\**\create.sql">
      <Link>Database\Mock\StoredProcedures\%(RecursiveDir)create.sql</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Database\Mock\Seeds\**\create.sql">
      <Link>Database\Mock\Seeds\%(RecursiveDir)create.sql</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Database\Mock\Bootstrap\update_table_descriptions.sql">
      <Link>Database\Mock\Bootstrap\update_table_descriptions.sql</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="deployment.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Models and Services live in their own library rather than in this project, so the test suite can reference them
    without hosting the Windows App SDK: a test project that references a WinUI executable fails every test with a
    missing Microsoft.WindowsAppRuntime.dll module initializer. The namespaces are unchanged, so this project's own
    code reads exactly as the reference module does.
  -->
  <ItemGroup>
    <ProjectReference Include="..\MTM_Database_Deployment.Core\MTM_Database_Deployment.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DevWinUI" Version="10.8.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
  </ItemGroup>

</Project>
