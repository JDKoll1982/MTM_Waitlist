<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MTM_Database_Deployment.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:MTM_Database_Deployment.Converters"
    xmlns:dev="using:DevWinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Database_Deployment.Models"
    mc:Ignorable="d"
    Title="Update the MTM database">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <Grid.Resources>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="FriendlyBody" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <Style x:Key="FriendlyHint" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header: what this app is for, in one sentence.  -->
        <Grid Padding="28,20,28,10" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Width="46"
                Height="46"
                VerticalAlignment="Center"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="12">
                <FontIcon
                    FontSize="22"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Glyph="&#xE74E;" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Update the MTM database" />
                <TextBlock Style="{StaticResource FriendlyHint}" Text="This keeps the database in step with the app. It only adds what is missing." />
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.ServerDetail, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!--  Sign-in lives behind a person icon so the user name and password are one click away.  -->
            <Button
                Grid.Column="2"
                MinWidth="150"
                VerticalAlignment="Center"
                AutomationProperties.Name="Database sign-in">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE77B;" />
                        <TextBlock Text="{x:Bind ViewModel.SignInSummary, Mode=OneWay}" VerticalAlignment="Center" />
                        <FontIcon FontSize="10" Glyph="&#xE70D;" />
                    </StackPanel>
                </Button.Content>
                <Button.Flyout>
                    <Flyout x:Name="SignInFlyout" Opening="OnSignInFlyoutOpening" Placement="BottomEdgeAlignedRight">
                        <StackPanel Width="340" Spacing="12">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Database sign-in" />
                            <TextBlock Style="{StaticResource FriendlyHint}" Text="The user name and password for the database computer. They are remembered on this PC only." />

                            <TextBox Header="User name" Text="{x:Bind ViewModel.UserName, Mode=TwoWay}" />
                            <PasswordBox
                                x:Name="FlyoutPasswordBox"
                                Header="Password"
                                PasswordChanged="OnFlyoutPasswordChanged" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{x:Bind ViewModel.CheckSignInCommand}" Content="Check sign-in" />
                                <Button
                                    Click="OnSaveCredentialsClick"
                                    Content="Save"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="14"
                                    Glyph="{x:Bind ViewModel.SignInGlyph, Mode=OneWay}"
                                    VerticalAlignment="Top" />
                                <TextBlock Style="{StaticResource FriendlyHint}" Text="{x:Bind ViewModel.SignInMessage, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!--  Progress trail. AutoSelectOnItemClick stays off so the trail cannot skip a step.  -->
        <dev:StepBar
            x:Name="Trail"
            Grid.Row="1"
            Margin="28,0,28,6"
            AutomationProperties.Name="Progress through the update"
            AutoSelectOnItemClick="False"
            DisplayMode="Index"
            HeaderDisplayMode="Bottom"
            ShowStepIndex="True"
            StepIndex="{x:Bind ViewModel.StepIndex, Mode=OneWay}">
            <dev:StepBarItem Content="Connect" />
            <dev:StepBarItem Content="Check" />
            <dev:StepBarItem Content="Save" />
        </dev:StepBar>

        <ScrollViewer
            Grid.Row="2"
            Padding="28,6,28,20"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">

            <StackPanel Spacing="16">

                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.StepTitle, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource FriendlyHint}" Text="{x:Bind ViewModel.StepHint, Mode=OneWay}" />
                </StackPanel>

                <!--  STEP 1 - connect  -->
                <StackPanel Spacing="16" Visibility="{x:Bind ui:Show.If(ViewModel.IsStep1), Mode=OneWay}">

                    <!--  InfoCard is a fixed-size tile, so two of them read as a deliberate pair rather than one lost tile.  -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="16">
                        <dev:InfoCard
                            MinHeight="104"
                            Description="Press Connect. The tool tries the usual database computer first, then this PC."
                            Title="We find the database for you" />
                        <dev:InfoCard
                            MinHeight="104"
                            Description="It only adds what is missing. Your records are never removed unless you tick a box."
                            Title="Your records stay put" />
                    </StackPanel>

                    <!--  Which database. Two clear choices beat a free-text box for an operator.  -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Which database should we update?" />
                            <TextBlock Style="{StaticResource FriendlyHint}" Text="Pick the live database unless IT has asked you to work on the test copy." />

                            <RadioButtons
                                AutomationProperties.Name="Which database"
                                ItemsSource="{x:Bind ViewModel.DatabaseOptions}"
                                SelectedIndex="{x:Bind ViewModel.DatabaseIndex, Mode=TwoWay}">
                                <RadioButtons.ItemTemplate>
                                    <DataTemplate x:DataType="models:Model_DatabaseOption">
                                        <StackPanel Margin="0,6" Spacing="2">
                                            <TextBlock
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Display}"
                                                TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource FriendlyHint}" Text="{x:Bind Description}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </RadioButtons.ItemTemplate>
                            </RadioButtons>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                FontSize="26"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE946;"
                                VerticalAlignment="Top" />

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.ConnectionHeadline, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource FriendlyBody}" Text="{x:Bind ViewModel.ConnectionDetail, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Header="Advanced settings - only change these if IT asks you to">

                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBox
                                Grid.Row="0"
                                Grid.Column="0"
                                Header="Usual database computer"
                                Text="{x:Bind ViewModel.PreferredServer, Mode=TwoWay}" />

                            <TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Header="Spare (this PC)"
                                Text="{x:Bind ViewModel.FallbackServer, Mode=TwoWay}" />

                            <NumberBox
                                Grid.Row="1"
                                Grid.Column="0"
                                Header="Port"
                                Value="{x:Bind ViewModel.Port, Mode=TwoWay}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="A different database name can be added to deployment.settings.json." />

                            <TextBlock
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind ViewModel.FolderDetail}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Expander>
                </StackPanel>

                <!--  STEP 2 - what will change  -->
                <StackPanel Spacing="16" Visibility="{x:Bind ui:Show.If(ViewModel.IsStep2), Mode=OneWay}">

                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                FontSize="26"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE9D9;"
                                VerticalAlignment="Top" />

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.ChangeHeadline, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource FriendlyBody}" Text="{x:Bind ViewModel.ChangeDetail, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.ChangeGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Model_ChangeGroup">
                                <Border
                                    Margin="0,0,0,12"
                                    Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon
                                                FontSize="18"
                                                Glyph="{x:Bind Glyph}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Title}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource FriendlyHint}" Text="{x:Bind Summary}" />

                                        <Expander
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Header="Show what exactly">
                                            <ItemsControl ItemsSource="{x:Bind Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock
                                                            Margin="0,2"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind}"
                                                            TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!--  STEP 3 - save  -->
                <StackPanel Spacing="16" Visibility="{x:Bind ui:Show.If(ViewModel.IsStep3), Mode=OneWay}">

                    <!--  Recap: the operator should be able to see what they are about to save without going back.  -->
                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ui:Show.If(ViewModel.HasChecked), Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.ChangeHeadline, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource FriendlyHint}" Text="{x:Bind ViewModel.ChangeDetail, Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ChangeGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Model_ChangeGroup">
                                        <StackPanel
                                            Margin="0,3"
                                            Orientation="Horizontal"
                                            Spacing="10">
                                            <FontIcon
                                                FontSize="14"
                                                Glyph="{x:Bind Glyph}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Text="{x:Bind Title}"
                                                TextWrapping="Wrap"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="How should we update it?" />
                            <TextBlock Style="{StaticResource FriendlyHint}" Text="Leave this on the recommended choice unless IT tells you otherwise." />

                            <dev:SelectorBarSegmented
                                x:Name="ModeSegments"
                                AutomationProperties.Name="Update method"
                                HorizontalAlignment="Left"
                                SelectionChanged="OnModeChanged">
                                <SelectorBarItem
                                    IsSelected="True"
                                    Tag="safe"
                                    Text="Safe update (recommended)" />
                                <SelectorBarItem Tag="reset" Text="Start over (erases everything)" />
                            </dev:SelectorBarSegmented>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE72E;"
                                    VerticalAlignment="Top" />
                                <TextBlock Style="{StaticResource FriendlyBody}" Text="{x:Bind ViewModel.SafetyLine, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ui:Show.If(ViewModel.IsSafeMode), Mode=OneWay}">
                        <CheckBox Content="Also remove leftovers - old columns and tables this tool does not use" IsChecked="{x:Bind ViewModel.RemoveDatabaseOnlyObjects, Mode=TwoWay}" />
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ui:Show.If(ViewModel.IsRebuildMode), Mode=OneWay}">
                        <CheckBox Content="I understand every record in the database will be erased" IsChecked="{x:Bind ViewModel.ConfirmRebuild, Mode=TwoWay}" />
                    </Border>
                </StackPanel>

                <!--  Outcome. Persistent, not a toast, because it can carry a "send this to IT" action.  -->
                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ui:Show.If(ViewModel.HasResult), Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon
                                FontSize="26"
                                Glyph="{x:Bind ViewModel.ResultGlyph, Mode=OneWay}"
                                VerticalAlignment="Top" />
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.ResultHeadline, Mode=OneWay}"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource FriendlyBody}" Text="{x:Bind ViewModel.ResultDetail, Mode=OneWay}" />

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                Command="{x:Bind ViewModel.OpenReportCommand}"
                                Content="Open the details"
                                Visibility="{x:Bind ui:Show.If(ViewModel.HasReport), Mode=OneWay}" />
                            <Button Command="{x:Bind ViewModel.SaveDetailsCopyCommand}" Content="Save a copy for IT" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Technical detail stays folded away unless someone asks for it.  -->
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Visibility="{x:Bind ui:Show.If(ViewModel.HasTechnicalDetails), Mode=OneWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="14" Glyph="&#xE7C3;" VerticalAlignment="Center" />
                            <TextBlock Text="Technical details - for IT" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="12"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.TechnicalDetails, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!--  Action bar  -->
        <Border
            Grid.Row="3"
            Padding="28,14"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
                    <ProgressRing
                        Width="18"
                        Height="18"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Visibility="{x:Bind ui:Show.If(ViewModel.IsBusy), Mode=OneWay}" />
                    <TextBlock
                        MaxWidth="560"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.ProgressMessage, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.GoBackCommand}"
                    Content="Back"
                    Visibility="{x:Bind ui:Show.If(ViewModel.CanGoBack), Mode=OneWay}" />

                <Button
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.CancelCommand}"
                    Content="Stop"
                    Visibility="{x:Bind ui:Show.If(ViewModel.IsBusy), Mode=OneWay}" />

                <Button
                    Grid.Column="3"
                    MinWidth="190"
                    AutomationProperties.Name="Connect to the database"
                    Command="{x:Bind ViewModel.ConnectCommand}"
                    Content="Connect"
                    IsEnabled="{x:Bind ViewModel.CanConnect, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind ui:Show.If(ViewModel.IsStep1), Mode=OneWay}" />

                <Button
                    Grid.Column="3"
                    MinWidth="210"
                    AutomationProperties.Name="Check what will change"
                    Command="{x:Bind ViewModel.CheckCommand}"
                    Content="{x:Bind ViewModel.CheckButtonText, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanCheck, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind ui:Show.If(ViewModel.IsStep2), Mode=OneWay}" />

                <dev:ProgressButton
                    Grid.Column="3"
                    MinWidth="250"
                    AutomationProperties.Name="Save the changes"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    CheckedContent="{x:Bind ViewModel.SaveButtonBusyText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.SaveCommand}"
                    Content="{x:Bind ViewModel.SaveButtonText, Mode=OneWay}"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    IsChecked="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                    IsIndeterminateProgressRing="True"
                    ProgressRingVisibility="Visible"
                    Visibility="{x:Bind ui:Show.If(ViewModel.IsStep3), Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Window>