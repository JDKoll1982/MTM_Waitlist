<Page
    x:Class="MTM_Waitlist.Module_Core.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:MTM_Waitlist.Module_Core.Behaviors"
    xmlns:converters="using:MTM_Waitlist.Module_Settings.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:headerModels="using:MTM_Waitlist.Module_Core.Models"
    xmlns:helpers="using:MTM_Waitlist.Module_Core.Helpers"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Waitlist.Models"
    xmlns:mock="using:MTM_Waitlist.Module_Mock.Views"
    xmlns:selectors="using:MTM_Waitlist.Module_Core.Selectors"
    xmlns:shared="using:MTM_Waitlist.Module_Shared.Services"
    x:Name="RootPage"
    KeyboardAcceleratorPlacementMode="Hidden"
    Loaded="OnLoaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!--
        The navigation pane's own scale. The labels carry this size, and the control's Settings entry is given the
        same size in code-behind because the control generates that item rather than this page declaring it.
        -->
        <x:Double x:Key="ShellNavItemFontSize">18</x:Double>

        <SolidColorBrush x:Key="HeaderStepCurrentBrush" Color="#FFF7630C" />
        <DataTemplate x:Key="HeaderStepPendingTemplate" x:DataType="headerModels:HeaderStep">
            <Grid Width="120">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Rectangle
                        Grid.Column="0"
                        Width="60"
                        Height="2"
                        Margin="0,13,0,0"
                        VerticalAlignment="Top"
                        Fill="{x:Bind LeftConnectorBrush, Mode=OneWay}"
                        Visibility="{x:Bind LeftConnectorVisibility, Mode=OneWay}" />
                    <Rectangle
                        Grid.Column="1"
                        Width="60"
                        Height="2"
                        Margin="0,13,0,0"
                        VerticalAlignment="Top"
                        Fill="{x:Bind RightConnectorBrush, Mode=OneWay}"
                        Visibility="{x:Bind RightConnectorVisibility, Mode=OneWay}" />
                    <Border
                        Grid.ColumnSpan="2"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="14">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{x:Bind StepNumber}" />
                    </Border>
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Label}"
                    TextAlignment="Center"
                    TextWrapping="NoWrap" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="HeaderStepCurrentTemplate" x:DataType="headerModels:HeaderStep">
            <Grid Width="120">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Rectangle
                        Grid.Column="0"
                        Width="60"
                        Height="2"
                        Margin="0,13,0,0"
                        VerticalAlignment="Top"
                        Fill="{x:Bind LeftConnectorBrush, Mode=OneWay}"
                        Visibility="{x:Bind LeftConnectorVisibility, Mode=OneWay}" />
                    <Rectangle
                        Grid.Column="1"
                        Width="60"
                        Height="2"
                        Margin="0,13,0,0"
                        VerticalAlignment="Top"
                        Fill="{x:Bind RightConnectorBrush, Mode=OneWay}"
                        Visibility="{x:Bind RightConnectorVisibility, Mode=OneWay}" />
                    <Border
                        Grid.ColumnSpan="2"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Center"
                        Background="{StaticResource HeaderStepCurrentBrush}"
                        CornerRadius="14">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{x:Bind StepNumber}" />
                    </Border>
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Text="{x:Bind Label}"
                    TextAlignment="Center"
                    TextWrapping="NoWrap" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="HeaderStepCompleteTemplate" x:DataType="headerModels:HeaderStep">
            <Grid Width="120">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Rectangle
                        Grid.Column="0"
                        Width="60"
                        Height="2"
                        Margin="0,13,0,0"
                        VerticalAlignment="Top"
                        Fill="{x:Bind LeftConnectorBrush, Mode=OneWay}"
                        Visibility="{x:Bind LeftConnectorVisibility, Mode=OneWay}" />
                    <Rectangle
                        Grid.Column="1"
                        Width="60"
                        Height="2"
                        Margin="0,13,0,0"
                        VerticalAlignment="Top"
                        Fill="{x:Bind RightConnectorBrush, Mode=OneWay}"
                        Visibility="{x:Bind RightConnectorVisibility, Mode=OneWay}" />
                    <Border
                        Grid.ColumnSpan="2"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="14">
                        <FontIcon
                            FontSize="14"
                            Foreground="White"
                            Glyph="&#xE73E;"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="{x:Bind Label}"
                    TextAlignment="Center"
                    TextWrapping="NoWrap" />
            </Grid>
        </DataTemplate>
        <selectors:HeaderStepTemplateSelector
            x:Key="HeaderStepTemplateSelector"
            CompleteTemplate="{StaticResource HeaderStepCompleteTemplate}"
            CurrentTemplate="{StaticResource HeaderStepCurrentTemplate}"
            PendingTemplate="{StaticResource HeaderStepPendingTemplate}" />
    </Page.Resources>

    <Grid>
        <Grid
            x:Name="AppTitleBar"
            Height="{Binding ElementName=NavigationViewControl, Path=CompactPaneLength}"
            VerticalAlignment="Top"
            Canvas.ZIndex="1"
            IsHitTestVisible="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="0"
                Width="16"
                Height="16"
                Margin="8,0,4,0"
                Source="/Assets/Packaging/window-icon.ico" />
            <TextBlock
                x:Name="AppTitleBarText"
                Grid.Column="1"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="NoWrap" />
            <AutoSuggestBox
                AutomationProperties.AutomationId="ShellPage_SearchBox"
                x:Name="TitleBarSearchBox"
                Grid.Column="2"
                MaxWidth="400"
                Margin="8,0,8,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                PlaceholderText="Search requests"
                QueryIcon="Find"
                QuerySubmitted="TitleBarSearchBox_QuerySubmitted"
                SuggestionChosen="TitleBarSearchBox_SuggestionChosen"
                TextChanged="TitleBarSearchBox_TextChanged"
                shared:TooltipBehavior.ResourceKey="Shell_SearchBox_Tooltip"
                shared:TooltipBehavior.AssociatedFiles="Module_Core/Views/ShellPage.xaml|Module_Core/Views/ShellPage.xaml.cs|Module_Core/ViewModels/ShellViewModel.cs|Module_Waitlist/Models/SampleOrder.cs|Module_Core/Contracts/Services/IBuildingSelectionService.cs|Module_Core/Services/BuildingSelectionService.cs|Module_Core/Helpers/ResourceExtensions.cs|Module_Shared/Services/TooltipBehavior.cs|Module_Shared/Services/TooltipService.cs|Module_Shared/Services/ControlInspectorService.cs"
                shared:TooltipBehavior.FallbackText="Search active requests and related data.">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="models:SampleOrder">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Title}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind RequestedByName}" />
                        </StackPanel>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
        </Grid>
        <NavigationView
            AutomationProperties.AutomationId="ShellPage_Navigation"
            x:Name="NavigationViewControl"
            Canvas.ZIndex="0"
            DisplayModeChanged="NavigationViewControl_DisplayModeChanged"
            ExpandedModeThresholdWidth="1280"
            OpenPaneLength="260"
            CompactPaneLength="48"
            Header="{x:Bind ViewModel}"
            IsBackButtonVisible="Visible"
            IsBackEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}"
            IsSettingsVisible="True"
            SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}">
            <!--
            The navigation pane drawn larger than the shipped default: a 16-pixel icon and the stock 36-pixel row
            are hard to read on a shop-floor screen. Both are theme resources the item's own template reads, so
            overriding them here resizes every item at once — the declared ones and the control's Settings entry —
            without replacing the item style, which would take the item's template with it.
            -->
            <NavigationView.Resources>
                <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">28</x:Double>
                <x:Double x:Key="NavigationViewItemOnLeftMinHeight">48</x:Double>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <!--
                TODO: Update item titles by updating <x:Uid>.Content entries in Strings/en-us/Resources.resw.
                https://docs.microsoft.com/windows/uwp/app-resources/localize-strings-ui-manifest#refer-to-a-string-resource-identifier-from-xaml

                The icons are font glyphs rather than the greyscale artwork in Assets/Icons. A bitmap is scaled up to
                fill the pane's icon box and goes soft as the pane grows, which is what the pane was doing; a glyph is
                drawn as an outline and stays sharp at any size. Both codes are taken from the Segoe Fluent Icons
                list — e8fd is BulletedList and e90f is Repair — and both are also in the older Segoe MDL2 Assets
                set, which is what a Windows 10 machine falls back to.
                -->
                <NavigationViewItem AutomationProperties.AutomationId="ShellPage_WaitlistNavItem" x:Uid="Shell_WaitlistView" FontSize="{StaticResource ShellNavItemFontSize}" helpers:NavigationHelper.NavigateTo="MTM_Waitlist.Module_Waitlist.ViewModels.WaitlistViewViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.AutomationId="ShellPage_WorkCenterSetupNavItem" x:Uid="Shell_ModuleSetup" FontSize="{StaticResource ShellNavItemFontSize}" helpers:NavigationHelper.NavigateTo="MTM_Waitlist.Module_Setup.ViewModels.SetupWorkCenterViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.HeaderTemplate>
                <DataTemplate>
                    <Grid HorizontalAlignment="Stretch" MinHeight="64" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{ThemeResource BodyLargeStrongTextBlockStyle}"
                                Text="{Binding HeaderText}" />
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsMyRequestsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    Text="{Binding MyRequestsFilterLabel}" />
                                <ToggleSwitch
                                    AutomationProperties.AutomationId="ShellPage_MyRequestsToggle"
                                    MinWidth="0"
                                    MinHeight="0"
                                    VerticalAlignment="Center"
                                    IsOn="{Binding ShowMyRequestsOnly, Mode=TwoWay}"
                                    Toggled="MyRequestsToggle_Toggled"
                                    OffContent=""
                                    OnContent=""
                                    AutomationProperties.Name="Show only my requests" />
                            </StackPanel>
                            <!-- What the list is sorted by. Every option shares one group name so the control
                                 offers them as a radio set; which one is ticked is set from the view model when
                                 the menu opens, because these items live in the shell's own header template. -->
                            <Button
                                AutomationProperties.AutomationId="ShellPage_SortButton"
                                Grid.Column="2"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Content="{Binding SortOrderLabel}"
                                Visibility="{Binding IsMyRequestsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                shared:TooltipBehavior.ResourceKey="Shell_SortOrder_Tooltip"
                                shared:TooltipBehavior.AssociatedFiles="Module_Core/Views/ShellPage.xaml|Module_Core/ViewModels/ShellViewModel.cs|MTM_Waitlist.Core/Contracts/Services/WaitlistSortOrder.cs|MTM_Waitlist.Core/Services/UrgencyCalculator.cs"
                                shared:TooltipBehavior.FallbackText="Choose what the list is sorted by.">
                                <Button.Flyout>
                                    <MenuFlyout Opening="SortOrderFlyout_Opening">
                                        <RadioMenuFlyoutItem
                                            AutomationProperties.AutomationId="ShellPage_SortMostUrgentItem"
                                            GroupName="WaitlistSortOrder"
                                            Tag="most-urgent"
                                            Text="{Binding SortOrderMostUrgentLabel}"
                                            Click="SortOrderItem_Click" />
                                        <RadioMenuFlyoutItem
                                            AutomationProperties.AutomationId="ShellPage_SortLongestWaitingItem"
                                            GroupName="WaitlistSortOrder"
                                            Tag="longest-waiting"
                                            Text="{Binding SortOrderLongestWaitingLabel}"
                                            Click="SortOrderItem_Click" />
                                        <RadioMenuFlyoutItem
                                            AutomationProperties.AutomationId="ShellPage_SortPressItem"
                                            GroupName="WaitlistSortOrder"
                                            Tag="press"
                                            Text="{Binding SortOrderPressLabel}"
                                            Click="SortOrderItem_Click" />
                                        <RadioMenuFlyoutItem
                                            AutomationProperties.AutomationId="ShellPage_SortRequestedByItem"
                                            GroupName="WaitlistSortOrder"
                                            Tag="requested-by"
                                            Text="{Binding SortOrderRequestedByLabel}"
                                            Click="SortOrderItem_Click" />
                                        <RadioMenuFlyoutItem
                                            AutomationProperties.AutomationId="ShellPage_SortStatusItem"
                                            GroupName="WaitlistSortOrder"
                                            Tag="status"
                                            Text="{Binding SortOrderStatusLabel}"
                                            Click="SortOrderItem_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <ComboBox
                                AutomationProperties.AutomationId="ShellPage_FacilitySelector"
                                x:Name="FacilitySelectorComboBox"
                                Grid.Column="3"
                                MinWidth="160"
                                MaxWidth="220"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding Buildings}"
                                SelectedItem="{Binding SelectedBuilding, Mode=TwoWay}"
                                shared:TooltipBehavior.ResourceKey="Shell_SelectFacility_Tooltip"
                                shared:TooltipBehavior.AssociatedFiles="Module_Core/Views/ShellPage.xaml|Module_Core/Views/ShellPage.xaml.cs|Module_Core/ViewModels/ShellViewModel.cs|Module_Core/Contracts/Services/IBuildingSelectionService.cs|Module_Core/Services/BuildingSelectionService.cs|Module_Core/Helpers/ResourceExtensions.cs|Module_Shared/Services/TooltipBehavior.cs|Module_Shared/Services/TooltipService.cs|Module_Shared/Services/ControlInspectorService.cs"
                                shared:TooltipBehavior.FallbackText="Select the active facility." />
                            <Button
                                AutomationProperties.AutomationId="ShellPage_CurrentUserButton"
                                x:Name="CurrentUserButton"
                                Grid.Column="4"
                                Margin="16,0,0,0"
                                Padding="8"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                shared:TooltipBehavior.ResourceKey="Shell_CurrentUser_Tooltip"
                                shared:TooltipBehavior.AssociatedFiles="Module_Core/Views/ShellPage.xaml|Module_Core/Views/ShellPage.xaml.cs|ViewModels/ShellViewModel.cs|Module_Startup/Models/StartupState.cs|MTM_Waitlist.Core/Contracts/Services/ISignOutService.cs|MTM_Waitlist.Startup/Services/SignOutService.cs|MTM_Waitlist.Startup/Services/SignInSessionKeys.cs|MTM_Waitlist.Startup/Services/AppProcessRestarter.cs|Strings/en-us/Resources.resw|Module_Core/Helpers/ResourceExtensions.cs|Module_Shared/Services/TooltipBehavior.cs|Module_Shared/Services/TooltipService.cs|Module_Shared/Services/ControlInspectorService.cs"
                                shared:TooltipBehavior.FallbackText="View the current signed-in user, or sign out.">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem
                                            AutomationProperties.AutomationId="ShellPage_SignOutItem"
                                            Click="SignOutItem_Click"
                                            Text="{Binding SignOutLabel}"
                                            ToolTipService.ToolTip="{Binding SignOutTooltip}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border
                                        Width="32"
                                        Height="32"
                                        Background="{Binding CurrentUserBadgeBrush}"
                                        CornerRadius="16">
                                        <FontIcon
                                            FontSize="16"
                                            Foreground="White"
                                            Glyph="{Binding CurrentUserIconGlyph}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        MaxWidth="220"
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{Binding CurrentUserDisplayName}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                            HorizontalAlignment="Center"                            
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled"
                            Visibility="{Binding IsHeaderProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl
                                ItemTemplateSelector="{StaticResource HeaderStepTemplateSelector}"
                                ItemsSource="{Binding HeaderSteps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="0" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>

                    </Grid>
                </DataTemplate>
            </NavigationView.HeaderTemplate>
            <i:Interaction.Behaviors>
                <behaviors:NavigationViewHeaderBehavior DefaultHeader="{x:Bind ViewModel}">
                    <behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
                        <DataTemplate>
                            <Grid MinHeight="64" Margin="0,0,60,0" RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{ThemeResource BodyLargeStrongTextBlockStyle}"
                                        Text="{Binding HeaderText}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsMyRequestsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{ThemeResource BodyTextBlockStyle}"
                                            Text="{Binding MyRequestsFilterLabel}" />
                                        <ToggleSwitch
                                            AutomationProperties.AutomationId="ShellPage_MyRequestsToggleDefault"
                                            MinWidth="0"
                                            MinHeight="0"
                                            VerticalAlignment="Center"
                                            IsOn="{Binding ShowMyRequestsOnly, Mode=TwoWay}"
                                            Toggled="MyRequestsToggle_Toggled"
                                            OffContent=""
                                            OnContent=""
                                            AutomationProperties.Name="Show only my requests" />
                                    </StackPanel>
                                    <!-- The same sort control as the navigation-view header carries, for the shell
                                         state where no page supplies its own header. -->
                                    <Button
                                        AutomationProperties.AutomationId="ShellPage_SortButtonDefault"
                                        Grid.Column="2"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="{Binding SortOrderLabel}"
                                        Visibility="{Binding IsMyRequestsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                        shared:TooltipBehavior.ResourceKey="Shell_SortOrder_Tooltip"
                                        shared:TooltipBehavior.AssociatedFiles="Module_Core/Views/ShellPage.xaml|Module_Core/ViewModels/ShellViewModel.cs|MTM_Waitlist.Core/Contracts/Services/WaitlistSortOrder.cs|MTM_Waitlist.Core/Services/UrgencyCalculator.cs"
                                        shared:TooltipBehavior.FallbackText="Choose what the list is sorted by.">
                                        <Button.Flyout>
                                            <MenuFlyout Opening="SortOrderFlyout_Opening">
                                                <RadioMenuFlyoutItem
                                                    AutomationProperties.AutomationId="ShellPage_SortMostUrgentItemDefault"
                                                    GroupName="WaitlistSortOrder"
                                                    Tag="most-urgent"
                                                    Text="{Binding SortOrderMostUrgentLabel}"
                                                    Click="SortOrderItem_Click" />
                                                <RadioMenuFlyoutItem
                                                    AutomationProperties.AutomationId="ShellPage_SortLongestWaitingItemDefault"
                                                    GroupName="WaitlistSortOrder"
                                                    Tag="longest-waiting"
                                                    Text="{Binding SortOrderLongestWaitingLabel}"
                                                    Click="SortOrderItem_Click" />
                                                <RadioMenuFlyoutItem
                                                    AutomationProperties.AutomationId="ShellPage_SortPressItemDefault"
                                                    GroupName="WaitlistSortOrder"
                                                    Tag="press"
                                                    Text="{Binding SortOrderPressLabel}"
                                                    Click="SortOrderItem_Click" />
                                                <RadioMenuFlyoutItem
                                                    AutomationProperties.AutomationId="ShellPage_SortRequestedByItemDefault"
                                                    GroupName="WaitlistSortOrder"
                                                    Tag="requested-by"
                                                    Text="{Binding SortOrderRequestedByLabel}"
                                                    Click="SortOrderItem_Click" />
                                                <RadioMenuFlyoutItem
                                                    AutomationProperties.AutomationId="ShellPage_SortStatusItemDefault"
                                                    GroupName="WaitlistSortOrder"
                                                    Tag="status"
                                                    Text="{Binding SortOrderStatusLabel}"
                                                    Click="SortOrderItem_Click" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <ComboBox
                                        AutomationProperties.AutomationId="ShellPage_FacilitySelectorDefault"
                                        x:Name="FacilitySelectorComboBoxDefault"
                                        Grid.Column="3"
                                        MinWidth="160"
                                        MaxWidth="220"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        ItemsSource="{Binding Buildings}"
                                        SelectedItem="{Binding SelectedBuilding, Mode=TwoWay}"
                                        shared:TooltipBehavior.ResourceKey="Shell_SelectFacility_Tooltip"
                                        shared:TooltipBehavior.AssociatedFiles="Module_Core/Views/ShellPage.xaml|Module_Core/Views/ShellPage.xaml.cs|Module_Core/ViewModels/ShellViewModel.cs|Module_Core/Contracts/Services/IBuildingSelectionService.cs|Module_Core/Services/BuildingSelectionService.cs|Module_Core/Helpers/ResourceExtensions.cs|Module_Shared/Services/TooltipBehavior.cs|Module_Shared/Services/TooltipService.cs|Module_Shared/Services/ControlInspectorService.cs"
                                        shared:TooltipBehavior.FallbackText="Select the active facility." />
                                    <Button
                                        AutomationProperties.AutomationId="ShellPage_CurrentUserButtonDefault"
                                        x:Name="CurrentUserButtonDefault"
                                        Grid.Column="4"
                                        Margin="16,0,0,0"
                                        Padding="8"
                                        HorizontalAlignment="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        shared:TooltipBehavior.ResourceKey="Shell_CurrentUser_Tooltip"
                                        shared:TooltipBehavior.AssociatedFiles="Module_Core/Views/ShellPage.xaml|Module_Core/Views/ShellPage.xaml.cs|ViewModels/ShellViewModel.cs|Module_Startup/Models/StartupState.cs|MTM_Waitlist.Core/Contracts/Services/ISignOutService.cs|MTM_Waitlist.Startup/Services/SignOutService.cs|MTM_Waitlist.Startup/Services/SignInSessionKeys.cs|MTM_Waitlist.Startup/Services/AppProcessRestarter.cs|Strings/en-us/Resources.resw|Module_Core/Helpers/ResourceExtensions.cs|Module_Shared/Services/TooltipBehavior.cs|Module_Shared/Services/TooltipService.cs|Module_Shared/Services/ControlInspectorService.cs"
                                        shared:TooltipBehavior.FallbackText="View the current signed-in user, or sign out.">
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem
                                                    AutomationProperties.AutomationId="ShellPage_SignOutItemDefault"
                                                    Click="SignOutItem_Click"
                                                    Text="{Binding SignOutLabel}"
                                                    ToolTipService.ToolTip="{Binding SignOutTooltip}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Border
                                                Width="32"
                                                Height="32"
                                                Background="{Binding CurrentUserBadgeBrush}"
                                                CornerRadius="16">
                                                <FontIcon
                                                    FontSize="16"
                                                    Foreground="White"
                                                    Glyph="{Binding CurrentUserIconGlyph}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                MaxWidth="220"
                                                Style="{ThemeResource BodyTextBlockStyle}"
                                                Text="{Binding CurrentUserDisplayName}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ScrollViewer
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Auto"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled"
                                    Visibility="{Binding IsHeaderProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl
                                        ItemTemplateSelector="{StaticResource HeaderStepTemplateSelector}"
                                        ItemsSource="{Binding HeaderSteps}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="0" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </DataTemplate>
                    </behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
                </behaviors:NavigationViewHeaderBehavior>
            </i:Interaction.Behaviors>
            <Grid Margin="{StaticResource NavigationViewPageContentMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                  Read-only fallback status, hosted in the existing shell: no new navigation route and no
                  interactive control. It appears only while cached data is in use and clears itself when
                  Infor Visual recovers (FR-003/FR-005, US4).
                -->
                <mock:ReadStatusIndicator
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch" />

                <Frame x:Name="NavigationFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Page>
