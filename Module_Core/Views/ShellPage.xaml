<Page
    x:Class="MTM_Waitlist.Module_Core.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:MTM_Waitlist.Module_Core.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:headerModels="using:MTM_Waitlist.Module_Core.Models"
    xmlns:helpers="using:MTM_Waitlist.Module_Core.Helpers"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Waitlist.Models"
    xmlns:selectors="using:MTM_Waitlist.Module_Core.Selectors"
    xmlns:shared="using:MTM_Waitlist.Module_Shared.Services"
    x:Name="RootPage"
    KeyboardAcceleratorPlacementMode="Hidden"
    Loaded="OnLoaded">

    <Page.Resources>
        <SolidColorBrush x:Key="HeaderStepCurrentBrush" Color="#FFF7630C" />
        <DataTemplate x:Key="HeaderStepPendingTemplate" x:DataType="headerModels:HeaderStep">
            <Grid Width="120">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Rectangle
                        Grid.Column="0"
                        Width="60"
                        Height="2"
                        Margin="0,13,0,0"
                        VerticalAlignment="Top"
                        Fill="{x:Bind LeftConnectorBrush, Mode=OneWay}"
                        Visibility="{x:Bind LeftConnectorVisibility, Mode=OneWay}" />
                    <Rectangle
                        Grid.Column="1"
                        Width="60"
                        Height="2"
                        Margin="0,13,0,0"
                        VerticalAlignment="Top"
                        Fill="{x:Bind RightConnectorBrush, Mode=OneWay}"
                        Visibility="{x:Bind RightConnectorVisibility, Mode=OneWay}" />
                    <Border
                        Grid.ColumnSpan="2"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="14">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{x:Bind StepNumber}" />
                    </Border>
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Label}"
                    TextAlignment="Center"
                    TextWrapping="NoWrap" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="HeaderStepCurrentTemplate" x:DataType="headerModels:HeaderStep">
            <Grid Width="120">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Rectangle
                        Grid.Column="0"
                        Width="60"
                        Height="2"
                        Margin="0,13,0,0"
                        VerticalAlignment="Top"
                        Fill="{x:Bind LeftConnectorBrush, Mode=OneWay}"
                        Visibility="{x:Bind LeftConnectorVisibility, Mode=OneWay}" />
                    <Rectangle
                        Grid.Column="1"
                        Width="60"
                        Height="2"
                        Margin="0,13,0,0"
                        VerticalAlignment="Top"
                        Fill="{x:Bind RightConnectorBrush, Mode=OneWay}"
                        Visibility="{x:Bind RightConnectorVisibility, Mode=OneWay}" />
                    <Border
                        Grid.ColumnSpan="2"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Center"
                        Background="{StaticResource HeaderStepCurrentBrush}"
                        CornerRadius="14">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{x:Bind StepNumber}" />
                    </Border>
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Text="{x:Bind Label}"
                    TextAlignment="Center"
                    TextWrapping="NoWrap" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="HeaderStepCompleteTemplate" x:DataType="headerModels:HeaderStep">
            <Grid Width="120">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Rectangle
                        Grid.Column="0"
                        Width="60"
                        Height="2"
                        Margin="0,13,0,0"
                        VerticalAlignment="Top"
                        Fill="{x:Bind LeftConnectorBrush, Mode=OneWay}"
                        Visibility="{x:Bind LeftConnectorVisibility, Mode=OneWay}" />
                    <Rectangle
                        Grid.Column="1"
                        Width="60"
                        Height="2"
                        Margin="0,13,0,0"
                        VerticalAlignment="Top"
                        Fill="{x:Bind RightConnectorBrush, Mode=OneWay}"
                        Visibility="{x:Bind RightConnectorVisibility, Mode=OneWay}" />
                    <Border
                        Grid.ColumnSpan="2"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="14">
                        <FontIcon
                            FontSize="14"
                            Foreground="White"
                            Glyph="&#xE73E;"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="{x:Bind Label}"
                    TextAlignment="Center"
                    TextWrapping="NoWrap" />
            </Grid>
        </DataTemplate>
        <selectors:HeaderStepTemplateSelector
            x:Key="HeaderStepTemplateSelector"
            CompleteTemplate="{StaticResource HeaderStepCompleteTemplate}"
            CurrentTemplate="{StaticResource HeaderStepCurrentTemplate}"
            PendingTemplate="{StaticResource HeaderStepPendingTemplate}" />
    </Page.Resources>

    <Grid>
        <Grid
            x:Name="AppTitleBar"
            Height="{Binding ElementName=NavigationViewControl, Path=CompactPaneLength}"
            VerticalAlignment="Top"
            Canvas.ZIndex="1"
            IsHitTestVisible="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="0"
                Width="16"
                Height="16"
                Margin="8,0,4,0"
                Source="/Assets/WindowIcon.ico" />
            <TextBlock
                x:Name="AppTitleBarText"
                Grid.Column="1"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="NoWrap" />
            <AutoSuggestBox
                x:Name="TitleBarSearchBox"
                Grid.Column="2"
                MaxWidth="400"
                Margin="8,0,8,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                PlaceholderText="Search requests"
                QueryIcon="Find"
                QuerySubmitted="TitleBarSearchBox_QuerySubmitted"
                SuggestionChosen="TitleBarSearchBox_SuggestionChosen"
                TextChanged="TitleBarSearchBox_TextChanged"
                shared:TooltipBehavior.ResourceKey="Shell_SearchBox_Tooltip"
                shared:TooltipBehavior.AssociatedFiles="Module_Core/Views/ShellPage.xaml|Module_Core/Views/ShellPage.xaml.cs|Module_Core/ViewModels/ShellViewModel.cs|Module_Waitlist/Models/SampleOrder.cs|Module_Core/Contracts/Services/IBuildingSelectionService.cs|Module_Core/Services/BuildingSelectionService.cs|Module_Core/Helpers/ResourceExtensions.cs|Module_Shared/Services/TooltipBehavior.cs|Module_Shared/Services/TooltipService.cs|Module_Shared/Services/ControlInspectorService.cs"
                shared:TooltipBehavior.FallbackText="Search active requests and related data.">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="models:SampleOrder">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Title}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind RequestedByName}" />
                        </StackPanel>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
        </Grid>
        <NavigationView
            x:Name="NavigationViewControl"
            Canvas.ZIndex="0"
            DisplayModeChanged="NavigationViewControl_DisplayModeChanged"
            ExpandedModeThresholdWidth="1280"
            OpenPaneLength="260"
            CompactPaneLength="48"
            Header="{x:Bind ViewModel.HeaderText, Mode=OneWay}"
            IsBackButtonVisible="Visible"
            IsBackEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}"
            IsSettingsVisible="True"
            SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}">
            <NavigationView.MenuItems>
                <!--
                TODO: Update item titles by updating <x:Uid>.Content entries in Strings/en-us/Resources.resw.
                https://docs.microsoft.com/windows/uwp/app-resources/localize-strings-ui-manifest#refer-to-a-string-resource-identifier-from-xaml

                TODO: Update item icons by updating FontIcon.Glyph properties.
                https://docs.microsoft.com/windows/apps/design/style/segoe-fluent-icons-font#icon-list
                -->
                <NavigationViewItem x:Uid="Shell_WaitlistView" helpers:NavigationHelper.NavigateTo="MTM_Waitlist.Module_Waitlist.ViewModels.WaitlistViewViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xf0e2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Shell_ModuleSetup" helpers:NavigationHelper.NavigateTo="MTM_Waitlist.Module_Setup.ViewModels.SetupWorkstationViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xe7be;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.HeaderTemplate>
                <DataTemplate>
                    <Grid HorizontalAlignment="Stretch" MinHeight="64" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{ThemeResource BodyLargeStrongTextBlockStyle}"
                                Text="{Binding}" />
                            <ComboBox
                                x:Name="FacilitySelectorComboBox"
                                Grid.Column="1"
                                MinWidth="160"
                                MaxWidth="220"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding ViewModel.Buildings, ElementName=RootPage}"
                                SelectedItem="{Binding ViewModel.SelectedBuilding, ElementName=RootPage, Mode=TwoWay}"
                                shared:TooltipBehavior.ResourceKey="Shell_SelectFacility_Tooltip"
                                shared:TooltipBehavior.AssociatedFiles="Module_Core/Views/ShellPage.xaml|Module_Core/Views/ShellPage.xaml.cs|Module_Core/ViewModels/ShellViewModel.cs|Module_Core/Contracts/Services/IBuildingSelectionService.cs|Module_Core/Services/BuildingSelectionService.cs|Module_Core/Helpers/ResourceExtensions.cs|Module_Shared/Services/TooltipBehavior.cs|Module_Shared/Services/TooltipService.cs|Module_Shared/Services/ControlInspectorService.cs"
                                shared:TooltipBehavior.FallbackText="Select the active facility." />
                            <Button
                                x:Name="CurrentUserButton"
                                Grid.Column="2"
                                Margin="16,0,0,0"
                                Padding="8"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                shared:TooltipBehavior.ResourceKey="Shell_CurrentUser_Tooltip"
                                shared:TooltipBehavior.AssociatedFiles="Module_Core/Views/ShellPage.xaml|Module_Core/Views/ShellPage.xaml.cs|Module_Core/ViewModels/ShellViewModel.cs|Module_Startup/Models/StartupState.cs|Module_Core/Helpers/ResourceExtensions.cs|Module_Shared/Services/TooltipBehavior.cs|Module_Shared/Services/TooltipService.cs|Module_Shared/Services/ControlInspectorService.cs"
                                shared:TooltipBehavior.FallbackText="View the current signed-in user.">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border
                                        Width="32"
                                        Height="32"
                                        Background="{Binding ViewModel.CurrentUserBadgeBrush, ElementName=RootPage}"
                                        CornerRadius="16">
                                        <FontIcon
                                            FontSize="16"
                                            Foreground="White"
                                            Glyph="{Binding ViewModel.CurrentUserIconGlyph, ElementName=RootPage}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        MaxWidth="220"
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{Binding ViewModel.CurrentUserDisplayName, ElementName=RootPage}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                            HorizontalAlignment="Center"                            
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled"
                            Visibility="{Binding ViewModel.IsHeaderProgressVisible, ElementName=RootPage, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl
                                ItemTemplateSelector="{StaticResource HeaderStepTemplateSelector}"
                                ItemsSource="{Binding ViewModel.HeaderSteps, ElementName=RootPage}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="0" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>

                    </Grid>
                </DataTemplate>
            </NavigationView.HeaderTemplate>
            <i:Interaction.Behaviors>
                <behaviors:NavigationViewHeaderBehavior DefaultHeader="{x:Bind ViewModel.HeaderText, Mode=OneWay}">
                    <behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
                        <DataTemplate>
                            <Grid MinHeight="64" Margin="0,0,60,0" RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{ThemeResource BodyLargeStrongTextBlockStyle}"
                                        Text="{Binding}" />
                                    <ComboBox
                                        x:Name="FacilitySelectorComboBoxDefault"
                                        Grid.Column="1"
                                        MinWidth="160"
                                        MaxWidth="220"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        ItemsSource="{Binding ViewModel.Buildings, ElementName=RootPage}"
                                        SelectedItem="{Binding ViewModel.SelectedBuilding, ElementName=RootPage, Mode=TwoWay}"
                                        shared:TooltipBehavior.ResourceKey="Shell_SelectFacility_Tooltip"
                                        shared:TooltipBehavior.AssociatedFiles="Module_Core/Views/ShellPage.xaml|Module_Core/Views/ShellPage.xaml.cs|Module_Core/ViewModels/ShellViewModel.cs|Module_Core/Contracts/Services/IBuildingSelectionService.cs|Module_Core/Services/BuildingSelectionService.cs|Module_Core/Helpers/ResourceExtensions.cs|Module_Shared/Services/TooltipBehavior.cs|Module_Shared/Services/TooltipService.cs|Module_Shared/Services/ControlInspectorService.cs"
                                        shared:TooltipBehavior.FallbackText="Select the active facility." />
                                    <Button
                                        x:Name="CurrentUserButtonDefault"
                                        Grid.Column="2"
                                        Margin="16,0,0,0"
                                        Padding="8"
                                        HorizontalAlignment="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        shared:TooltipBehavior.ResourceKey="Shell_CurrentUser_Tooltip"
                                        shared:TooltipBehavior.AssociatedFiles="Module_Core/Views/ShellPage.xaml|Module_Core/Views/ShellPage.xaml.cs|Module_Core/ViewModels/ShellViewModel.cs|Module_Startup/Models/StartupState.cs|Module_Core/Helpers/ResourceExtensions.cs|Module_Shared/Services/TooltipBehavior.cs|Module_Shared/Services/TooltipService.cs|Module_Shared/Services/ControlInspectorService.cs"
                                        shared:TooltipBehavior.FallbackText="View the current signed-in user.">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Border
                                                Width="32"
                                                Height="32"
                                                Background="{Binding ViewModel.CurrentUserBadgeBrush, ElementName=RootPage}"
                                                CornerRadius="16">
                                                <FontIcon
                                                    FontSize="16"
                                                    Foreground="White"
                                                    Glyph="{Binding ViewModel.CurrentUserIconGlyph, ElementName=RootPage}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                MaxWidth="220"
                                                Style="{ThemeResource BodyTextBlockStyle}"
                                                Text="{Binding ViewModel.CurrentUserDisplayName, ElementName=RootPage}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ScrollViewer
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Auto"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled"
                                    Visibility="{Binding ViewModel.IsHeaderProgressVisible, ElementName=RootPage, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl
                                        ItemTemplateSelector="{StaticResource HeaderStepTemplateSelector}"
                                        ItemsSource="{Binding ViewModel.HeaderSteps, ElementName=RootPage}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="0" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </DataTemplate>
                    </behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
                </behaviors:NavigationViewHeaderBehavior>
            </i:Interaction.Behaviors>
            <Grid Margin="{StaticResource NavigationViewPageContentMargin}">
                <Frame x:Name="NavigationFrame" />
            </Grid>
        </NavigationView>
    </Grid>
</Page>
