<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The dialog sizing scale (014-adopt-lab-design-system, FR-004).

        One scale for every dialog in the application, declared once, because a size declared per screen is how a
        dialog ends up wider than the window that owns it. The figures are set by the smallest supported screen, a
        15-inch display at 150% scaling, which gives about 1280 by 720 effective pixels: a 720-wide dialog leaves its
        owner visible on both sides of it, and a 640-tall body fits under a title and above the buttons in that window.

        A dialog reads these through MTM_Waitlist.Module_Shared.Dialogs.DialogSizing. A dialog that declares a width of
        its own fails the sizing audit.
    -->
    <x:Double x:Key="DialogMinWidth">480</x:Double>
    <x:Double x:Key="DialogPreferredWidth">720</x:Double>
    <x:Double x:Key="DialogMaxWidth">880</x:Double>
    <x:Double x:Key="DialogMaxBodyHeight">640</x:Double>
    <x:Double x:Key="DialogBodyMinHeight">120</x:Double>

</ResourceDictionary>
