<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MTM_Waitlist.GenericRequest.Controls.GenericRequestDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MTM_Waitlist.GenericRequest.Controls"
    xmlns:models="using:MTM_Waitlist.GenericRequest.Controls.Models"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock x:Uid="GenericRequest_Card_Detail_Title" Style="{StaticResource TitleTextBlockStyle}" />
            <controls:GenericRequestCard Model="{x:Bind Model}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        x:Uid="GenericRequest_Card_RaisedBy"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind RaisedBy}" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        x:Uid="GenericRequest_Card_RaisedAt"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind RaisedAt}" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock x:Uid="GenericRequest_Card_History_Title" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ListView AutomationProperties.Name="{x:Bind HistoryName}" ItemsSource="{x:Bind History}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:GenericRequestCardHistoryEntry">
                            <StackPanel Padding="0,6" Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind OccurredAtDisplay}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Summary}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
