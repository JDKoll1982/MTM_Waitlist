{
  "version": 1,
  "repository": "MTM_Waitlist",
  "layers": {
    "rules": [
      {
        "layer": "view",
        "kinds": [
          "class"
        ],
        "namespaceSegments": [
          "Views",
          "View",
          "Controls",
          "Dialogs",
          "Converters"
        ]
      },
      {
        "layer": "view",
        "kinds": [
          "class"
        ],
        "nameSuffixes": [
          "Page",
          "Window",
          "Dialog",
          "UserControl",
          "Control",
          "View",
          "Panel",
          "Converter"
        ]
      },
      {
        "layer": "viewmodel",
        "nameSuffixes": [
          "ViewModel"
        ]
      },
      {
        "layer": "viewmodel",
        "namePrefixes": [
          "ViewModel_"
        ]
      },
      {
        "layer": "model",
        "namePrefixes": [
          "Model_",
          "Enum_"
        ]
      },
      {
        "layer": "model",
        "kinds": [
          "record",
          "struct",
          "enum"
        ]
      },
      {
        "layer": "model",
        "kinds": [
          "class"
        ],
        "nameSuffixes": [
          "Data",
          "Result",
          "Row",
          "Entry",
          "Option",
          "Item",
          "Column",
          "Request",
          "Payload",
          "Outcome",
          "Kind",
          "State",
          "Dto",
          "EventArgs",
          "Args",
          "Options",
          "Card",
          "Credentials",
          "Display"
        ]
      },
      {
        "layer": "viewmodel",
        "kinds": [
          "class"
        ],
        "namespaceSegments": [
          "ViewModels"
        ],
        "unlessNameSuffixes": [
          "Data",
          "Card",
          "Row",
          "Item",
          "Option",
          "Column",
          "Credentials",
          "EventArgs",
          "Args",
          "Outcome",
          "Display",
          "Result",
          "Entry",
          "Dto",
          "Payload",
          "State",
          "Kind",
          "Model",
          "Routes"
        ]
      },
      {
        "layer": "service",
        "kinds": [
          "interface"
        ],
        "nameSuffixes": [
          "Service",
          "Store",
          "Provider",
          "Reader",
          "Writer",
          "Catalog",
          "Resolver",
          "Fallback",
          "Policy",
          "Tracker",
          "Hasher",
          "Server",
          "Gate",
          "Host",
          "Pipeline",
          "Notifier",
          "Prompt",
          "Repository",
          "Client",
          "Handler"
        ]
      },
      {
        "layer": "service",
        "kinds": [
          "interface"
        ],
        "namePrefixes": [
          "Service_"
        ]
      },
      {
        "layer": "service",
        "kinds": [
          "interface"
        ],
        "namespaceSegments": [
          "Services",
          "Service",
          "Contracts"
        ]
      },
      {
        "layer": "model",
        "kinds": [
          "interface"
        ]
      },
      {
        "layer": "service",
        "namespaceSegments": [
          "Services",
          "Service",
          "DependencyInjection"
        ]
      },
      {
        "layer": "service",
        "nameSuffixes": [
          "Service",
          "Store",
          "Provider",
          "Reader",
          "Writer",
          "Catalog",
          "Resolver",
          "Fallback",
          "Policy",
          "Tracker",
          "Hasher",
          "Server",
          "Gate",
          "Host",
          "Pipeline",
          "Notifier",
          "Prompt",
          "Repository",
          "Client",
          "Handler"
        ]
      },
      {
        "layer": "service",
        "namePrefixes": [
          "Service_"
        ]
      }
    ],
    "default": "model"
  },
  "links": {
    "genericPairCalls": [
      "Configure"
    ],
    "dependencyPropertyCall": "Register",
    "addCallPattern": "^Add(Singleton|Transient)$",
    "serviceLocator": [
      "GetService",
      "GetRequiredService",
      "Get"
    ],
    "dataContextCasts": [
      "is",
      "as"
    ]
  },
  "findings": {
    "entryPoints": [
      "App"
    ],
    "transparentBases": [
      "ObservableObject",
      "ObservableRecipient",
      "Page",
      "UserControl",
      "Panel",
      "Window",
      "Application"
    ],
    "generatedMembers": [
      {
        "attribute": "RelayCommand",
        "on": "method",
        "form": "commandSuffix"
      }
    ]
  },
  "files": {
    "include": [
      "**/*.cs",
      "**/*.xaml"
    ],
    "exclude": [
      "**/bin/**",
      "**/obj/**"
    ]
  }
}
