<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MTM_Waitlist.Module_Shared.Dialogs.MessageDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The standard message body (014-adopt-lab-design-system, FR-005). Every one of the six message kinds wears this,
        so a person reads the same frame whatever the application is asking them.

        Sizing is applied in code-behind from Styles/Dialogs.xaml rather than written here, because a width written
        here would be a second declaration of the same scale (FR-004).
    -->
    <Border
        x:Name="Card"
        Padding="20"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="TitleText"
                Grid.Row="0"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                TextWrapping="WrapWholeWords" />

            <ScrollViewer
                x:Name="MessageScroller"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <TextBlock
                    x:Name="MessageText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    TextWrapping="WrapWholeWords" />
            </ScrollViewer>

            <TextBlock
                x:Name="SubjectText"
                Grid.Row="2"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                TextWrapping="WrapWholeWords"
                Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
