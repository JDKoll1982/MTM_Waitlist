<UserControl
    x:Class="MTM_Waitlist.Module_Waitlist.Controls.PickupFg.PickupFgWaitlistLineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MTM_Waitlist.Module_Waitlist.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <local:WaitlistLineCardView
            AccentBrush="#FF2FA54A"
            AccentSurfaceBrush="#FFE5F6E8"
            BadgeBackgroundBrush="#FFCBF0D2"
            BadgeText="FG"
            Order="{Binding Mode=OneWay}">
        <local:WaitlistLineCardView.DetailsContent>
            <Grid ColumnSpacing="12" RowSpacing="2">
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontWeight="SemiBold" Text="Part number" />
                <TextBlock Grid.Column="1" Text="{Binding Fields[0].Value}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Quantity remaining" />
                <TextBlock Grid.Column="3" Text="{Binding Fields[2].Value}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Part description" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Fields[1].Value}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Customer" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Fields[3].Value}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="2" Grid.Column="2" FontWeight="SemiBold" Text="Packlist" />
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Fields[4].Value}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </local:WaitlistLineCardView.DetailsContent>
    </local:WaitlistLineCardView>
</UserControl>

<!--
    Notes
    Card contents:
    Part number - The finished-goods part being requested.
    Part description - The description of the finished-goods part.
    Quantity remaining - Ordered quantity minus fulfilled quantity, never less than zero.

    Detail page contents:
    Customer and order - Customer, customer order number, line number, and customer purchase-order reference.
    Part details - Part number, description, customer part number, selling unit, and piece count.
    Quantities - Ordered, allocated, fulfilled, and remaining quantities.
    Shipment details - Packlist number, ship via, shipped date, expected delivery date, and shipment status.
    Schedule details - Desired ship date, promise date, order status, and line status.
    Work-order context - Related work order, operation, press or resource, and scheduled finish when available.
    Request context - Requesting user, requesting work center, request time, and remaining waitlist time.
-->