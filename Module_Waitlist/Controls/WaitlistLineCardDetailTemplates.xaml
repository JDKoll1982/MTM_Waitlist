<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settingsConverters="using:MTM_Waitlist.Module_Settings.Converters"
    xmlns:sharedControls="using:MTM_Waitlist.Module_Shared.Controls"
    xmlns:controls="using:MTM_Waitlist.Module_Waitlist.Controls"
    xmlns:waitlistConverters="using:MTM_Waitlist.Module_Waitlist.Converters">

    <!--
        The detail column's per-Item arrangements, one template per Item, all in this one dictionary
        (specs/012-waitlist-card-layout, research R3, D31). The card's own selector looks a row's Item up at
        run time under `WaitlistLineCardDetail_<ItemCode>` and draws what it finds, so an Item's arrangement
        landing here is all it takes for that Item to draw its own cells, with no card edit.

        Each template is the detail zone's two lower rows: a two-column grid whose four slots fill in the
        row's declared cell order (FR-026). Which slots exist and how far the last one reaches is read off
        the number of cells the row actually filled, through `WaitlistCardCellLayout` (FR-103): four cells
        are two rows of two, three let the third span the bottom row, two leave the bottom row empty so it
        collapses, one spans the full width, and none leaves both rows empty with the title row above keeping
        the space (FR-024, FR-026, FR-027). Nothing is padded to fill a short panel (FR-006).

        Every cell is drawn by the same pair of shared templates below, so the anatomy - the label and its value
        read on one line as `Label: value`, the answer told apart from the question by size, weight and colour -
        is written once (FR-028). The label is the one the cell's own
        declaration carries, resolved through the application's resources rather than written here (FR-059,
        FR-104); the label-less die-shop cell hides its label and draws its phrase as the value (FR-055); and
        every cell whose value is a description - the request description on `other`, the part description on
        `deliver-component`, the coil description on both coil Items - is drawn through the application's shared
        scrolling text control, so a long description scrolls rather than being clipped (FR-053). Which of the
        two lines a cell gets is decided by the cell itself, through `WaitlistCardCellTemplateSelector`.
    -->

    <waitlistConverters:WaitlistCardCellLabelConverter x:Key="WaitlistCardCellLabelConverter" />
    <waitlistConverters:WaitlistCardCellSpanConverter x:Key="WaitlistCardCellSpanConverter" />
    <waitlistConverters:WaitlistCardCellBorderConverter x:Key="WaitlistCardCellBorderConverter" />
    <waitlistConverters:WaitlistCardCellVisibilityConverter x:Key="WaitlistCardCellVisibilityConverter" />
    <settingsConverters:BoolToVisibilityConverter x:Key="WaitlistCardCellLabelVisibilityConverter" />

    <!--
        The picture rule, declared here as the label converter above is: this dictionary is merged into the
        application's resources before the app-level declaration is in scope, so a cell that draws a picture
        carries its own instance rather than reaching for a key that is not yet there.
    -->
    <settingsConverters:ResolvedImagePathToSourceConverter x:Key="WaitlistCardCellReferenceImageConverter" />

    <!--
        One cell: the label the declaration carries, then its value on the same line, a real gap between them, the
        pair read from the cell's left edge, and a hairline along its top and left edge only where another cell
        meets it - never around the outside of the cell area (FR-028).

        Left is where the pair starts, and the whole cell area is left-aligned with it: the grid those cells sit in
        is the thing the card centres, in its own area, so a panel whose lower row is empty keeps its cells in the
        middle of the section instead of against the top of it. Centring each pair instead was tried and put the
        six cells' contents on six different axes (FR-027).

        The pair is told apart the way a modern data row is: the label small, secondary and semibold, the value a
        step larger, semibold and in the primary text colour, so the answer reads first and the question that
        produced it second. The gap is a column spacing rather than the separator's trailing space, because a
        trailing space at the end of a line is collapsed by layout and the pair then reads `Part Type:WIP`.
    -->
    <DataTemplate x:Key="WaitlistLineCardDetailCell">
        <Border
            Padding="12,5"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="{Binding Converter={StaticResource WaitlistCardCellBorderConverter}}">
            <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding Label, Converter={StaticResource WaitlistCardCellLabelConverter}, ConverterParameter=separator}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding IsLabelLess, Converter={StaticResource WaitlistCardCellLabelVisibilityConverter}, ConverterParameter=Invert}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="{Binding Value}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </Grid>
        </Border>
    </DataTemplate>

    <!--
        One cell whose value is drawn in full by scrolling it past rather than clipping it: a description, which
        can be a whole sentence - the request description on `other`, or a part or coil description on the cards
        that declare one (FR-053, FR-111). The cell selector below hands this template to every cell whose label
        says its value is a description.

        Its value column is `*` rather than `Auto`, which is what gives the line a field narrower than the words in
        it: a control measured to its own text would never overflow and so would never scroll. The label still
        starts at the cell's left edge like every other cell, so the pair reads the same way across the panel.
        That is the one difference from the plain cell's anatomy, and it is why this is a template of its own.
    -->
    <DataTemplate x:Key="WaitlistLineCardDetailScrollingCell">
        <Border
            Padding="12,5"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="{Binding Converter={StaticResource WaitlistCardCellBorderConverter}}">
            <Grid ColumnSpacing="8" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding Label, Converter={StaticResource WaitlistCardCellLabelConverter}, ConverterParameter=separator}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding IsLabelLess, Converter={StaticResource WaitlistCardCellLabelVisibilityConverter}, ConverterParameter=Invert}" />
                <sharedControls:AutoScrollTextView
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="{Binding Value}" />
            </Grid>
        </Border>
    </DataTemplate>

    <!--
        One cell that pictures the answer it shows: the hopper's size, whose word is also the key its reference
        picture is filed under, so the card opens the picture the New Request hopper step drew (FR-077, D22).
        The picture is the card's own enlarge behaviour and nothing new - Shift+click, because a plain click on
        a card row already belongs to the row (FR-078) - and a size whose picture is missing or unusable draws
        the application's one shared placeholder instead of a blank (FR-080). The value stays beside the
        picture so the size the requester chose is still readable as a word.
    -->
    <DataTemplate x:Key="WaitlistLineCardDetailPictureCell">
        <Border
            Padding="12,5"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="{Binding Converter={StaticResource WaitlistCardCellBorderConverter}}">
            <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding Label, Converter={StaticResource WaitlistCardCellLabelConverter}, ConverterParameter=separator}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding IsLabelLess, Converter={StaticResource WaitlistCardCellLabelVisibilityConverter}, ConverterParameter=Invert}" />
                <sharedControls:ClickToEnlargeImageView
                    Grid.Column="1"
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="WaitlistLineCardDetailCell_ReferenceImage"
                    Source="{Binding EffectiveReferenceImagePath, Converter={StaticResource WaitlistCardCellReferenceImageConverter}}"
                    Stretch="Uniform" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="{Binding Value}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </Grid>
        </Border>
    </DataTemplate>

    <!--
        Which of the two line cells a cell is drawn with: the scrolling line when the cell's value is a description,
        the plain line for every other value. Declared here, after the templates it names, because a
        `StaticResource` is resolved where it is read.

        The choice belongs to the cell, so every slot of every Item's template asks this selector rather than
        pinning a template per slot: a description sits in the third slot on a coil card and the first on a
        component card, and it moves as soon as a value ahead of it is missing or a fourth cell arrives (FR-028,
        FR-053).
    -->
    <controls:WaitlistCardCellTemplateSelector
        x:Key="WaitlistCardCellTemplateSelector"
        PlainTemplate="{StaticResource WaitlistLineCardDetailCell}"
        ScrollingTemplate="{StaticResource WaitlistLineCardDetailScrollingCell}" />

