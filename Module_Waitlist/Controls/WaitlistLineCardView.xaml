<UserControl
    x:Class="MTM_Waitlist.Module_Waitlist.Controls.WaitlistLineCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:MTM_Waitlist.Module_Shared.Services"
    xmlns:cardControls="using:MTM_Waitlist.Module_Waitlist.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sharedControls="using:MTM_Waitlist.Module_Shared.Controls"
    x:Name="Root"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--
            The detail zone's cells are one template per Item, held in the application's resources as a single
            dictionary (research R3, D31). The selector resolves the row's Item to its own template key at run
            time, so an Item's template landing in that dictionary is all it takes for that Item to draw its own
            cells.

            The fallback is the declared no-cells case: an Item whose template is absent draws no cells at all,
            with no substituted value and no explanation, and the title row above it keeps the space (FR-026,
            FR-027, FR-060).

            Its root is an empty `Grid` rather than a template with no content at all. A contentless
            `DataTemplate` does not reliably draw nothing: the cell area is a `ContentControl` holding the row,
            and a presenter given no usable template falls back to rendering its content - which for a row is the
            row's own type name, so `MTM_Waitlist.Module_Waitlist.Models.SampleOrder` was drawn on the card where
            the cells belong. A template whose root is an empty panel draws nothing, which is what "no cells" has
            to mean.
        -->
        <DataTemplate x:Key="WaitlistLineCardDetailFallback">
            <Grid />
        </DataTemplate>
        <cardControls:WaitlistLineCardDetailTemplateSelector
            x:Key="WaitlistLineCardDetailTemplateSelector"
            FallbackTemplate="{StaticResource WaitlistLineCardDetailFallback}" />
    </UserControl.Resources>

    <Border
        MinHeight="136"
        Padding="10"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="10">
        <!--
            The four zones, left to right, separated by a vertical rule (FR-001): identity (the accent bar, the
            material picture with its new-message badge, and the requesting work centre as a large unlabelled
            value beneath the picture), status (the status word, the time ring and the person rows),
            identity-and-detail (the title pair stacked over an inner grid, with the Item's own cells beneath it)
            and action (up to six square buttons). Nothing is padded to fill a short zone, and no card is given a
            uniform height (FR-006, FR-009).
        -->
        <Grid ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  The accent bar: the leftmost column of the identity zone, full height (FR-002).  -->
            <Border
                Grid.Column="0"
                Background="{Binding AccentBrush, ElementName=Root}"
                CornerRadius="6" />

            <!--
                Zone 1, identity. The material part's picture and the new-message badge keep their present
                meaning (FR-002, FR-003): the picture is the part the request is *about*, never the artwork for
                the kind of request, and a request whose material cannot be pictured draws the one shared
                placeholder. The list keeps its row selection, so a plain click on the picture still belongs to
                the row and Shift+click is what enlarges it.
            -->
            <StackPanel
                x:Name="IdentityZone"
                Grid.Column="1"
                Width="96"
                Margin="10,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="6">
                <Border
                    Width="96"
                    Height="96"
                    Padding="7"
                    Background="{Binding AccentSurfaceBrush, ElementName=Root}"
                    CornerRadius="10">
                    <Grid>
                        <sharedControls:ClickToEnlargeImageView
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="WaitlistLineCardView_PartPicture"
                            Source="{Binding Order.EffectiveImagePath, ElementName=Root, Converter={StaticResource ResolvedImagePathToSourceConverter}}"
                            Stretch="Uniform" />

                        <Border
                            Width="26"
                            Height="26"
                            Margin="0,0,-6,-6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="#FF000000"
                            CornerRadius="999"
                            shared:TooltipBehavior.FallbackText="{Binding Order.NewMessageTooltip, ElementName=Root}"
                            Visibility="{Binding Order.HasNewMessages, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon
                                FontSize="14"
                                Foreground="White"
                                Glyph="&#xE8BD;" />
                        </Border>
                    </Grid>
                </Border>

                <!--
                    The requesting work centre: a large value with nothing in front of it, beneath the picture
                    (FR-004). It is the identity zone's own value and is never a detail cell, and the row's
                    requesting user is never drawn on the card at all (FR-005, D19). A row that names no work
                    centre draws no gap where one would have been (FR-006).
                -->
                <TextBlock
                    x:Name="RequestingWorkCenterText"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="{Binding Order.RequestedPressName, ElementName=Root}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasRequestingWorkCenter, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>

            <!--  The vertical rule between the identity and status zones (FR-001).  -->
            <Border
                x:Name="IdentityStatusRule"
                Grid.Column="2"
                Width="1"
                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <!--
                Zone 2, status: a centred stack of the status word, the ring, the person and - for a closed
                request - the requester (FR-011). The whole column carries one of three themes, so the word and
                the ring can never disagree about which state the row is in (FR-019).

                The zone is drawn as an inset panel, so the column reads as its own surface against the card
                instead of a band of bare text. The fill is deliberately neutral and comes from the theme, not
                from the status: the state is still carried by the word and the ring alone (FR-019), and the
                panel follows the theme rather than being a colour that only works on one of them.
            -->
            <Border
                x:Name="StatusZone"
                Grid.Column="3"
                Width="128"
                Margin="8,0"
                Padding="8,6"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="4"
                    Tag="{Binding Order.StatusTheme, ElementName=Root}">
                    <!--
                        Row 1: the status word, standing alone as plain coloured text with no label in front of it
                        and no coloured pill anywhere (FR-008, FR-012). It is the card body's one interactive
                        element: it becomes clickable only for the row's own material handler, and it opens the
                        conditions flyout (FR-070, FR-071, FR-074). The flyout host is declared here, carries the row's
                        condition options, and opens the status flyout control as its body: the picker is therefore
                        only ever reached through this gated button, and choosing from it closes it (FR-074).
                    -->
                    <Button
                        x:Name="StatusWordButton"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        AutomationProperties.AutomationId="WaitlistLineCardView_StatusWordButton"
                        AutomationProperties.HelpText="{Binding StatusWordHelpText, ElementName=Root}"
                        AutomationProperties.Name="{Binding Order.StatusWord, ElementName=Root}"
                        IsEnabled="{Binding Order.CanSetStatusCondition, ElementName=Root}"
                        Tag="{Binding ConditionOptions, ElementName=Root}"
                        Visibility="{Binding HasStatusWord, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button.Flyout>
                            <Flyout
                                x:Name="StatusConditionFlyout"
                                Opened="OnStatusConditionFlyoutOpened"
                                Placement="Bottom">
                                <cardControls:WaitlistStatusFlyout
                                    x:Name="StatusConditionPicker"
                                    ConditionChosen="OnStatusConditionChosen"
                                    Conditions="{Binding ConditionOptions, ElementName=Root}" />
                            </Flyout>
                        </Button.Flyout>
                        <TextBlock
                            x:Name="StatusWordText"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{Binding StatusColumnBrush, ElementName=Root}"
                            Text="{Binding Order.StatusWord, ElementName=Root}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Button>

                    <!--
                        Row 2: the platform ring in its determinate state, read-only, filling as the request's
                        allotment is used and carrying the row's time text inside it (FR-013, research R2). It is
                        never the click target - the status word beside it is - and no percentage and no
                        elapsed-time line is drawn anywhere in this zone (FR-021). The ring and its box carry an
                        explicit size, because the platform control's own default is far smaller than the host: left
                        unsized it draws a hairline no bigger than a glyph, which is what the box is there to say it
                        must not be (D44). The track is painted so the unfilled part of the allotment is visible
                        rather than invisible.
                    -->
                    <Grid
                        x:Name="TimeRingHost"
                        Width="72"
                        Height="72"
                        HorizontalAlignment="Center">
                        <ProgressRing
                            x:Name="TimeRing"
                            Width="72"
                            Height="72"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="WaitlistLineCardView_TimeRing"
                            AutomationProperties.Name="{Binding RingAccessibleName, ElementName=Root}"
                            Background="{ThemeResource CardStrokeColorDefaultBrush}"
                            Foreground="{Binding StatusColumnBrush, ElementName=Root}"
                            IsIndeterminate="False"
                            Maximum="1"
                            Minimum="0"
                            Value="{Binding Order.RingValue, ElementName=Root}" />
                        <TextBlock
                            x:Name="TimeRingText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="{Binding Order.RingText, ElementName=Root}"
                            TextAlignment="Center" />
                    </Grid>

                    <!--
                        Rows 3 and 4: the person, and - once the request has closed - the requester (FR-022). A row
                        with no value is removed rather than left blank (FR-018).
                    -->
                    <TextBlock
                        x:Name="StatusPersonText"
                        HorizontalAlignment="Center"
                        Text="{Binding Order.PersonText, ElementName=Root}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding Order.HasPerson, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock
                        x:Name="StatusRequesterText"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Order.RequesterText, ElementName=Root}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding Order.HasRequester, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!--  The vertical rule between the status and detail zones (FR-001).  -->
            <Border
                x:Name="StatusDetailRule"
                Grid.Column="4"
                Width="1"
                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <!--
                Zone 3, identity-and-detail: an inner grid of three rows and two columns (FR-024). Row 1 always
                spans both columns and carries the request's category word and its own identifier (FR-007); the
                cells the Item declares occupy rows 2 and 3. Which cells those are is the Item's decision and is
                never chosen per row, so the cell area is resolved through the per-Item template selector
                (FR-025). An Item with no cells draws none of them and its rows collapse to nothing, and the
                zone's alignment is what the title pair does with the space that leaves: centred in the card
                when the row resolved no data at all, at the top over its cells when it did (FR-026, FR-027).
                The rows are spaced by the cells themselves rather than by this grid, so a zone with no cells
                has no spacing to leave behind either.
            -->
            <Grid
                x:Name="DetailZone"
                Grid.Column="5"
                VerticalAlignment="{Binding Order.Cells.Count, ElementName=Root, Converter={StaticResource WaitlistCardTitleAlignmentConverter}}"
                ColumnSpacing="0"
                RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--
                    The title pair, stacked and centred: the Item's own word on the first line and the request's
                    identifier beneath it (FR-007). Side by side they read as one sentence and the identifier is
                    the part a reader is looking for, so the two lines are what the card draws - the word large
                    and the identifier smaller, both centred over the cells below.
                -->
                <StackPanel
                    x:Name="DetailTitleRow"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Stretch"
                    Spacing="0">
                    <TextBlock
                        x:Name="DetailCategoryWord"
                        FontSize="26"
                        FontWeight="SemiBold"
                        Text="{Binding Order.Title, ElementName=Root}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="DetailIdentifier"
                        FontSize="20"
                        Text="{Binding Order.Subtitle, ElementName=Root}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding HasIdentifier, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <!--
                    The cell area, and the only thing that separates it from the title above it: the gap is a
                    margin here rather than spacing on the zone's rows, so that a row which resolved no data
                    collapses the area completely and leaves no gap or empty row behind (FR-006, FR-026).
                -->
                <ContentControl
                    x:Name="DetailCells"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.RowSpan="2"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Content="{Binding Order, ElementName=Root}"
                    ContentTemplateSelector="{StaticResource WaitlistLineCardDetailTemplateSelector}"
                    Visibility="{Binding Order.Cells.Count, ElementName=Root, Converter={StaticResource WaitlistCardCellVisibilityConverter}, ConverterParameter=0}" />
            </Grid>

            <!--  The vertical rule between the detail and action zones (FR-001).  -->
            <Border
                x:Name="DetailActionRule"
                Grid.Column="6"
                Width="1"
                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <!--
                Zone 4, action: up to five square buttons in three columns and two rows, in row-major order -
                Accept, Cancel, Give back, then Complete, Open details (FR-061). Three across rather than two, so
                the actions occupy two rows instead of three and the zone is as tall as the tallest of the other
                three (D44). A button is drawn only while the row's own gate says the action is available, and an
                unavailable one is removed rather than blanked (FR-062, FR-063): the reflow panel gives the next
                button its place rather than leaving a hole, and only the row count shrinks. Every button keeps
                its 44x44 hit target, its tooltip and its accessible name (FR-064, FR-065), and Accept, Complete
                and Give back keep three distinct colours and glyphs (FR-066). Printing is deliberately not here:
                it is a future action of the request detail page rather than of the card (FR-067).
            -->
            <cardControls:WaitlistActionReflowPanel
                x:Name="ActionZone"
                Grid.Column="7"
                Margin="10,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <Button
                    x:Name="AcceptButton"
                    Width="44"
                    Height="44"
                    MinWidth="44"
                    MinHeight="44"
                    AutomationProperties.AutomationId="WaitlistLineCardView_AcceptButton"
                    AutomationProperties.Name="{Binding Order.AcceptActionText, ElementName=Root}"
                    Background="{ThemeResource SystemFillColorSuccessBrush}"
                    Command="{Binding Order.AcceptCommand, ElementName=Root}"
                    CommandParameter="{Binding Order, ElementName=Root}"
                    CornerRadius="9"
                    shared:TooltipBehavior.FallbackText="{Binding Order.AcceptActionText, ElementName=Root}"
                    Visibility="{Binding Order.CanAccept, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon
                        FontSize="18"
                        Foreground="White"
                        Glyph="&#xE8FB;" />
                </Button>

                <Button
                    x:Name="CancelButton"
                    Width="44"
                    Height="44"
                    MinWidth="44"
                    MinHeight="44"
                    AutomationProperties.AutomationId="WaitlistLineCardView_CancelButton"
                    AutomationProperties.Name="{Binding Order.CancelActionText, ElementName=Root}"
                    Background="{ThemeResource SystemFillColorCriticalBrush}"
                    Command="{Binding Order.CancelCommand, ElementName=Root}"
                    CommandParameter="{Binding Order, ElementName=Root}"
                    CornerRadius="9"
                    shared:TooltipBehavior.FallbackText="{Binding Order.CancelActionText, ElementName=Root}"
                    Visibility="{Binding Order.CanCancelRequest, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon
                        FontSize="18"
                        Foreground="White"
                        Glyph="&#xE10A;" />
                </Button>

                <Button
                    x:Name="ReleaseButton"
                    Width="44"
                    Height="44"
                    MinWidth="44"
                    MinHeight="44"
                    AutomationProperties.AutomationId="WaitlistLineCardView_ReleaseButton"
                    AutomationProperties.Name="{Binding Order.ReleaseActionText, ElementName=Root}"
                    Background="{ThemeResource SystemFillColorSolidNeutralBrush}"
                    Command="{Binding Order.ReleaseCommand, ElementName=Root}"
                    CommandParameter="{Binding Order, ElementName=Root}"
                    CornerRadius="9"
                    shared:TooltipBehavior.FallbackText="{Binding Order.ReleaseActionText, ElementName=Root}"
                    Visibility="{Binding Order.CanCompleteOrRelease, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon
                        FontSize="18"
                        Foreground="White"
                        Glyph="&#xE7A7;" />
                </Button>

                <Button
                    x:Name="CompleteButton"
                    Width="44"
                    Height="44"
                    MinWidth="44"
                    MinHeight="44"
                    AutomationProperties.AutomationId="WaitlistLineCardView_CompleteButton"
                    AutomationProperties.Name="{Binding Order.CompleteActionText, ElementName=Root}"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Command="{Binding Order.CompleteCommand, ElementName=Root}"
                    CommandParameter="{Binding Order, ElementName=Root}"
                    CornerRadius="9"
                    shared:TooltipBehavior.FallbackText="{Binding Order.CompleteActionText, ElementName=Root}"
                    Visibility="{Binding Order.CanCompleteOrRelease, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon
                        FontSize="18"
                        Foreground="White"
                        Glyph="&#xE930;" />
                </Button>

                <!--
                    Open details is the only way the card opens the request now that the body no longer does
                    (FR-068, FR-069). It carries the magnifier glyph and the `Open details` tooltip, both from
                    resources, and it opens the request through the application's navigation service.
                -->
                <Button
                    x:Name="OpenDetailsButton"
                    Width="44"
                    Height="44"
                    MinWidth="44"
                    MinHeight="44"
                    AutomationProperties.AutomationId="WaitlistLineCardView_OpenDetailsButton"
                    AutomationProperties.Name="{Binding OpenDetailsText, ElementName=Root}"
                    Background="{ThemeResource SystemFillColorSolidNeutralBrush}"
                    Click="OnOpenDetailsClick"
                    CornerRadius="9"
                    shared:TooltipBehavior.FallbackText="{Binding OpenDetailsText, ElementName=Root}"
                    Visibility="{Binding Order.CanOpenDetails, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon
                        FontSize="18"
                        Foreground="White"
                        Glyph="&#xE721;" />
                </Button>
            </cardControls:WaitlistActionReflowPanel>
        </Grid>
    </Border>
</UserControl>
