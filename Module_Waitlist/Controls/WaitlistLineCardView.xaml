<UserControl
    x:Class="MTM_Waitlist.Module_Waitlist.Controls.WaitlistLineCardView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        MinHeight="136"
        Padding="10"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="10">
        <Grid RowSpacing="8" ColumnSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Accent bar spans the full card height on the far left -->
            <Border
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Background="{Binding AccentBrush, ElementName=Root}"
                CornerRadius="6" />

            <!-- Type/subtype image + badge (fixed square, not stretched) -->
            <Border
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="1"
                Width="96"
                Height="96"
                Padding="7"
                VerticalAlignment="Center"
                Background="{Binding AccentSurfaceBrush, ElementName=Root}"
                CornerRadius="10">
                <Grid>
                    <Image
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="{Binding Order.EffectiveImagePath, ElementName=Root, Converter={StaticResource ResolvedImagePathToSourceConverter}}"
                        Stretch="Uniform" />

                    <Border
                        Padding="6,3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{Binding BadgeBackgroundBrush, ElementName=Root}"
                        CornerRadius="999">
                        <TextBlock
                            FontSize="10"
                            FontWeight="Bold"
                            Text="{Binding BadgeText, ElementName=Root}" />
                    </Border>

                    <!-- New-message indicator, pinned to the lower-right of the request-type image: this
                         request changed after the viewer last opened its details. Clicking the card opens the
                         request, which clears it. -->
                    <Border
                        Width="26"
                        Height="26"
                        Margin="0,0,-6,-6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="#FF000000"
                        CornerRadius="999"
                        ToolTipService.ToolTip="{Binding Order.NewMessageTooltip, ElementName=Root}"
                        Visibility="{Binding Order.HasNewMessages, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon FontSize="14" Foreground="White" Glyph="&#xE8BD;" />
                    </Border>
                </Grid>
            </Border>

            <!-- Title on its own row, above the content -->
            <TextBlock
                Grid.Row="0"
                Grid.Column="2"
                FontSize="20"
                MaxLines="2"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="{Binding Order.Title, ElementName=Root}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="WrapWholeWords" />

            <!-- Row 1 content: metadata (left) + details (right) -->
            <Grid
                Grid.Row="1"
                Grid.Column="2"
                ColumnSpacing="24"
                RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 4 metadata rows (label/value aligned) -->
                <Grid ColumnSpacing="10" RowSpacing="4" VerticalAlignment="Top">
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontWeight="SemiBold" Text="Requested by" />
                    <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Order.RequestedByName, ElementName=Root}" TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Press" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Order.RequestedPressName, ElementName=Root}" TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Remaining time" />
                    <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="{Binding RemainingTimeFontWeight, ElementName=Root}" Foreground="{Binding RemainingTimeBrush, ElementName=Root}" Text="{Binding Order.RemainingTimeText, ElementName=Root}" TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Waiting" Visibility="{Binding Order.HasWaitingFor, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Order.WaitingForText, ElementName=Root}" TextTrimming="CharacterEllipsis" Visibility="{Binding Order.HasWaitingFor, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>

                <!-- Type-specific detail fields -->
                <ScrollViewer
                    Grid.Column="1"
                    Margin="0,0,4,0"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto">
                    <ContentPresenter
                        Content="{Binding DetailsContent, ElementName=Root}"
                        HorizontalContentAlignment="Stretch" />
                </ScrollViewer>
            </Grid>

            <!-- Action buttons (vertically centered) + compact status pill below spanning button width -->
            <Grid
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="3"
                Width="150">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- The actions this viewer may take on this row. A button is drawn only while the row's
                     own gate says the action is available, carries the command the view model put on the
                     row, and names itself with the row's localized label. The action area offers only what
                     the application can actually do (FR-007/FR-008/FR-020, contracts C1/C7), and it keeps
                     the approved anatomy: at most two 44x44 icon buttons, vertically centred above the
                     compact status pill.

                     Accept and Complete are the same slot in two states, so they must never be mistaken for
                     each other: Accept is green with the Accept glyph, Complete is the accent colour with the
                     Completed glyph. Glyph names come from the Segoe Fluent Icons list; E10B is in the
                     deprecated E0-E5 range and is not used. -->
                <StackPanel
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        MinWidth="44"
                        MinHeight="44"
                        AutomationProperties.Name="{Binding Order.AcceptActionText, ElementName=Root}"
                        Background="{ThemeResource SystemFillColorSuccessBrush}"
                        Command="{Binding Order.AcceptCommand, ElementName=Root}"
                        CommandParameter="{Binding Order, ElementName=Root}"
                        CornerRadius="9"
                        ToolTipService.ToolTip="{Binding Order.AcceptActionText, ElementName=Root}"
                        Visibility="{Binding Order.CanAccept, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon FontSize="18" Foreground="White" Glyph="&#xE8FB;" />
                    </Button>
                    <Button
                        MinWidth="44"
                        MinHeight="44"
                        AutomationProperties.Name="{Binding Order.CompleteActionText, ElementName=Root}"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Command="{Binding Order.CompleteCommand, ElementName=Root}"
                        CommandParameter="{Binding Order, ElementName=Root}"
                        CornerRadius="9"
                        ToolTipService.ToolTip="{Binding Order.CompleteActionText, ElementName=Root}"
                        Visibility="{Binding Order.CanCompleteOrRelease, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon FontSize="18" Foreground="White" Glyph="&#xE930;" />
                    </Button>
                    <Button
                        MinWidth="44"
                        MinHeight="44"
                        AutomationProperties.Name="{Binding Order.CancelActionText, ElementName=Root}"
                        Background="{ThemeResource SystemFillColorCriticalBrush}"
                        Command="{Binding Order.CancelCommand, ElementName=Root}"
                        CommandParameter="{Binding Order, ElementName=Root}"
                        CornerRadius="9"
                        ToolTipService.ToolTip="{Binding Order.CancelActionText, ElementName=Root}"
                        Visibility="{Binding Order.CanCancelRequest, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon FontSize="18" Foreground="White" Glyph="&#xE10A;" />
                    </Button>
                </StackPanel>

                <!-- Status pill: the request's real lifecycle status, compact and fixed-height, below the
                     buttons (contract C7). One colour per state (RequestStatusPalette) so the badge says where
                     the request is without the label having to be read: grey queued, blue claimed, green done,
                     red cancelled. -->
                <Border
                    Grid.Row="1"
                    Height="36"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="{Binding Order.Status, ElementName=Root, Converter={StaticResource RequestStatusToBrushConverter}}"
                    CornerRadius="12"
                    Visibility="{Binding Order.HasStatusBadge, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{Binding Order.Status, ElementName=Root, Converter={StaticResource RequestStatusToBrushConverter}, ConverterParameter=Foreground}"
                        Text="{Binding Order.StatusBadgeText, ElementName=Root}" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>

<!--
    Notes
    Card contents:
    Request image - The request-type image selected by the order's image path.
    Request badge - The request type label, such as COIL, FG, NCM, O/S, WIP, or SCRAP.
    Request title - The primary short description of the waitlist request.
    Requesting user - The name of the user who created the request.
    Press - The press or resource associated with the request when available.
    Remaining time - The calculated time remaining before the request's target or promise time.
    Actions - Edit, cancel, and accept controls. Each action must be wired to the appropriate command before being enabled.

    Detail page contents:
    Shared summary - Reuse the request image, badge, title, requester, press or resource, and remaining time from the card.
    Type-specific sections - Render the fields listed in the corresponding request-type control's notes.
    Scheduling section - Show queued time, target or promise date, current status, and assignment when available.
    Material section - Show part, description, quantity, location, and inventory or WIP information when applicable.
    Workflow section - Show approval, dispatch, acceptance, cancellation, and audit information when available.
    Navigation - Provide a clear way to return to the waitlist and preserve the selected request context.
-->