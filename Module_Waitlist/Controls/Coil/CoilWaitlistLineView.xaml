<UserControl
    x:Class="MTM_Waitlist.Module_Waitlist.Controls.Coil.CoilWaitlistLineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MTM_Waitlist.Module_Waitlist.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <local:WaitlistLineCardView
            AccentBrush="#FF6E839C"
            AccentSurfaceBrush="#FFEAF0F7"
            BadgeBackgroundBrush="#FFD4E2EF"
            BadgeText="COIL"
            Order="{Binding Mode=OneWay}">
        <local:WaitlistLineCardView.DetailsContent>
            <Grid ColumnSpacing="12" RowSpacing="2">
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontWeight="SemiBold" Text="Requested coil" />
                <TextBlock Grid.Column="1" Text="{Binding Fields[0].Value}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Quantity in house" />
                <TextBlock Grid.Column="3" Text="{Binding Fields[1].Value}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Coil description" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Fields[2].Value}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" Grid.Column="2" FontWeight="SemiBold" Text="Average coil weight" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Fields[3].Value}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Requesting work center" />
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Fields[4].Value}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </local:WaitlistLineCardView.DetailsContent>
    </local:WaitlistLineCardView>
</UserControl>

<!--
    Notes
    Card contents:
    Requested coil - The coil number associated with the work order. Blank when the request is not tied to a coil.
    Quantity in house - Total available quantity for the coil's part across inventory locations, excluding NCM and SHIP locations.
    Coil description - The description of the coil's part number.
    Average coil weight - The average received weight for this part number from the MTM Receiving application database.
    Requesting work center - The work center associated with the user who created the waitlist line.

    Detail page contents:
    Requested coil - The coil number associated with the work order. Blank when the request is not tied to a coil.
    Quantity in house - Total available quantity for the coil's part across inventory locations, excluding NCM and SHIP locations.
    Quantity still needed - Work-order coil quantity required minus the quantity already issued or used by the work order.
    Coil description - The description of the coil's part number.
    Average coil weight - The average received weight for this part number from the MTM Receiving application database.
    Work center - The work center associated with the waitlist request.
    Work center description - The description of the requesting work center.
    Work order number - The work order identifier associated with the waitlist request.
    Requesting user - The user who created the waitlist line.
    Requesting user's employee number - The employee number of the user who created the waitlist line.
    Coil tipping strategy - Use Crane when the coil height is less than 10 inches; otherwise use Tipper.
-->