<ContentDialog
    x:Class="MTM_Waitlist.Module_Waitlist.Views.NewRequestSubtypeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="RootDialog"
    DefaultButton="Close"
    CloseButtonText="Cancel"
    Title="Choose subtype"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    Style="{StaticResource RequestContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
        <x:Double x:Key="ContentDialogThemeMaxWidth">600</x:Double>
        <x:Double x:Key="ContentDialogThemeMinWidth">600</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">600</x:Double>
        <x:Double x:Key="ContentDialogMinHeight">600</x:Double>
        <x:Double x:Key="ContentDialogThemeMinHeight">600</x:Double>
        <x:Double x:Key="ContentDialogThemeMaxHeight">600</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">600</x:Double>
        <x:Double x:Key="ContentDialogHeight">600</x:Double>
        <x:Double x:Key="ContentDialogThemeHeight">600</x:Double>
    </ContentDialog.Resources>

    <Grid MinWidth="560" MinHeight="360" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="RequestTypeTextBlock"
            Grid.Row="0"
            Style="{ThemeResource BodyStrongTextBlockStyle}"
            TextWrapping="WrapWholeWords" />

        <TextBlock
            Grid.Row="1"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Select a subtype to continue."
            TextWrapping="WrapWholeWords" />

        <GridView
            x:Name="SubtypeGridView"
            Grid.Row="2"
            IsItemClickEnabled="True"
            ItemClick="SubtypeGridView_ItemClick"
            SelectionMode="Single">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Width="150"
                        Height="150"
                        Margin="8"
                        Padding="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <Border
                                Width="72"
                                Height="72"
                                Padding="4"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <Image
                                    Source="{Binding ImagePath, Converter={StaticResource ResolvedImagePathToSourceConverter}}"
                                    Stretch="Uniform" />
                            </Border>
                            <TextBlock
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="{Binding RequestType}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</ContentDialog>
