<Page
    x:Class="MTM_Waitlist.Module_Waitlist.Views.NewRequestSummaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MTM_Waitlist.Module_Settings.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Style="{StaticResource SetupPageGridStyle}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource SetupPageHeaderStyle}">
            <TextBlock Style="{StaticResource SetupPageTitleStyle}" Text="Confirm request" />
            <TextBlock Style="{StaticResource SetupPageSubtitleStyle}" Text="Review the details and submit your request." />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="16">
            <Border Style="{StaticResource SetupSectionCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource RequestDialogTitleStyle}" Text="Request summary" />
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource RequestDialogFieldLabelStyle}"
                            Text="Work Center" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource RequestDialogFieldValueStyle}"
                            Text="{x:Bind ViewModel.WorkCenter, Mode=OneWay}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource RequestDialogFieldLabelStyle}"
                            Text="Category" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource RequestDialogFieldValueStyle}"
                            Text="{x:Bind ViewModel.CategoryText, Mode=OneWay}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource RequestDialogFieldLabelStyle}"
                            Text="Item"
                            Visibility="{x:Bind ViewModel.HasItem, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource RequestDialogFieldValueStyle}"
                            Text="{x:Bind ViewModel.ItemText, Mode=OneWay}"
                            TextWrapping="WrapWholeWords"
                            Visibility="{x:Bind ViewModel.HasItem, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Style="{StaticResource RequestDialogFieldLabelStyle}"
                            Text="Details"
                            Visibility="{x:Bind ViewModel.HasDetail, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <!--
                            One row per entry this confirmation will raise, not one row for the request: two dies
                            chosen is two requests, and the operator sees both before committing.
                        -->
                        <ItemsControl
                            AutomationProperties.AutomationId="NewRequestSummaryPage_DetailLines"
                            Grid.Row="3"
                            Grid.Column="1"
                            ItemsSource="{x:Bind ViewModel.DetailLines, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasDetail, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Style="{StaticResource RequestDialogFieldValueStyle}"
                                        Text="{Binding}"
                                        TextWrapping="WrapWholeWords" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!--
                        The part this confirmation is asking for, drawn with its own picture, and with the one
                        shared placeholder when the part cannot be pictured — never a blank space and never artwork
                        chosen from the part's family (FR-014, FR-015, FR-018). A request that names no particular
                        material draws no part block at all.
                    -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.HasPart, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border
                            MinWidth="72"
                            MinHeight="72"
                            Padding="4"
                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <Image
                                AutomationProperties.AutomationId="NewRequestSummaryPage_PartPicture"
                                Source="{x:Bind ViewModel.PartPicturePath, Mode=OneWay, Converter={StaticResource ResolvedImagePathToSourceConverter}}"
                                Stretch="Uniform" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RequestDialogFieldLabelStyle}" Text="Part" />
                            <TextBlock Style="{StaticResource RequestDialogFieldValueStyle}" Text="{x:Bind ViewModel.PartNumber, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Style="{StaticResource SetupSectionCardStyle}"
                Visibility="{x:Bind ViewModel.IsCoilVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource RequestDialogTitleStyle}" Text="Coil details" />
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource RequestDialogFieldLabelStyle}"
                            Text="Requested coil" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource RequestDialogFieldValueStyle}"
                            Text="{x:Bind ViewModel.CoilNumber, Mode=OneWay}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource RequestDialogFieldLabelStyle}"
                            Text="Quantity in house" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource RequestDialogFieldValueStyle}"
                            Text="{x:Bind ViewModel.CoilQuantityOnHand, Mode=OneWay}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource RequestDialogFieldLabelStyle}"
                            Text="Coil description" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource RequestDialogFieldValueStyle}"
                            Text="{x:Bind ViewModel.CoilDescription, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Style="{StaticResource RequestDialogFieldLabelStyle}"
                            Text="Average coil weight"
                            Visibility="{x:Bind ViewModel.HasCoilAverageWeight, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource RequestDialogFieldValueStyle}"
                            Text="{x:Bind ViewModel.CoilAverageWeight, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasCoilAverageWeight, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- The step resolves how many requests this will raise; showing it is what stops the operator
                 discovering the second entry after they have committed to it. -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasMultipleRequests, Mode=OneWay}"
                IsClosable="False"
                Severity="Informational"
                Message="{x:Bind ViewModel.RequestCountText, Mode=OneWay}" />

            <InfoBar
                IsOpen="{x:Bind ViewModel.IsStatusVisible, Mode=OneWay}"
                Severity="Error"
                Title="Current job changed"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="2" />

        <StackPanel Grid.Row="3" Style="{StaticResource SetupActionBarStyle}">
            <Button
                AutomationProperties.AutomationId="NewRequestSummaryPage_BackButton"
                Content="Back"
                Command="{x:Bind ViewModel.BackCommand}"
                IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}" />
            <Button
                AutomationProperties.AutomationId="NewRequestSummaryPage_SubmitButton"
                Command="{x:Bind ViewModel.SubmitCommand}"
                Style="{StaticResource AccentButtonStyle}"
                IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing
                            Width="16"
                            Height="16"
                            IsActive="{x:Bind ViewModel.IsSubmitting, Mode=OneWay}" />
                        <TextBlock Text="Submit" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </StackPanel>
    </Grid>
</Page>
