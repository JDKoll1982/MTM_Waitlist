<Page
    x:Class="MTM_Waitlist.Module_Waitlist.Views.WaitlistViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:MTM_Waitlist.Module_Shared.Services"
    xmlns:animations="using:CommunityToolkit.WinUI.UI.Animations"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Waitlist.Models"
    xmlns:cardControls="using:MTM_Waitlist.Module_Waitlist.Controls"
    xmlns:winui="using:Microsoft.UI.Xaml.Controls"
    xmlns:converters="using:MTM_Waitlist.Module_Settings.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!--  One card template for every Item (FR-006): there is nothing left to choose between.  -->
        <DataTemplate x:Key="WaitlistLineCardTemplate" x:DataType="models:SampleOrder">
            <cardControls:WaitlistLineCardView
                AutomationProperties.Name="{x:Bind Title}"
                AccentBrush="{ThemeResource AccentFillColorDefaultBrush}"
                AccentSurfaceBrush="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                Order="{Binding}" />
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="ContentArea">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="FabLayoutStates">
                <VisualState x:Name="CompactFabState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="WaitlistListView.Padding" Value="6,12,6,92" />
                        <Setter Target="WaitlistFab.Width" Value="56" />
                        <Setter Target="WaitlistFab.Height" Value="56" />
                        <Setter Target="WaitlistFab.CornerRadius" Value="28" />
                        <Setter Target="WaitlistFabIcon.FontSize" Value="24" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="WideFabState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="WaitlistListView.Padding" Value="6,12,6,108" />
                        <Setter Target="WaitlistFab.Width" Value="72" />
                        <Setter Target="WaitlistFab.Height" Value="72" />
                        <Setter Target="WaitlistFab.CornerRadius" Value="36" />
                        <Setter Target="WaitlistFabIcon.FontSize" Value="30" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ListView
            AutomationProperties.AutomationId="WaitlistViewPage_CardList"
            x:Name="WaitlistListView"
            Padding="6,12,6,92"
            IsItemClickEnabled="True"
            ItemClick="ListView_ItemClick"
            ItemTemplate="{StaticResource WaitlistLineCardTemplate}"
            ItemsSource="{x:Bind ViewModel.Source, Mode=OneWay}"
            SelectionMode="Single">

            <!--  Adjust container item style to stretch row content full width  -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ListViewItemPresenter
                                    ContentMargin="0"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    PointerOverBackground="Transparent"
                                    PressedBackground="Transparent"
                                    SelectedBackground="Transparent"
                                    SelectedPointerOverBackground="Transparent"
                                    SelectionCheckMarkVisualEnabled="False" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

        </ListView>

        <!--
          This screen's internal-store unavailable state (FR-021). It appears only while the waitlist
          database has failed every bounded retry, in this screen rather than as an app-wide banner, and it
          clears itself as soon as a read succeeds. The retry re-runs this screen's own load. All text is
          resource-backed (constitution V).
        -->
        <InfoBar
            x:Name="StoreUnavailableBar"
            Margin="12,12,12,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.StoreUnavailable.IsUnavailable, Mode=OneWay}"
            Message="{x:Bind ViewModel.StoreUnavailableMessage, Mode=OneWay}"
            Severity="Error"
            Title="{x:Bind ViewModel.StoreUnavailableTitle, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button
                    AutomationProperties.AutomationId="WaitlistViewPage_StoreRetryButton"
                    Command="{x:Bind ViewModel.StoreUnavailable.RetryCommand, Mode=OneWay}"
                    Content="{x:Bind ViewModel.StoreUnavailableRetryText, Mode=OneWay}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid
            x:Name="EmptyWaitlistState"
            Visibility="{x:Bind ViewModel.IsWaitlistEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
            IsHitTestVisible="False"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Margin="24">
            <Border
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <Grid>
                    <Grid
                        MaxWidth="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Image
                            x:Name="EmptyStateImage"
                            Grid.Row="0"
                            Width="240"
                            Height="240"
                            HorizontalAlignment="Center"
                            Stretch="Uniform"
                            Source="ms-appx:///Assets/Placeholders/waitlist-empty-state.png"
                            AutomationProperties.Name="No requests available illustration" />

                        <TextBlock
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="No Requests Right Now"
                            TextAlignment="Center" />

                        <TextBlock
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="Tap the + button to add the first request for this Work Center."
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!--  Floating Green Circular Action Button  -->
        <Button
            AutomationProperties.AutomationId="WaitlistViewPage_AddRequestButton"
            x:Name="WaitlistFab"
            Width="56"
            Height="56"
            Click="OnAddRequestClick"
            Margin="36"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            AutomationProperties.Name="Add Waitlist Item"
            Background="{ThemeResource SystemFillColorSuccessBrush}"
            BorderBrush="Black"
            BorderThickness="4"
            CornerRadius="28"
            Style="{ThemeResource DefaultButtonStyle}" shared:TooltipBehavior.ResourceKey="Waitlist_WaitlistFab_Tooltip" shared:TooltipBehavior.AssociatedFiles="Module_Waitlist/Views/WaitlistViewPage.xaml|Module_Waitlist/Views/WaitlistViewPage.xaml.cs|Module_Waitlist/ViewModels/WaitlistViewViewModel.cs|Module_Shared/Services/TooltipBehavior.cs|Module_Shared/Services/TooltipService.cs|Module_Shared/Services/ControlInspectorService.cs|Module_Core/Helpers/ResourceExtensions.cs" shared:TooltipBehavior.FallbackText="Add Waitlist Item.">
            <FontIcon
                x:Name="WaitlistFabIcon"
                FontSize="24"
                Foreground="White"
                Glyph="&#xE710;" />
        </Button>
    </Grid>
</Page>


