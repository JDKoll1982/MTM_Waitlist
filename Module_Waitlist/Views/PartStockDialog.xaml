<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MTM_Waitlist.Module_Waitlist.Views.PartStockDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:MTM_Waitlist.Module_Waitlist.ViewModels"
    mc:Ignorable="d"
    AutomationProperties.AutomationId="PartStockDialog"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">480</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">640</x:Double>
    </ContentDialog.Resources>

    <StackPanel MinWidth="440" Spacing="16">

        <!-- The part, large, with the system that answered as a badge beside it. -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="PartNumberText"
                Grid.Column="0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="PartStockDialog_PartNumber"
                IsTextSelectionEnabled="True"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.PartNumber, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />

            <Border
                x:Name="SourceBadge"
                Grid.Column="1"
                Padding="12,4"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="PartStockDialog_Source"
                AutomationProperties.Name="{x:Bind ViewModel.SourceLabelText}"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="12"
                Visibility="{x:Bind ViewModel.HasAnswer, Mode=OneWay}">
                <TextBlock
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.SourceText, Mode=OneWay}" />
            </Border>
        </Grid>

        <TextBlock
            x:Name="SourceNoteTextBlock"
            AutomationProperties.AutomationId="PartStockDialog_SourceNote"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.SourceNoteText, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.HasSourceNote, Mode=OneWay}" />

        <StackPanel
            x:Name="LoadingPanel"
            Orientation="Horizontal"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <muxc:ProgressRing
                Width="24"
                Height="24"
                AutomationProperties.AutomationId="PartStockDialog_Progress"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.LoadingText}" />
        </StackPanel>

        <!-- Column headers, then one row per location. -->
        <Grid x:Name="LocationHeaderRow" ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasLocations, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.LocationHeaderText}" />
            <TextBlock
                Grid.Column="1"
                HorizontalTextAlignment="Right"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.QuantityHeaderText}" />
        </Grid>

        <ScrollViewer
            MaxHeight="280"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind ViewModel.ShowsStockRows, Mode=OneWay}">
            <StackPanel>
                <ItemsControl
                    x:Name="LocationList"
                    AutomationProperties.AutomationId="PartStockDialog_Locations"
                    ItemsSource="{x:Bind ViewModel.Locations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PartStockLocationItem">
                            <Grid Padding="0,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Location}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalTextAlignment="Right"
                                    Text="{x:Bind QuantityText}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    The part-wide total, drawn as the list's own last row rather than as a card above it: the same
                    two columns, the same row height and the same type as the rows it follows, closed off by one
                    hairline. It scrolls with the list it belongs to.
                -->
                <Border
                    x:Name="TotalRow"
                    Padding="0,6"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="{x:Bind ViewModel.HasTotal, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.TotalLabelText}" />
                        <TextBlock
                            x:Name="TotalValue"
                            Grid.Column="1"
                            HorizontalTextAlignment="Right"
                            AutomationProperties.AutomationId="PartStockDialog_Total"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock
            x:Name="EmptyTextBlock"
            AutomationProperties.AutomationId="PartStockDialog_Empty"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.HasEmptyText, Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
