<Page
    x:Class="MTM_Waitlist.Module_Waitlist.Views.NewRequestResultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MTM_Waitlist.Module_Settings.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Style="{StaticResource SetupPageGridStyle}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <FontIcon
                    Width="64"
                    Height="64"
                    HorizontalAlignment="Center"
                    FontSize="64"
                    Glyph="{x:Bind ViewModel.IconGlyph, Mode=OneWay}"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SetupPageTitleStyle}"
                    Text="{x:Bind ViewModel.Heading, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="WrapWholeWords" />

                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SetupPageSubtitleStyle}"
                    Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="WrapWholeWords" />

                <ProgressRing
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.IsSuccess, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button
                        Content="Add Another Request"
                        Command="{x:Bind ViewModel.AddAnotherRequestCommand}" />
                    <Button
                        Content="Return to Waitlist"
                        Command="{x:Bind ViewModel.ReturnToWaitlistCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.IsDuplicate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button
                        Content="Cancel"
                        Command="{x:Bind ViewModel.CancelToWaitlistCommand}" />
                    <Button
                        Content="Continue"
                        Command="{x:Bind ViewModel.ContinueDuplicateCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.IsFailure, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button
                        Content="Close"
                        Command="{x:Bind ViewModel.CancelToWaitlistCommand}" />
                    <Button
                        Content="Retry"
                        Command="{x:Bind ViewModel.RetryCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" />
    </Grid>
</Page>
