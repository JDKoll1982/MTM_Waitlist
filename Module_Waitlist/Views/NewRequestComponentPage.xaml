<Page
    x:Class="MTM_Waitlist.Module_Waitlist.Views.NewRequestComponentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MTM_Waitlist.Module_Waitlist.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sharedControls="using:MTM_Waitlist.Module_Shared.Controls"
    mc:Ignorable="d">

    <Grid Style="{StaticResource SetupPageGridStyle}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource SetupPageHeaderStyle}">
            <TextBlock
                x:Uid="NewRequest_Component.Title"
                Style="{StaticResource SetupPageTitleStyle}"
                Text="New Request - Choose Component" />
            <TextBlock Style="{StaticResource SetupPageSubtitleStyle}" Text="{x:Bind ViewModel.WorkCenterText, Mode=OneWay}" />
            <TextBlock Style="{StaticResource SetupPageSubtitleStyle}" Text="{x:Bind ViewModel.PromptText, Mode=OneWay}" />
            <TextBlock
                Margin="0,6,0,0"
                Style="{StaticResource RequestDialogCaptionStyle}"
                Text="{x:Bind ViewModel.UnavailableMessage, Mode=OneWay}"
                TextWrapping="WrapWholeWords"
                Visibility="{x:Bind ViewModel.IsUnavailableVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <GridView
                    AutomationProperties.AutomationId="NewRequestComponentPage_ComponentTiles"
                    x:Name="ComponentGridView"
                    ItemsSource="{x:Bind ViewModel.Options, Mode=OneWay}"
                    IsItemClickEnabled="True"
                    ItemClick="ComponentGridView_ItemClick"
                    SelectionMode="None">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:NewRequestComponentOption">
                            <Grid
                                Margin="8"
                                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                AutomationProperties.Name="{x:Bind Title}">
                                <Border
                                    Width="150"
                                    Height="170"
                                    Padding="10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                        <!-- The picture box. It draws the part's own picture, and the one shared no-image placeholder when the part cannot be pictured: never a blank space, and never artwork standing in for the part (FR-014, FR-018, FR-023). -->
                                        <Border
                                            Width="84"
                                            Height="84"
                                            Padding="4"
                                            HorizontalAlignment="Center"
                                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                            CornerRadius="8">
                                            <sharedControls:ClickToEnlargeImageView
                                                AutomationProperties.AutomationId="{x:Bind ImageAutomationId}"
                                                Source="{x:Bind ImagePath, Converter={StaticResource ResolvedImagePathToSourceConverter}}"
                                                Stretch="Uniform" />
                                        </Border>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            TextAlignment="Center"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Title}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Border>

                                <!-- Selection outline, drawn only on the card currently chosen. -->
                                <Border
                                    BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    IsHitTestVisible="False"
                                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Style="{StaticResource SetupActionBarStyle}">
            <Button
                AutomationProperties.AutomationId="NewRequestComponentPage_BackButton"
                x:Uid="NewRequest_Component.BackButton"
                Content="Back"
                Command="{x:Bind ViewModel.BackCommand}" />
        </StackPanel>
    </Grid>
</Page>
