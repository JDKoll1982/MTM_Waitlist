<Page
    x:Class="MTM_Waitlist.Module_Waitlist.Views.WaitlistViewDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Waitlist.Models"
    mc:Ignorable="d">

    <Grid x:Name="ContentArea">
        <ScrollViewer IsTabStop="True">
            <Grid
                x:Name="ContentPanel"
                Padding="24"
                RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Padding="20"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            x:Name="ItemHero"
                            Grid.RowSpan="6"
                            MinWidth="88"
                            MinHeight="88"
                            MaxWidth="110"
                            MaxHeight="110"
                            Padding="12"
                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                            CornerRadius="12"
                            Visibility="{x:Bind ViewModel.IsItemPresent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Image
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="View larger request type image"
                                Source="{x:Bind ViewModel.Item.EffectiveImagePath, Mode=OneWay, Converter={StaticResource ResolvedImagePathToSourceConverter}}"
                                Stretch="Uniform"
                                Tapped="OpenImageViewer_Tapped" />
                        </Border>

                        <!-- The active work center / press image, shown like the request-type image
                             on the right of the same hero card (click to enlarge). -->
                        <Border
                            Grid.Column="3"
                            Grid.RowSpan="6"
                            MinWidth="110"
                            MinHeight="110"
                            MaxWidth="150"
                            MaxHeight="150"
                            Padding="12"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                            CornerRadius="12"
                            Visibility="{x:Bind ViewModel.IsItemPresent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Image
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="View larger work center image"
                                Source="{x:Bind ViewModel.Item.EffectiveWorkCenterImagePath, Mode=OneWay, Converter={StaticResource ResolvedImagePathToSourceConverter}}"
                                Stretch="Uniform"
                                Tapped="OpenImageViewer_Tapped" />
                        </Border>

                        <TextBlock
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.Item.Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="WrapWholeWords" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Text="Requested By" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.Item.RequestedByName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Text="Work Center" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="2"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.Item.RequestedPressName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Text="Remaining Time" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="2"
                            Foreground="{x:Bind ViewModel.Item.RemainingTimeText, Mode=OneWay, Converter={StaticResource RemainingTimeToBrushConverter}}"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.Item.RemainingTimeText, Mode=OneWay}" />

                        <TextBlock
                            Grid.Column="1"
                            Grid.Row="5"
                            Grid.ColumnSpan="2"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="Material, workflow, and handoff details are shown below." 
                            TextWrapping="WrapWholeWords" />
                    </Grid>
                </Border>

                <TextBlock
                    Grid.Row="1"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="Request Details" />

                <!-- Section failure, rendered in place with a retry (contract C2, data-model.md §1). The
                     element is x:Load-gated, so when nothing failed it is not in the visual tree at all;
                     x:Name is required on every element that carries x:Load. A section with nothing to
                     show is hidden instead — it is not added to TemplateSections, so the list below draws
                     no shell for it and no placeholder value stands in for the missing read. -->
                <Border
                    x:Name="SectionFailureBlock"
                    Grid.Row="2"
                    Margin="0,0,0,16"
                    Padding="18"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    x:Load="{x:Bind ViewModel.IsSectionLoadFailed, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.SectionFailureMessage, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                        <Button
                            HorizontalAlignment="Left"
                            Command="{x:Bind ViewModel.RetryLoadCommand}"
                            Content="{x:Bind ViewModel.SectionFailureRetryText}" />
                    </StackPanel>
                </Border>

                <ItemsControl
                    Grid.Row="2"
                    ItemsSource="{x:Bind ViewModel.TemplateSections, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:WaitlistDetailTemplateSection">
                            <Border
                                Margin="0,0,0,16"
                                Padding="18"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Style="{ThemeResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind Title}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind Summary}"
                                        TextWrapping="WrapWholeWords" />
                                    <ItemsControl
                                        Grid.Row="2"
                                        ItemsSource="{x:Bind Fields}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid
                                                    HorizontalAlignment="Stretch"
                                                    MaximumRowsOrColumns="2"
                                                    Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:WaitlistDetailTemplateField">
                                                <Grid
                                                    MinWidth="260"
                                                    MaxWidth="420"
                                                    Margin="0,0,16,6"
                                                    ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="120" MaxWidth="180" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="{x:Bind Label}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Value}"
                                                        TextWrapping="WrapWholeWords" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border
                    Grid.Row="3"
                    Margin="0,0,0,16"
                    Padding="18"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{x:Bind ViewModel.IsInventoryEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="Inventory by Location" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{x:Bind ViewModel.SortInventoryCommand}"
                                CommandParameter="PartNumber"
                                Style="{ThemeResource DefaultButtonStyle}"
                                FontWeight="SemiBold"
                                Content="Part #" />
                            <Button
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{x:Bind ViewModel.SortInventoryCommand}"
                                CommandParameter="Location"
                                Style="{ThemeResource DefaultButtonStyle}"
                                FontWeight="SemiBold"
                                Content="Location" />
                            <Button
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{x:Bind ViewModel.SortInventoryCommand}"
                                CommandParameter="Quantity"
                                Style="{ThemeResource DefaultButtonStyle}"
                                FontWeight="SemiBold"
                                Content="Quantity (lb)" />
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.InventoryRows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Padding="4,2"
                                        ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{Binding PartNumber}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding Location}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding OnHandQuantity}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- The accept / complete / release / cancel actions are NOT here: they live on the list card,
                     which is where a handler works through the queue. This page reads the request, takes a note
                     and shows what has happened to it. -->

                <!-- The request's message box. Anyone signed in may send one — this is how the floor tells whoever
                     picks the request up what is happening — so it is not gated on the handler role. Text is pushed
                     to the view model as it is typed: x:Bind defaults TextBox.Text to LostFocus, which meant the
                     first click read an empty draft and saved nothing. -->
                <Border
                    Grid.Row="4"
                    Margin="0,0,0,16"
                    Padding="18"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{x:Bind ViewModel.IsItemPresent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.NoteLabel, Mode=OneWay}" />
                        <TextBox
                            AcceptsReturn="True"
                            AutomationProperties.Name="{x:Bind ViewModel.NoteLabel, Mode=OneWay}"
                            PlaceholderText="{x:Bind ViewModel.NotePlaceholder, Mode=OneWay}"
                            Text="{x:Bind ViewModel.NoteDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12"
                            Visibility="{x:Bind ViewModel.HasNoteMessage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.NoteMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Left"
                            Command="{x:Bind ViewModel.SaveNoteCommand}"
                            Content="{x:Bind ViewModel.NoteSaveText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- The request's audit trail, read from the store so it covers what happened before this
                     session, and refreshed every 30 seconds while the page is open. A request with nothing
                     recorded says so rather than hiding the block, so an empty history stays distinguishable
                     from one that could not be read. -->
                <Border
                    Grid.Row="5"
                    Margin="0,0,0,16"
                    Padding="18"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{x:Bind ViewModel.IsItemPresent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.HistoryTitle, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.HistorySummary, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.HistoryRows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:WaitlistRequestAuditEntry">
                                    <Grid
                                        Padding="0,4"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="140" />
                                            <ColumnDefinition Width="Auto" MinWidth="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind OccurredLocalText}" />
                                        <!-- Who sent it, by name. The message type (created / accepted / completed /
                                             canceled / note updated) is deliberately not shown: the user needs to
                                             know who said something, not which audit event carried it. -->
                                        <TextBlock
                                            Grid.Column="1"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind ActorDisplayName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <!-- What was said, in the entry's own words. -->
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind Details}"
                                            TextWrapping="WrapWholeWords" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.HistoryEmptyText, Mode=OneWay}"
                            TextWrapping="WrapWholeWords"
                            Visibility="{x:Bind ViewModel.IsHistoryEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <StackPanel
                    Grid.RowSpan="6"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.IsEmptyStateVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="Nothing to show"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.EmptyStateMessage, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <!--
                  The Item's own declared fields (FR-007). They live here and never on the card. Fields are
                  laid out in declared order, two per row, and a field alone on its row takes that row's full
                  width — the span comes from the declared field count, never from the Item's identity (§D9,
                  FR-006). A field whose value no source produces is not drawn, so the grid simply has fewer
                  rows rather than a placeholder standing in for a value.
                -->
                <Border
                    Grid.Row="6"
                    Padding="18"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{x:Bind ViewModel.HasDeclaredFields, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Uid="Waitlist_Detail.DeclaredFields.Title"
                            Grid.Row="0"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.DeclaredFieldsTitle, Mode=OneWay}" />
                        <ItemsControl
                            Grid.Row="1"
                            ItemsSource="{x:Bind ViewModel.DeclaredFieldRows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:WaitlistDetailFieldRow">
                                    <Grid Margin="0,0,0,6" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid
                                            Grid.Column="0"
                                            Grid.ColumnSpan="{x:Bind FirstSpan}"
                                            ColumnSpacing="12"
                                            Visibility="{x:Bind HasFirst, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="120" MaxWidth="180" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind First.Label}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind First.Value}"
                                                TextWrapping="WrapWholeWords" />
                                        </Grid>
                                        <Grid
                                            Grid.Column="1"
                                            ColumnSpacing="12"
                                            Visibility="{x:Bind HasSecond, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="120" MaxWidth="180" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Second.Label}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Second.Value}"
                                                TextWrapping="WrapWholeWords" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Enlarged-image viewer (lightbox). Clicking either hero image opens it with the
             full-size image; the X (top right) or tapping the scrim closes it. -->
        <Grid
            x:Name="ImageViewerOverlay"
            Background="#CC000000"
            Visibility="Collapsed"
            Tapped="ImageViewerScrim_Tapped">
            <Button
                Margin="16"
                Padding="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                AutomationProperties.Name="Close image viewer"
                Click="ImageViewerClose_Click"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                Content="&#xE711;" />
            <Image
                x:Name="ImageViewerImage"
                Margin="64"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Stretch="Uniform" />
        </Grid>
    </Grid>
</Page>
