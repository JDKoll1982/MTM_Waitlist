<Page
    x:Class="MTM_Waitlist.Module_Waitlist.Views.WaitlistViewDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Waitlist.Models"
    xmlns:converters="using:MTM_Waitlist.Module_Waitlist.Converters"
    xmlns:sharedControls="using:MTM_Waitlist.Module_Shared.Controls"
    xmlns:shared="using:MTM_Waitlist.Module_Shared.Services"
    xmlns:dev="using:DevWinUI"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- One bubble template per side, because the two sides differ in more than alignment: their bubble and
             text colours are different theme brushes, and a theme brush can only be named statically. -->
        <DataTemplate x:Key="MineMessageTemplate" x:DataType="models:WaitlistMessageRow">
            <StackPanel
                Margin="0,0,0,10"
                HorizontalAlignment="Right">
                <Border
                    Padding="14,10"
                    HorizontalAlignment="Right"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="12"
                    MaxWidth="560">
                    <TextBlock
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Text}"
                        TextWrapping="WrapWholeWords" />
                </Border>
                <TextBlock
                    Margin="6,4,6,0"
                    HorizontalAlignment="Right"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind SenderDisplayName}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TheirMessageTemplate" x:DataType="models:WaitlistMessageRow">
            <StackPanel
                Margin="0,0,0,10"
                HorizontalAlignment="Left">
                <Border
                    Padding="14,10"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="12"
                    MaxWidth="560">
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Text}"
                        TextWrapping="WrapWholeWords" />
                </Border>
                <TextBlock
                    Margin="6,4,6,0"
                    HorizontalAlignment="Left"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind SenderDisplayName}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <converters:WaitlistMessageTemplateSelector
            x:Key="MessageTemplateSelector"
            MineTemplate="{StaticResource MineMessageTemplate}"
            TheirTemplate="{StaticResource TheirMessageTemplate}" />
    </Page.Resources>

    <Grid
        x:Name="ContentArea"
>
        <ScrollViewer IsTabStop="True">
            <Grid
                x:Name="ContentPanel"
                Padding="24"
                RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Padding="20"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            x:Name="ItemHero"
                            Grid.RowSpan="6"
                            MinWidth="88"
                            MinHeight="88"
                            MaxWidth="110"
                            MaxHeight="110"
                            Padding="12"
                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                            CornerRadius="12"
                            Visibility="{x:Bind ViewModel.IsItemPresent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <sharedControls:ClickToEnlargeImageView
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="WaitlistViewDetailPage_RequestTypeImage"
                                AutomationProperties.Name="Request picture"
                                Source="{x:Bind ViewModel.Item.EffectiveImagePath, Mode=OneWay, Converter={StaticResource ResolvedImagePathToSourceConverter}}"
                                Stretch="Uniform" />
                        </Border>

                        <!-- The active work center / press image, shown like the request image on the right of the
                             same hero card (click to enlarge). -->
                        <Border
                            Grid.Column="3"
                            Grid.RowSpan="6"
                            MinWidth="110"
                            MinHeight="110"
                            MaxWidth="150"
                            MaxHeight="150"
                            Padding="12"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                            CornerRadius="12"
                            Visibility="{x:Bind ViewModel.IsItemPresent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <sharedControls:ClickToEnlargeImageView
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="WaitlistViewDetailPage_WorkCenterImage"
                                AutomationProperties.Name="Work center picture"
                                Source="{x:Bind ViewModel.Item.EffectiveWorkCenterImagePath, Mode=OneWay, Converter={StaticResource ResolvedImagePathToSourceConverter}}"
                                Stretch="Uniform" />
                        </Border>

                        <TextBlock
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.Item.Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="WrapWholeWords" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Text="Requested By" />
                        <dev:AutoScrollView IsPlaying="True"
                            Grid.Row="1"
                            Grid.Column="2"
                            VerticalAlignment="Center">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.Item.RequestedByName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </dev:AutoScrollView>
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Text="Work Center" />
                        <dev:AutoScrollView IsPlaying="True"
                            Grid.Row="2"
                            Grid.Column="2"
                            VerticalAlignment="Center">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.Item.RequestedPressName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </dev:AutoScrollView>
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Text="Remaining Time" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="2"
                            Foreground="{x:Bind ViewModel.Item.RemainingTimeText, Mode=OneWay, Converter={StaticResource RemainingTimeToBrushConverter}}"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.Item.RemainingTimeAndAllotmentText, Mode=OneWay}" />
                    </Grid>
                </Border>

                <TextBlock
                    Grid.Row="1"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="Request Details" />

                <!-- Section failure, rendered in place with a retry (contract C2, data-model.md §1). The
                     element is x:Load-gated, so when nothing failed it is not in the visual tree at all;
                     x:Name is required on every element that carries x:Load. A section with nothing to
                     show is hidden instead — it is not added to TemplateSections, so the list below draws
                     no shell for it and no placeholder value stands in for the missing read. -->
                <Border
                    x:Name="SectionFailureBlock"
                    Grid.Row="2"
                    Margin="0,0,0,16"
                    Padding="18"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    x:Load="{x:Bind ViewModel.IsSectionLoadFailed, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.SectionFailureMessage, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                        <Button
                            AutomationProperties.AutomationId="WaitlistViewDetailPage_SectionRetryButton"
                            HorizontalAlignment="Left"
                            Command="{x:Bind ViewModel.RetryLoadCommand}"
                            Content="{x:Bind ViewModel.SectionFailureRetryText}" />
                    </StackPanel>
                </Border>

                <ItemsControl
                    Grid.Row="2"
                    ItemsSource="{x:Bind ViewModel.TemplateSections, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:WaitlistDetailTemplateSection">
                            <Border
                                Margin="0,0,0,16"
                                Padding="18"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Style="{ThemeResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind Title}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind Summary}"
                                        TextWrapping="WrapWholeWords" />
                                    <ItemsControl
                                        Grid.Row="2"
                                        ItemsSource="{x:Bind Fields}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid
                                                    HorizontalAlignment="Stretch"
                                                    MaximumRowsOrColumns="2"
                                                    Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:WaitlistDetailTemplateField">
                                                <Grid
                                                    MinWidth="260"
                                                    MaxWidth="420"
                                                    Margin="0,0,16,6"
                                                    ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="120" MaxWidth="180" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="{x:Bind Label}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Value}"
                                                        TextWrapping="WrapWholeWords" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border
                    Grid.Row="3"
                    Margin="0,0,0,16"
                    Padding="18"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{x:Bind ViewModel.IsInventoryEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="Inventory by Location" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                AutomationProperties.AutomationId="WaitlistViewDetailPage_SortPartNumberButton"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{x:Bind ViewModel.SortInventoryCommand}"
                                CommandParameter="PartNumber"
                                Style="{ThemeResource DefaultButtonStyle}"
                                FontWeight="SemiBold"
                                Content="Part #" />
                            <Button
                                AutomationProperties.AutomationId="WaitlistViewDetailPage_SortLocationButton"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{x:Bind ViewModel.SortInventoryCommand}"
                                CommandParameter="Location"
                                Style="{ThemeResource DefaultButtonStyle}"
                                FontWeight="SemiBold"
                                Content="Location" />
                            <Button
                                AutomationProperties.AutomationId="WaitlistViewDetailPage_SortQuantityButton"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{x:Bind ViewModel.SortInventoryCommand}"
                                CommandParameter="Quantity"
                                Style="{ThemeResource DefaultButtonStyle}"
                                FontWeight="SemiBold"
                                Content="Quantity (lb)" />
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.InventoryRows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Padding="4,2"
                                        ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{Binding PartNumber}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding Location}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding OnHandQuantity}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- The accept / complete / release / cancel actions are NOT here: they live on the list card,
                     which is where a handler works through the queue. This page reads the request, takes a note
                     and shows what has happened to it. -->

                <!-- One card, read as a conversation: the thread above, the composer beneath it, and one header over
                     both carrying the toggle that swaps the thread for the audit trail. The audit trail is where the
                     changes that carry no words live — a request accepted, completed or cancelled — so they stay
                     reachable without putting an empty bubble in the conversation. Anyone signed in may send a
                     message; it is not gated on the handler role. Text is pushed to the view model as it is typed:
                     x:Bind defaults TextBox.Text to LostFocus, which meant the first click read an empty draft and
                     saved nothing. The box grows to a ceiling and then scrolls, because a TextBox with AcceptsReturn
                     grows without one. -->
                <Border
                    Grid.Row="4"
                    Margin="0,0,0,16"
                    Padding="18"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{x:Bind ViewModel.IsItemPresent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="12">

                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.StreamTitle, Mode=OneWay}" />

                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="4">
                                <Button
                                    Padding="8"
                                    AutomationProperties.AutomationId="WaitlistViewDetailPage_ShowMessagesButton"
                                    AutomationProperties.Name="{x:Bind ViewModel.ShowMessagesText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ShowMessagesCommand}"
                                    Visibility="{x:Bind ViewModel.CanShowMessages, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    shared:TooltipBehavior.AssociatedFiles="Module_Waitlist/Views/WaitlistViewDetailPage.xaml|MTM_Waitlist.Waitlist.View/ViewModels/WaitlistViewDetailViewModel.cs"
                                    shared:TooltipBehavior.FallbackText="Show the messages."
                                    shared:TooltipBehavior.ResourceKey="Waitlist_Note_Toggle_Messages_Tooltip">
                                    <FontIcon FontSize="16" Glyph="&#xE8BD;" />
                                </Button>
                                <Button
                                    Padding="8"
                                    AutomationProperties.AutomationId="WaitlistViewDetailPage_ShowAuditButton"
                                    AutomationProperties.Name="{x:Bind ViewModel.ShowAuditText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ShowAuditCommand}"
                                    Visibility="{x:Bind ViewModel.CanShowAudit, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    shared:TooltipBehavior.AssociatedFiles="Module_Waitlist/Views/WaitlistViewDetailPage.xaml|MTM_Waitlist.Waitlist.View/ViewModels/WaitlistViewDetailViewModel.cs"
                                    shared:TooltipBehavior.FallbackText="Show the audit trail."
                                    shared:TooltipBehavior.ResourceKey="Waitlist_Note_Toggle_Audit_Tooltip">
                                    <FontIcon FontSize="16" Glyph="&#xE81C;" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- The message thread. A message the signed-in person sent sits on the right and everyone
                             else's on the left, with the sender in small print beneath the bubble. -->
                        <StackPanel Spacing="0" Visibility="{x:Bind ViewModel.CanShowAudit, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ScrollViewer
                                MaxHeight="280"
                                AutomationProperties.AutomationId="WaitlistViewDetailPage_MessageStream"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="{x:Bind ViewModel.HasMessageStream, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl
                                    ItemTemplateSelector="{StaticResource MessageTemplateSelector}"
                                    ItemsSource="{x:Bind ViewModel.MessageStream, Mode=OneWay}" />
                            </ScrollViewer>

                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.MessageStreamEmptyText, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.IsMessageStreamEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- The audit trail behind the toggle: every change, with who made it and when. -->
                        <StackPanel Spacing="0" Visibility="{x:Bind ViewModel.IsAuditVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ScrollViewer
                                MaxHeight="280"
                                AutomationProperties.AutomationId="WaitlistViewDetailPage_AuditTrail"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.AuditRows, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:WaitlistMessageRow">
                                            <Grid
                                                Padding="0,5"
                                                ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="140" />
                                                    <ColumnDefinition Width="Auto" MinWidth="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind OccurredLocalText}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind SenderDisplayName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="{x:Bind Text}"
                                                    TextWrapping="WrapWholeWords" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.AuditEmptyText, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind ViewModel.HasAuditRows, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                        </StackPanel>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="0"
                                AcceptsReturn="True"
                                AutomationProperties.AutomationId="WaitlistViewDetailPage_NoteInput"
                                AutomationProperties.Name="{x:Bind ViewModel.NoteLabel, Mode=OneWay}"
                                MaxHeight="120"
                                MinHeight="44"
                                PlaceholderText="{x:Bind ViewModel.NotePlaceholder, Mode=OneWay}"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                Text="{x:Bind ViewModel.NoteDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Bottom" />

                            <Button
                                Grid.Column="1"
                                Padding="10"
                                AutomationProperties.AutomationId="WaitlistViewDetailPage_SaveNoteButton"
                                AutomationProperties.Name="{x:Bind ViewModel.NoteSaveText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.SaveNoteCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                VerticalAlignment="Bottom"
                                shared:TooltipBehavior.AssociatedFiles="Module_Waitlist/Views/WaitlistViewDetailPage.xaml|MTM_Waitlist.Waitlist.View/ViewModels/WaitlistViewDetailViewModel.cs"
                                shared:TooltipBehavior.FallbackText="Send this message."
                                shared:TooltipBehavior.ResourceKey="Waitlist_Note_Send_Tooltip">
                                <FontIcon FontSize="16" Glyph="&#xE724;" />
                            </Button>
                        </Grid>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.NoteMessage, Mode=OneWay}"
                            TextWrapping="WrapWholeWords"
                            Visibility="{x:Bind ViewModel.HasNoteMessage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <StackPanel
                    Grid.RowSpan="6"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.IsEmptyStateVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="Nothing to show"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.EmptyStateMessage, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <!--
                  The Item's own declared fields (FR-007). They live here and never on the card. Fields are
                  laid out in declared order, two per row, and a field alone on its row takes that row's full
                  width — the span comes from the declared field count, never from the Item's identity (§D9,
                  FR-006). A field whose value no source produces is not drawn, so the grid simply has fewer
                  rows rather than a placeholder standing in for a value.
                -->
                <Border
                    Grid.Row="6"
                    Padding="18"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{x:Bind ViewModel.IsDeclaredFieldsSectionVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Uid="Waitlist_Detail_DeclaredFields.Title"
                            Grid.Row="0"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.DeclaredFieldsTitle, Mode=OneWay}" />
                        <!--
                            A configuration this page cannot use is stated here rather than drawn as a grid with
                            fields quietly missing from it (FR-026).
                        -->
                        <TextBlock
                            Grid.Row="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.DeclaredFieldsReport, Mode=OneWay}"
                            TextWrapping="WrapWholeWords"
                            Visibility="{x:Bind ViewModel.HasDeclaredFieldsReport, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ItemsControl
                            Grid.Row="2"
                            ItemsSource="{x:Bind ViewModel.DeclaredFieldRows, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasDeclaredFields, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:WaitlistDetailFieldRow">
                                    <Grid Margin="0,0,0,6" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid
                                            Grid.Column="0"
                                            Grid.ColumnSpan="{x:Bind FirstSpan}"
                                            ColumnSpacing="12"
                                            Visibility="{x:Bind HasFirst, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="120" MaxWidth="180" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind First.Label}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontWeight="{x:Bind First.ValueFontWeight}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind First.Value}"
                                                TextWrapping="{x:Bind First.ValueTextWrapping}" />
                                        </Grid>
                                        <Grid
                                            Grid.Column="1"
                                            ColumnSpacing="12"
                                            Visibility="{x:Bind HasSecond, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="120" MaxWidth="180" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Second.Label}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontWeight="{x:Bind Second.ValueFontWeight}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Second.Value}"
                                                TextWrapping="{x:Bind Second.ValueTextWrapping}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
