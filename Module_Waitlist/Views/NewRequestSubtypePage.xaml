<Page
    x:Class="MTM_Waitlist.Module_Waitlist.Views.NewRequestSubtypePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Style="{StaticResource SetupPageGridStyle}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource SetupPageHeaderStyle}">
            <TextBlock Style="{StaticResource SetupPageTitleStyle}" Text="Choose a Subtype" />
            <TextBlock Style="{StaticResource SetupPageSubtitleStyle}" Text="{x:Bind ViewModel.RequestTypeName, Mode=OneWay}" />
            <TextBlock Style="{StaticResource SetupPageSubtitleStyle}" Text="Select a subtype to continue." />
        </StackPanel>

        <Grid Grid.Row="1">
            <ProgressRing
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <GridView
                    x:Name="SubtypeGridView"
                    ItemsSource="{x:Bind ViewModel.Subtypes, Mode=OneWay}"
                    IsItemClickEnabled="True"
                    ItemClick="SubtypeGridView_ItemClick"
                    SelectionMode="Single">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid
                                Orientation="Horizontal"
                                MaximumRowsOrColumns="4" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="150"
                                Height="150"
                                Margin="8"
                                Padding="10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                                    <Border
                                        Width="72"
                                        Height="72"
                                        Padding="4"
                                        HorizontalAlignment="Center"
                                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                        CornerRadius="8">
                                        <Image
                                            Source="{Binding ImagePath, Converter={StaticResource ResolvedImagePathToSourceConverter}}"
                                            Stretch="Uniform" />
                                    </Border>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        TextAlignment="Center"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Text="{Binding Name}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Style="{StaticResource SetupActionBarStyle}">
            <Button
                Content="Back"
                Command="{x:Bind ViewModel.BackCommand}" />
        </StackPanel>
    </Grid>
</Page>
