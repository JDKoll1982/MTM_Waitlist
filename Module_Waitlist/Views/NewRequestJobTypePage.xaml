<Page
    x:Class="MTM_Waitlist.Module_Waitlist.Views.NewRequestJobTypePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dev="using:DevWinUI"
    xmlns:shared="using:MTM_Waitlist.Module_Shared.Services">

    <Page.Resources>
        <!--
            The card is the clickable thing, so the item container draws nothing of its own. The generic flow's
            category step uses this same presenter, which is what keeps the two category screens looking alike.
        -->
        <Style x:Key="CategoryCardItemContainerStyle" TargetType="GridViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <ListViewItemPresenter
                            ContentMargin="0"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            PointerOverBackground="Transparent"
                            PressedBackground="Transparent"
                            SelectedBackground="Transparent"
                            SelectedPointerOverBackground="Transparent"
                            SelectedPressedBackground="Transparent"
                            SelectedBorderThickness="0"
                            RevealBorderThickness="0"
                            SelectionCheckMarkVisualEnabled="False" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid
        Style="{StaticResource SetupPageGridStyle}"
        Padding="24"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Spacing="8"
            Style="{StaticResource SetupPageHeaderStyle}">
            <TextBlock
                x:Uid="NewRequest_Category_Title"
                Style="{StaticResource SetupPageTitleStyle}"
                Text="New Request - Choose Category" />
            <TextBlock Style="{StaticResource SetupPageSubtitleStyle}" Text="{x:Bind ViewModel.WorkCenterText, Mode=OneWay}" />
            <TextBlock Style="{StaticResource SetupPageSubtitleStyle}" Text="{x:Bind ViewModel.PromptText, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                The coil readout sits in a card panel above the grid, which is the place and the surface the generic
                flow puts its job-fill offer on, so the two category steps read the same way.
            -->
            <StackPanel
                Grid.Row="0"
                Padding="16"
                Spacing="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="{x:Bind ViewModel.IsCoilBannerVisible, Mode=OneWay}">
                <TextBlock
                    Text="{x:Bind ViewModel.CoilBannerText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

                <!--
                    One card per category, drawn the way the generic flow draws them: a bordered surface, a title, a
                    divider and the details beneath it, with an accent outline on the chosen card. The click is the
                    choice, so the grid keeps no selection of its own and the outline follows the card's own flag.
                -->
                <GridView
                    AutomationProperties.AutomationId="NewRequestJobTypePage_CategoryTiles"
                    x:Name="JobTypeGridView"
                    HorizontalContentAlignment="Stretch"
                    IsItemClickEnabled="True"
                    ItemClick="JobTypeGridView_ItemClick"
                    ItemContainerStyle="{StaticResource CategoryCardItemContainerStyle}"
                    ItemsSource="{x:Bind ViewModel.Options, Mode=OneWay}"
                    SelectionMode="None"
                    shared:CardGridSizing.MaximumColumns="3"
                    shared:CardGridSizing.MinimumCardWidth="280">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid HorizontalAlignment="Stretch" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Margin="8"
                                AutomationProperties.Name="{Binding Name}">
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <StackPanel Padding="16" Spacing="10">
                                        <!-- The name is drawn by the one-line scrolling control (009 B1/B2), at the
                                             size the generic flow's category cards set, so a long name scrolls
                                             instead of wrapping and pushing the card out of shape. -->
                                        <dev:AutoScrollView IsPlaying="True"
                                            HorizontalAlignment="Stretch">
                                            <TextBlock
                                                FontSize="20"
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                        </dev:AutoScrollView>
                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Summary}"
                                            TextWrapping="Wrap"
                                            Style="{StaticResource BodyTextBlockStyle}" />
                                    </StackPanel>
                                </Border>

                                <!-- The chosen card's outline, drawn on the card border like the generic flow's. -->
                                <Border
                                    BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                                    BorderThickness="2"
                                    CornerRadius="12"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </Grid>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Left"
            Style="{StaticResource SetupActionBarStyle}">
            <Button
                AutomationProperties.AutomationId="NewRequestJobTypePage_BackButton"
                x:Uid="NewRequest_Category_BackButton"
                Content="Back"
                ContentTemplate="{StaticResource ActionBarBackTemplate}"
                Command="{x:Bind ViewModel.BackCommand}" />
        </StackPanel>
    </Grid>
</Page>
