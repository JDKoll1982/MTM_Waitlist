<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MTM_Waitlist.Module_Waitlist.Views.NewRequestCoilTurnPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Style="{StaticResource SetupPageGridStyle}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource SetupPageHeaderStyle}">
            <TextBlock
                x:Uid="NewRequest_CoilTurn_Title"
                Style="{StaticResource SetupPageTitleStyle}"
                Text="New Request - Turn the Coil" />
            <TextBlock Style="{StaticResource SetupPageSubtitleStyle}" Text="{x:Bind ViewModel.WorkCenterText, Mode=OneWay}" />
            <TextBlock Style="{StaticResource SetupPageSubtitleStyle}" Text="{x:Bind ViewModel.PromptText, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <StackPanel Spacing="10">
                <!-- The weight is the required answer this step exists for, and it is deliberately not the job's
                     average coil weight: only the operator knows the weight of the coil being turned (FR-054,
                     FR-086). -->
                <TextBox
                    x:Name="WeightInput"
                    AutomationProperties.AutomationId="NewRequestCoilTurnPage_WeightInput"
                    x:Uid="NewRequest_CoilTurn_WeightInput"
                    Header="Weight of Coil"
                    MinWidth="240"
                    MaxWidth="320"
                    HorizontalAlignment="Left"
                    Text="{x:Bind ViewModel.WeightText, Mode=TwoWay}" />
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                    TextWrapping="WrapWholeWords"
                    Visibility="{x:Bind ViewModel.IsValidationVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Style="{StaticResource SetupActionBarStyle}">
            <Button
                AutomationProperties.AutomationId="NewRequestCoilTurnPage_BackButton"
                x:Uid="NewRequest_CoilTurn_BackButton"
                Content="Back"
                ContentTemplate="{StaticResource ActionBarBackTemplate}"
                Command="{x:Bind ViewModel.BackCommand}" />
            <Button
                AutomationProperties.AutomationId="NewRequestCoilTurnPage_ContinueButton"
                x:Uid="NewRequest_CoilTurn_ContinueButton"
                Content="Continue"
                ContentTemplate="{StaticResource ActionBarContinueTemplate}"
                Command="{x:Bind ViewModel.ContinueCommand}"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>
