<Page
    x:Class="MTM_Waitlist.Module_Waitlist.Views.NewRequestDiePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MTM_Waitlist.Module_Waitlist.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Style="{StaticResource SetupPageGridStyle}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource SetupPageHeaderStyle}">
            <TextBlock
                x:Uid="NewRequest_Die.Title.Text"
                Style="{StaticResource SetupPageTitleStyle}"
                Text="New Request - Choose Die" />
            <TextBlock Style="{StaticResource SetupPageSubtitleStyle}" Text="{x:Bind ViewModel.WorkCenterText, Mode=OneWay}" />
            <TextBlock Style="{StaticResource SetupPageSubtitleStyle}" Text="{x:Bind ViewModel.PromptText, Mode=OneWay}" />
            <TextBlock
                Margin="0,6,0,0"
                Style="{StaticResource RequestDialogCaptionStyle}"
                Text="{x:Bind ViewModel.UnavailableMessage, Mode=OneWay}"
                TextWrapping="WrapWholeWords"
                Visibility="{x:Bind ViewModel.IsUnavailableVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <GridView
                    AutomationProperties.AutomationId="NewRequestDiePage_DieTiles"
                    x:Name="DieGridView"
                    ItemsSource="{x:Bind ViewModel.Options, Mode=OneWay}"
                    IsItemClickEnabled="True"
                    ItemClick="DieGridView_ItemClick"
                    SelectionMode="None">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:NewRequestDieOption">
                            <Grid Margin="8" AutomationProperties.Name="{x:Bind Title}">
                                <Border
                                    MinWidth="170"
                                    MinHeight="130"
                                    MaxWidth="240"
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- The die card is no longer text only: it draws the die's own picture, or
                                             the one shared placeholder when the die cannot be pictured (FR-018). -->
                                        <Border
                                            MinWidth="64"
                                            MinHeight="64"
                                            Padding="4"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                            CornerRadius="8">
                                            <Image
                                                AutomationProperties.AutomationId="{x:Bind ImageAutomationId}"
                                                Source="{x:Bind ImagePath, Converter={StaticResource ResolvedImagePathToSourceConverter}}"
                                                Stretch="Uniform" />
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="8">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                TextAlignment="Center"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Title}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                TextAlignment="Center"
                                                Style="{StaticResource RequestDialogCaptionStyle}"
                                                Text="{x:Bind Summary}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Selection outline, drawn only on the cards currently chosen. -->
                                <Border
                                    BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    IsHitTestVisible="False"
                                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Style="{StaticResource SetupActionBarStyle}">
            <Button
                AutomationProperties.AutomationId="NewRequestDiePage_BackButton"
                x:Uid="NewRequest_Die.BackButton.Content"
                Content="Back"
                Command="{x:Bind ViewModel.BackCommand}" />
            <Button
                AutomationProperties.AutomationId="NewRequestDiePage_SelectAllButton"
                x:Uid="NewRequest_Die.SelectAllButton.Content"
                Content="Select all"
                Command="{x:Bind ViewModel.SelectAllCommand}" />
            <Button
                AutomationProperties.AutomationId="NewRequestDiePage_ContinueButton"
                x:Uid="NewRequest_Die.ContinueButton.Content"
                Content="Continue"
                Command="{x:Bind ViewModel.ContinueCommand}"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>
