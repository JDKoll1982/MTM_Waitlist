<Page
    x:Class="MTM_Waitlist.Module_Waitlist.Views.NewRequestDunnagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MTM_Waitlist.Module_Waitlist.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Style="{StaticResource SetupPageGridStyle}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource SetupPageHeaderStyle}">
            <TextBlock
                x:Uid="NewRequest_Dunnage.Title"
                Style="{StaticResource SetupPageTitleStyle}"
                Text="New Request - Choose Dunnage" />
            <TextBlock Style="{StaticResource SetupPageSubtitleStyle}" Text="{x:Bind ViewModel.WorkCenterText, Mode=OneWay}" />
            <TextBlock Style="{StaticResource SetupPageSubtitleStyle}" Text="{x:Bind ViewModel.PromptText, Mode=OneWay}" />
            <TextBlock
                Margin="0,6,0,0"
                Style="{StaticResource RequestDialogCaptionStyle}"
                Text="{x:Bind ViewModel.UnavailableMessage, Mode=OneWay}"
                TextWrapping="WrapWholeWords"
                Visibility="{x:Bind ViewModel.IsUnavailableVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <ProgressRing
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <GridView
                    AutomationProperties.AutomationId="NewRequestDunnagePage_DunnageTiles"
                    x:Name="DunnageGridView"
                    ItemsSource="{x:Bind ViewModel.Options, Mode=OneWay}"
                    IsItemClickEnabled="True"
                    ItemClick="DunnageGridView_ItemClick"
                    SelectionMode="None">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:NewRequestDunnageOption">
                            <Grid Margin="8" AutomationProperties.Name="{x:Bind Title}">
                                <Border
                                    Width="150"
                                    Height="170"
                                    Padding="10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                        <Border
                                            Width="84"
                                            Height="84"
                                            Padding="4"
                                            HorizontalAlignment="Center"
                                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                            CornerRadius="8">
                                            <Image
                                                Source="{x:Bind ImagePath, Converter={StaticResource ResolvedImagePathToSourceConverter}}"
                                                Stretch="Uniform" />
                                        </Border>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            TextAlignment="Center"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Title}"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            TextAlignment="Center"
                                            Style="{StaticResource RequestDialogCaptionStyle}"
                                            Text="{x:Bind Summary}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Border>

                                <!-- Selection outline, drawn only on the card currently chosen. -->
                                <Border
                                    BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    IsHitTestVisible="False"
                                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Style="{StaticResource SetupActionBarStyle}">
            <Button
                AutomationProperties.AutomationId="NewRequestDunnagePage_BackButton"
                x:Uid="NewRequest_Dunnage.BackButton"
                Content="Back"
                Command="{x:Bind ViewModel.BackCommand}" />
            <Button
                AutomationProperties.AutomationId="NewRequestDunnagePage_SubstituteButton"
                x:Uid="NewRequest_Dunnage.SubstituteButton"
                Content="Use substitute…"
                Command="{x:Bind ViewModel.UseSubstituteCommand}" />
        </StackPanel>
    </Grid>
</Page>
