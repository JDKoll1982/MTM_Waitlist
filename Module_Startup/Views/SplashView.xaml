<UserControl
    x:Class="MTM_Waitlist.Module_Startup.Views.SplashView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">
            <ProgressRing
                Width="64"
                Height="64"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="26"
                FontWeight="SemiBold"
                Text="Launching MTM Waitlist" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            <Border
                x:Name="DatabaseFailureBanner"
                x:Load="{x:Bind ViewModel.IsDatabaseFailure, Mode=OneWay}"
                Padding="12"
                Background="{ThemeResource SystemFillColorCriticalBrush}"
                CornerRadius="8">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    FontWeight="SemiBold"
                    Text="We could not connect to the database. Retry or close the application." />
            </Border>
        </StackPanel>

        <StackPanel
            x:Name="ActionArea"
            Grid.Row="1"
            x:Load="{x:Bind ViewModel.ShowActions, Mode=OneWay}"
            Margin="0,0,0,24"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="12">
            <Button Command="{x:Bind ViewModel.RetryCommand, Mode=OneWay}" Content="Retry" />
            <StackPanel
                x:Name="ResetActionArea"
                x:Load="{x:Bind ViewModel.ShowResetToDefaultsAction, Mode=OneWay}">
                <Button Command="{x:Bind ViewModel.ResetToDefaultsCommand, Mode=OneWay}" Content="Restore Defaults" />
            </StackPanel>
            <Button Command="{x:Bind ViewModel.ExitCommand, Mode=OneWay}" Content="Close" />
        </StackPanel>
    </Grid>
</UserControl>
