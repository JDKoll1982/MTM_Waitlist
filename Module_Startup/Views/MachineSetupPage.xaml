<Page
    x:Class="MTM_Waitlist.Module_Startup.Views.MachineSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The machine-setup stage: shown when this computer has no configuration and before any operator signs in
        (`contracts/machine-configuration-contract.md` §§2-3; FR-006, FR-007, FR-008).

        It is a stage of the one window rather than a window of its own. The close box, Escape, Alt+F4, the
        screen's own cancel control, declining the sign-in and the one window's own close all arrive at the same
        stated ending (FR-008): the close box routes through the host, which asks this stage what closing it
        means, and Escape and Alt+F4 are answered here.

        Four rows, and the message is its own row rather than something laid over the form: a refusal or a stated
        reason for the ending never covers the fields the person is working in (FR-005's rule, applied here).
    -->
    <Grid
        x:Name="RootGrid"
        MaxWidth="{StaticResource PageContentMaxWidth}"
        Padding="32"
        AutomationProperties.AutomationId="MachineSetupWindow_Root"
        AutomationProperties.Name="Set up this computer"
        RowSpacing="16">

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
            <KeyboardAccelerator Key="F4" Modifiers="Menu" Invoked="OnAltF4Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock
                AutomationProperties.AutomationId="MachineSetupWindow_Heading"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.TitleText}" />
            <TextBlock
                AutomationProperties.AutomationId="MachineSetupWindow_Subtitle"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.SubtitleText}"
                TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <!-- The unlock. It is offered until somebody is authorised, and the save checks that again. -->
                <StackPanel
                    AutomationProperties.AutomationId="MachineSetupWindow_SignInPanel"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.ShowSignInForm, Mode=OneWay}">
                    <TextBlock
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.SignInHeadingText}" />
                    <TextBox
                        x:Name="SignInNameBox"
                        AutomationProperties.AutomationId="MachineSetupWindow_SignInName"
                        Header="{x:Bind ViewModel.SignInNameLabelText}"
                        PlaceholderText="{x:Bind ViewModel.SignInNameHintText}"
                        Text="{x:Bind ViewModel.SignInName, Mode=TwoWay}" />
                    <PasswordBox
                        x:Name="CredentialBox"
                        AutomationProperties.AutomationId="MachineSetupWindow_Credential"
                        Header="{x:Bind ViewModel.CredentialLabelText}"
                        PlaceholderText="{x:Bind ViewModel.CredentialHintText}" />
                    <Button
                        x:Name="SignInButton"
                        AutomationProperties.AutomationId="MachineSetupWindow_SignInButton"
                        Click="OnSignInClick"
                        Content="{x:Bind ViewModel.SignInActionText}"
                        IsEnabled="{x:Bind ViewModel.CanSignIn, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <!-- What this computer is. It appears only once the gate has authorised a person. -->
                <StackPanel
                    AutomationProperties.AutomationId="MachineSetupWindow_ConfigurationPanel"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.ShowConfigurationForm, Mode=OneWay}">
                    <TextBlock
                        AutomationProperties.AutomationId="MachineSetupWindow_AuthorizedPerson"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.AuthorizedPersonName, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasAuthorizedPerson, Mode=OneWay}" />
                    <TextBlock
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.IdentityHeadingText}" />
                    <!-- The name is read from the computer and shown. It is drawn as text rather than as a field,
                         so there is nothing for a person to type (FR-049). -->
                    <TextBlock
                        AutomationProperties.AutomationId="MachineSetupWindow_ComputerNameLabel"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.ComputerNameLabelText}" />
                    <TextBlock
                        x:Name="ComputerNameText"
                        AutomationProperties.AutomationId="MachineSetupWindow_ComputerName"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.ComputerName, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBox
                        x:Name="LocationBox"
                        AutomationProperties.AutomationId="MachineSetupWindow_Location"
                        Header="{x:Bind ViewModel.LocationLabelText}"
                        Text="{x:Bind ViewModel.Location, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border
            x:Name="MessageStrip"
            AutomationProperties.AutomationId="MachineSetupWindow_Message"
            Grid.Row="2"
            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
            CornerRadius="4"
            Padding="12"
            Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}">
            <TextBlock
                x:Name="MessageText"
                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                TextWrapping="Wrap" />
        </Border>

        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <ProgressRing
                AutomationProperties.AutomationId="MachineSetupWindow_Busy"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <Button
                x:Name="CancelButton"
                AutomationProperties.AutomationId="MachineSetupWindow_CancelButton"
                Click="OnCancelClick"
                Content="{x:Bind ViewModel.CancelActionText}" />
            <Button
                x:Name="SaveButton"
                AutomationProperties.AutomationId="MachineSetupWindow_SaveButton"
                Click="OnSaveClick"
                Content="{x:Bind ViewModel.SaveActionText}"
                IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.ShowConfigurationForm, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
