<Page
    x:Class="MTM_Waitlist.Module_Startup.Views.SplashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Startup.Models"
    mc:Ignorable="d">

    <!--
        The launch surface, and the stage the one window shows while a launch runs
        (`contracts/launch-concurrency-contract.md` §3; FR-002, FR-004, FR-005, FR-031, FR-039).

        A splash screen reads top to bottom: the mark, then how far along the launch is, then every line whose
        work is still in flight, then anything the person may act on.

        Several operations can now run at the same time, so the surface renders each of them as its own row
        rather than one "current step": an operation announces itself before its work begins, so its row is open
        until the row that ends it arrives. That is what makes a stalled concurrent launch attributable to a
        named operation instead of an anonymous hang (FR-031).

        The whole stack is centred on the window rather than anchored to its top: the surface is watched for a
        handful of seconds while a launch runs, and a short stack pinned to the top of an otherwise empty window
        reads as a window that is still loading rather than as a launch under way.

        The error strip is its own row rather than something laid over the rows above it, so a stated cause never
        covers what a person is reading (FR-005).
    -->
    <Grid
        Padding="32,28"
        RowSpacing="16"
        VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image
            x:Name="Logo"
            AutomationProperties.AutomationId="SplashPage_Logo"
            AutomationProperties.Name="{x:Bind ViewModel.TitleText}"
            Grid.Row="0"
            HorizontalAlignment="Center"
            MaxHeight="132"
            Source="ms-appx:///Assets/Brand/mtm-logo-transparent.png"
            Stretch="Uniform" />

        <StackPanel Grid.Row="1" Spacing="6">
            <ProgressBar
                x:Name="ProgressBar"
                AutomationProperties.AutomationId="SplashPage_ProgressBar"
                IsIndeterminate="{x:Bind ViewModel.IsWaitingOnSomethingRemote, Mode=OneWay}"
                Maximum="{x:Bind ViewModel.ProgressMaximum, Mode=OneWay}"
                Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
            <TextBlock
                x:Name="ProgressTextBlock"
                AutomationProperties.AutomationId="SplashPage_Progress"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
        </StackPanel>

        <!--
            Every line whose work has not ended, rendered at once. An open row carries its own moving indicator, so
            a launch with three operations in flight shows three rows and the person can see which one is still
            going (FR-031).
        -->
        <ListView
            x:Name="LinesList"
            AutomationProperties.AutomationId="SplashPage_Lines"
            Grid.Row="2"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind Surface.Lines}"
            MaxHeight="240"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SplashFeedLine">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind TimeText}" />
                        <ProgressRing
                            Grid.Column="1"
                            Width="14"
                            Height="14"
                            VerticalAlignment="Center"
                            IsActive="{x:Bind IsOpen}"
                            Visibility="{x:Bind IsOpen}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Text="{x:Bind Text}"
                            TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border
            x:Name="ErrorStrip"
            AutomationProperties.AutomationId="SplashPage_ErrorStrip"
            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
            CornerRadius="4"
            Grid.Row="3"
            Padding="12,8"
            Visibility="Collapsed">
            <TextBlock
                x:Name="ErrorTextBlock"
                AutomationProperties.AutomationId="SplashPage_ErrorText"
                TextWrapping="Wrap" />
        </Border>

        <!--
            The button bar. The one window is the only window, so this is a second way out beside the window's own
            close box, and it ends the process exactly as closing the window does.
        -->
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="CloseButton"
                AutomationProperties.AutomationId="SplashPage_CloseButton"
                Click="OnCloseClick"
                Content="{x:Bind ViewModel.CloseActionText}" />
        </StackPanel>
    </Grid>
</Page>
