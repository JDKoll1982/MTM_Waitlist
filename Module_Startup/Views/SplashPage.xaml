<Page
    x:Class="MTM_Waitlist.Module_Startup.Views.SplashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MTM_Waitlist.Module_Shared.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        A splash screen reads top to bottom: the mark, then how far along the launch is, then the one line stating
        the work under way, then anything the person may act on.

        Row 1 is the logo. Row 2 is the progress bar and the count beneath it, and the bar turns into a travelling
        one while the step under way is reaching for something outside this computer — a store, a share, the
        external system — because those are the waits with no proportion to report and a bar that sits still
        through one looks like a frozen application. Row 3 is the single status line, which rotates rather than
        flickering as each step takes over; it states the work under way and nothing that has already finished,
        because the surface shows a launch rather than a history of one (FR-039). Row 4 is a stated stop, and Row 5
        is the button bar.

        The error strip is its own row rather than something laid over the line above it, so a stated cause never
        covers what a person is reading (FR-005).
    -->
    <Grid Padding="32,28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image
            x:Name="Logo"
            AutomationProperties.AutomationId="SplashPage_Logo"
            AutomationProperties.Name="{x:Bind ViewModel.TitleText}"
            Grid.Row="0"
            HorizontalAlignment="Center"
            MaxHeight="132"
            Source="ms-appx:///Assets/Brand/mtm-logo-transparent.png"
            Stretch="Uniform" />

        <StackPanel Grid.Row="1" Spacing="6">
            <ProgressBar
                x:Name="ProgressBar"
                AutomationProperties.AutomationId="SplashPage_ProgressBar"
                IsIndeterminate="{x:Bind ViewModel.IsWaitingOnSomethingRemote, Mode=OneWay}"
                Maximum="{x:Bind ViewModel.ProgressMaximum, Mode=OneWay}"
                Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
            <TextBlock
                x:Name="ProgressTextBlock"
                AutomationProperties.AutomationId="SplashPage_Progress"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
        </StackPanel>

        <controls:RotatingTextView
            x:Name="StatusText"
            AutomationProperties.AutomationId="SplashPage_Status"
            Grid.Row="2"
            FontSize="16"
            FontWeight="SemiBold"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            HorizontalAlignment="Center"
            Text="{x:Bind ViewModel.CurrentStep, Mode=OneWay}"
            TextAlignment="Center" />

        <Border
            x:Name="ErrorStrip"
            AutomationProperties.AutomationId="SplashPage_ErrorStrip"
            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
            CornerRadius="4"
            Grid.Row="3"
            Padding="12,8"
            Visibility="Collapsed">
            <TextBlock
                x:Name="ErrorTextBlock"
                AutomationProperties.AutomationId="SplashPage_ErrorText"
                TextWrapping="Wrap" />
        </Border>

        <!--
            The button bar. The window carries no title bar and no system buttons, so this is the only way out of
            the surface that a person can see, and it ends the process exactly as closing the window does.
        -->
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="CloseButton"
                AutomationProperties.AutomationId="SplashPage_CloseButton"
                Click="OnCloseClick"
                Content="{x:Bind ViewModel.CloseActionText}" />
        </StackPanel>
    </Grid>
</Page>
