<Page
    x:Class="MTM_Waitlist.Module_Startup.Views.DeveloperModePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">
            <TextBlock
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="Developer Mode" />
            <wct:SettingsCard>
                <wct:SettingsCard.Header>
                    <TextBlock
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="Startup recovery test" />
                </wct:SettingsCard.Header>
                <wct:SettingsCard.Description>
                    <TextBlock
                        TextWrapping="Wrap"
                        Text="Deliberately corrupts the local startup settings, restarts the application, and verifies that the Splash recovery flow can restore defaults." />
                </wct:SettingsCard.Description>
                <wct:SettingsCard.Content>
                    <StackPanel Spacing="8">
                        <Button
                            HorizontalAlignment="Left"
                            Command="{x:Bind ViewModel.CorruptStartupDataAndRestartCommand}"
                            Content="Corrupt startup data and restart" />
                        <ProgressRing
                            Width="20"
                            Height="20"
                            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                    </StackPanel>
                </wct:SettingsCard.Content>
            </wct:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
