<Page
    x:Class="MTM_Waitlist.Module_Startup.Views.SignInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MTM_Waitlist.Module_Startup.Models"
    xmlns:views="using:MTM_Waitlist.Module_Startup.Views"
    mc:Ignorable="d">

    <!--
        The sign-in stage, in two parts: an identifier first (a user name, or exactly four digits for an employee
        number), then the PIN (`contracts/identifier-signin-contract.md` §§1-3, §5; FR-001 to FR-007, FR-012 to
        FR-015). The people who signed in on this computer before are offered beside the form, behind a rule, as
        choices that fill in the user name only (FR-014, FR-048).

        It is a stage of the one window rather than a window of its own, because there is one window for the whole
        life of the application. The message is its own row rather than something laid over the form, so a refusal
        never covers the fields the person is working in (FR-005's rule, applied here), and the set-up panel takes
        the form's place rather than sitting over it.

        Enter submits on each stage exactly as the button does, and the set-up panel advances field by field
        (FR-014); a blank field shows its hint rather than doing nothing (FR-015).
    -->
    <Grid
        x:Name="RootGrid"
        Padding="32"
        AutomationProperties.AutomationId="SignInWindow_Root"
        AutomationProperties.Name="Sign in"
        RowSpacing="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock
                AutomationProperties.AutomationId="SignInWindow_Heading"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.HeadingText}" />
            <TextBlock
                AutomationProperties.AutomationId="SignInWindow_Subtitle"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.SubtitleText}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--
            Two columns: the form on the left and the people who signed in here before on the right, divided by a
            rule. The list is a set of choices that fill in the user name only, so the PIN is always still entered
            (FR-014, FR-048).
        -->
        <Grid Grid.Row="1" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">

                <!-- The first stage: what identifies the person. -->
                <StackPanel
                    x:Name="IdentifierPanel"
                    AutomationProperties.AutomationId="SignInWindow_IdentifierPanel"
                    Spacing="8">
                    <TextBox
                        x:Name="IdentifierBox"
                        AutomationProperties.AutomationId="SignInWindow_Identifier"
                        Header="{x:Bind IdentifierLabelText}"
                        KeyDown="OnIdentifierKeyDown"
                        Text="{x:Bind ViewModel.IdentifierText, Mode=TwoWay}" />
                    <TextBlock
                        AutomationProperties.AutomationId="SignInWindow_IdentifierHint"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind IdentifierHintText}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="ContinueButton"
                        AutomationProperties.AutomationId="SignInWindow_ContinueButton"
                        Click="OnContinueClick"
                        Content="{x:Bind ViewModel.ContinueActionText}"
                        IsEnabled="{x:Bind ViewModel.CanSignIn, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <!-- The second stage: the PIN for the person the identifier resolved to. -->
                <StackPanel
                    x:Name="CredentialPanel"
                    AutomationProperties.AutomationId="SignInWindow_SignInPanel"
                    Spacing="8">
                    <TextBlock
                        AutomationProperties.AutomationId="SignInWindow_ResolvedName"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.SignInName, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <PasswordBox
                        x:Name="CredentialBox"
                        AutomationProperties.AutomationId="SignInWindow_Credential"
                        Header="{x:Bind ViewModel.CredentialLabelText}"
                        KeyDown="OnCredentialKeyDown" />
                    <TextBlock
                        AutomationProperties.AutomationId="SignInWindow_Hint"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.Hint, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="SignInButton"
                        AutomationProperties.AutomationId="SignInWindow_SignInButton"
                        Click="OnSignInClick"
                        Content="{x:Bind ViewModel.SignInActionText}"
                        IsEnabled="{x:Bind ViewModel.CanSignIn, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <!-- The forced password change. It appears only once a temporary credential has been accepted (FR-013). -->
                <StackPanel
                    x:Name="PasswordPanel"
                    AutomationProperties.AutomationId="SignInWindow_PasswordPanel"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsPasswordChangeRequired, Mode=OneWay}">
                    <TextBlock
                        AutomationProperties.AutomationId="SignInWindow_PasswordHeading"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind PasswordChange.HeadingText}" />
                    <TextBlock
                        AutomationProperties.AutomationId="SignInWindow_PasswordExplanation"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind PasswordChange.ExplanationText}"
                        TextWrapping="Wrap" />
                    <PasswordBox
                        x:Name="NewPasswordBox"
                        AutomationProperties.AutomationId="SignInWindow_NewPassword"
                        Header="{x:Bind PasswordChange.PasswordLabelText}" />
                    <PasswordBox
                        x:Name="ConfirmPasswordBox"
                        AutomationProperties.AutomationId="SignInWindow_ConfirmPassword"
                        Header="{x:Bind PasswordChange.ConfirmationLabelText}" />
                    <TextBlock
                        x:Name="PasswordMessageText"
                        AutomationProperties.AutomationId="SignInWindow_PasswordMessage"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind PasswordChange.Message, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind PasswordChange.HasMessage, Mode=OneWay}" />
                    <Button
                        x:Name="SubmitPasswordButton"
                        AutomationProperties.AutomationId="SignInWindow_SubmitPasswordButton"
                        Click="OnSubmitPasswordClick"
                        Content="{x:Bind PasswordChange.SubmitActionText}"
                        IsEnabled="{x:Bind PasswordChange.CanSubmit, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <!-- The set-up panel. It takes the form's place for a person the plant system knows and the store does not. -->
                <views:SetUpPanel
                    x:Name="PanelView"
                    AutomationProperties.AutomationId="SignInWindow_SetUpPanel"
                    Visibility="{x:Bind Panel.IsVisible, Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>

            <Border
                Grid.Column="1"
                Width="1"
                Margin="20,0"
                Background="{ThemeResource CardStrokeColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.HasPreviousPeople, Mode=OneWay}" />

            <!-- The people who signed in here before: one card each, drawn on the right of the form (FR-048). -->
            <ScrollViewer
                Grid.Column="2"
                MaxWidth="300"
                VerticalScrollBarVisibility="Auto">
                <StackPanel
                    x:Name="PreviousPeoplePanel"
                    AutomationProperties.AutomationId="SignInWindow_PreviousPeoplePanel"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.HasPreviousPeople, Mode=OneWay}">
                    <TextBlock
                        AutomationProperties.AutomationId="SignInWindow_PreviousPeopleHeading"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.PreviousPeopleHeadingText}"
                        TextWrapping="Wrap" />
                    <ItemsControl
                        AutomationProperties.AutomationId="SignInWindow_PreviousPeople"
                        ItemsSource="{x:Bind ViewModel.PreviousPeople}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PreviousSignIn">
                                <Button
                                    Margin="0,0,0,4"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    AutomationProperties.AutomationId="{x:Bind SignInName}"
                                    Click="OnPreviousPersonClick">
                                    <StackPanel>
                                        <TextBlock
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind DisplayName}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind SignInName}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="MessageStrip"
                AutomationProperties.AutomationId="SignInWindow_Message"
                Grid.Column="0"
                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                CornerRadius="4"
                Padding="12"
                Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" />
            </Border>

            <ProgressRing
                AutomationProperties.AutomationId="SignInWindow_Busy"
                Grid.Column="1"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
