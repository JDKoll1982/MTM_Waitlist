<Page
    x:Class="MTM_Waitlist.Module_DevTools.Views.RequestTypeBuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wct="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid
            Margin="24"
            HorizontalAlignment="Center"
            MaxWidth="1240"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="6">
                <TextBlock
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Text="Request Type Builder" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Developer tool for creating request-type cards and detail schemas."
                    TextWrapping="Wrap" />
            </StackPanel>

            <wct:SettingsExpander
                Grid.Row="1"
                IsExpanded="True"
                Description="Define the request type, choose an image, and use presets to assemble a good name quickly."
                Header="Request Setup &amp; Presets">
                <wct:SettingsExpander.Items>
                    <wct:SettingsCard HorizontalContentAlignment="Stretch">
                        <wct:SettingsCard.Content>
                            <Grid HorizontalAlignment="Stretch" ColumnSpacing="24" RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="0.9*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="16">
                                    <TextBlock
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Text="Core Details" />

                                    <TextBox
                                        Header="Request Type Name"
                                        PlaceholderText="Example: Equipment Dropoff"
                                        Text="{x:Bind ViewModel.RequestTypeName, Mode=TwoWay}" />

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Grid.Column="0"
                                            Header="Image File"
                                            PlaceholderText="Select an image"
                                            Text="{x:Bind ViewModel.ImageFilePath, Mode=TwoWay}" />
                                        <Button
                                            Grid.Column="1"
                                            Margin="0,28,0,0"
                                            Command="{x:Bind ViewModel.BrowseImageCommand}"
                                            Content="Browse" />
                                    </Grid>

                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Text="Start with a waitlist-style prefix, then add the material flow suffix that best matches the request." />
                                </StackPanel>

                                <wct:SettingsCard Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <wct:SettingsCard.Header>
                                        <TextBlock
                                            Style="{ThemeResource SubtitleTextBlockStyle}"
                                            Text="Prefixes and Suffixes" />
                                    </wct:SettingsCard.Header>
                                    <wct:SettingsCard.Description>
                                        <TextBlock
                                            TextWrapping="Wrap"
                                            Text="Pick a preset prefix and suffix to build a request name faster." />
                                    </wct:SettingsCard.Description>
                                    <wct:SettingsCard.Content>
                                        <Grid ColumnSpacing="12" RowSpacing="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="360">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="Prefixes" />
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="Suffixes" />

                                            <ListView
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                MaxHeight="180"
                                                IsItemClickEnabled="True"
                                                ItemsSource="{x:Bind ViewModel.PresetPrefixes}"
                                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                SelectedItem="{x:Bind ViewModel.SelectedPresetPrefix, Mode=TwoWay}" />
                                            <ListView
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                MaxHeight="180"
                                                IsItemClickEnabled="True"
                                                ItemsSource="{x:Bind ViewModel.PresetSuffixes}"
                                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                SelectedItem="{x:Bind ViewModel.SelectedPresetSuffix, Mode=TwoWay}" />

                                            <StackPanel
                                                Grid.Row="2"
                                                Grid.ColumnSpan="2"
                                                Margin="0,12,0,0"
                                                Orientation="Horizontal"
                                                Spacing="12">
                                                <Button
                                                    Command="{x:Bind ViewModel.ApplySelectedPresetPrefixCommand}"
                                                    Content="Use Prefix" />
                                                <Button
                                                    Command="{x:Bind ViewModel.ApplySelectedPresetSuffixCommand}"
                                                    Content="Use Suffix" />
                                                <Button
                                                    Command="{x:Bind ViewModel.ApplySelectedPresetPairCommand}"
                                                    Content="Use Prefix + Suffix" />
                                            </StackPanel>
                                        </Grid>
                                    </wct:SettingsCard.Content>
                                </wct:SettingsCard>
                            </Grid>
                        </wct:SettingsCard.Content>
                    </wct:SettingsCard>
                </wct:SettingsExpander.Items>
            </wct:SettingsExpander>

            <wct:SettingsExpander
                Grid.Row="2"
                IsExpanded="True"
                Description="Add up to five fields that appear on the request card."
                Header="Card Data (Max 5)">
                <wct:SettingsExpander.Items>
                    <wct:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                        <wct:SettingsCard.Content>
                            <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                                <Grid ColumnSpacing="8" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        Header="Field"
                                        Text="{x:Bind ViewModel.CardFieldNameInput, Mode=TwoWay}" />
                                    <ComboBox
                                        Grid.Column="1"
                                        Header="Type"
                                        DisplayMemberPath="Label"
                                        ItemsSource="{x:Bind ViewModel.DataTypeOptions}"
                                        SelectedItem="{x:Bind ViewModel.SelectedCardDataType, Mode=TwoWay}" />
                                    <Button
                                        Grid.Column="2"
                                        Margin="0,28,0,0"
                                        Command="{x:Bind ViewModel.AddCardFieldCommand}"
                                        Content="Add" />
                                </Grid>

                                <ListView
                                    Height="140"
                                    ItemsSource="{x:Bind ViewModel.CardFields}"
                                    SelectedItem="{x:Bind ViewModel.SelectedCardField, Mode=TwoWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding FieldName}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding DataTypeLabel}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Button
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.RemoveSelectedCardFieldCommand}"
                                    Content="Remove Selected Card Field" />
                            </StackPanel>
                        </wct:SettingsCard.Content>
                    </wct:SettingsCard>
                </wct:SettingsExpander.Items>
            </wct:SettingsExpander>

            <wct:SettingsExpander
                Grid.Row="3"
                IsExpanded="True"
                Description="Add the information that should appear after the card is opened."
                Header="Clicked Card Data">
                <wct:SettingsExpander.Items>
                    <wct:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                        <wct:SettingsCard.Content>
                            <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                                <Grid ColumnSpacing="8" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        Header="Field"
                                        Text="{x:Bind ViewModel.DetailFieldNameInput, Mode=TwoWay}" />
                                    <ComboBox
                                        Grid.Column="1"
                                        Header="Type"
                                        DisplayMemberPath="Label"
                                        ItemsSource="{x:Bind ViewModel.DataTypeOptions}"
                                        SelectedItem="{x:Bind ViewModel.SelectedDetailDataType, Mode=TwoWay}" />
                                    <Button
                                        Grid.Column="2"
                                        Margin="0,28,0,0"
                                        Command="{x:Bind ViewModel.AddDetailFieldCommand}"
                                        Content="Add" />
                                    HorizontalAlignment="Stretch"
                                </Grid>

                                <ListView
                                    Height="180"
                                    ItemsSource="{x:Bind ViewModel.DetailFields}"
                                    SelectedItem="{x:Bind ViewModel.SelectedDetailField, Mode=TwoWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding FieldName}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding DataTypeLabel}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Button
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.RemoveSelectedDetailFieldCommand}"
                                    Content="Remove Selected Detail Field" />
                            </StackPanel>
                        </wct:SettingsCard.Content>
                    </wct:SettingsCard>
                </wct:SettingsExpander.Items>
            </wct:SettingsExpander>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12">
                <Button
                    Command="{x:Bind ViewModel.SaveRequestTypeCommand}"
                    Content="Save Request Type" />
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
