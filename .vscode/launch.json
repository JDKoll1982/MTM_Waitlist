{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MTM_Waitlist - App Logs Only",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/bin/x64/Debug/net10.0-windows10.0.19041.0/win-x64/MTM_Waitlist.exe",
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "justMyCode": true,
            "env": {
                "Logging__LogLevel__Default": "None",
                "Logging__LogLevel__Microsoft": "None",
                "Logging__LogLevel__Microsoft.Hosting.Lifetime": "None"
            }
        },
        {
            "name": "MTM_Waitlist - App Logs + Exceptions",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/bin/x64/Debug/net10.0-windows10.0.19041.0/win-x64/MTM_Waitlist.exe",
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "justMyCode": true,
            "env": {
                "Logging__LogLevel__Default": "None",
                "Logging__LogLevel__Microsoft": "None",
                "Logging__LogLevel__Microsoft.Hosting.Lifetime": "None"
            }
        }
    ]
}