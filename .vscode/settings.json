{
    "csharp.debug.justMyCode": true,
    "csharp.debug.logging": {
        "exceptions": false,
        "moduleLoad": false,
        "programOutput": true,
        "threadExit": false,
        "processExit": false
    },
    "files.associations": {
        "*.csv": "tsv"
    },
    "codegraphy.exclude": [
        "**/*.md",
        "**/*.txt",
        "**/docs/**",
        "**/*.json",
        "**/*.config"
    ],
    "python-envs.defaultEnvManager": "ms-python.python:system",
    "chat.mcp.serverSampling": {
        "MTM_Waitlist/.vscode/mcp.json: xamlmcp": {
            "allowedModels": [
                "agent-host-copilotcli:deepseek/deepseek-v4-flash",
                "deepseek/deepseek-v4-flash",
                "agent-host-copilotcli:deepseek/deepseek-v4-flash-vision-exp",
                "deepseek/deepseek-v4-flash-vision-exp"
            ]
        },
        "MTM_Waitlist/.vscode/mcp.json: oraios/serena": {
            "allowedModels": [
                "agent-host-copilotcli:deepseek/deepseek-v4-flash",
                "deepseek/deepseek-v4-flash",
                "agent-host-copilotcli:deepseek/deepseek-v4-flash-vision-exp",
                "deepseek/deepseek-v4-flash-vision-exp"
            ]
        },
        "MTM_Waitlist/.vscode/mcp.json: csv-mcp-server": {
            "allowedModels": [
                "copilotcli/auto",
                "copilot/auto",
                "agent-host-copilotcli:deepseek/deepseek-v4-flash",
                "deepseek/deepseek-v4-flash",
                "agent-host-copilotcli:deepseek/deepseek-v4-flash-vision-exp",
                "deepseek/deepseek-v4-flash-vision-exp"
            ]
        }
    },
    "chat.promptFilesRecommendations": {
        "speckit.constitution": true,
        "speckit.specify": true,
        "speckit.plan": true,
        "speckit.tasks": true,
        "speckit.implement": true
    },
    "chat.tools.terminal.autoApprove": {
        ".specify/scripts/bash/": true,
        ".specify/scripts/powershell/": true
    }
}
