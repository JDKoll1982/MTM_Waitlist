{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build MTM_Waitlist",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"${workspaceFolder}/MTM_Waitlist.sln",
				"-p:Configuration=Debug",
				"-p:Platform=x64",
				"/m:1",
				"/nodeReuse:false"
			],
			"options": {
				"env": {
					"MSBUILDDISABLENODEREUSE": "1"
				}
			},
			"problemMatcher": "$msCompile",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Clean MTM_Waitlist",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"clean",
				"${workspaceFolder}/MTM_Waitlist.sln",
				"-p:Configuration=Debug",
				"-p:Platform=x64",
				"/m:1",
				"/nodeReuse:false"
			],
			"options": {
				"env": {
					"MSBUILDDISABLENODEREUSE": "1"
				}
			},
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Kill stale build processes",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-Process -Name MTM_Waitlist,Microsoft.UI.Xaml.Markup.Compiler,VBCSCompiler,MSBuild -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; Write-Output 'Cleared stale XAML compiler / build node processes.'"
			]
		},
		{
			"label": "Test: All (clean)",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-Process -Name MTM_Waitlist,Microsoft.UI.Xaml.Markup.Compiler,VBCSCompiler,MSBuild -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; $env:MSBUILDDISABLENODEREUSE='1'; dotnet test \"${workspaceFolder}/MTM_Waitlist.Tests/MTM_Waitlist.Tests.csproj\" -c Debug -p:Platform=x64"
			],
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Run Module_Setup tests",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"test",
				"${workspaceFolder}/MTM_Waitlist.Tests/MTM_Waitlist.Tests.csproj",
				"-p:Platform=x64",
				"/m:1",
				"--filter",
				"FullyQualifiedName~Module_Setup"
			],
			"options": {
				"env": {
					"MSBUILDDISABLENODEREUSE": "1"
				}
			}
		}
	]
}